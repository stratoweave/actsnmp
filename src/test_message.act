"""Tests for message

MSG_A .. MSG_O are the SNMPv1/v2c reference packets, verified with pysnmp,
tshark and net-snmp. The V3 vectors are the deterministic SNMPv3 messages
and net-snmp captures; their MAC offsets were confirmed with Python hmac.
The remaining messages were encoded independently with pysnmp 7.1 and
pyasn1 0.6.
"""

import testing
import ber
import errors
import message
import pdu
from oid import Oid
from pdu import Pdu, TrapV1Pdu
from message import CommunityMessage, V3Message, UsmSecurityParameters, ScopedPdu
from values import VarBind, Value, Integer, OctetString, ObjectIdentifier, IpAddress, Counter32, Gauge32
from values import TimeTicks, Opaque, Counter64, NoSuchObject, NoSuchInstance, EndOfMibView, UnknownValue
from values import MalformedValue
from testutil import h, decode_fails, encode_fails, Lcg

def vb(oid: str, v: Value) -> VarBind:
    return VarBind(Oid.parse(oid), v)

def req(oid: str) -> VarBind:
    return VarBind(Oid.parse(oid))

def oidv(oid: str) -> ObjectIdentifier:
    return ObjectIdentifier(Oid.parse(oid))

def community_of(data: bytes) -> CommunityMessage:
    c, v = message.decode(data)
    testing.assertNone(v)
    if c is not None:
        return c
    raise AssertionError("not a community message: " + data.hex())

def v3_of(data: bytes) -> V3Message:
    c, v = message.decode(data)
    testing.assertNone(c)
    if v is not None:
        return v
    raise AssertionError("not an SNMPv3 message: " + data.hex())

def encode3(m: V3Message, payload: bytes) -> (bytes, int):
    """message.encode_v3 as a plain tuple, for unpacking"""
    r = message.encode_v3(m, payload)
    return (r.msg, r.auth_offset)

def zero_mac(data: bytes, offset: int, n: int) -> bytes:
    return data[:offset] + b"\x00" * n + data[offset + n:]


