               63, None, 49),
        V3Case("net-snmp sha256aes Response", NS_SHA256AES_RESPONSE, 0x241e54ae, 0x03, UsmSecurityParameters(engine(),
               1, 90, b"sha256aes", h("dbb852d86a9d8f69e4c6f3f2a7feda7027728cd14da4be01"), h("53c8002187c1d9c1")),
               63, None, 69),
        V3Case("v3 trap", V3_TRAP_NOAUTH, 0x1000, 0x00, UsmSecurityParameters(engine(), 7, 1000, b"noauth"), 59,
               ScopedPdu(engine(), b"", Pdu(pdu.TRAP_V2, 99, varbinds=[
                   vb(SYS_UPTIME, TimeTicks(100000)), vb(TRAP_OID, oidv("1.3.6.1.6.3.1.1.5.4")),
                   vb("1.3.6.1.2.1.2.2.1.1.2", Integer(2))]))),
        V3Case("v3 inform", V3_INFORM_SHA, 2147483647, 0x05, UsmSecurityParameters(engine(), 1, 150, b"shaonly",
               h("b30de57fccf6670145130c02")), 62,
               ScopedPdu(engine(), b"ctx", Pdu(pdu.INFORM, 77, varbinds=[
                   vb(SYS_UPTIME, TimeTicks(4242)), vb(TRAP_OID, oidv("1.3.6.1.6.3.1.1.5.1"))]))),
    ]

# The documented ciphertexts of the deterministic vectors
def spec9_ciphertexts() -> dict[str, bytes]:
    return {
        "V-MD5-DES": h("28468e6066b2c3d978d5232f7f7e56785d793d927d63c15db32b6afd75589c1ec76ce216b5d4b8a40c9178ddee5f9915c79a24204d99f04b"),
        "V-SHA-AES": h("de46c1433b208b758146de11e079276ee206bab469d6ce21038348f198816b713439d9e58ac5b4b2b45044c7e38c6a50ad"),
        "V-SHA256-AES": h("fe3e1e5c4c5796fe07c9bd16ce71174ee7de35ab7219fcafe3a8e6121bff78d6001a75ed00825f0460460a1bee412124bc"),
        "V-SHA512-AES": h("00f6bd885a2280d692f48d7235bf0253d53a61f9bea0f761968260557e1dc4d68cda45559cff1ad1a3c4c64df1c9b39028"),
        "V-SHA-AES256-BLUMENTHAL": h("b0b1388a10dd06ed7e9001f7be3fe765f8cfcc39780e43260f8cf10dc82dacba69fea90096724237b279da96eb01771f5b"),
        "V-SHA-AES256C-REEDER": h("d36f8dda3098977e766a64088f2ca41c63858c002d198dbd50d1324a0d21888fcf013625023657588401df41961e1c8329"),
        "V-SHA256-DES": h("6f846754d1c7fe34ef066d97fef3cf748d540de2f60cb18404ebea2895d8f20dedf885de2f36d6f72039e5358278bf6690776cc96db61a43"),
    }

def _test_v3_decode() -> None:
    for c in v3_cases():
        m = v3_of(c.data)
        testing.assertEqual(m.msg_id, c.msg_id, c.name)
        testing.assertEqual(m.max_size, 65507, c.name)
        testing.assertEqual(m.flags, c.flags, c.name)
        testing.assertEqual(m.security_model, message.SEC_MODEL_USM, c.name)
        testing.assertEqual(m.usm, c.usm, c.name)
        testing.assertEqual(m.auth_offset, c.auth_offset, c.name)
        n = len(c.usm.auth_params)
        testing.assertEqual(c.data[m.auth_offset:m.auth_offset + n], c.usm.auth_params, c.name)
        testing.assertEqual(m.scoped, c.scoped, c.name)
        if c.encrypted_len >= 0:
            testing.assertEqual(m.encrypted, c.data[len(c.data) - c.encrypted_len:], c.name)
        else:
            testing.assertNone(m.encrypted, c.name)

def _test_v3_spec9_ciphertexts() -> None:
    cts = spec9_ciphertexts()
    found = 0
    for c in v3_cases():
        ct = cts.get(c.name)
        if ct is not None:
            testing.assertEqual(v3_of(c.data).encrypted, ct, c.name)
            found += 1
    testing.assertEqual(found, 7)

def _test_v3_reencode_up_to_mac() -> None:
    # Every vector re-encodes from its decoded fields to the same octets, with the MAC
    # zeroed at the same offset.
    for c in v3_cases():
        m = v3_of(c.data)
        s = m.scoped
        e = m.encrypted
        if s is not None:
            payload = message.encode_scoped(s)
        elif e is not None:
            payload = e
        else:
            raise AssertionError("no data in " + c.name)
        msg, off = encode3(m, payload)
        n = len(c.usm.auth_params)
        testing.assertEqual(off, c.auth_offset, c.name)
        testing.assertEqual(msg, zero_mac(c.data, off, n), c.name)

def _test_v3_encode_noauth_exact() -> None:
    # V-NOAUTH built from scratch reproduces the vector byte for byte
    m = V3Message(0x01020304, 65507, message.FLAG_REPORTABLE, UsmSecurityParameters(engine(), 0, 0, b"noauth"))
    msg, off = encode3(m, message.encode_scoped(spec_scoped(0x0a0b0c0d)))
    testing.assertEqual(msg, h(V_NOAUTH))
    testing.assertEqual(off, 59)
    # the other noAuthNoPriv messages: discovery request and report, the v3 trap
    m = V3Message(1001, 65507, message.FLAG_REPORTABLE, UsmSecurityParameters())
    msg, off = encode3(m, message.encode_scoped(ScopedPdu(b"", b"", Pdu(pdu.GET, 5001))))
    testing.assertEqual(msg, h(DISCOVERY_REQUEST))
    testing.assertEqual(off, 38)
    m = V3Message(1001, 65507, 0, UsmSecurityParameters(engine(), 1, 49))
    msg, off = encode3(m, message.encode_scoped(report(5001, 4, 11)))
    testing.assertEqual(msg, h(DISCOVERY_REPORT))
    m = V3Message(0x1000, 65507, 0, UsmSecurityParameters(engine(), 7, 1000, b"noauth"))
    sp = ScopedPdu(engine(), b"", Pdu(pdu.TRAP_V2, 99, varbinds=[
        vb(SYS_UPTIME, TimeTicks(100000)), vb(TRAP_OID, oidv("1.3.6.1.6.3.1.1.5.4")),
        vb("1.3.6.1.2.1.2.2.1.1.2", Integer(2))]))
    msg, off = encode3(m, message.encode_scoped(sp))
    testing.assertEqual(msg, h(V3_TRAP_NOAUTH))
    testing.assertEqual(off, 59)

def _test_v3_encode_authnopriv_up_to_mac() -> None:
    # The placeholder is zero-filled whatever auth_params holds; only its length counts.
    for auth in [b"\x00" * 12, b"\xff" * 12, h("f559bb6bc446b77acb582af5")]:
        m = V3Message(0x01020304, 65507, message.FLAG_AUTH | message.FLAG_REPORTABLE,
                      UsmSecurityParameters(engine(), 1, 150, b"shaonly", auth))
        msg, off = encode3(m, message.encode_scoped(spec_scoped(0x0a0b0c0d)))
        testing.assertEqual(off, 61)
        testing.assertEqual(msg, zero_mac(h(V_SHA_AUTHNOPRIV), 61, 12))
        testing.assertEqual(msg[:off] + h("f559bb6bc446b77acb582af5") + msg[off + 12:], h(V_SHA_AUTHNOPRIV))
    m = V3Message(2147483647, 65507, message.FLAG_AUTH | message.FLAG_REPORTABLE,
                  UsmSecurityParameters(engine(), 1, 150, b"shaonly", b"\x00" * 12))
    sp = ScopedPdu(engine(), b"ctx", Pdu(pdu.INFORM, 77, varbinds=[
        vb(SYS_UPTIME, TimeTicks(4242)), vb(TRAP_OID, oidv("1.3.6.1.6.3.1.1.5.1"))]))
    msg, off = encode3(m, message.encode_scoped(sp))
    testing.assertEqual(off, 62)
    testing.assertEqual(msg, zero_mac(h(V3_INFORM_SHA), 62, 12))

def _test_v3_encode_authpriv_up_to_mac() -> None:
    m = V3Message(0x01020304, 65507, message.FLAG_AUTH | message.FLAG_PRIV | message.FLAG_REPORTABLE,
                  UsmSecurityParameters(engine(), 1, 150, b"shaaes", b"\x00" * 12, h("deadbeef00000001")))
    ct = spec9_ciphertexts()["V-SHA-AES"]
    msg, off = encode3(m, ct)
    testing.assertEqual(off, 61)
    testing.assertEqual(msg, zero_mac(h(V_SHA_AES), 61, 12))

def _test_v3_auth_offset_long_forms() -> None:
    # Outer and inner lengths in long form move the placeholder; encode and decode agree.
    for n in [0, 100, 200, 300, 70000]:
        usm = UsmSecurityParameters(b"e" * 32, 2147483647, 2147483647, b"u" * 32, b"\x01" * 48, b"\x02" * 8)
        m = V3Message(2147483647, 2147483647, message.FLAG_AUTH | message.FLAG_PRIV, usm)
        msg, off = encode3(m, b"\xaa" * n)
        d = v3_of(msg)
        testing.assertEqual(d.auth_offset, off, "payload %d" % n)
        testing.assertEqual(d.usm.auth_params, b"\x00" * 48)
        testing.assertEqual(d.usm.user, b"u" * 32)
        testing.assertEqual(d.encrypted, b"\xaa" * n)
        testing.assertEqual(d.max_size, 2147483647)

# Building blocks of SNMPv3 test messages

HDR = "02 04 01 02 03 04 02 03 00 ff e3 04 01 04 02 01 03"
USM = "30 21 04 0d 80 00 1f 88 80 01 02 03 04 05 06 07 08 02 01 00 02 01 00 04 06 6e 6f 61 75 74 68 04 00 04 00"
USM_FIELDS = "04 0d 80 00 1f 88 80 01 02 03 04 05 06 07 08 02 01 00 02 01 00 04 06 6e 6f 61 75 74 68 04 00 04 00"
TRAP_PDU = "a4 14 06 01 2b 40 04 01 02 03 04 02 01 00 02 01 00 43 01 00 30 00"
SCOPED = "30 2f 04 0d 80 00 1f 88 80 01 02 03 04 05 06 07 08 04 00 a0 1c 02 04 0a 0b 0c 0d 02 01 00 02 01 00 30 0e 30 0c 06 08 2b 06 01 02 01 01 01 00 05 00"

def v3raw(header: str, params: bytes, data: str) -> bytes:
    """An SNMPv3 message from the HeaderData content, msgSecurityParameters content and msgData"""
    return ber.enc_tlv(ber.TAG_SEQUENCE, h("02 01 03") + ber.enc_tlv(ber.TAG_SEQUENCE, h(header))
                       + ber.enc_tlv(ber.TAG_OCTET_STRING, params) + h(data))

def seq(content: str) -> bytes:
    return ber.enc_tlv(ber.TAG_SEQUENCE, h(content))

def _test_decode_scoped_plaintexts() -> None:
    # Decrypted ScopedPDUs of the encryption examples and the net-snmp exchanges, with and without
    # DES padding after the SEQUENCE (zeros, PKCS#5-style 07 x 7 and 03 x 3)
    cases = [
        ("302f040d80001f888001020304050607080400a01c02040a0b0c0d020100020100300e300c06082b06010201010100050000000000000000",
         spec_scoped(0x0a0b0c0d)),
        ("302d040d80001f888001020304050607080400a01a0202138a020100020100300e300c06082b060102010101000500",
         spec_scoped(5002)),
        ("302f040d80001f888001020304050607080400a01c02047fd703ab020100020100300e300c06082b060102010101000500",
         spec_scoped(0x7fd703ab)),
        ("3043040d80001f888001020304050607080400a23002047fd703ab0201000201003022302006082b060102010101000414616374736e6d702d76332d737065632d74657374",
         sysdescr_response(0x7fd703ab)),
        ("302f040d80001f888001020304050607080400a01c020401a95adc020100020100300e300c06082b06010201010100050007070707070707",
         spec_scoped(0x01a95adc)),
        ("3043040d80001f888001020304050607080400a230020401a95adc0201000201003022302006082b060102010101000414616374736e6d702d76332d737065632d74657374030303",
         sysdescr_response(0x01a95adc)),
        ("302f040d80001f888001020304050607080400a01c02045ca535b8020100020100300e300c06082b060102010101000500",
         spec_scoped(0x5ca535b8)),
        ("3043040d80001f888001020304050607080400a23002045ca535b80201000201003022302006082b060102010101000414616374736e6d702d76332d737065632d74657374",
         sysdescr_response(0x5ca535b8)),
    ]
    for hx, expected in cases:
        b = h(hx)
        testing.assertEqual(message.decode_scoped(b, 0, len(b)), expected, hx[:40])
    # decode_scoped also works at an offset, up to end
    b = h("ff") + message.encode_scoped(spec_scoped(1)) + h("ee ee")
    testing.assertEqual(message.decode_scoped(b, 1, len(b) - 1), spec_scoped(1))
    decode_fails(lambda: message.decode_scoped(b, 1, len(b) - 3), "end inside the ScopedPDU")

def _test_decode_scoped_rejects() -> None:
    sp = "04 01 65 04 00 " + "a0 0b 02 01 07 02 01 00 02 01 00 30 00"
    good = ber.enc_tlv(ber.TAG_SEQUENCE, h(sp))
    testing.assertEqual(message.decode_scoped(good, 0, len(good)), ScopedPdu(b"e", b"", Pdu(pdu.GET, 7)))
    bad = [
        (ber.enc_tlv(ber.TAG_SEQUENCE, h(sp + " 05 00")), "data after the PDU"),
        (ber.enc_tlv(ber.TAG_SEQUENCE, h("02 01 65 04 00 a0 0b 02 01 07 02 01 00 02 01 00 30 00")), "contextEngineID INTEGER"),
        (ber.enc_tlv(ber.TAG_SEQUENCE, h("04 01 65 a0 0b 02 01 07 02 01 00 02 01 00 30 00")), "no contextName"),
        (ber.enc_tlv(ber.TAG_SEQUENCE, h("04 01 65 04 00")), "no PDU"),
        (ber.enc_tlv(ber.TAG_SEQUENCE, h("04 01 65 04 00 a9 00")), "unknown PDU type"),
        (seq("04 00 04 00 " + TRAP_PDU), "SNMPv1 Trap-PDU"),
        (ber.enc_tlv(ber.TAG_OCTET_STRING, h(sp)), "OCTET STRING instead of a SEQUENCE"),
        (h("30 80") + h(sp) + h("00 00"), "indefinite length"),
        (h(""), "empty"),
        (h("ff 03 00 00 00"), "garbage (a wrong decryption key)"),
    ]
    for data, what in bad:
        decode_fails(lambda: message.decode_scoped(data, 0, len(data)), what)


# SNMPv3 structure ##################################################################################

def _test_v3_raw_helper() -> None:
    testing.assertEqual(v3raw(HDR, h(USM), SCOPED), h(V_NOAUTH))
    testing.assertEqual(seq(USM_FIELDS), h(USM))

def _test_v3_rejects() -> None:
    usm = h(USM)
    bad = [
        (v3raw("02 01 ff 02 03 00 ff e3 04 01 04 02 01 03", usm, SCOPED), "msgID -1"),
        (v3raw("02 05 00 80 00 00 00 02 03 00 ff e3 04 01 04 02 01 03", usm, SCOPED), "msgID 2^31"),
        (v3raw("04 01 01 02 03 00 ff e3 04 01 04 02 01 03", usm, SCOPED), "msgID OCTET STRING"),
        (v3raw("02 01 01 02 02 01 e3 04 01 04 02 01 03", usm, SCOPED), "msgMaxSize 483"),
        (v3raw("02 01 01 02 05 00 80 00 00 00 04 01 04 02 01 03", usm, SCOPED), "msgMaxSize 2^31"),
        (v3raw("02 01 01 02 03 00 ff e3 04 00 02 01 03", usm, SCOPED), "empty msgFlags"),
        (v3raw("02 01 01 02 03 00 ff e3 04 02 04 00 02 01 03", usm, SCOPED), "2-octet msgFlags"),
        (v3raw("02 01 01 02 03 00 ff e3 02 01 04 02 01 03", usm, SCOPED), "msgFlags INTEGER"),
        (v3raw("02 01 01 02 03 00 ff e3 04 01 04 02 01 00", usm, SCOPED), "msgSecurityModel 0"),
        (v3raw("02 01 01 02 03 00 ff e3 04 01 04 02 01 ff", usm, SCOPED), "msgSecurityModel -1"),
        (v3raw("02 01 01 02 03 00 ff e3 04 01 04", usm, SCOPED), "no msgSecurityModel"),
        (v3raw(HDR + " 05 00", usm, SCOPED), "data after msgSecurityModel"),
        (v3raw("", usm, SCOPED), "empty HeaderData"),
        (seq("02 01 03 31 11 " + HDR + " 04 23 " + USM + " " + SCOPED), "HeaderData is a SET"),
        (seq("02 01 03 30 11 " + HDR + " 30 21 " + USM_FIELDS + " " + SCOPED), "msgSecurityParameters not wrapped"),
        (seq("02 01 03 30 11 " + HDR + " " + SCOPED), "no msgSecurityParameters"),
        (seq("02 01 03 30 11 " + HDR + " 04 23 " + USM), "no msgData"),
        (seq("02 01 03"), "only a version"),
        (v3raw(HDR, usm + h("05 00"), SCOPED), "data after UsmSecurityParameters"),
        (v3raw(HDR, b"", SCOPED), "empty msgSecurityParameters"),
        (v3raw(HDR, ber.enc_tlv(0x31, h(USM_FIELDS)), SCOPED), "UsmSecurityParameters is a SET"),
        (v3raw(HDR, seq(USM_FIELDS + " 04 00"), SCOPED), "extra USM field"),
        (v3raw(HDR, seq(USM_FIELDS[:-6]), SCOPED), "no msgPrivacyParameters"),
        (v3raw(HDR, seq("02 0d 80 00 1f 88 80 01 02 03 04 05 06 07 08" + USM_FIELDS[44:]), SCOPED),
         "engine ID INTEGER"),
        (v3raw(HDR, seq("04 00 02 01 ff 02 01 00 04 00 04 00 04 00"), SCOPED), "boots -1"),
        (v3raw(HDR, seq("04 00 02 05 00 80 00 00 00 02 01 00 04 00 04 00 04 00"), SCOPED), "boots 2^31"),
        (v3raw(HDR, seq("04 00 02 01 00 02 05 00 80 00 00 00 04 00 04 00 04 00"), SCOPED), "time 2^31"),
        (v3raw(HDR, seq("04 00 02 01 00 02 01 00 04 21 " + "61 " * 33 + "04 00 04 00"), SCOPED),
         "33-octet user name"),
        (v3raw(HDR, seq("04 00 02 01 00 02 01 00 04 00 02 01 00 04 00"), SCOPED), "authParams INTEGER"),
        (v3raw(HDR, seq("04 00 02 01 00 02 01 00 04 00 04 00 05 00"), SCOPED), "privParams NULL"),
        (v3raw("02 01 01 02 03 00 ff e3 04 01 07 02 01 03", usm, SCOPED), "privFlag with a plaintext ScopedPDU"),
        (v3raw("02 01 01 02 03 00 ff e3 04 01 03 02 01 03", usm, SCOPED), "authPriv flags with a plaintext ScopedPDU"),
        (v3raw(HDR, usm, "04 03 01 02 03"), "no privFlag with an encryptedPDU"),
        (v3raw(HDR, usm, "a0 00"), "msgData is a PDU"),
        (v3raw(HDR, usm, ""), "no msgData"),
        (v3raw(HDR, usm, SCOPED + " 05 00"), "data after msgData"),
        (v3raw(HDR, usm, SCOPED + " " + SCOPED), "two ScopedPDUs"),
        (v3raw(HDR, usm, "30 05 04 00 04 00 a0"), "truncated ScopedPDU"),
        (v3raw(HDR, usm, seq("04 00 04 00 " + TRAP_PDU).hex()), "Trap-PDU in the ScopedPDU"),
    ]
    for data, what in bad:
        decode_fails(lambda: message.decode(data), what)

def _test_v3_trailing_octets_rejected() -> None:
    # Policy (message module documentation): SNMPv3 datagrams with octets after the
    # outer SEQUENCE are dropped, also by peek.
    for c in v3_cases():
        for junk in ["00", "00 00", "30 00", "04 0c 00 00 00 00 00 00 00 00 00 00 00 00"]:
            data = c.data + h(junk)
            decode_fails(lambda: message.decode(data), c.name + " + " + junk)
            decode_fails(lambda: message.peek(data), "peek " + c.name + " + " + junk)

def _test_v3_lenient() -> None:
    # non-minimal integers and lengths
    m = v3_of(ber.enc_tlv(ber.TAG_SEQUENCE, h("02 02 00 03 30 82 00 11 " + HDR + " 04 81 23 " + USM + " " + SCOPED)))
    testing.assertEqual(m.scoped, spec_scoped(0x0a0b0c0d))
    testing.assertEqual(m.auth_offset, 59 + 4)
    # a 32-octet user name, an empty engine ID with boots/time 2^31-1
    m = v3_of(v3raw(HDR, seq("04 00 02 04 7f ff ff ff 02 04 7f ff ff ff 04 20 " + "61 " * 32 + "04 00 04 00"), SCOPED))
    testing.assertEqual(m.usm, UsmSecurityParameters(b"", 2147483647, 2147483647, b"a" * 32))
    # msgMaxSize at its minimum
    m = v3_of(v3raw("02 01 00 02 02 01 e4 04 01 04 02 01 03", h(USM), SCOPED))
    testing.assertEqual(m.max_size, 484)
    testing.assertEqual(m.msg_id, 0)

def _test_v3_flags() -> None:
    usm = h(USM)
    # undefined bits are cleared (RFC 3412 section 7.2 step 5e)
    m = v3_of(v3raw("02 01 01 02 03 00 ff e3 04 01 fc 02 01 03", usm, SCOPED))
    testing.assertEqual(m.flags, message.FLAG_REPORTABLE)
    testing.assertEqual(m.scoped, spec_scoped(0x0a0b0c0d))
    m = v3_of(v3raw("02 01 01 02 03 00 ff e3 04 01 ff 02 01 03", usm, "04 03 01 02 03"))
    testing.assertEqual(m.flags, 0x07)
    testing.assertEqual(m.encrypted, h("01 02 03"))
    testing.assertNone(m.scoped)
    # privFlag without authFlag is invalid (snmpInvalidMsgs), which the usm layer decides:
    # the data is decoded as encrypted
    m = v3_of(v3raw("02 01 01 02 03 00 ff e3 04 01 02 02 01 03", usm, "04 00"))
    testing.assertEqual(m.flags, message.FLAG_PRIV)
    testing.assertEqual(m.encrypted, b"")
    # constants
    testing.assertEqual([message.FLAG_AUTH, message.FLAG_PRIV, message.FLAG_REPORTABLE, message.SEC_MODEL_USM],
                        [1, 2, 4, 3])
    testing.assertEqual([message.SNMP_V1, message.SNMP_V2C, message.SNMP_V3], [0, 1, 3])

def _test_v3_other_security_models() -> None:
    # Decoded but flagged: the security model is kept, the parameters are not interpreted.
    for model, params in [(1, "de ad be ef"), (2, ""), (4, USM), (2147483647, "30 00")]:
        hdr = "02 01 01 02 03 00 ff e3 04 01 04 " + ber.enc_integer(model).hex()
        m = v3_of(v3raw(hdr, h(params), SCOPED))
        testing.assertEqual(m.security_model, model)
        testing.assertEqual(m.usm, UsmSecurityParameters())
        testing.assertEqual(m.auth_offset, -1)
        testing.assertEqual(m.scoped, spec_scoped(0x0a0b0c0d))

def _test_encode_v3_rejects() -> None:
    sp = message.encode_scoped(spec_scoped(1))
    usm = UsmSecurityParameters(engine(), 1, 2, b"user")
    bad = [
        (V3Message(-1, 65507, 4, usm), "msgID -1"),
        (V3Message(2147483648, 65507, 4, usm), "msgID 2^31"),
        (V3Message(1, 483, 4, usm), "msgMaxSize 483"),
        (V3Message(1, 2147483648, 4, usm), "msgMaxSize 2^31"),
        (V3Message(1, 65507, -1, usm), "msgFlags -1"),
        (V3Message(1, 65507, 256, usm), "msgFlags 256"),
        (V3Message(1, 65507, 4, usm, security_model=0), "msgSecurityModel 0"),
        (V3Message(1, 65507, 4, UsmSecurityParameters(engine(), -1, 0, b"u")), "boots -1"),
        (V3Message(1, 65507, 4, UsmSecurityParameters(engine(), 2147483648, 0, b"u")), "boots 2^31"),
        (V3Message(1, 65507, 4, UsmSecurityParameters(engine(), 0, -1, b"u")), "time -1"),
        (V3Message(1, 65507, 4, UsmSecurityParameters(engine(), 0, 2147483648, b"u")), "time 2^31"),
        (V3Message(1, 65507, 4, UsmSecurityParameters(engine(), 0, 0, b"u" * 33)), "33-octet user"),
    ]
    for m, what in bad:
        encode_fails(lambda: message.encode_v3(m, sp), what)
    m = V3Message(1, 65507, 4, usm)
    encode_fails(lambda: message.encode_v3(m, b""), "empty plaintext")
    encode_fails(lambda: message.encode_v3(m, h("04 00")), "plaintext is not a SEQUENCE")
    encode_fails(lambda: message.encode_scoped(ScopedPdu(b"", b"", Pdu(pdu.TRAP_V1, 1))), "Trap-PDU in a ScopedPDU")
    encode_fails(lambda: message.encode_scoped(ScopedPdu(b"", b"", Pdu(pdu.GET, -2147483649))), "request-id")
    # limits that are accepted
    message.encode_v3(V3Message(0, 484, 255, UsmSecurityParameters(b"", 0, 0, b"u" * 32), security_model=2147483647),
                      b"anything")
    message.encode_v3(V3Message(2147483647, 2147483647, 0, UsmSecurityParameters(b"", 2147483647, 2147483647)), sp)

def _test_v3_repr() -> None:
    m = V3Message(5, 1500, 7, UsmSecurityParameters(h("80 00"), 1, 2, b"bob", h("aa"), h("bb")), None, h("01 02"))
    testing.assertEqual(repr(m), "V3Message(msg_id=5, max_size=1500, flags=0x07, security_model=3, "
                        + "UsmSecurityParameters(engine_id=8000, boots=1, time=2, user=b'bob', auth_params=aa, "
                        + "priv_params=bb), encrypted=<2 octets>, auth_offset=-1)")
    m = V3Message(5, 1500, 4, UsmSecurityParameters(), ScopedPdu(h("80"), b"c", Pdu(pdu.GET, 1)))
    testing.assertEqual(str(m), "V3Message(msg_id=5, max_size=1500, flags=0x04, security_model=3, "
                        + "UsmSecurityParameters(engine_id=, boots=0, time=0, user=b'', auth_params=, priv_params=), "
                        + "ScopedPdu(context_engine_id=80, context_name=b'c', Pdu(GET, request_id=1, error_status=0, "
                        + "error_index=0, varbinds=[])), auth_offset=-1)")
    testing.assertEqual(repr(V3Message(1, 484, 0, UsmSecurityParameters())),
                        "V3Message(msg_id=1, max_size=484, flags=0x00, security_model=3, UsmSecurityParameters("
                        + "engine_id=, boots=0, time=0, user=b'', auth_params=, priv_params=), no data, "
                        + "auth_offset=-1)")

def _test_v3_equality() -> None:
    u = UsmSecurityParameters(b"e", 1, 2, b"u", b"a", b"p")
    testing.assertEqual(u, UsmSecurityParameters(b"e", 1, 2, b"u", b"a", b"p"))
    others = [UsmSecurityParameters(b"f", 1, 2, b"u", b"a", b"p"), UsmSecurityParameters(b"e", 0, 2, b"u", b"a", b"p"),
              UsmSecurityParameters(b"e", 1, 0, b"u", b"a", b"p"), UsmSecurityParameters(b"e", 1, 2, b"v", b"a", b"p"),
              UsmSecurityParameters(b"e", 1, 2, b"u", b"b", b"p"), UsmSecurityParameters(b"e", 1, 2, b"u", b"a", b"q")]
    for other in others:
        testing.assertNotEqual(u, other)
    s = ScopedPdu(b"e", b"c", Pdu(pdu.GET, 1))
    testing.assertEqual(s, ScopedPdu(b"e", b"c", Pdu(pdu.GET, 1)))
    testing.assertNotEqual(s, ScopedPdu(b"f", b"c", Pdu(pdu.GET, 1)))
    testing.assertNotEqual(s, ScopedPdu(b"e", b"d", Pdu(pdu.GET, 1)))
    testing.assertNotEqual(s, ScopedPdu(b"e", b"c", Pdu(pdu.GET, 2)))


# peek ##############################################################################################

def _test_peek() -> None:
    for hx, m in community_messages():
        p = m.pdu
        expected_id = p.request_id if p is not None else 0
        testing.assertEqual(message.peek(h(hx)), (version=m.version, id=expected_id), hx[:30])
    testing.assertEqual(message.peek(h(MSG_GETNEXT_V1_PYASN1)), (version=0, id=-2147483648))
    for c in v3_cases():
        testing.assertEqual(message.peek(c.data), (version=3, id=c.msg_id), c.name)
    # peek only reads up to the id: a datagram whose varbinds are broken peeks fine
    broken = community_raw("02 01 01", "04 01 61", "a2 0b 02 01 2a 02 01 00 02 01 00 31 00")
    decode_fails(lambda: message.decode(broken), "broken varbinds")
    testing.assertEqual(message.peek(broken), (version=1, id=42))
    v3broken = v3raw(HDR, h("ff"), "")
    decode_fails(lambda: message.decode(v3broken), "broken SNMPv3 message")
    testing.assertEqual(message.peek(v3broken), (version=3, id=0x01020304))

def _test_peek_rejects() -> None:
    bad = [
        (h(""), "empty"),
        (h("02 01 01"), "no SEQUENCE"),
        (community_raw("02 01 02", "04 01 61", PDU_GET), "version 2"),
        (community_raw("04 01 01", "04 01 61", PDU_GET), "version is not an INTEGER"),
        (community_raw("02 01 01", "02 01 61", PDU_GET), "community is an INTEGER"),
        (community_raw("02 01 01", "04 01 61", "a9 03 02 01 01"), "unknown PDU type"),
        (community_raw("02 01 01", "04 01 61", "30 03 02 01 01"), "SEQUENCE instead of a PDU"),
        (community_raw("02 01 01", "04 01 61", "a0 03 04 01 01"), "request-id is an OCTET STRING"),
        (community_raw("02 01 01", "04 01 61", "a0 07 02 05 00 80 00 00 00"), "request-id 2^31"),
        (community_raw("02 01 01", "04 01 61", "a0 00"), "empty PDU"),
        (community_raw("02 01 01", "04 01 61", ""), "no PDU"),
        (seq("02 01 03 31 03 02 01 01"), "SNMPv3 HeaderData is a SET"),
        (seq("02 01 03 30 03 02 01 ff"), "msgID -1"),
        (seq("02 01 03"), "no HeaderData"),
    ]
    for data, what in bad:
        decode_fails(lambda: message.peek(data), what)


# Robustness ########################################################################################

def all_messages() -> list[bytes]:
    return [h(hx) for hx, m in community_messages()] + [c.data for c in v3_cases()]

def _test_truncation_at_every_offset() -> None:
    for data in all_messages():
        for k in range(len(data)):
            cut = data[:k]
            decode_fails(lambda: message.decode(cut), "%s cut to %d octets" % (data.hex()[:20], k))
            decode_fails(lambda: message.peek(cut), "peek %s cut to %d octets" % (data.hex()[:20], k))

def _test_mutations_raise_only_decode_error() -> None:
    # Overwrite every octet of some messages with interesting values: decode and peek
    # either succeed or raise DecodeError; any other exception makes the test an ERR.
    ok = 0
    for data in [h(MSG_I), h(MSG_TRAP_SPECIFIC), h(V_SHA_AES), h(DISCOVERY_REPORT), h(V3_INFORM_SHA)]:
        for i in range(len(data)):
            for x in [0x00, 0x01, 0x03, 0x7f, 0x80, 0x81, 0x84, 0xff, data[i] ^ 0x01, data[i] ^ 0x80]:
                m = data[:i] + ber.BYTE_TABLE[x] + data[i + 1:]
                try:
                    message.decode(m)
                    ok += 1
                except errors.DecodeError:
                    pass
                try:
                    message.peek(m)
                except errors.DecodeError:
                    pass
    testing.assertTrue(ok > 0)


# Randomised round trips ############################################################################

def random_pdu(rng: Lcg, v1: bool=False) -> Pdu:
    """A random PDU of any type, or of an SNMPv1 type with v1"""
    types = ([pdu.GET, pdu.GETNEXT, pdu.RESPONSE, pdu.SET] if v1 else
             [pdu.GET, pdu.GETNEXT, pdu.RESPONSE, pdu.SET, pdu.GETBULK, pdu.INFORM, pdu.TRAP_V2, pdu.REPORT])
    vbs = [VarBind(Oid([1, 3, 6, 1, rng.next31(), rng.below(3)]), Gauge32(rng.next31())) for i in range(rng.below(4))]
    return Pdu(types[rng.below(len(types))], rng.next31() - rng.next31(), rng.below(19), rng.below(4), vbs)

def _test_random_v3_round_trip() -> None:
    rng = Lcg(31337)
    for i in range(150):
        flags = rng.below(8)
        usm = UsmSecurityParameters(rng.octets(rng.below(33)), rng.next31(), rng.next31(), rng.octets(rng.below(33)),
                                    b"\x00" * [0, 12, 16, 24, 32, 48][rng.below(6)], rng.octets(8 * rng.below(2)))
        m = V3Message(rng.next31(), 484 + rng.below(70000), flags, usm)
        sp = ScopedPdu(rng.octets(rng.below(33)), rng.octets(rng.below(10)), random_pdu(rng))
        priv = (flags & message.FLAG_PRIV) != 0
        payload = rng.octets(rng.below(400)) if priv else message.encode_scoped(sp)
        msg, off = encode3(m, payload)
        d = v3_of(msg)
        testing.assertEqual(d.msg_id, m.msg_id)
        testing.assertEqual(d.max_size, m.max_size)
        testing.assertEqual(d.flags, flags)
        testing.assertEqual(d.usm, usm)
        testing.assertEqual(d.auth_offset, off)
        if priv:
            testing.assertEqual(d.encrypted, payload)
            testing.assertNone(d.scoped)
        else:
            testing.assertEqual(d.scoped, sp)
            testing.assertNone(d.encrypted)
        testing.assertEqual(message.peek(msg), (version=3, id=m.msg_id))

def _test_random_community_round_trip() -> None:
    rng = Lcg(4711)
    for i in range(150):
        version = rng.below(2)
        community = rng.octets(rng.below(200))
        if version == message.SNMP_V1 and rng.below(3) == 0:
            t = TrapV1Pdu(Oid([1, 3, 6, rng.next31()]), rng.octets(4), rng.below(7), rng.next31(), rng.next31(), [])
            m = CommunityMessage(version, community, None, t)
            rid = 0
        else:
            p = random_pdu(rng, version == message.SNMP_V1)
            m = CommunityMessage(version, community, p)
            rid = p.request_id
        data = message.encode_community(m)
        check_community(community_of(data), m, "random %d" % i)
        testing.assertEqual(message.peek(data), (version=version, id=rid))


# Performance (acton test perf; in ordinary runs the bodies run once) ###############################

def getresponse30() -> CommunityMessage:
    """A 1412-octet GetResponse: 30 ifDescr.N = 30-octet strings"""
    vbs = [VarBind(Oid([1, 3, 6, 1, 2, 1, 2, 2, 1, 2, i + 1]), OctetString(b"GigabitEthernet0/0/0 interface"))
           for i in range(30)]
    return CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(pdu.RESPONSE, 1, 0, 0, vbs))

def _test_perf_decode_getresponse30(t: testing.SyncT) -> None:
    m = getresponse30()
    data = message.encode_community(m)
    testing.assertEqual(len(data), 1412)
    for n in t.loop():
        for i in range(n):
            message.decode(data)
    check_community(community_of(data), m, "GetResponse of 30 varbinds")

def _test_perf_encode_getresponse30(t: testing.SyncT) -> None:
    m = getresponse30()
    data = message.encode_community(m)
    for n in t.loop():
        for i in range(n):
            message.encode_community(m)
    testing.assertEqual(message.encode_community(m), data)
