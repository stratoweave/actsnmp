def engine() -> bytes:
    return h(ENGINE)

def spec_scoped(request_id: int) -> ScopedPdu:
    """The ScopedPDU of the deterministic vectors: GET sysDescr.0 in the default context"""
    return ScopedPdu(engine(), b"", Pdu(pdu.GET, request_id, varbinds=[req(SYS_DESCR)]))

def sysdescr_response(request_id: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"", Pdu(pdu.RESPONSE, request_id, varbinds=[
        vb(SYS_DESCR, OctetString(b"actsnmp-v3-spec-test"))]))

def report(request_id: int, counter: int, value: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"", Pdu(pdu.REPORT, request_id, varbinds=[
        VarBind(Oid([1, 3, 6, 1, 6, 3, 15, 1, 1, counter, 0]), Counter32(value))]))

class V3Case(object):
    """An SNMPv3 vector and what decode() must make of it"""
    name: str
    data: bytes
    msg_id: int
    flags: int
    usm: UsmSecurityParameters
    auth_offset: int
    scoped: ?ScopedPdu
    encrypted_len: int

    def __init__(self, name: str, hx: str, msg_id: int, flags: int, usm: UsmSecurityParameters,
                 auth_offset: int, scoped: ?ScopedPdu, encrypted_len: int=-1):
        self.name = name
        self.data = h(hx)
        self.msg_id = msg_id
        self.flags = flags
        self.usm = usm
        self.auth_offset = auth_offset
        self.scoped = scoped
        self.encrypted_len = encrypted_len

def spec9_usm(user: bytes, mac: str, salt: str) -> UsmSecurityParameters:
    return UsmSecurityParameters(engine(), 1, 150, user, h(mac), h(salt))

def v3_cases() -> list[V3Case]:
    rid = 0x0a0b0c0d
    mid = 0x01020304
    return [
        V3Case("V-NOAUTH", V_NOAUTH, mid, 0x04, UsmSecurityParameters(engine(), 0, 0, b"noauth"), 59, spec_scoped(rid)),
        V3Case("V-SHA-AUTHNOPRIV", V_SHA_AUTHNOPRIV, mid, 0x05, spec9_usm(b"shaonly", "f559bb6bc446b77acb582af5", ""),
               61, spec_scoped(rid)),
        V3Case("V-SHA512-AUTHNOPRIV", V_SHA512_AUTHNOPRIV, mid, 0x05, spec9_usm(b"sha512only",
               "2c307a9806583640a8a4e8f5a480b1a1d7f87863f0e1a0e6076cc97491fe26896a41702840afebd9660caaf7ca843223", ""),
               65, spec_scoped(rid)),
        V3Case("V-MD5-DES", V_MD5_DES, mid, 0x07, spec9_usm(b"md5des", "972432bea3b7105727ff5f1b", "000000010000002a"),
               61, None, 56),
        V3Case("V-SHA-AES", V_SHA_AES, mid, 0x07, spec9_usm(b"shaaes", "f348b914214305ef905cb296", "deadbeef00000001"),
               61, None, 49),
        V3Case("V-SHA256-AES", V_SHA256_AES, mid, 0x07, spec9_usm(b"sha256aes",
               "d6751c0da3fe7040e062c22ec7860a29c7672659f71c9eb2", "deadbeef00000002"), 64, None, 49),
        V3Case("V-SHA512-AES", V_SHA512_AES, mid, 0x07, spec9_usm(b"sha512aes",
               "6b11470be02819178940abc55f55ee61623e2c5e46ba6ede055765df22742fc29819f7d3b571c40956850296bd5662e6",
               "deadbeef00000003"), 64, None, 49),
        V3Case("V-SHA-AES256-BLUMENTHAL", V_SHA_AES256_BLUMENTHAL, mid, 0x07, spec9_usm(b"shaaes256",
               "d2f58f68255ebe2c103852eb", "deadbeef00000004"), 64, None, 49),
        V3Case("V-SHA-AES256C-REEDER", V_SHA_AES256C_REEDER, mid, 0x07, spec9_usm(b"shaaes256c",
               "f89490fb29493054b2aca0fe", "deadbeef00000005"), 65, None, 49),
        V3Case("V-SHA256-DES", V_SHA256_DES, mid, 0x07, spec9_usm(b"sha256des",
               "5983f965061f1dc3dcc133a891482e5885bc94d6064b2232", "000000010000002b"), 64, None, 56),
        V3Case("discovery request", DISCOVERY_REQUEST, 1001, 0x04, UsmSecurityParameters(), 38,
               ScopedPdu(b"", b"", Pdu(pdu.GET, 5001))),
        V3Case("discovery report", DISCOVERY_REPORT, 1001, 0x00, UsmSecurityParameters(engine(), 1, 49), 51,
               report(5001, 4, 11)),
        V3Case("sync request", SYNC_REQUEST, 1002, 0x07, UsmSecurityParameters(engine(), 0, 0, b"shaaes",
               h("2af60c653f8b27f6a69b4838"), h("70303bcd6260e5b8")), 57, None, 47),
        V3Case("sync report", SYNC_REPORT, 1002, 0x01, UsmSecurityParameters(engine(), 1, 49, b"shaaes",
               h("f9ea5ba42655e14b7bcc50e6")), 57, report(0, 2, 1)),
        V3Case("net-snmp discovery request", NS_DISCOVERY_REQUEST, 0x7e2724ee, 0x04, UsmSecurityParameters(), 40,
               ScopedPdu(b"", b"", Pdu(pdu.GET, 0x7fd703ac))),
        V3Case("net-snmp discovery report", NS_DISCOVERY_REPORT, 0x7e2724ee, 0x00,
               UsmSecurityParameters(engine(), 1, 307), 54, report(0x7fd703ac, 4, 1)),
        V3Case("net-snmp shaaes GET", NS_SHAAES_GET, 0x7e2724ed, 0x07, UsmSecurityParameters(engine(), 1, 307,
               b"shaaes", h("c410a13c02ddf2e4c7466244"), h("1ab1c1139c3a2265")), 61, None, 49),
        V3Case("net-snmp shaaes Response", NS_SHAAES_RESPONSE, 0x7e2724ed, 0x03, UsmSecurityParameters(engine(), 1,
               307, b"shaaes", h("1152abd1076047dee28f835c"), h("0ad9df2c507d65ce")), 61, None, 69),
        V3Case("net-snmp md5des GET", NS_MD5DES_GET, 0x2b4f41c3, 0x07, UsmSecurityParameters(engine(), 1, 90,
               b"md5des", h("069ccb74c6f521d8895a0151"), h("00000001601ee48a")), 60, None, 56),
        V3Case("net-snmp md5des Response", NS_MD5DES_RESPONSE, 0x2b4f41c3, 0x03, UsmSecurityParameters(engine(), 1,
               90, b"md5des", h("68362b690688667f12eb106e"), h("0000000141ce4c21")), 60, None, 72),
        V3Case("net-snmp sha256aes GET", NS_SHA256AES_GET, 0x241e54ae, 0x07, UsmSecurityParameters(engine(), 1, 90,
