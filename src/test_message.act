        (MSG_GETNEXT_V1, CommunityMessage(v1, PUBLIC, Pdu(pdu.GETNEXT, -2147483648, varbinds=[
            req("1.3.6.1.2.1.1"), req("1.3.6.1.2.1.2.2.1.2")]))),
    ]

def check_community(got: CommunityMessage, expected: CommunityMessage, what: str) -> None:
    testing.assertEqual(got.version, expected.version, what)
    testing.assertEqual(got.community, expected.community, what)
    testing.assertEqual(got.pdu, expected.pdu, what)
    testing.assertEqual(got.trap, expected.trap, what)

def _test_community_messages_decode() -> None:
    for hx, expected in community_messages():
        check_community(community_of(h(hx)), expected, hx[:30])

def _test_community_messages_encode() -> None:
    for hx, m in community_messages():
        testing.assertEqual(message.encode_community(m), h(hx), hx[:30])

def _test_pyasn1_non_minimal_request_id() -> None:
    # pyasn1 encodes -2^31 in 5 octets; we decode it and
    # encode the minimal form
    m = community_of(h(MSG_GETNEXT_V1_PYASN1))
    check_community(m, community_of(h(MSG_GETNEXT_V1)), "pyasn1 form")
    testing.assertEqual(message.encode_community(m), h(MSG_GETNEXT_V1))

def _test_spec_lenient_vectors() -> None:
    # non-minimal outer lengths and trailing octets are accepted
    a = h(MSG_A)
    body = a[2:]
    expected = community_of(a)
    for hdr in ["30 81 29", "30 82 00 29", "30 84 00 00 00 29"]:
        check_community(community_of(h(hdr) + body), expected, hdr)
    for junk in ["00 00", "ff", "30 00", "a2 03 02 01 01"]:
        check_community(community_of(a + h(junk)), expected, "trailing " + junk)
        testing.assertEqual(message.peek(a + h(junk)), (version=1, id=0x12345678))

def _test_spec_reject_vectors() -> None:
    # must-reject vectors
    a = h(MSG_A)
    decode_fails(lambda: message.decode(h("30 80") + a[2:] + h("00 00")), "indefinite outer length")
    decode_fails(lambda: message.decode(h("30 2a") + a[2:]), "outer length one too long")
    short = h("30 28") + a[2:]
    decode_fails(lambda: message.decode(short), "outer length one too short")
    bad_rid = h("30 25 02 01 01 04 06 70 75 62 6c 69 63 a0 18 02 00 02 01 00 02 01 00 30 0e 30 0c 06 08 2b 06 01 02 01 01 01 00 05 00")
    decode_fails(lambda: message.decode(bad_rid), "empty request-id")
    big_arc = h("""30 2b 02 01 01 04 06 70 75 62 6c 69 63 a0 1e 02 04 12 34 56 78 02 01 00 02 01 00 30 10 30 0e
                   06 0a 2b 06 01 04 01 90 80 80 80 00 05 00""")
    decode_fails(lambda: message.decode(big_arc), "varbind name with arc 2^32")
    cut_arc = h("30 23 02 01 01 04 06 70 75 62 6c 69 63 a0 16 02 04 12 34 56 78 02 01 00 02 01 00 30 08 30 06 06 02 2b 86 05 00")
    decode_fails(lambda: message.decode(cut_arc), "varbind name with a truncated sub-identifier")


# SNMPv1/v2c structure ##############################################################################

def community_raw(version: str, community: str, pdu_hex: str) -> bytes:
    """A community message from hex parts, with correct outer length"""
    return ber.enc_tlv(ber.TAG_SEQUENCE, h(version) + h(community) + h(pdu_hex))

PDU_GET = "a0 0b 02 01 07 02 01 00 02 01 00 30 00"

def _test_community_structure_rejects() -> None:
    good = community_raw("02 01 01", "04 01 61", PDU_GET)
    testing.assertEqual(community_of(good).pdu, Pdu(pdu.GET, 7))
    bad = [
        (community_raw("02 01 02", "04 01 61", PDU_GET), "version 2 (SNMPv2u)"),
        (community_raw("02 01 04", "04 01 61", PDU_GET), "version 4"),
        (community_raw("02 01 ff", "04 01 61", PDU_GET), "version -1"),
        (community_raw("02 02 01 00", "04 01 61", PDU_GET), "version 256"),
        (community_raw("02 05 00 80 00 00 01", "04 01 61", PDU_GET), "version 2^31+1"),
        (community_raw("02 00", "04 01 61", PDU_GET), "empty version"),
        (community_raw("04 01 01", "04 01 61", PDU_GET), "version is an OCTET STRING"),
        (community_raw("", "04 01 61", PDU_GET), "no version"),
        (community_raw("02 01 01", "02 01 61", PDU_GET), "community is an INTEGER"),
        (community_raw("02 01 01", "", PDU_GET), "no community"),
        (community_raw("02 01 01", "04 01 61", ""), "no PDU"),
        (community_raw("02 01 01", "04 01 61", "a9 00"), "unknown PDU type"),
        (community_raw("02 01 01", "04 01 61", "30 00"), "PDU is a SEQUENCE"),
        (community_raw("02 01 01", "04 01 61", PDU_GET + " 05 00"), "data after the PDU"),
        (community_raw("02 01 01", "04 01 61", PDU_GET + " " + PDU_GET), "two PDUs"),
        (community_raw("02 01 01", "04 01 61", "a0 0b 02 01 07 02 01 00 02 01 00 31 00"), "broken PDU"),
        (ber.enc_tlv(0x31, h("02 01 01 04 01 61 " + PDU_GET)), "outer SET"),
        (h(""), "empty datagram"),
        (h("30"), "lone tag"),
        (h("30 00"), "empty SEQUENCE"),
        (h("ff ff ff"), "garbage"),
    ]
    for data, what in bad:
        decode_fails(lambda: message.decode(data), what)

def _test_wrong_version_pdus_decode() -> None:
    # Version/PDU compatibility is the receiver's business: an SNMPv1 Trap-PDU in an
    # SNMPv2c message and an SNMPv2 PDU in an SNMPv1 message both decode.
    m = community_of(community_raw("02 01 01", "04 06 70 75 62 6c 69 63", h(MSG_M)[13:].hex()))
    testing.assertEqual(m.version, message.SNMP_V2C)
    testing.assertNone(m.pdu)
    testing.assertEqual(m.trap?.time_stamp, 123456)
    m = community_of(community_raw("02 01 00", "04 00", h(MSG_D)[13:].hex()))
    testing.assertEqual(m.version, message.SNMP_V1)
    testing.assertEqual(m.community, b"")
    testing.assertEqual(m.pdu, bulk_request(10))

def _test_encode_community_rejects() -> None:
    p = Pdu(pdu.GET, 1)
    t = TrapV1Pdu(Oid.parse("1.3.6.1.4.1"), h("7f 00 00 01"), pdu.COLD_START, 0, 0)
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V3, PUBLIC, p)), "version 3")
    encode_fails(lambda: message.encode_community(CommunityMessage(2, PUBLIC, p)), "version 2")
    encode_fails(lambda: message.encode_community(CommunityMessage(-1, PUBLIC, p)), "version -1")
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC)), "no PDU")
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, p, t)), "Pdu and trap")
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, None, t)),
                 "Trap-PDU in SNMPv2c")
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(pdu.GET, 2147483648))),
                 "request-id out of range")
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(pdu.TRAP_V1, 1))),
                 "TRAP_V1 as a Pdu")
    testing.assertEqual(message.encode_community(CommunityMessage(message.SNMP_V1, b"", None, t)),
                        h("30 1f 02 01 00 04 00 a4 18 06 05 2b 06 01 04 01 40 04 7f 00 00 01 02 01 00 02 01 00 43 01 00 30 00"))

def _test_encode_v1_rejects_v2_only() -> None:
    # SNMPv1 has no GETBULK, INFORM, SNMPv2-Trap or Report PDU and no Counter64 (RFC 3584
    # 4.2); the SNMPv2c message of the same content encodes
    for t in [pdu.GETBULK, pdu.INFORM, pdu.TRAP_V2, pdu.REPORT]:
        encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, Pdu(t, 1))),
                     pdu.pdu_type_name(t) + " in SNMPv1")
        message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(t, 1)))
    c64 = [vb("1.3.6.1.2.1.1.3.0", TimeTicks(5)), vb("1.3.6.1.2.1.31.1.1.1.6.1", Counter64(5))]
    for t in [pdu.RESPONSE, pdu.SET, pdu.GET]:
        encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, Pdu(t, 1, varbinds=c64))),
                     "Counter64 in an SNMPv1 " + pdu.pdu_type_name(t))
    t1 = TrapV1Pdu(Oid.parse("1.3.6.1.4.1"), h("7f 00 00 01"), pdu.COLD_START, 0, 0, c64)
    encode_fails(lambda: message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, None, t1)),
                 "Counter64 in an SNMPv1 Trap-PDU")
    message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(pdu.RESPONSE, 1, varbinds=c64)))
    # the SNMPv1 PDU types stay allowed, and a raw Counter64 TLV is the escape hatch for tests
    for t in [pdu.GET, pdu.GETNEXT, pdu.RESPONSE, pdu.SET]:
        message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, Pdu(t, 1, varbinds=[req("1.3.6")])))
    raw = message.encode_community(CommunityMessage(message.SNMP_V1, PUBLIC, Pdu(pdu.RESPONSE, 1, varbinds=[
        vb("1.3.6.1.2.1.31.1.1.1.6.1", UnknownValue(ber.TAG_COUNTER64, h("05")))])))
    testing.assertEqual(community_of(raw).pdu?.varbinds, [vb("1.3.6.1.2.1.31.1.1.1.6.1", Counter64(5))])

def _test_out_of_range_values_keep_the_pdu() -> None:
    # An agent's unsigned value in an INTEGER object (hrStorageSize 2^31) or a 64-bit value in
    # a Counter32 costs that varbind at most, never the whole Response (net-snmp shows both)
    vbs = [vb("1.3.6.1.2.1.25.2.3.1.5.1", UnknownValue(ber.TAG_INTEGER, h("00 80 00 00 00"))),
           vb("1.3.6.1.2.1.2.2.1.10.1", UnknownValue(ber.TAG_COUNTER32, h("01 00 00 00 05"))),
           vb("1.3.6.1.2.1.1.3.0", TimeTicks(5))]
    data = message.encode_community(CommunityMessage(message.SNMP_V2C, PUBLIC, Pdu(pdu.RESPONSE, 1, 0, 0, vbs)))
    want = [vb("1.3.6.1.2.1.25.2.3.1.5.1", Integer(2147483648)),
            vb("1.3.6.1.2.1.2.2.1.10.1", MalformedValue(ber.TAG_COUNTER32, h("01 00 00 00 05"), "")),
            vb("1.3.6.1.2.1.1.3.0", TimeTicks(5))]
    testing.assertEqual(community_of(data).pdu?.varbinds, want)
    testing.assertEqual(message.peek(data), (version=1, id=1))
    # the same inside an SNMPv3 ScopedPDU
    sp = ScopedPdu(b"", b"", Pdu(pdu.RESPONSE, 2, 0, 0, vbs))
    m = v3_of(encode3(V3Message(1, 65507, 0, UsmSecurityParameters()), message.encode_scoped(sp)).0)
    testing.assertEqual(m.scoped?.pdu?.varbinds, want)
    # a bad varbind name still fails the message
    bad_name = community_raw("02 01 01", "04 06 70 75 62 6c 69 63",
                             "a2 17 02 01 01 02 01 00 02 01 00 30 0c 30 0a 06 06 2b 06 01 02 01 86 05 00")
    decode_fails(lambda: message.decode(bad_name), "varbind name with a truncated sub-identifier")

def _test_long_community() -> None:
    m = CommunityMessage(message.SNMP_V2C, b"c" * 300, Pdu(pdu.GET, 7))
    data = message.encode_community(m)
    testing.assertEqual(data[:4], h("30 82 01 40"))
    check_community(community_of(data), m, "300-octet community")

def _test_community_repr_hides_community() -> None:
    m = CommunityMessage(message.SNMP_V2C, b"s3cret", Pdu(pdu.GET, 7))
    r = repr(m)
    testing.assertEqual(r, "CommunityMessage(version=1, community=<6 octets>, Pdu(GET, request_id=7, error_status=0, "
                        + "error_index=0, varbinds=[]))")
    testing.assertEqual(str(m), r)
    testing.assertEqual(repr(CommunityMessage(message.SNMP_V1, b"x", None, TrapV1Pdu(Oid([1, 3]), b"", 0, 0, 0))),
                        "CommunityMessage(version=0, community=<1 octets>, TrapV1Pdu(enterprise=1.3, agent_addr=b'', "
                        + "generic_trap=0, specific_trap=0, time_stamp=0, varbinds=[]))")


