SYS_DESCR = "1.3.6.1.2.1.1.1.0"
SYS_UPTIME = "1.3.6.1.2.1.1.3.0"
TRAP_OID = "1.3.6.1.6.3.1.1.4.1.0"
PUBLIC = b"public"

def contact() -> VarBind:
    return vb("1.3.6.1.2.1.1.4.0", OctetString(b"noc@example.net"))

def inform_varbinds() -> list[VarBind]:
    return [vb(SYS_UPTIME, TimeTicks(123456)), vb(TRAP_OID, oidv("1.3.6.1.6.3.1.1.5.1")),
            vb("1.3.6.1.2.1.1.5.0", OctetString(b"router1"))]

def bulk_request(max_repetitions: int) -> Pdu:
    return Pdu(pdu.GETBULK, 1, 1, max_repetitions, [req("1.3.6.1.2.1.1.3"), req("1.3.6.1.2.1.2.2.1.2"),
                                                     req("1.3.6.1.2.1.2.2.1.3")])

def community_messages() -> list[(str, CommunityMessage)]:
    v1 = message.SNMP_V1
    v2 = message.SNMP_V2C
    return [
        (MSG_A, CommunityMessage(v2, PUBLIC, Pdu(pdu.GET, 0x12345678, varbinds=[req(SYS_DESCR)]))),
        (MSG_B, CommunityMessage(v2, PUBLIC, Pdu(pdu.RESPONSE, 0x12345678, varbinds=[
            vb(SYS_DESCR, OctetString(b"Linux router 6.1.0"))]))),
        (MSG_C, CommunityMessage(v2, PUBLIC, Pdu(pdu.GETNEXT, 7, varbinds=[req("1.3.6.1.2.1.1")]))),
        (MSG_D, CommunityMessage(v2, PUBLIC, bulk_request(10))),
        (MSG_DB, CommunityMessage(v2, PUBLIC, bulk_request(2))),
        (MSG_E, CommunityMessage(v2, PUBLIC, Pdu(pdu.RESPONSE, 1, varbinds=[
            vb(SYS_UPTIME, TimeTicks(3830)),
            vb("1.3.6.1.2.1.2.2.1.2.1", OctetString(b"lo")),
            vb("1.3.6.1.2.1.2.2.1.3.1", Integer(24)),
            vb("1.3.6.1.2.1.2.2.1.2.2", OctetString(b"eth0")),
            vb("1.3.6.1.2.1.2.2.1.3.2", Integer(6))]))),
        (MSG_F, CommunityMessage(v2, PUBLIC, Pdu(pdu.RESPONSE, 2, varbinds=[
            vb("1.3.6.1.2.1.1.99.0", NoSuchObject()),
            vb("1.3.6.1.2.1.1.1.1", NoSuchInstance()),
            vb("1.3.6.1.6.3.1", EndOfMibView())]))),
        (MSG_G, CommunityMessage(v1, PUBLIC, Pdu(pdu.GET, 3, varbinds=[req(SYS_UPTIME), req("1.3.6.1.2.1.1.5.0")]))),
        (MSG_H, CommunityMessage(v1, PUBLIC, Pdu(pdu.RESPONSE, 3, pdu.NO_SUCH_NAME, 2,
                                                 [req(SYS_UPTIME), req("1.3.6.1.2.1.1.5.0")]))),
