"""mibmeta: compact runtime metadata of compiled MIB modules.

`module_meta` and `bundle` derive `ModuleMeta`s from a resolved `mib.model.MibSet`. They work
together with the YANG emitter (`mib.yang.Translator`), so prefixes, revisions, data node
paths and key names are the ones the emitted YANG uses, and value conversions (`conv`,
`hint`) match the YANG types. Optional strings are "" when absent.

`to_json` and `bundle_to_json` write the `actsnmp-mibmeta/1` JSON format with a fixed key
order, so the output diffs cleanly; `from_json` and `bundle_from_json` read it back.
Malformed input raises `MetaError` (a ValueError) and nothing else.

`MetaIndex` is the runtime lookup: an OID trie with longest-prefix match, lookup by name and
by YANG path, and the table structure (rows, columns, AUGMENTS, INDEX) the SNMP side needs.
OIDs are `list[int]`.

Every segment of a YANG path carries the prefix of the module that defines it, so an
augmenting column of Q-BRIDGE-MIB is
`/bridge-mib:BRIDGE-MIB/.../bridge-mib:dot1dBasePortEntry/q-bridge:dot1qPvid`. Nodes that
are not data nodes have no path: non-index accessible-for-notify objects, OID assignments,
identities, conformance statements, augmenting rows and their tables. A container whose OID
node is defined in another module (a vendor scalar below SNMPv2-MIB's `system`), or is a
scalar, column or notification (a MIB error), is listed in `ModuleMeta.containers`, so every
data node with `smiv2:oid` has an entry.
"""

import json
import mib.model
import mib.source
import mib.yang

FORMAT = "actsnmp-mibmeta/1"


class MetaError(ValueError):
    """Malformed mibmeta input (`from_json`, `bundle_from_json`)."""
    def __init__(self, msg: str):
        ValueError.__init__(self, msg)


class SyntaxMeta(object):
    """Wire syntax of a leaf.

    `wire` is the SMI base type, `tc` the nearest named type as `MOD::TC` ("" if none), `conv`
    the value conversion kind and `hint` the effective DISPLAY-HINT. Constraints are the
    effective ones; `enums` and `bits` are in MIB order. `builtin` is the YANG builtin type of
    an integer conversion when it differs from the conversion's default, as
    `mib.yang.int_builtin` decides it: `int64` for values beyond int32, or the unsigned type
    of a well-known TC such as inet:port-number. It is "" otherwise."""
    wire: str
    tc: str
    conv: str
    hint: str
    ranges: list[(bigint, bigint)]
    sizes: list[(bigint, bigint)]
    enums: list[(str, int)]
    bits: list[(str, int)]
    builtin: str

    def __init__(self, wire: str, tc: str, conv: str, hint: str, builtin: str=""):
        self.wire = wire
        self.tc = tc
        self.conv = conv
        self.hint = hint
        self.ranges = []
        self.sizes = []
        self.enums = []
        self.bits = []
        self.builtin = builtin


class IndexPart(object):
    """One INDEX item. `obj` (JSON `object`) is "MOD::name", or "" for a synthetic SMIv1 item;
    `key` is the YANG key leaf name; `enc` the instance encoding (int, fixed, var, implied,
    oid, oid-implied, ipv4, netaddr), with `size` for `fixed`."""
    obj: str
    key: str
    enc: str
    size: int
    syntax: ?SyntaxMeta

    def __init__(self, obj: str, key: str, enc: str, size: int, syntax: ?SyntaxMeta):
        self.obj = obj
        self.key = key
        self.enc = enc
        self.size = size
        self.syntax = syntax


class TypeMeta(object):
    name: str
    parent: str
    status: str
    syntax: ?SyntaxMeta

    def __init__(self, name: str, parent: str, status: str, syntax: ?SyntaxMeta):
        self.name = name
        self.parent = parent
        self.status = status
        self.syntax = syntax


class NodeMeta(object):
    name: str
    module: str
    oid: list[int]
    kind: str
    access: str
    status: str
    units: str
    defval: str
    syntax: ?SyntaxMeta
    yang: str
    index: list[IndexPart]
    implied: bool
    keyless: bool
    augments: str
    sparse_of: str
    objects: list[str]
    members: list[str]

    def __init__(self, name: str, module: str, oid: list[int], kind: str):
        self.name = name
        self.module = module
        self.oid = oid
        self.kind = kind
        self.access = ""
        self.status = "current"
        self.units = ""
        self.defval = ""
        self.syntax = None
        self.yang = ""
        self.index = []
        self.implied = False
        self.keyless = False
        self.augments = ""
        self.sparse_of = ""
        self.objects = []
        self.members = []

    def qname(self) -> str:
        return self.module + "::" + self.name


class ModuleMeta(object):
    name: str
    smi: str
    yang_ns: str
    yang_prefix: str
    revision: str
    source_sha256: str
    types: list[TypeMeta]
    nodes: list[NodeMeta]
    containers: list[NodeMeta]

    def __init__(self, name: str, smi: str):
        self.name = name
        self.smi = smi
        self.yang_ns = "urn:ietf:params:xml:ns:yang:smiv2:" + name
        self.yang_prefix = prefix_of(name)
        self.revision = ""
        self.source_sha256 = ""
        self.types = []
        self.nodes = []
        self.containers = []


class MibBundle(object):
    format: str
    modules: list[ModuleMeta]

    def __init__(self, modules: list[ModuleMeta]):
        self.format = FORMAT
        self.modules = modules


# --- derivation from the model ----------------------------------------------------------------

def prefix_of(name: str) -> str:
    """RFC 6643 Appendix B prefix when no other prefix is taken: the first two `-` tokens of the
    lowercased name (the whole name when it has one token). `module_meta` uses the prefix of
    the emitted YANG, which also avoids collisions with the module's import prefixes."""
    return mib.yang.module_prefix(name)


def revision_date(m: mib.model.MibModule) -> str:
    """`YYYY-MM-DD` of LAST-UPDATED (else the first REVISION), "" when there is no valid one."""
    k = mib.source.date_key(m.last_updated)
    if k == "" and len(m.revisions) > 0:
        k = mib.source.date_key(m.revisions[0].date)
    if len(k) < 8:
        return ""
    return k[0:4] + "-" + k[4:6] + "-" + k[6:8]


def yang_hint(s: mib.model.Syntax, ms: ?mib.model.MibSet, tr: ?mib.yang.Translator) -> str:
    """The hint the YANG emitter decides string versus binary by: the translator's (SMIv1
    informal hints and the options), else the SMIv1 informal hints with the defaults (`ms`),
    else the resolver's."""
    if tr is not None:
        return tr.hint(s)
    if ms is not None:
        return mib.yang.effective_hint(ms, s)
    return s.hint


def conv_of(s: mib.model.Syntax, ms: ?mib.model.MibSet = None, tr: ?mib.yang.Translator = None, hint: ?str = None) -> str:
    """The value conversion kind of a resolved syntax, matching the YANG type the emitter
    gives it: with `ms` (or the translator `tr`, whose options apply) the hint is the YANG
    emitter's (SMIv1 informal hints, `ignore_display_hint`) unless `hint` is given, a TC
    derived from TruthValue converts as `truthvalue` (its YANG type is boolean), and
    enumerations YANG cannot express (int64 leaf) convert as `int`."""
    b = s.base
    h = hint if hint is not None else yang_hint(s, ms, tr)
    if b == "INTEGER":
        if len(s.enums) > 0:
            if s.tc_name == "TruthValue" and s.tc_module == "SNMPv2-TC":
                return "truthvalue"
            if ms is not None and mib.yang.yang_boolean(ms, s):
                return "truthvalue"
            if mib.yang.enum_expressible(s.enums):
                return "enum"
            return "int"
        if h.startswith("d-"):
            return "int-hint"
        return "int"
    if b == "Unsigned32" or b == "Gauge32" or b == "Counter32" or b == "TimeTicks" or b == "Counter64":
        return "uint"
    if b == "BITS":
        # BITS without named bits is `binary` in YANG (a `bits` type needs a bit statement)
        if mib.yang.bits_expressible(s.bits):
            return "bits"
        return "binary"
    if b == "IpAddress":
        return "ipv4"
    if b == "OBJECT IDENTIFIER":
        return "oid"
    if b == "Opaque":
        return "opaque"
    if b == "OCTET STRING":
        for c in s.chain:
            if c == "SNMPv2-TC::PhysAddress":
                return "phys-address"
            if c == "SNMPv2-TC::MacAddress":
                return "mac-address"
        if h != "":
            return "string-hint"
        return "binary"
    return ""


def builtin_of(s: mib.model.Syntax, conv: str, ms: ?mib.model.MibSet = None) -> str:
    """`SyntaxMeta.builtin`: the YANG builtin type of an integer conversion when it is not the
    conversion's default, else ""."""
    if conv != "int" and conv != "int-hint" and conv != "uint":
        return ""
    b = mib.yang.int_builtin(ms, s)
    dflt = "int32"
    if conv == "uint":
        dflt = "uint64" if s.base == "Counter64" else "uint32"
    return "" if b == dflt else b


def syntax_meta(s: mib.model.Syntax, ms: ?mib.model.MibSet = None, tr: ?mib.yang.Translator = None, hint: ?str = None) -> SyntaxMeta:
    """`hint`: the hint to use instead of the syntax's (a TC's own, `Translator.tdef_hint`)."""
    h = hint if hint is not None else yang_hint(s, ms, tr)
    cv = conv_of(s, ms, tr, h)
    sm = SyntaxMeta(s.base, s.tc(), cv, h, builtin_of(s, cv, ms if ms is not None else (tr.ms if tr is not None else None)))
    sm.ranges = [(r.lo, r.hi) for r in s.ranges]
    sm.sizes = [(r.lo, r.hi) for r in s.sizes]
    sm.enums = [(e.label, e.value) for e in s.enums]
    sm.bits = [(e.label, e.value) for e in s.bits]
    return sm


def _opt_syntax(s: ?mib.model.Syntax, ms: ?mib.model.MibSet = None, tr: ?mib.yang.Translator = None, hint: ?str = None) -> ?SyntaxMeta:
    if s is not None:
        if s.unresolved == "" and s.base != "" and s.base != "SEQUENCE" and s.base != "SEQUENCE OF" and s.base != "CHOICE":
            return syntax_meta(s, ms, tr, hint)
    return None


def node_meta(n: mib.model.MibNode, ms: ?mib.model.MibSet = None, tr: ?mib.yang.Translator = None) -> NodeMeta:
    nm = NodeMeta(n.name, n.module, n.oid, n.kind)
    nm.access = n.access
    nm.status = n.status
    nm.units = n.units
    dv = n.defval
    if dv is not None:
        nm.defval = dv.smi
    nm.syntax = _opt_syntax(n.syntax, ms, tr)
    if n.kind == "row":
        if n.augments == "":
            # an augmenting row has no index of its own: the base row's applies
            nm.index = [IndexPart(p.object(), p.key, p.enc, p.size, _opt_syntax(p.syntax, ms, tr)) for p in n.index]
        nm.implied = n.implied
        nm.keyless = n.keyless
        nm.augments = n.augments
        nm.sparse_of = n.sparse_of
    nm.objects = n.objects
    nm.members = n.members
    return nm


def module_meta(ms: mib.model.MibSet, name: str, tr: ?mib.yang.Translator = None) -> ?ModuleMeta:
    """The mibmeta of module `name` of a resolved set (None when it is not loaded). Nodes are
    sorted by OID; unlinked nodes are left out. The YANG facts (prefix, revision, data node
    paths, key leaf names) come from `tr` (a new `mib.yang.Translator` by default; pass one to
    share its work across modules)."""
    m = ms.module(name)
    if m is not None:
        t = tr if tr is not None else mib.yang.Translator(ms)
        mm = ModuleMeta(m.name, m.smi)
        mm.revision = revision_date(m)
        yr = t.module(name)
        if yr is not None:
            mm.yang_prefix = yr.prefix
            mm.revision = yr.revision
        paths = t.paths(name)
        mm.source_sha256 = m.sha256
        for ty in m.types:
            if ty.kind == "tc" or ty.kind == "type":
                mm.types.append(TypeMeta(ty.name, ty.parent, ty.status, _opt_syntax(ty.syntax, ms, t, t.tdef_hint(ty))))
        keyed = [(n.oid, i) for i, n in enumerate(m.nodes) if n.linked]
        for k in sorted(keyed):
            n = m.nodes[k.1]
            nm = node_meta(n, ms, t)
            nm.yang = paths.get_def(mib.yang.node_key(n), "")
            if n.kind == "row" and n.augments == "":
                keys = t.row_keys(n)
                if len(keys) == len(nm.index):
                    for i, p in enumerate(nm.index):
                        p.key = keys[i]
            mm.nodes.append(nm)
        for c in t.containers(name):
            cm = NodeMeta(c.0, m.name, c.1, "container")
            cm.yang = c.2
            mm.containers.append(cm)
        return mm
    return None


def bundle(ms: mib.model.MibSet, names: list[str]) -> MibBundle:
    out: list[ModuleMeta] = []
    tr = mib.yang.Translator(ms)
    for nm in names:
        mm = module_meta(ms, nm, tr)
        if mm is not None:
            out.append(mm)
    return MibBundle(out)


# --- JSON writer ------------------------------------------------------------------------------

def jq(s: str) -> str:
    """A JSON string literal."""
    out: list[str] = []
    for ch in s:
        c = ord(ch)
        if ch == "\"":
            out.append("\\\"")
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif c < 32:
            out.append("\\u%04x" % c)
        else:
            out.append(ch)
    return "\"" + "".join(out) + "\""


def _pairs_big(xs: list[(bigint, bigint)]) -> str:
    return "[" + ",".join(["[" + str(x.0) + "," + str(x.1) + "]" for x in xs]) + "]"


def _pairs_named(xs: list[(str, int)]) -> str:
    return "[" + ",".join(["[" + jq(x.0) + "," + str(x.1) + "]" for x in xs]) + "]"


def _strs(xs: list[str]) -> str:
    return "[" + ",".join([jq(x) for x in xs]) + "]"


def syntax_json(s: SyntaxMeta) -> str:
    f = ["\"wire\":" + jq(s.wire)]
    if s.tc != "":
        f.append("\"tc\":" + jq(s.tc))
    f.append("\"conv\":" + jq(s.conv))
    if s.builtin != "":
        f.append("\"builtin\":" + jq(s.builtin))
    if s.hint != "":
        f.append("\"hint\":" + jq(s.hint))
    if len(s.ranges) > 0:
        f.append("\"ranges\":" + _pairs_big(s.ranges))
    if len(s.sizes) > 0:
        f.append("\"sizes\":" + _pairs_big(s.sizes))
    if len(s.enums) > 0:
        f.append("\"enums\":" + _pairs_named(s.enums))
    if len(s.bits) > 0:
        f.append("\"bits\":" + _pairs_named(s.bits))
    return "{{" + ",".join(f) + "}}"


def _index_json(p: IndexPart) -> str:
    f = ["\"object\":" + jq(p.obj), "\"key\":" + jq(p.key), "\"enc\":" + jq(p.enc)]
    if p.enc == "fixed":
        f.append("\"size\":" + str(p.size))
    sx = p.syntax
    if sx is not None:
        f.append("\"syntax\":" + syntax_json(sx))
    return "{{" + ",".join(f) + "}}"


def node_json(n: NodeMeta) -> str:
    f = ["\"name\":" + jq(n.name), "\"oid\":" + jq(mib.model.oid_str(n.oid)), "\"kind\":" + jq(n.kind)]
    if n.access != "":
        f.append("\"access\":" + jq(n.access))
    f.append("\"status\":" + jq(n.status))
    if n.units != "":
        f.append("\"units\":" + jq(n.units))
    if n.defval != "":
        f.append("\"defval\":" + jq(n.defval))
    sx = n.syntax
    if sx is not None:
        f.append("\"syntax\":" + syntax_json(sx))
    if n.yang != "":
        f.append("\"yang\":" + jq(n.yang))
    if n.kind == "row":
        f.append("\"implied\":" + ("true" if n.implied else "false"))
        if n.keyless:
            f.append("\"keyless\":true")
        if n.augments != "":
            f.append("\"augments\":" + jq(n.augments))
        else:
            f.append("\"index\":[" + ",".join([_index_json(p) for p in n.index]) + "]")
        if n.sparse_of != "":
            f.append("\"sparse_of\":" + jq(n.sparse_of))
    if len(n.objects) > 0:
        f.append("\"objects\":" + _strs(n.objects))
    if len(n.members) > 0:
        f.append("\"members\":" + _strs(n.members))
    return "{{" + ",".join(f) + "}}"


def _type_json(t: TypeMeta) -> str:
    f = ["\"name\":" + jq(t.name)]
    if t.parent != "":
        f.append("\"parent\":" + jq(t.parent))
    f.append("\"status\":" + jq(t.status))
    sx = t.syntax
    if sx is not None:
        f.append("\"syntax\":" + syntax_json(sx))
    return "{{" + ",".join(f) + "}}"


def module_json(m: ModuleMeta) -> str:
    """The module object (without the `format` key)."""
    y = ["\"ns\":" + jq(m.yang_ns), "\"prefix\":" + jq(m.yang_prefix)]
    if m.revision != "":
        y.append("\"revision\":" + jq(m.revision))
    f = ["\"module\":" + jq(m.name), "\"smi\":" + jq(m.smi), "\"yang\":{{" + ",".join(y) + "}}"]
    if m.source_sha256 != "":
        f.append("\"source_sha256\":" + jq(m.source_sha256))
    f.append("\"types\":[\n " + ",\n ".join([_type_json(t) for t in m.types]) + "]" if len(m.types) > 0 else "\"types\":[]")
    f.append("\"nodes\":[\n " + ",\n ".join([node_json(n) for n in m.nodes]) + "]" if len(m.nodes) > 0 else "\"nodes\":[]")
    if len(m.containers) > 0:
        f.append("\"containers\":[\n " + ",\n ".join([node_json(n) for n in m.containers]) + "]")
    return "{{" + ",\n".join(f) + "}}"


def to_json(m: ModuleMeta) -> str:
    """One module as an `actsnmp-mibmeta/1` JSON document, one node per line."""
    return "{{\"format\":" + jq(FORMAT) + ",\n" + module_json(m)[1:] + "\n"


def bundle_to_json(b: MibBundle) -> str:
    return "{{\"format\":" + jq(b.format) + ",\n\"modules\":[\n" + ",\n".join([module_json(m) for m in b.modules]) + "]}}\n"


# --- JSON reader ------------------------------------------------------------------------------

def _get(d: dict[str, ?value], k: str) -> ?value:
    if k in d:
        return d[k]
    return None


def _str(d: dict[str, ?value], k: str) -> str:
    v = _get(d, k)
    if isinstance(v, str):
        return v
    return ""


def _need_str(d: dict[str, ?value], k: str, what: str) -> str:
    v = _get(d, k)
    if isinstance(v, str):
        if v != "":
            return v
    elif v is not None:
        raise MetaError(what + ": \"" + k + "\" is not a string")
    raise MetaError(what + ": \"" + k + "\" missing")


def _bool(d: dict[str, ?value], k: str) -> bool:
    v = _get(d, k)
    if isinstance(v, bool):
        return v
    return False


def _big(v: ?value) -> bigint:
    if isinstance(v, int):
        return bigint(v)
    if isinstance(v, bigint):
        return v
    if isinstance(v, float):
        return bigint(int(v))
    if isinstance(v, str):
        return bigint(v)
    raise MetaError("number expected")


def _int(v: ?value) -> int:
    if isinstance(v, int):
        return v
    if isinstance(v, bigint):
        return int(v)
    if isinstance(v, float):
        return int(v)
    raise MetaError("integer expected")


def _list(d: dict[str, ?value], k: str) -> list[?value]:
    v = _get(d, k)
    if isinstance(v, list):
        lst: list[?value] = v
        return lst
    if v is not None:
        raise MetaError("\"" + k + "\" is not a list")
    return []


def _dict(v: ?value) -> dict[str, ?value]:
    if isinstance(v, dict):
        dd: dict[str, ?value] = v
        return dd
    raise MetaError("object expected")


def _strlist(d: dict[str, ?value], k: str) -> list[str]:
    out: list[str] = []
    for v in _list(d, k):
        if isinstance(v, str):
            out.append(v)
    return out


def _pairs_b(d: dict[str, ?value], k: str) -> list[(bigint, bigint)]:
    out: list[(bigint, bigint)] = []
    for v in _list(d, k):
        if isinstance(v, list):
            p: list[?value] = v
            if len(p) == 2:
                out.append((_big(p[0]), _big(p[1])))
    return out


def _pairs_n(d: dict[str, ?value], k: str) -> list[(str, int)]:
    out: list[(str, int)] = []
    for v in _list(d, k):
        if isinstance(v, list):
            p: list[?value] = v
            if len(p) == 2:
                lbl = p[0]
                if isinstance(lbl, str):
                    out.append((lbl, _int(p[1])))
    return out


def _syntax(v: ?value) -> ?SyntaxMeta:
    if v is None:
        return None
    d = _dict(v)
    s = SyntaxMeta(_str(d, "wire"), _str(d, "tc"), _str(d, "conv"), _str(d, "hint"), _str(d, "builtin"))
    s.ranges = _pairs_b(d, "ranges")
    s.sizes = _pairs_b(d, "sizes")
    s.enums = _pairs_n(d, "enums")
    s.bits = _pairs_n(d, "bits")
    return s


def parse_oid(s: str) -> list[int]:
    """Dotted decimal (no leading dot) to arcs, [] for ""; MetaError for anything else."""
    if s == "":
        return []
    out: list[int] = []
    for x in s.split("."):
        if x == "" or len(x) > 10 or not x.isdecimal():
            raise MetaError("bad OID " + repr(s))
        a = int(x)
        if a > 4294967295:
            raise MetaError("bad OID " + repr(s))
        out.append(a)
    return out


def _module(d: dict[str, ?value]) -> ModuleMeta:
    name = _str(d, "module")
    if name == "":
        raise MetaError("module name missing")
    try:
        return _module_body(d, name)
    except MetaError as e:
        raise MetaError(name + ": " + e.error_message)
    except ValueError as e:
        raise MetaError(name + ": " + e.error_message)


def _module_body(d: dict[str, ?value], name: str) -> ModuleMeta:
    m = ModuleMeta(name, _str(d, "smi"))
    yv = _get(d, "yang")
    if yv is not None:
        y = _dict(yv)
        m.yang_ns = _str(y, "ns")
        m.yang_prefix = _str(y, "prefix")
        m.revision = _str(y, "revision")
    m.source_sha256 = _str(d, "source_sha256")
    for tv in _list(d, "types"):
        td = _dict(tv)
        m.types.append(TypeMeta(_str(td, "name"), _str(td, "parent"), _str(td, "status"), _syntax(_get(td, "syntax"))))
    for nv in _list(d, "nodes"):
        nd = _dict(nv)
        nn = _need_str(nd, "name", "node")
        n = NodeMeta(nn, name, parse_oid(_need_str(nd, "oid", nn)), _need_str(nd, "kind", nn))
        n.access = _str(nd, "access")
        n.status = _str(nd, "status")
        n.units = _str(nd, "units")
        n.defval = _str(nd, "defval")
        n.syntax = _syntax(_get(nd, "syntax"))
        n.yang = _str(nd, "yang")
        n.implied = _bool(nd, "implied")
        n.keyless = _bool(nd, "keyless")
        n.augments = _str(nd, "augments")
        n.sparse_of = _str(nd, "sparse_of")
        n.objects = _strlist(nd, "objects")
        n.members = _strlist(nd, "members")
        for pv in _list(nd, "index"):
            pd = _dict(pv)
            sz = _get(pd, "size")
            n.index.append(IndexPart(_str(pd, "object"), _str(pd, "key"), _str(pd, "enc"), _int(sz) if sz is not None else 0,
                                     _syntax(_get(pd, "syntax"))))
        m.nodes.append(n)
    for cv in _list(d, "containers"):
        cd = _dict(cv)
        cn = _need_str(cd, "name", "container")
        c = NodeMeta(cn, name, parse_oid(_need_str(cd, "oid", cn)), _need_str(cd, "kind", cn))
        c.status = _str(cd, "status")
        c.yang = _str(cd, "yang")
        m.containers.append(c)
    return m


def _decode(text: str) -> dict[str, ?value]:
    try:
        d = json.decode(text)
        f = _str(d, "format")
        if f != FORMAT:
            raise MetaError("unsupported mibmeta format " + f)
        return d
    except MetaError as e:
        raise e
    except ValueError as e:
        raise MetaError("malformed mibmeta JSON: " + e.error_message)


def from_json(text: str) -> ModuleMeta:
    """Read one module written by `to_json`; raises MetaError on malformed input."""
    return _module(_decode(text))


def bundle_from_json(text: str) -> MibBundle:
    """Read a bundle written by `bundle_to_json`; raises MetaError."""
    d = _decode(text)
    return MibBundle([_module(_dict(v)) for v in _list(d, "modules")])


# --- lookup structures --------------------------------------------------------------------------

class TrieNode(object):
    """One OID of the trie: the `nodes` named there and `obj`, the column or scalar among them
    `lookup_object` returns (the first one added, an SMIv2 module's before an SMIv1 module's)."""
    children: dict[int, TrieNode]
    nodes: list[NodeMeta]
    obj: ?NodeMeta

    def __init__(self):
        self.children = {}
        self.nodes = []
        self.obj = None


def _is_object(n: NodeMeta) -> bool:
    return n.kind == "column" or n.kind == "scalar"


class MetaIndex(object):
    """Runtime lookup over a bundle: an OID trie (longest-prefix match), names, YANG data
    node paths, types, and the table structure (rows, their columns and AUGMENTS).

    At an OID with several names, `lookup` returns the first one added, preferring a
    registration over a plain OID assignment. Where two modules define the same object (both
    RFC1213-MIB and IF-MIB define `ifEntry` and its columns), `lookup_object` prefers the
    SMIv2 module's, `canonical_row` picks the one row tables are assembled under, and the
    table helpers prefer the node of the module asked about."""
    root: TrieNode
    by_qname: dict[str, NodeMeta]
    by_name: dict[str, list[NodeMeta]]
    by_yang_path: dict[str, NodeMeta]
    by_type: dict[str, TypeMeta]
    augmented_by: dict[str, list[NodeMeta]]
    smiv1: set[str]

    def __init__(self, b: MibBundle):
        self.root = TrieNode()
        self.by_qname = {}
        self.by_name = {}
        self.by_yang_path = {}
        self.by_type = {}
        self.augmented_by = {}
        self.smiv1 = set([m.name for m in b.modules if m.smi == "v1"])
        for m in b.modules:
            for n in m.nodes:
                self.add(n)
            for c in m.containers:
                if c.yang != "" and c.yang not in self.by_yang_path:
                    self.by_yang_path[c.yang] = c
            for t in m.types:
                q = m.name + "::" + t.name
                if q not in self.by_type:
                    self.by_type[q] = t

    def add(self, n: NodeMeta) -> None:
        cur = self.root
        for a in n.oid:
            c = cur.children.get(a)
            if c is not None:
                cur = c
            else:
                t = TrieNode()
                cur.children[a] = t
                cur = t
        if n.kind != "node" and len(cur.nodes) > 0 and cur.nodes[0].kind == "node":
            cur.nodes.insert(0, n)
        else:
            cur.nodes.append(n)
        if _is_object(n):
            o = cur.obj
            if o is not None:
                if o.module in self.smiv1 and n.module not in self.smiv1:
                    cur.obj = n
            else:
                cur.obj = n
        q = n.qname()
        if q not in self.by_qname:
            self.by_qname[q] = n
        if n.yang != "" and n.yang not in self.by_yang_path:
            self.by_yang_path[n.yang] = n
        lst = self.by_name.get(n.name)
        if lst is not None:
            lst.append(n)
        else:
            self.by_name[n.name] = [n]
        if n.kind == "row" and n.augments != "":
            al = self.augmented_by.get(n.augments)
            if al is not None:
                al.append(n)
            else:
                self.augmented_by[n.augments] = [n]

    def lookup(self, oid: list[int]) -> ?(NodeMeta, list[int]):
        """The deepest named node that is a prefix of `oid`, with the remaining sub-ids (the
        instance suffix for a column or scalar), or None."""
        cur = self.root
        best: ?NodeMeta = None
        depth = 0
        for i, a in enumerate(oid):
            c = cur.children.get(a)
            if c is not None:
                cur = c
                if len(cur.nodes) > 0:
                    best = cur.nodes[0]
                    depth = i + 1
            else:
                break
        if best is not None:
            return (best, oid[depth:])
        return None

    def exact(self, oid: list[int]) -> list[NodeMeta]:
        cur = self.root
        for a in oid:
            c = cur.children.get(a)
            if c is not None:
                cur = c
            else:
                return []
        return cur.nodes

    def find_path(self, path: str) -> ?NodeMeta:
        """The node whose YANG data node (schema) path is `path`."""
        return self.by_yang_path.get(path)

    def find(self, name: str) -> ?NodeMeta:
        """By `MOD::name` (also `MOD.name`) or bare name (the first module that defines it)."""
        if "::" in name:
            return self.by_qname.get(name)
        lst = self.by_name.get(name)
        if lst is not None and len(lst) > 0:
            return lst[0]
        p = name.split(".")
        if len(p) == 2:
            return self.by_qname.get(p[0] + "::" + p[1])
        return None

    def find_type(self, qname: str) -> ?TypeMeta:
        """A TC or type assignment by `MOD::Name`."""
        return self.by_type.get(qname)

    def tc_chain(self, qname: str) -> list[str]:
        """The parent TCs of TC `qname` (`TypeMeta.parent`, nearest first, without `qname`
        itself), as far as the bundle has them; cycles end the chain."""
        out: list[str] = []
        cur = qname
        for i in range(32):
            t = self.by_type.get(cur)
            if t is not None:
                if t.parent == "" or t.parent == qname or t.parent in out:
                    break
                out.append(t.parent)
                cur = t.parent
            else:
                break
        return out

    # --- OIDs with instances ---

    def lookup_object(self, oid: list[int]) -> ?(NodeMeta, list[int]):
        """The deepest column or scalar whose OID is a prefix of `oid`, with the instance
        suffix (the remaining sub-ids), or None. Unlike `lookup`, names registered below an
        object (a MIB error) and plain OID assignments at its OID do not hide it; at an OID
        with several objects an SMIv2 module's wins over an SMIv1 module's, else the first
        added."""
        cur = self.root
        best: ?NodeMeta = None
        depth = 0
        n = len(oid)
        for i in range(n):
            c = cur.children.get(oid[i])
            if c is not None:
                cur = c
                o = c.obj
                if o is not None:
                    best = o
                    depth = i + 1
            else:
                break
        if best is not None:
            return (best, oid[depth:])
        return None

    def _at(self, oid: list[int], kind: str, module: str) -> ?NodeMeta:
        """The node of `kind` at `oid`, preferring one of `module`."""
        first: ?NodeMeta = None
        for n in self.exact(oid):
            if n.kind == kind:
                if n.module == module:
                    return n
                if first is None:
                    first = n
        return first

    def object_at(self, oid: list[int], module: str) -> ?NodeMeta:
        """The column or scalar `module` defines at `oid`, None when it defines none there."""
        for n in self.exact(oid):
            if n.module == module and _is_object(n):
                return n
        return None

    def canonical_row(self, row: NodeMeta) -> NodeMeta:
        """The base row tables are assembled under when several modules define a row without
        AUGMENTS at `row`'s OID (RFC1213-MIB and IF-MIB `ifEntry`, RFC1271-MIB and RMON-MIB
        `etherStatsEntry`): one that other rows AUGMENT (`ifXEntry` augments IF-MIB's), else an
        SMIv2 module's, else the first added; `row` itself when it is the only one."""
        cands = [n for n in self.exact(row.oid) if n.kind == "row" and n.augments == ""]
        if len(cands) < 2:
            return row
        for c in cands:
            if c.qname() in self.augmented_by:
                return c
        for c in cands:
            if c.module not in self.smiv1:
                return c
        return cands[0]

    def children(self, node: NodeMeta) -> list[NodeMeta]:
        """The nodes one arc below `node`, in arc order: per arc the node of `node`'s module,
        else the first one there."""
        cur = self.root
        for a in node.oid:
            c = cur.children.get(a)
            if c is not None:
                cur = c
            else:
                return []
        out: list[NodeMeta] = []
        for a in sorted(list(cur.children.keys())):
            ch = cur.children[a]
            pick: ?NodeMeta = None
            for n in ch.nodes:
                if n.module == node.module:
                    pick = n
                    break
            if pick is None and len(ch.nodes) > 0:
                pick = ch.nodes[0]
            if pick is not None:
                out.append(pick)
        return out

    # --- tables ---

    def row_of(self, column: NodeMeta) -> ?NodeMeta:
        """The row a column belongs to (the row node at its parent OID; one of the column's
        module when several modules define a row there), None for a node that is not below a
        row."""
        n = len(column.oid)
        if n == 0:
            return None
        return self._at(column.oid[:n - 1], "row", column.module)

    def table_of(self, row: NodeMeta) -> ?NodeMeta:
        """The table node at a row's parent OID, None when there is none."""
        n = len(row.oid)
        if n == 0:
            return None
        return self._at(row.oid[:n - 1], "table", row.module)

    def row_of_table(self, table: NodeMeta) -> ?NodeMeta:
        """The row below a table (the first row node one arc below it)."""
        for n in self.children(table):
            if n.kind == "row":
                return n
        for c in self.children(table):
            for n in self.exact(c.oid):
                if n.kind == "row":
                    return n
        return None

    def base_row(self, row: NodeMeta) -> ?NodeMeta:
        """The row whose INDEX applies to `row`: `row` itself, or for an augmenting row the row
        it AUGMENTS, followed to the end of an (illegal) AUGMENTS chain. None when a row of the
        chain is not in the bundle, or the chain loops."""
        cur = row
        seen: set[str] = set()
        for i in range(32):
            if cur.augments == "":
                return cur
            q = cur.qname()
            if q in seen:
                return None
            seen.add(q)
            nxt = self.by_qname.get(cur.augments)
            if nxt is not None:
                cur = nxt
            else:
                return None
        return None

    def augmenting_rows(self, row: NodeMeta) -> list[NodeMeta]:
        """The rows that AUGMENT `row`, also through augmenting rows (illegal, but written), in
        OID order."""
        out: list[NodeMeta] = []
        seen: set[str] = {row.qname()}
        todo = [row.qname()]
        while len(todo) > 0:
            q = todo.pop(0)
            lst = self.augmented_by.get(q)
            if lst is not None:
                for r in lst:
                    rq = r.qname()
                    if rq not in seen:
                        seen.add(rq)
                        out.append(r)
                        todo.append(rq)
        keyed = [(r.oid, i) for i, r in enumerate(out)]
        return [out[k.1] for k in sorted(keyed)]

    def _own_columns(self, row: NodeMeta) -> list[NodeMeta]:
        cur = self.root
        for a in row.oid:
            c = cur.children.get(a)
            if c is not None:
                cur = c
            else:
                return []
        q = row.qname()
        out: list[NodeMeta] = []
        for a in sorted(list(cur.children.keys())):
            pick: ?NodeMeta = None
            other: ?NodeMeta = None
            for n in cur.children[a].nodes:
                if n.kind == "column":
                    if n.module == row.module:
                        pick = n
                        break
                    if other is None:
                        r = self.row_of(n)
                        if r is not None and r.qname() == q:
                            other = n
            if pick is not None:
                out.append(pick)
            elif other is not None:
                out.append(other)
        return out

    def columns(self, row: NodeMeta, augments: bool=False) -> list[NodeMeta]:
        """The columns of `row` in OID order, then with `augments` those of the rows augmenting
        it (`augmenting_rows`). Per arc the column of the row's module; a column of another
        module counts when its own `row_of` is `row` (registered below it without a row of its
        module there), so a second module defining the row's OIDs (RFC1213-MIB and IF-MIB)
        contributes nothing."""
        out = self._own_columns(row)
        if augments:
            for r in self.augmenting_rows(row):
                for n in self._own_columns(r):
                    out.append(n)
        return out

    def index_of(self, row: NodeMeta) -> list[IndexPart]:
        """The INDEX parts that name `row`'s instances: its own, or for an augmenting row the
        base row's ([] when the base row is not in the bundle; check `base_row`)."""
        b = self.base_row(row)
        if b is not None:
            return b.index
        return []
