}


def level_of(code: str) -> int:
    """Default level of `code`, or 0 (internal) when the code is not in the catalogue."""
    e = CATALOG.get(code)
    if e is not None:
        return e.0
    return 0


def known_code(code: str) -> bool:
    """True when `code` is in the catalogue."""
    return code in CATALOG


def severity_name(level: int) -> str:
    """'internal', 'error' (1-2), 'warning' (3-4) or 'info' (5-6)."""
    if level <= 0:
        return "internal"
    if level <= 2:
        return "error"
    if level <= 4:
        return "warning"
    return "info"


class Diagnostic(object):
    """One finding. Lines and byte columns are 1-based. `module` is the MIB module the
    position belongs to, or "" when it is outside any module or not known yet."""
    level: int
    code: str
    module: str
    file: str
    line: int
    col: int
    message: str

    def __init__(self, level: int, code: str, module: str, file: str, line: int, col: int, message: str):
        self.level = level
        self.code = code
        self.module = module
        self.file = file
        self.line = line
        self.col = col
        self.message = message

    def severity(self) -> str:
        return severity_name(self.level)

    def where(self) -> str:
        """`file:line:col`"""
        return self.file + ":" + str(self.line) + ":" + str(self.col)

    def __str__(self) -> str:
        """`file:line:col: [level] {{code}} message`, close to smilint's line format."""
        return self.where() + ": [" + str(self.level) + "] {{" + self.code + "}} " + self.message

    def __repr__(self) -> str:
        return "Diagnostic(" + self.__str__() + ")"


class Diagnostics(object):
    """A collector of diagnostics with a level policy.

    `report()` stamps `file` and `module` on each diagnostic; the caller updates them as it
    moves between files and modules. `overrides` replaces catalogue levels per code.
    Diagnostics above `max_level` are only counted in `suppressed`, except level 0, which is
    always kept.
    """
    file: str
    module: str
    items: list[Diagnostic]
    overrides: dict[str, int]
    max_level: int
    suppressed: int

    def __init__(self, file: str = "", max_level: int = 6):
        self.file = file
        self.module = ""
        self.items = []
        self.overrides = {}
        self.max_level = max_level
        self.suppressed = 0

    def set_level(self, code: str, level: int) -> None:
        """Override the level of `code` for everything reported from now on."""
        self.overrides[code] = level

    def effective_level(self, code: str) -> int:
        o = self.overrides.get(code)
        if o is not None:
            return o
        return level_of(code)

    def report(self, code: str, line: int, col: int, message: str) -> None:
        """Record a diagnostic at `line:col` of the current file, with the code's level.
        An unknown code is recorded as an internal error (level 0) that names the code."""
        lv = self.effective_level(code)
        if not known_code(code):
            self.items.append(Diagnostic(0, "internal", self.module, self.file, line, col,
                                         "unknown diagnostic code " + code + ": " + message))
            return
        if lv > self.max_level and lv > 0:
            self.suppressed += 1
            return
        self.items.append(Diagnostic(lv, code, self.module, self.file, line, col, message))

    def add(self, d: Diagnostic) -> None:
        """Add a ready-made diagnostic (subject to `max_level`)."""
        if d.level > self.max_level and d.level > 0:
            self.suppressed += 1
            return
        self.items.append(d)

    def extend(self, ds: list[Diagnostic]) -> None:
        for d in ds:
            self.add(d)

    def count(self, max_level: int = 6) -> int:
        """Number of diagnostics with level <= max_level."""
        n = 0
        for d in self.items:
            if d.level <= max_level:
                n += 1
        return n

    def errors(self) -> list[Diagnostic]:
        """Diagnostics of level 0-2."""
        return [d for d in self.items if d.level <= 2]

    def has_errors(self) -> bool:
        for d in self.items:
            if d.level <= 2:
                return True
        return False

    def codes(self) -> list[str]:
        """The codes of all diagnostics, in report order."""
        return [d.code for d in self.items]

    def ordered(self) -> list[Diagnostic]:
        """All diagnostics ordered by file, line, column, then report order."""
        keyed = [((d.file, d.line, d.col, i), i) for i, d in enumerate(self.items)]
        return [self.items[k.1] for k in sorted(keyed)]

    def format(self) -> str:
        """All diagnostics, ordered, one per line."""
        return "\n".join([str(d) for d in self.ordered()])


def format_all(ds: list[Diagnostic]) -> str:
    """One diagnostic per line, in the given order."""
    return "\n".join([str(d) for d in ds])


def summary(ds: list[Diagnostic]) -> str:
    """`code xN` counts sorted by code, one per line: a stable digest for snapshot tests."""
    cnt: dict[str, int] = {}
    for d in ds:
        cnt[d.code] = cnt.get_def(d.code, 0) + 1
    return "\n".join([k + " x" + str(cnt[k]) for k in sorted(list(cnt.keys()))])
