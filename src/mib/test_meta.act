"""Tests of `mib.meta`: derivation from the resolved model, the actsnmp-mibmeta/1 JSON
round trip and the lookup structures."""

import testing
import mib.meta
import mib.model
import mib.resolver

M_MIB = r"""M-MIB DEFINITIONS ::= BEGIN
IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE, Integer32, Counter64, IpAddress, enterprises
        FROM SNMPv2-SMI
    TEXTUAL-CONVENTION, DisplayString, PhysAddress, TruthValue, RowStatus
        FROM SNMPv2-TC;
mMIB MODULE-IDENTITY
    LAST-UPDATED "202610100000Z"
    ORGANIZATION "o"
    CONTACT-INFO "c"
    DESCRIPTION  "d \"quoted\""
    ::= { enterprises 99997 }
Percent ::= TEXTUAL-CONVENTION DISPLAY-HINT "d-2" STATUS current DESCRIPTION "p" SYNTAX Integer32 (0..10000)
mObjects OBJECT IDENTIFIER ::= { mMIB 1 }
mName OBJECT-TYPE SYNTAX DisplayString (SIZE (0..32)) MAX-ACCESS read-write STATUS current DESCRIPTION "n"
    DEFVAL { "x" } ::= { mObjects 1 }
mBig OBJECT-TYPE SYNTAX Counter64 UNITS "octets" MAX-ACCESS read-only STATUS current DESCRIPTION "b" ::= { mObjects 2 }
mTable OBJECT-TYPE SYNTAX SEQUENCE OF MEntry MAX-ACCESS not-accessible STATUS current DESCRIPTION "t" ::= { mObjects 3 }
mEntry OBJECT-TYPE SYNTAX MEntry MAX-ACCESS not-accessible STATUS current DESCRIPTION "e" INDEX { mAddr, IMPLIED mKey } ::= { mTable 1 }
MEntry ::= SEQUENCE { mAddr IpAddress, mKey DisplayString, mMac PhysAddress, mOn TruthValue, mPct Percent, mStatus RowStatus }
mAddr OBJECT-TYPE SYNTAX IpAddress MAX-ACCESS not-accessible STATUS current DESCRIPTION "a" ::= { mEntry 1 }
mKey OBJECT-TYPE SYNTAX DisplayString MAX-ACCESS not-accessible STATUS current DESCRIPTION "k" ::= { mEntry 2 }
mMac OBJECT-TYPE SYNTAX PhysAddress MAX-ACCESS read-create STATUS current DESCRIPTION "m" ::= { mEntry 3 }
mOn OBJECT-TYPE SYNTAX TruthValue MAX-ACCESS read-create STATUS current DESCRIPTION "o" DEFVAL { true } ::= { mEntry 4 }
mPct OBJECT-TYPE SYNTAX Percent MAX-ACCESS read-create STATUS deprecated DESCRIPTION "p" ::= { mEntry 5 }
mStatus OBJECT-TYPE SYNTAX RowStatus MAX-ACCESS read-create STATUS current DESCRIPTION "s" ::= { mEntry 6 }
mEvent NOTIFICATION-TYPE OBJECTS { mName, mOn } STATUS current DESCRIPTION "e" ::= { mMIB 0 1 }
END
"""


def meta() -> mib.meta.ModuleMeta:
    ms = mib.resolver.resolve_texts([M_MIB])
    mm = mib.meta.module_meta(ms, "M-MIB")
    if mm is not None:
        return mm
    raise ValueError("M-MIB not resolved")


def _test_module_meta_json() -> str:
    """Snapshot of the JSON of a small module (key order and content are the contract)."""
    return mib.meta.to_json(meta())


def _test_json_round_trip() -> None:
    mm = meta()
    j1 = mib.meta.to_json(mm)
    mm2 = mib.meta.from_json(j1)
    testing.assertEqual(mib.meta.to_json(mm2), j1)
    b = mib.meta.MibBundle([mm, mm2])
    bj = mib.meta.bundle_to_json(b)
    b2 = mib.meta.bundle_from_json(bj)
    testing.assertEqual(len(b2.modules), 2)
    testing.assertEqual(mib.meta.bundle_to_json(b2), bj)


def _test_derivation() -> None:
    mm = meta()
    testing.assertEqual(mm.yang_prefix, "m-mib")
    testing.assertEqual(mm.revision, "2026-10-10")
    testing.assertEqual([n.name for n in mm.nodes],
                        ["mMIB", "mEvent", "mObjects", "mName", "mBig", "mTable", "mEntry", "mAddr", "mKey", "mMac", "mOn", "mPct", "mStatus"])
    convs: list[str] = []
    for n in mm.nodes:
        s = n.syntax
        if s is not None:
            convs.append(n.name + ":" + s.conv)
    testing.assertEqual(convs, ["mName:string-hint", "mBig:uint", "mAddr:ipv4", "mKey:string-hint", "mMac:phys-address",
                                "mOn:truthvalue", "mPct:int-hint", "mStatus:enum"])
    row = mm.nodes[6]
    testing.assertEqual([p.obj + "=" + p.enc for p in row.index], ["M-MIB::mAddr=ipv4", "M-MIB::mKey=implied"])
    testing.assertTrue(row.implied)


def _test_lookup() -> None:
    mm = meta()
    ix = mib.meta.MetaIndex(mib.meta.MibBundle([mm]))
    r = ix.lookup([1, 3, 6, 1, 4, 1, 99997, 1, 3, 1, 4, 192, 0, 2, 1, 97, 98])
    if r is not None:
        testing.assertEqual(r.0.name, "mOn")
        testing.assertEqual(r.1, [192, 0, 2, 1, 97, 98])
    else:
        testing.error("no match")
    s = ix.lookup([1, 3, 6, 1, 4, 1, 99997, 1, 2, 0])
    testing.assertEqual(s.0.name + ":" + str(s.1) if s is not None else "", "mBig:[0]")
    testing.assertNone(ix.lookup([1, 3, 6, 1, 4, 1, 5]))
    n = ix.find("M-MIB::mName")
    testing.assertEqual(n.oid if n is not None else [], [1, 3, 6, 1, 4, 1, 99997, 1, 1])
    n2 = ix.find("mStatus")
    testing.assertEqual(n2.qname() if n2 is not None else "", "M-MIB::mStatus")
    n3 = ix.find("M-MIB.mKey")
    testing.assertEqual(n3.kind if n3 is not None else "", "column")
    testing.assertNone(ix.find("nothing"))


def _test_bad_format() -> None:
    try:
        mib.meta.from_json(r"""{"format":"other/1","module":"X"}""")
        testing.error("accepted a wrong format")
    except mib.meta.MetaError as e:
        testing.assertEqual(e.error_message, "unsupported mibmeta format other/1")


def meta_error(text: str) -> str:
    """The MetaError message of from_json(text) ("" when it parsed); any other exception
    propagates and fails the test."""
    try:
        mib.meta.from_json(text)
        return ""
    except mib.meta.MetaError as e:
        return e.error_message


def _test_malformed_json() -> None:
    """Malformed input raises MetaError (a ValueError), never another exception."""
    good = r"""{"format":"actsnmp-mibmeta/1","module":"X","smi":"v2","nodes":[{"name":"a","oid":"1.3.6","kind":"node","status":"current"}]}"""
    testing.assertEqual(meta_error(good), "")
    bad: list[(str, str)] = [
        ("{{", "malformed mibmeta JSON"),
        ("[1, 2]", "malformed mibmeta JSON"),
        ("", "malformed mibmeta JSON"),
        (r"""{"format":"actsnmp-mibmeta/1"}""", "module name missing"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":{"a":1}}""", "X: \"nodes\" is not a list"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[1]}""", "X: object expected"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"oid":"1.3","kind":"node"}]}""", "X: node: \"name\" missing"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","kind":"node"}]}""", "X: a: \"oid\" missing"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3"}]}""", "X: a: \"kind\" missing"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":5,"kind":"node"}]}""", "X: a: \"oid\" is not a string"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"","kind":"node"}]}""", "X: a: \"oid\" missing"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"r","oid":"1.3","kind":"row","index":{"enc":"int"}}]}""", "X: \"index\" is not a list"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","types":"T"}""", "X: \"types\" is not a list"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3","kind":"scalar","syntax":{"wire":"INTEGER","enums":[["a",1e400]]}}]}""", "malformed mibmeta JSON"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3","kind":"scalar","syntax":{"wire":"INTEGER","ranges":"0..5"}}]}""", "X: \"ranges\" is not a list"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.x","kind":"node"}]}""", "X: bad OID '1.x'"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.4294967296","kind":"node"}]}""", "X: bad OID '1.4294967296'"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1..3","kind":"node"}]}""", "X: bad OID '1..3'"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"r","oid":"1.3","kind":"row","index":[{"enc":"fixed","size":"x"}]}]}""", "X: integer expected"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3","kind":"scalar","syntax":{"wire":"INTEGER","ranges":[["a",1]]}}]}""", "X: "),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3","kind":"scalar","syntax":{"wire":"INTEGER","ranges":[[true,1]]}}]}""", "X: number expected"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","nodes":[{"name":"a","oid":"1.3","kind":"scalar","syntax":7}]}""", "X: object expected"),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","types":[{"name":"T","syntax":{"wire":"BITS","bits":[["b",1e30]]}}]}""", "X: "),
        (r"""{"format":"actsnmp-mibmeta/1","module":"X","yang":"x"}""", "X: object expected"),
        (r"""{"format":"other/1","module":"X"}""", "unsupported mibmeta format other/1"),
    ]
    for t in bad:
        got = meta_error(t.0)
        testing.assertTrue(got.startswith(t.1) and got != "", repr(t.0) + " gave " + repr(got))
    try:
        mib.meta.bundle_from_json(r"""{"format":"actsnmp-mibmeta/1","modules":[{"module":"X","nodes":[{"name":"a"}]}]}""")
        testing.error("bundle_from_json accepted a node without an OID")
    except ValueError as e:
        testing.assertEqual(e.error_message, "X: a: \"oid\" missing", "a MetaError is a ValueError")
    try:
        mib.meta.bundle_from_json("{{")
        testing.error("bundle_from_json accepted bad JSON")
    except mib.meta.MetaError:
        pass


def _test_index_helpers() -> None:
    """The table helpers on M-MIB; test_tables covers AUGMENTS."""
    mm = meta()
    ix = mib.meta.MetaIndex(mib.meta.MibBundle([mm]))
    key = ix.find("mKey")
    entry = ix.find("mEntry")
    table = ix.find("mTable")
    if key is not None and entry is not None and table is not None:
        r = ix.row_of(key)
        testing.assertEqual(r.name if r is not None else "", "mEntry")
        tb = ix.table_of(entry)
        testing.assertEqual(tb.name if tb is not None else "", "mTable")
        rt = ix.row_of_table(table)
        testing.assertEqual(rt.name if rt is not None else "", "mEntry")
        testing.assertEqual([c.name for c in ix.columns(entry, True)], ["mAddr", "mKey", "mMac", "mOn", "mPct", "mStatus"])
        testing.assertEqual([c.name for c in ix.augmenting_rows(entry)], [])
        b = ix.base_row(entry)
        testing.assertEqual(b.name if b is not None else "", "mEntry")
        testing.assertEqual([p.key + ":" + p.enc for p in ix.index_of(entry)], ["mAddr:ipv4", "mKey:implied"])
        testing.assertNone(ix.row_of(entry), "a row is not below a row")
        testing.assertNone(ix.table_of(table))
    else:
        testing.error("M-MIB nodes missing")
    o = ix.lookup_object([1, 3, 6, 1, 4, 1, 99997, 1, 3, 1, 3, 10, 0, 0, 1, 120])
    testing.assertEqual(o.0.name + str(o.1) if o is not None else "", "mMac[10, 0, 0, 1, 120]")
    testing.assertNone(ix.lookup_object([1, 3, 6, 1, 4, 1, 99997, 1, 3, 1]))
    testing.assertNone(ix.lookup_object([1, 3, 6, 1, 4, 1, 99997, 1]))
    obj = ix.find("mObjects")
    if obj is not None:
        testing.assertEqual([c.name for c in ix.children(obj)], ["mName", "mBig", "mTable"])
    pct = ix.find_type("M-MIB::Percent")
    testing.assertEqual(pct.name if pct is not None else "", "Percent")
    testing.assertNone(ix.find_type("M-MIB::Nothing"))
    testing.assertEqual(ix.tc_chain("M-MIB::Percent"), [])
