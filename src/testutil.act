"""Helpers shared by the test modules; not part of the library API"""

import file
import logging
import net
import testing
import ber
import errors
import transport
from transport import ServerTransport

def h(s: str) -> bytes:
    """Return the bytes written as hex in s; spaces, colons and line breaks are ignored (ber.from_hex)"""
    return ber.from_hex(s)

def decode_fails[T](f: mut() -> T, what: str) -> None:
    """Fail the test unless f raises errors.DecodeError (any other exception propagates)"""
    try:
        f()
    except errors.DecodeError:
        return
    testing.error("no DecodeError: " + what)

def encode_fails[T](f: mut() -> T, what: str) -> None:
    """Fail the test unless f raises errors.EncodeError (any other exception propagates)"""
    try:
        f()
    except errors.EncodeError:
        return
    testing.error("no EncodeError: " + what)

def value_fails[T](f: mut() -> T, what: str) -> None:
    """Fail the test unless f raises ValueError (any other exception propagates)"""
    try:
        f()
    except ValueError:
        return
    testing.error("no ValueError: " + what)


class Lcg(object):
    """Deterministic pseudo-random numbers: a 64-bit LCG with Knuth's MMIX constants

    The state wraps modulo 2^64, so a seed always gives the same
    sequence.
    """
    state: int

    def __init__(self, seed: int):
        self.state = seed

    def next64(self) -> int:
        """Advance and return the whole 64-bit state (any int, negative ones included)"""
        self.state = self.state * 6364136223846793005 + 1442695040888963407
        return self.state

    def next31(self) -> int:
        """Advance and return the high bits of the state as a number in 0..2^31-1"""
        return (self.next64() >> 33) & 0x7fffffff

    def below(self, n: int) -> int:
        """Return a number in 0..n-1; n must be at least 1"""
        return self.next31() % n

    def octets(self, n: int) -> bytes:
        """Return n pseudo-random octets"""
        return b"".join([ber.BYTE_TABLE[self.below(256)] for i in range(n)])


def pseudo_random(n: int, seed: int) -> bytes:
    """Return n deterministic octets without short repeats (31-bit LCG with glibc's constants, high byte)"""
    t = ber.BYTE_TABLE
    parts: list[bytes] = []
    x = seed
    for _ in range(n):
        x = (x * 1103515245 + 12345) % 2147483648
        parts.append(t[x >> 23])
    return b"".join(parts)


proc def read_text(t: testing.EnvT, path: str) -> str:
    """The text of the file at path, relative to the project root when run by `acton test`

    Test results are cached by source hash, so tests that read files need
    --no-cache after those files change.
    """
    f = file.ReadFile(file.ReadFileCap(file.FileCap(t.env.cap)), path)
    data = f.read()
    f.close()
    return data.decode()


proc def outcome(check: proc() -> None) -> ?Exception:
    """Run check; return what it raised, or None when it passed (async tests report it with report())"""
    try:
        check()
    except Exception as e:
        return e
    return None

proc def report(t: testing.AsyncT, error: ?Exception) -> None:
    """End an async test: t.failure(error), or t.success() when error is None"""
    if error is not None:
        t.failure(error)
    else:
        t.success()

proc def report_env(t: testing.EnvT, error: ?Exception) -> None:
    """End an env test: t.failure(error), or t.success() when error is None"""
    if error is not None:
        t.failure(error)
    else:
        t.success()


actor ListenTcp(cap: net.TCPListenCap, address: str, first_port: int, count: int,
                on_ready: action(ServerTransport, ?str) -> None, log_handler: ?logging.Handler,
                max_connections: int=256, idle_timeout: float=300.0):
    """transport.tcp_server_transport() on the first free port of first_port .. first_port + count - 1

    A listening TCP socket stays bound until the process exits, and a test
    can run several times in one process, so each run listens on the next
    port of the test's own range; a port that anything else uses is skipped
    as well. on_ready gets the last error when no port of the range is
    free. Give every test its own range, apart from the other tests' and
    from the ephemeral ports.
    """
    var _port = first_port

    def _ready(s: ServerTransport, error: ?str) -> None:
        if error is not None and "address already in use" in error and _port < first_port + count - 1:
            _port += 1
            transport.tcp_server_transport(cap, address, _port, _ready, log_handler, max_connections, idle_timeout)
            return
        on_ready(s, error)

    transport.tcp_server_transport(cap, address, _port, _ready, log_handler, max_connections, idle_timeout)
