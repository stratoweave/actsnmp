AGENT_PORT = 161
OTHER_PORT = 1161
MANAGER_ADDR = "10.0.0.2"
MANAGER_PORT = 40000

# Seconds a test waits to see that nothing more arrives, and after which it checks what it has
QUIET = 0.2
WATCHDOG = 2.5

# The engine of the net-snmp discovery capture
ENGINE_ID = h("80001f88800102030405060708")
OTHER_ENGINE_ID = h("80001f88800a0b0c0d0e0f1011")

# The enterprise subtree of the test view
ENT = "1.3.6.1.4.1.99999"
SYS_DESCR = "1.3.6.1.2.1.1.1.0"
SYS_OBJECT_ID = "1.3.6.1.2.1.1.2.0"
SYS_UPTIME = "1.3.6.1.2.1.1.3.0"
SYS_NAME = "1.3.6.1.2.1.1.5.0"
ENGINE_ID_OID = "1.3.6.1.6.3.10.2.1.1.0"
DESCR = b"actsnmp test agent"
BIG = 400

# net-snmp's engine ID discovery request, captured (msgID 1001, request-id 5001)
