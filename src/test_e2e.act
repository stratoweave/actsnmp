actor _test_fault_error_at(t: testing.AsyncT):
    """error_at: the injected error-status reaches the caller with its index, OID and transient flag"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(status_of(outs[0], "get"), (pdu.RESOURCE_UNAVAILABLE, 2))
        err = outs[0].e
        if isinstance(err, errors.ErrorStatusError):
            testing.assertEqual(err.oid, e([5, 1, 0]).arcs)
            testing.assertTrue(err.transient, "resourceUnavailable is transient")
        testing.assertEqual(vbs_of(outs[1], "another OID"), [VarBind(e([6, 1, 0]), Gauge32(8))])

    run = _FaultRun(t, Faults(error_at=e([5, 1, 0]), error_status=pdu.RESOURCE_UNAVAILABLE), None,
                    Community("public"), OPTS, check)
    c = run.client()
    cb = run.callback()
    c.get(cb, [e([1, 1, 0]), e([5, 1, 0])])
    c.get(cb, [e([6, 1, 0])])
    run.expect(2)

actor _test_fault_wrong_source_version_community(t: testing.AsyncT):
    """Answers from another port, in the wrong version or (checked) with the wrong community time out with a hint"""
    t.timeout(30.0)
    mn = MemNet()
    other = mn.server(AGENT, 1161)
    a1 = Agent(mn.server(AGENT, 161), make_view(), agent_config([]), None,
               Faults(respond_from_other_port=True, other_port=other))
    a2 = Agent(mn.server(AGENT, 162), make_view(), agent_config([]), None, Faults(wrong_version=True))
    a3 = Agent(mn.server(AGENT, 163), make_view(), agent_config([]), None, Faults(wrong_community=True))
    quick = Options(timeout=0.2, retries=0)
    c1 = Client(None, AGENT, Community("public"), None, opts=quick, transport=mn.client(MANAGER, 40001, AGENT, 161))
    c2 = Client(None, AGENT, Community("public"), None, port=162, opts=quick,
                transport=mn.client(MANAGER, 40002, AGENT, 162))
    c3 = Client(None, AGENT, Community("public"), None, port=163, opts=quick.with_(check_community=True),
                transport=mn.client(MANAGER, 40003, AGENT, 163))
    c4 = Client(None, AGENT, Community("public"), None, port=163, opts=quick,
                transport=mn.client(MANAGER, 40004, AGENT, 163))
    var results: dict[str, list[Outcome]] = {}

    def check() -> None:
        testing.assertEqual(timeout_hint(results["port"][0], "other port"), "1 datagram from another source")
        testing.assertEqual(timeout_hint(results["version"][0], "version"), "1 datagram of another SNMP version")
        testing.assertEqual(timeout_hint(results["community"][0], "community"), "1 datagram failed authentication")
        testing.assertEqual(vbs_of(results["unchecked"][0], "community not checked"),
                            [VarBind(SYS_DESCR, OctetString(DESCR))])

    def reported(label: str, outs: list[Outcome]) -> None:
        results[label] = outs
        if len(results) == 4:
            report(t, outcome(check))

    for c, label in [(c1, "port"), (c2, "version"), (c3, "community"), (c4, "unchecked")]:
        col = Collector(label, reported)
        c.get(col.cb, [SYS_DESCR])
        col.expect(1)

actor _test_fault_trailing_bytes(t: testing.AsyncT):
    """Octets after the message: ignored in SNMPv2c, an undecodable message in SNMPv3 (dropped, the request times out)"""
    t.timeout(30.0)
    u = _sha_aes()
    mn = MemNet()
    a1 = Agent(mn.server(AGENT, 161), make_view(), agent_config([u]), None, Faults(trailing_bytes=b"\x00\x00"))
    c1 = Client(None, AGENT, Community("public"), None, opts=OPTS, transport=mn.client(MANAGER, 40001, AGENT, 161))
    c2 = Client(None, AGENT, u, None, opts=Options(timeout=0.3, retries=0),
                transport=mn.client(MANAGER, 40002, AGENT, 161))
