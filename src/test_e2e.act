    "u_ro_sha_aes\tauthPriv\tSHA\tAES\tSHA\tAES\tauthpass123\tprivpass123\tyes(read-only)\tno"
]

SYS_DESCR = Oid([1, 3, 6, 1, 2, 1, 1, 1, 0])
ENTERPRISE = Oid([1, 3, 6, 1, 4, 1, 8072, 9999])
DESCR = b"actsnmp end-to-end agent"


def e(arcs: list[int]) -> Oid:
    """An OID below the lab's enterprise subtree 1.3.6.1.4.1.8072.9999.1"""
    return Oid([1, 3, 6, 1, 4, 1, 8072, 9999, 1] + arcs)

def big(i: int) -> OctetString:
    return OctetString(("%03d" % i).encode() * 33)

def make_view() -> MibView:
    """The agent's variables: scalars of every type, a 3-column table and 64 writable per-client integers"""
    vbs = [VarBind(SYS_DESCR, OctetString(DESCR)),
           VarBind(e([1, 1, 0]), Integer(42)),
           VarBind(e([2, 1, 0]), OctetString(b"hello")),
           VarBind(e([3, 1, 0]), Counter64(18446744073709551615)),
           VarBind(e([4, 1, 0]), IpAddress(b"\xc0\x00\x02\x01")),
           VarBind(e([5, 1, 0]), Counter32(7)),
           VarBind(e([6, 1, 0]), Gauge32(8)),
           VarBind(e([7, 1, 0]), TimeTicks(9)),
           VarBind(e([8, 1, 0]), ObjectIdentifier(ENTERPRISE))]
    for i in range(1, 9):
        vbs.append(VarBind(e([9, i, 0]), big(i)))
    for c in range(1, 4):
        for i in range(1, 6):
            vbs.append(VarBind(e([10, 1, c, i]), Integer(c * 100 + i)))
    for i in range(1, 65):
        vbs.append(VarBind(e([20, i, 0]), Integer(0)))
    return MibView(vbs)

def write_rules() -> list[WriteRule]:
    return [WriteRule(e([1]), [ber.TAG_INTEGER], 0, 100), WriteRule(e([2]), [ber.TAG_OCTET_STRING], 0, 16),
            WriteRule(e([20]), [ber.TAG_INTEGER], 0, 100000)]

def agent_config(users: list[Usm]) -> AgentConfig:
    return AgentConfig({"public": False, "private": True}, users, h(AGENT_ENGINE), AGENT_BOOTS, write_rules(),
                       read_only_users=["u_ro_sha_aes"])

def lab_users(auth: str) -> list[Usm]:
    """The users of USERS whose net-snmp authentication column is auth; MD5 also gets u_noauth, SHA u_ro_sha_aes"""
    rows: list[str] = []
    for r in USERS:
        a = r.split("\t")[2]
        if a == auth or (auth == "MD5" and a == "-"):
            rows.append(r)
    return security.load_users_tsv("\n".join(rows)).users

def table(c: int, i: int) -> VarBind:
    return VarBind(e([10, 1, c, i]), Integer(c * 100 + i))


# Outcomes ##########################################################################################

class Outcome(object):
    """What a request's callback got"""
    r: ?Response
    e: ?errors.SnmpError

    def __init__(self, r: ?Response, e: ?errors.SnmpError):
        self.r = r
        self.e = e

def describe(o: Outcome) -> str:
    e = o.e
    if e is not None:
        return "error " + str(e)
    r = o.r
    if r is not None:
        return repr(r)
    return "nothing"

def ok(o: Outcome, what: str) -> Response:
    e = o.e
    if e is not None:
        raise AssertionError(what + ": unexpected error " + str(e))
    r = o.r
    if r is not None:
        return r
    raise AssertionError(what + ": no response")

def vbs_of(o: Outcome, what: str) -> list[VarBind]:
    return ok(o, what).varbinds

def status_of(o: Outcome, what: str) -> (int, int):
    e = o.e
    if isinstance(e, errors.ErrorStatusError):
        return (e.status, e.index)
    raise AssertionError(what + ": expected an error-status, got " + describe(o))

def timeout_hint(o: Outcome, what: str) -> str:
    e = o.e
    if isinstance(e, errors.TimeoutError):
        hint = e.hint
        return hint if hint is not None else ""
    raise AssertionError(what + ": expected a TimeoutError, got " + describe(o))

actor Collector(label: str, report: action(str, list[Outcome]) -> None):
    """The callbacks of one Client's requests, in completion order; report(label, outcomes) once expect(n) are in"""
    var got: list[Outcome] = []
    var want = -1
    var reported = False

    proc def _check() -> None:
        if not reported and want >= 0 and len(got) >= want:
            reported = True
            report(label, got)

    def cb(c: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        got.append(Outcome(r, e))
        _check()

    def expect(n: int) -> None:
        want = n
        _check()

    def count() -> int:
        return len(got)

def _client(mn: MemNet, sec: security.Security, port: int, opts: Options=OPTS, log: ?logging.Handler=None) -> Client:
    return Client(None, AGENT, sec, log, opts=opts, transport=mn.client(MANAGER, port, AGENT, 161))


# SNMPv2c and SNMPv1 ###############################################################################

actor _test_v2c_ops(t: testing.AsyncT):
    """SNMPv2c: get, get_next, get_bulk and set with every SET error status, through the real Client and Agent"""
    t.timeout(30.0)
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([]), t.log_handler)
    var results: dict[str, list[Outcome]] = {}

    def check() -> None:
        a = results["public"]
        testing.assertEqual(vbs_of(a[0], "get"),
                            [VarBind(SYS_DESCR, OctetString(DESCR)), VarBind(e([6, 1, 0]), Gauge32(8)),
                             VarBind(e([3, 1, 0]), Counter64(18446744073709551615)),
                             VarBind(e([4, 1, 0]), IpAddress(b"\xc0\x00\x02\x01")),
                             VarBind(e([1, 1, 1]), NoSuchInstance()), VarBind(e([99, 0]), NoSuchObject())])
        testing.assertEqual(vbs_of(a[1], "get_next"),
                            [VarBind(e([2, 1, 0]), OctetString(b"hello")), table(1, 1),
                             VarBind(Oid([2, 999]), EndOfMibView())])
        testing.assertEqual(vbs_of(a[2], "get_bulk"),
                            [VarBind(e([2, 1, 0]), OctetString(b"hello")), table(1, 1), table(2, 1), table(1, 2),
                             table(2, 2), table(1, 3), table(2, 3)])
        testing.assertEqual(status_of(a[3], "set with public"), (pdu.NO_ACCESS, 1))
        testing.assertEqual(len(a), 4)
        p = results["private"]
        testing.assertEqual(vbs_of(p[0], "set"), [VarBind(e([1, 1, 0]), Integer(7))])
        testing.assertEqual(vbs_of(p[1], "get after set"), [VarBind(e([1, 1, 0]), Integer(7))])
        testing.assertEqual(status_of(p[2], "notWritable"), (pdu.NOT_WRITABLE, 1))
        testing.assertEqual(status_of(p[3], "wrongType"), (pdu.WRONG_TYPE, 1))
        testing.assertEqual(status_of(p[4], "wrongLength"), (pdu.WRONG_LENGTH, 1))
        testing.assertEqual(status_of(p[5], "wrongValue"), (pdu.WRONG_VALUE, 1))
        testing.assertEqual(status_of(p[6], "noCreation"), (pdu.NO_CREATION, 1))
        testing.assertEqual(status_of(p[7], "second varbind wrongType"), (pdu.WRONG_TYPE, 2))
        testing.assertEqual(vbs_of(p[8], "get after the failed SET"), [VarBind(e([1, 1, 0]), Integer(7))])
        err = p[7].e
        if isinstance(err, errors.ErrorStatusError):
            testing.assertEqual(err.oid, e([2, 1, 0]).arcs)
            r = error_response(err)
            testing.assertTrue(r is not None, "the ErrorStatusError keeps its Response")

    def reported(label: str, outs: list[Outcome]) -> None:
        results[label] = outs
        if len(results) == 2:
            report(t, outcome(check))

    pub = _client(mn, Community("public"), 40001, OPTS, t.log_handler)
    cp = Collector("public", reported)
    pub.get(cp.cb, [SYS_DESCR, e([6, 1, 0]), e([3, 1, 0]), e([4, 1, 0]), e([1, 1, 1]), e([99, 0])])
    pub.get_next(cp.cb, [e([1, 1, 0]), e([10, 1, 1]), Oid([2, 999])])
    pub.get_bulk(cp.cb, [e([1, 1, 0]), e([10, 1, 1]), e([10, 1, 2])], 1, 3)
    pub.set(cp.cb, [VarBind(e([1, 1, 0]), Integer(1))])
    cp.expect(4)

    priv = _client(mn, Community("private"), 40002, OPTS, t.log_handler)
    cq = Collector("private", reported)
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), Integer(7))])
    priv.get(cq.cb, [e([1, 1, 0])])
    priv.set(cq.cb, [VarBind(SYS_DESCR, OctetString(b"x"))])
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), OctetString(b"x"))])
    priv.set(cq.cb, [VarBind(e([2, 1, 0]), OctetString(b"y" * 17))])
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), Integer(101))])
    priv.set(cq.cb, [VarBind(e([1, 9, 0]), Integer(1))])
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), Integer(55)), VarBind(e([2, 1, 0]), Integer(1))])
    priv.get(cq.cb, [e([1, 1, 0])])
    cq.expect(9)

actor _test_v1_ops(t: testing.AsyncT):
    """SNMPv1: exceptions and Counter64 become noSuchName (fixed by the Client), GETBULK goes as GETNEXT, SET errors mapped"""
    t.timeout(30.0)
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([]), t.log_handler)
    var results: dict[str, list[Outcome]] = {}

    def check() -> None:
        a = results["public"]
        testing.assertEqual(vbs_of(a[0], "get"), [VarBind(SYS_DESCR, OctetString(DESCR)),
                                                  VarBind(e([3, 1, 0]), NoSuchObject()),
                                                  VarBind(e([6, 1, 0]), Gauge32(8))])
        testing.assertEqual(vbs_of(a[1], "get of a missing instance"), [VarBind(e([1, 1, 1]), NoSuchObject())])
        testing.assertEqual(vbs_of(a[2], "get_next skips Counter64"),
                            [VarBind(e([4, 1, 0]), IpAddress(b"\xc0\x00\x02\x01"))])
        testing.assertEqual(vbs_of(a[3], "get_bulk as GETNEXT"), [table(1, 1)])
        testing.assertEqual(vbs_of(a[4], "get_next past the end"), [VarBind(Oid([2, 999]), EndOfMibView())])
        testing.assertEqual(status_of(a[5], "set with public"), (pdu.NO_SUCH_NAME, 1))
        r6 = ok(a[6], "get with two missing")
        testing.assertEqual(r6.varbinds, [VarBind(e([1, 1, 1]), NoSuchObject()), VarBind(SYS_DESCR, OctetString(DESCR)),
                                          VarBind(e([99, 0]), NoSuchObject()), VarBind(e([6, 1, 0]), Gauge32(8))])
        testing.assertEqual(r6.attempts, 3, "two noSuchName answers fixed, one resend each")
        testing.assertEqual(vbs_of(a[7], "get_next with one past the end"),
                            [VarBind(e([6, 1, 0]), Gauge32(8)), VarBind(Oid([2, 999]), EndOfMibView())])
        p = results["private"]
        testing.assertEqual(vbs_of(p[0], "set"), [VarBind(e([1, 1, 0]), Integer(9))])
        testing.assertEqual(status_of(p[1], "notWritable"), (pdu.NO_SUCH_NAME, 1))
        testing.assertEqual(status_of(p[2], "wrongType"), (pdu.BAD_VALUE, 1))
        testing.assertEqual(status_of(p[3], "noCreation"), (pdu.NO_SUCH_NAME, 1))
        testing.assertEqual(status_of(p[4], "wrongValue"), (pdu.BAD_VALUE, 1))
        testing.assertEqual(vbs_of(p[5], "get after"), [VarBind(e([1, 1, 0]), Integer(9))])

    def reported(label: str, outs: list[Outcome]) -> None:
        results[label] = outs
        if len(results) == 2:
            report(t, outcome(check))

    pub = _client(mn, Community("public", message.SNMP_V1), 40001, OPTS, t.log_handler)
    cp = Collector("public", reported)
    pub.get(cp.cb, [SYS_DESCR, e([3, 1, 0]), e([6, 1, 0])])
    pub.get(cp.cb, [e([1, 1, 1])])
    pub.get_next(cp.cb, [e([2, 1, 0])])
    pub.get_bulk(cp.cb, [e([10, 1, 1])], 0, 5)
    pub.get_next(cp.cb, [Oid([2, 999])])
    pub.set(cp.cb, [VarBind(e([1, 1, 0]), Integer(1))])
    pub.get(cp.cb, [e([1, 1, 1]), SYS_DESCR, e([99, 0]), e([6, 1, 0])])
    pub.get_next(cp.cb, [e([5, 1, 0]), Oid([2, 999])])
    cp.expect(8)

    priv = _client(mn, Community("private", message.SNMP_V1), 40002, OPTS, t.log_handler)
    cq = Collector("private", reported)
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), Integer(9))])
    priv.set(cq.cb, [VarBind(SYS_DESCR, OctetString(b"x"))])
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), OctetString(b"x"))])
    priv.set(cq.cb, [VarBind(e([1, 9, 0]), Integer(1))])
    priv.set(cq.cb, [VarBind(e([1, 1, 0]), Integer(1000))])
    priv.get(cq.cb, [e([1, 1, 0])])
    cq.expect(6)


# SNMPv3: every authentication and privacy protocol ###############################################

actor _V3Group(t: testing.AsyncT, auth: str):
    """Every lab user with authentication protocol auth, each with its own Client discovering the agent from cold"""
    users = lab_users(auth)
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config(users), None)
    var clients: dict[str, Client] = {}
    var results: dict[str, list[Outcome]] = {}

    def check() -> None:
        for i in range(len(users)):
            u = users[i]
            name = u.user
            a = results[name]
            n = i + 1
            what = name + ": "
            testing.assertEqual(vbs_of(a[0], what + "get"),
                                [VarBind(SYS_DESCR, OctetString(DESCR)), VarBind(e([20, n, 0]), Integer(0))])
            if name == "u_ro_sha_aes":
                testing.assertEqual(status_of(a[1], what + "set by a read-only user"), (pdu.NO_ACCESS, 1))
                testing.assertEqual(vbs_of(a[2], what + "get after"), [VarBind(e([20, n, 0]), Integer(0))])
            else:
                testing.assertEqual(vbs_of(a[1], what + "set"), [VarBind(e([20, n, 0]), Integer(n * 7 + 1))])
                testing.assertEqual(vbs_of(a[2], what + "get after"), [VarBind(e([20, n, 0]), Integer(n * 7 + 1))])
            testing.assertEqual(vbs_of(a[3], what + "get_next"), [VarBind(e([2, 1, 0]), OctetString(b"hello"))])
            testing.assertEqual(vbs_of(a[4], what + "get_bulk"), [table(1, 1), table(1, 2), table(1, 3)])
            r = ok(a[0], what + "get")
            testing.assertEqual((r.context_engine_id, r.context_name), (h(AGENT_ENGINE), b""), what + "context")
            c = clients[name]
            info = c.engine_info()
            if info is not None:
                testing.assertEqual((info.engine_id, info.boots), (h(AGENT_ENGINE), AGENT_BOOTS), what + "engine")
            else:
                raise AssertionError(what + "no engine info after discovery")
            s = c.stats()
            testing.assertTrue(s.reports >= 1, what + "the discovery Report: " + str(s))
            testing.assertEqual((s.timeouts, s.drops_auth, s.drops_decode), (0, 0, 0), what + str(s))

    def reported(label: str, outs: list[Outcome]) -> None:
        results[label] = outs
        if len(results) == len(users):
            report(t, outcome(check))

    for i in range(len(users)):
        u = users[i]
        n = i + 1
        c = _client(mn, u, 41000 + n)
        clients[u.user] = c
        col = Collector(u.user, reported)
        c.get(col.cb, [SYS_DESCR, e([20, n, 0])])
        c.set(col.cb, [VarBind(e([20, n, 0]), Integer(n * 7 + 1))])
        c.get(col.cb, [e([20, n, 0])])
        c.get_next(col.cb, [e([1, 1, 0])])
        c.get_bulk(col.cb, [e([10, 1, 1])], 0, 3)
        col.expect(5)

