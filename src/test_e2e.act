actor _test_v3_discover(t: testing.AsyncT):
    """discover() from cold reports the agent's engine ID and boots; a request after it needs no second probe"""
    t.timeout(30.0)
    u = Usm.from_passwords("u_sha_aes", usm.AUTH_SHA1, "authpass123", usm.PRIV_AES128, "privpass123")
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([u]), t.log_handler)
    c = _client(mn, u, 40001, OPTS, t.log_handler)
    var info: ?EngineInfo = None

    def got(r: ?Response, err: ?errors.SnmpError) -> None:
        s = c.stats()
        def check() -> None:
            testing.assertEqual(vbs_of(Outcome(r, err), "get"), [VarBind(SYS_DESCR, OctetString(DESCR))])
            i = info
            if i is not None:
                testing.assertEqual((i.engine_id, i.boots), (h(AGENT_ENGINE), AGENT_BOOTS))
            else:
                raise AssertionError("no EngineInfo")
            testing.assertEqual(s.reports, 1, "one discovery Report: " + str(s))
        report(t, outcome(check))

    def get_done(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        got(r, err)

    def discovered(cl: Client, i: ?EngineInfo, err: ?errors.SnmpError) -> None:
        if err is not None:
            t.failure(AssertionError("discovery failed: " + str(err)))
            return
        info = i
        c.get(get_done, [SYS_DESCR])

    c.discover(discovered)


# Faults seen through the real Client ##############################################################

actor _FaultRun(t: testing.AsyncT, faults: ?Faults, net_faults: ?NetFaults, sec: security.Security, opts: Options,
                check: proc(list[Outcome], Client) -> None, other_port: int=0):
    """An Agent with faults on a MemNet (net_faults on the answers to the manager), one Client, and requests"""
    mn = MemNet(net_faults)
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([_sha_aes()]), t.log_handler, faults)
    c = _client(mn, sec, 40001, opts, t.log_handler)

    def reported(label: str, outs: list[Outcome]) -> None:
        def run() -> None:
            check(outs, c)
        report(t, outcome(run))

    col = Collector("faults", reported)

    def client() -> Client:
        return c

    def callback() -> action(Client, ?Response, ?errors.SnmpError) -> None:
        return col.cb

    def expect(n: int) -> None:
        col.expect(n)

    def quietly(n: int) -> None:
        # expect n outcomes, but report only after QUIET more seconds (to catch a second callback)
        after now QUIET: col.expect(n)

def _sha_aes() -> Usm:
    return Usm.from_passwords("u_sha_aes", usm.AUTH_SHA1, "authpass123", usm.PRIV_AES128, "privpass123")

actor _test_fault_drop_first_n(t: testing.AsyncT):
    """drop_first_n: the lost answer is retried; the SET was applied once and its retry meets the same value"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        r = ok(outs[0], "get")
        testing.assertEqual((r.varbinds, r.attempts), ([VarBind(SYS_DESCR, OctetString(DESCR))], 2))
        testing.assertEqual(vbs_of(outs[1], "get"), [VarBind(e([1, 1, 0]), Integer(42))])
        testing.assertEqual(c.stats().retries, 1)

    run = _FaultRun(t, Faults(drop_first_n=1), None, Community("public"), Options(timeout=0.2, retries=2), check)
    c = run.client()
    cb = run.callback()
    c.get(cb, [SYS_DESCR])
    c.get(cb, [e([1, 1, 0])])
    run.expect(2)

actor _test_fault_wrong_request_id(t: testing.AsyncT):
    """wrong_request_id: the copy with another request-id is dropped, the genuine Response taken"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(vbs_of(outs[0], "get"), [VarBind(SYS_DESCR, OctetString(DESCR))])
        testing.assertEqual(vbs_of(outs[1], "get_next"), [VarBind(e([2, 1, 0]), OctetString(b"hello"))])
        s = c.stats()
        testing.assertEqual((s.drops_unknown_id, s.responses), (2, 2), str(s))

    run = _FaultRun(t, Faults(wrong_request_id=True), None, Community("public"), OPTS, check)
    c = run.client()
    cb = run.callback()
    c.get(cb, [SYS_DESCR])
    c.get_next(cb, [e([1, 1, 0])])
    run.expect(2)

actor _test_net_duplicate(t: testing.AsyncT):
    """Every answer duplicated by the network: each callback exactly once, the copies dropped"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(len(outs), 3, "exactly one callback per request")
        for o in outs:
            testing.assertEqual(vbs_of(o, "get"), [VarBind(SYS_DESCR, OctetString(DESCR))])
        s = c.stats()
        testing.assertEqual((s.responses, s.drops_unknown_id), (3, 3), str(s))

    run = _FaultRun(t, None, NetFaults(duplicate=True, to_address=MANAGER), Community("public"), OPTS, check)
    c = run.client()
    cb = run.callback()
    for _ in range(3):
        c.get(cb, [SYS_DESCR])
    run.quietly(3)

actor _test_net_late(t: testing.AsyncT):
    """Answers delayed beyond the timeout: the late answer to the first attempt completes the request"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        r = ok(outs[0], "get")
        testing.assertEqual((r.varbinds, r.attempts), ([VarBind(SYS_DESCR, OctetString(DESCR))], 2))
        testing.assertTrue(r.rtt >= 0.25, "the rtt of the first attempt: %f" % r.rtt)
        s = c.stats()
        testing.assertEqual((s.responses, s.retries, s.timeouts), (1, 1, 0), str(s))

    run = _FaultRun(t, None, NetFaults(delay=0.3, to_address=MANAGER), Community("public"),
                    Options(timeout=0.2, retries=2), check)
    c = run.client()
    c.get(run.callback(), [SYS_DESCR])
    run.expect(1)

actor _test_fault_not_in_time_window_once(t: testing.AsyncT):
    """SNMPv3: a forced authenticated notInTimeWindows Report makes the Client resynchronise and resend once"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(vbs_of(outs[0], "get"), [VarBind(SYS_DESCR, OctetString(DESCR))])
        testing.assertEqual(vbs_of(outs[1], "get"), [VarBind(e([1, 1, 0]), Integer(42))])
        s = c.stats()
        testing.assertEqual((s.reports, s.timeouts), (2, 0), "discovery and notInTimeWindows: " + str(s))

    run = _FaultRun(t, Faults(report_not_in_time_window_once=True), None, _sha_aes(), OPTS, check)
    c = run.client()
    cb = run.callback()
    c.get(cb, [SYS_DESCR])
    c.get(cb, [e([1, 1, 0])])
    run.expect(2)

actor _test_fault_too_big(t: testing.AsyncT):
    """too_big_over: a GET is split until each part fits, a GETBULK halves max-repetitions, a SET reports tooBig"""
    t.timeout(30.0)
    oids = [e([9, i, 0]) for i in range(1, 9)]

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(vbs_of(outs[0], "split get"), [VarBind(e([9, i, 0]), big(i)) for i in range(1, 9)])
        vbs = vbs_of(outs[1], "halved get_bulk")
        testing.assertTrue(len(vbs) >= 1 and len(vbs) <= 4, "repetitions halved: %d varbinds" % len(vbs))
        testing.assertEqual(vbs, [VarBind(e([9, i, 0]), big(i)) for i in range(2, 2 + len(vbs))])
        testing.assertEqual(status_of(outs[2], "set"), (pdu.TOO_BIG, 0))

    run = _FaultRun(t, Faults(too_big_over=300), None, Community("private"), OPTS, check)
    c = run.client()
    cb = run.callback()
    c.get(cb, oids)
    c.get_bulk(cb, [e([9, 1, 0])], 0, 8)
    c.set(cb, [VarBind(e([20, i, 0]), Integer(i)) for i in range(1, 30)])
    run.expect(3)

