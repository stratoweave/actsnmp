    k1.expect(1)
    k2 = Collector("v3", reported)
    c2.get(k2.cb, [SYS_DESCR])
    k2.expect(1)


# Notifications: Client.trap / trap_v1 / inform to the NotificationReceiver #######################

def block(head: str, lines: list[str]) -> str:
    return "\n".join([head] + lines + ["END"])

actor _NotifyRun(t: testing.AsyncT, users: list[Usm], communities: list[str], want: int,
                 check: proc(list[str], dict[str, int], dict[str, list[Outcome]]) -> None):
    """A NotificationReceiver on RECEIVER:162; checks once want notifications and every expected callback are in"""
    mn = MemNet()
    var blocks: list[str] = []
    var outcomes: dict[str, list[Outcome]] = {}
    var expected = 0
    var traps_done: list[str] = []
    var finished = False
    var rcv: ?NotificationReceiver = None

    proc def _maybe_done() -> None:
        if not finished and len(blocks) >= want and len(outcomes) >= expected:
            finished = True
            st: dict[str, int] = {}
            r = rcv
            if r is not None:
                st = r.stats()
            def run() -> None:
                check(sorted(blocks), st, outcomes)
            report(t, outcome(run))

    def on_notification(r: NotificationReceiver, n: Notification) -> None:
        blocks.append(fmt.canon_notification(n))
        _maybe_done()

    def reported(label: str, outs: list[Outcome]) -> None:
        outcomes[label] = outs
        _maybe_done()

    def trap_done(c: Client, err: ?errors.SnmpError) -> None:
        if err is not None:
            t.failure(AssertionError("trap failed: " + str(err)))
        traps_done.append("x")

    def client(sec: security.Security, port: int) -> Client:
        return Client(None, RECEIVER, sec, None, port=162, opts=OPTS, transport=mn.client(MANAGER, port, RECEIVER, 162))

    def collector(label: str) -> Collector:
        expected += 1
        return Collector(label, reported)

    def trap_cb() -> action(Client, ?errors.SnmpError) -> None:
        return trap_done

    rcv = NotificationReceiver(mn.server(RECEIVER, 162), ReceiverConfig(communities, users, [], h(RECEIVER_ENGINE), 1),
                               on_notification, None)

actor _test_notify_v1_v2c(t: testing.AsyncT):
    """trap_v1, trap and inform over SNMPv1/v2c: delivered, informs acknowledged, canonical blocks as the lab's"""
    t.timeout(30.0)

    def check(blocks: list[str], st: dict[str, int], outcomes: dict[str, list[Outcome]]) -> None:
        r = ok(outcomes["inform"][0], "inform")
        testing.assertEqual(r.varbinds, notify.build_trap_v2(500, notify.TRAP_LINK_DOWN, [VarBind(e([1, 1, 0]), Integer(3))]))
        want = [block('NOTIFICATION v1 TRAP community="public" enterprise=.1.3.6.1.4.1.8072.9999 agent=192.0.2.1 '
                      + 'generic=6 specific=42 uptime=12345 trapoid=.1.3.6.1.4.1.8072.9999.0.42',
                      [".1.3.6.1.4.1.8072.9999.1.1.1.0 = INTEGER: 0"]),
                block('NOTIFICATION v2c INFORM community="public" uptime=500 trapoid=.1.3.6.1.6.3.1.1.5.3',
                      [".1.3.6.1.4.1.8072.9999.1.1.1.0 = INTEGER: 3"]),
                block('NOTIFICATION v2c TRAP2 community="public" uptime=12345 trapoid=.1.3.6.1.6.3.1.1.5.1',
                      ['.1.3.6.1.4.1.8072.9999.1.2.1.0 = STRING: "Hello, SNMP!"'])]
        testing.assertEqual(blocks, sorted(want))
        testing.assertEqual((st["delivered"], st["acked"], st["dropped_community"]), (3, 1, 1), str(st))

    run = _NotifyRun(t, [], ["public"], 3, check)
    v1 = run.client(Community("public", message.SNMP_V1), 42001)
    v2 = run.client(Community("public"), 42002)
    bad = run.client(Community("secret"), 42003)
    tcb = run.trap_cb()
    v1.trap_v1(tcb, ENTERPRISE, b"\xc0\x00\x02\x01", 6, 42, [VarBind(e([1, 1, 0]), Integer(0))], 12345)
    bad.trap(tcb, notify.TRAP_COLD_START, [], 1)
    v2.trap(tcb, notify.TRAP_COLD_START, [VarBind(e([2, 1, 0]), OctetString(b"Hello, SNMP!"))], 12345)
    col = run.collector("inform")
    v2.inform(col.cb, notify.TRAP_LINK_DOWN, [VarBind(e([1, 1, 0]), Integer(3))], 500)
    col.expect(1)

actor _NotifyV3(t: testing.AsyncT, auth: str):
    """Every lab user with authentication protocol auth sends an SNMPv3 trap and an inform to the receiver"""
    users = lab_users(auth)

    def check(blocks: list[str], st: dict[str, int], outcomes: dict[str, list[Outcome]]) -> None:
        want: list[str] = []
        for i in range(len(users)):
            u = users[i]
            head = 'user="' + u.user + '" level=' + usm.level_text(u.level()) + ' context=""'
            line = [".1.3.6.1.4.1.8072.9999.1.1.1.0 = INTEGER: %d" % i]
            want.append(block("NOTIFICATION v3 TRAP2 " + head + " uptime=%d trapoid=.1.3.6.1.6.3.1.1.5.4" % (1000 + i),
                              line))
            want.append(block("NOTIFICATION v3 INFORM " + head + " uptime=%d trapoid=.1.3.6.1.6.3.1.1.5.3" % (2000 + i),
                              line))
            ok(outcomes[u.user][0], u.user + ": inform")
        testing.assertEqual(blocks, sorted(want))
        testing.assertEqual((st["delivered"], st["acked"], st["internal_errors"]), (2 * len(users), len(users), 0),
                            str(st))

    run = _NotifyRun(t, users, [], 2 * len(users), check)
    tcb = run.trap_cb()
    for i in range(len(users)):
        u = users[i]
        c = run.client(u, 43000 + i)
        c.trap(tcb, notify.TRAP_LINK_UP, [VarBind(e([1, 1, 0]), Integer(i))], 1000 + i)
        col = run.collector(u.user)
        c.inform(col.cb, notify.TRAP_LINK_DOWN, [VarBind(e([1, 1, 0]), Integer(i))], 2000 + i)
        col.expect(1)

