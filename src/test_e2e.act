"""End-to-end tests: the real Client against the real Agent and NotificationReceiver over MemNet

Nothing is scripted on the wire, so every byte is produced and checked by
the library itself. Requests of one Client complete in order
(max_in_flight 1), so a Collector records the outcomes in order. The
watchdog timeouts are generous because the Reeder key extension runs a
password-to-key round per localization.
"""

import logging
import testing
import time

import ber
import errors
import fmt
import message
import notify
import pdu
import security
import usm
from agent import Agent, AgentConfig, Faults
from client import Client, EngineInfo, Options, Response, error_response
from mibview import MibView, WriteRule
from notify import Notification
from oid import Oid
from receiver import NotificationReceiver, ReceiverConfig
from security import Community, Usm
from transport import MemNet, NetFaults, ServerTransport
from values import Counter32, Counter64, EndOfMibView, Gauge32, Integer, IpAddress, NoSuchInstance, NoSuchObject
from values import ObjectIdentifier, OctetString, TimeTicks, Value, VarBind
from testutil import h, outcome, report

AGENT = "10.0.0.1"
MANAGER = "10.0.0.2"
RECEIVER = "10.0.0.9"
AGENT_ENGINE = "80001f88806532652d6167656e74"
RECEIVER_ENGINE = "80001f8880616374736e6d7072"
AGENT_BOOTS = 5

# Seconds to wait to see that nothing more arrives
QUIET = 0.2

# Every request waits up to 2 s (no retries) unless a test says otherwise; MemNet loses nothing
OPTS = Options(timeout=2.0, retries=0)

# A copy of interop/config/users.tsv (without its header): every authentication protocol with
