actor _test_v3_agent_reboot(t: testing.AsyncT):
    """The agent reboots (boots + 1), then changes its engine ID: the Client resynchronises, then rediscovers"""
    t.timeout(30.0)
    u = _sha_aes()
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([u]), t.log_handler)
    c = _client(mn, u, 40001, OPTS, t.log_handler)
    new_engine = h("80001f888001020304050607")
    var step = 0

    def fail(what: str, r: ?Response, err: ?errors.SnmpError) -> bool:
        if err is not None:
            t.failure(AssertionError(what + ": " + str(err)))
            return True
        return False

    def third(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        if fail("after the engine ID change", r, err):
            return
        info = c.engine_info()
        s = c.stats()
        def check() -> None:
            testing.assertEqual(vbs_of(Outcome(r, err), "get"), [VarBind(SYS_DESCR, OctetString(DESCR))])
            if info is not None:
                testing.assertEqual((info.engine_id, info.boots), (new_engine, 1))
            else:
                raise AssertionError("no engine info")
            # discovery, notInTimeWindows after the reboot, unknownEngineIDs, discovery again
            testing.assertEqual((s.reports, s.timeouts), (4, 0), str(s))
        report(t, outcome(check))

    def second(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        if fail("after the reboot", r, err):
            return
        boots = -1
        info = c.engine_info()
        if info is not None:
            boots = info.boots
        if boots != AGENT_BOOTS + 1:
            t.failure(AssertionError("boots not learned after the reboot: %d" % boots))
            return
        agent.reboot(1, new_engine)
        c.get(third, [SYS_DESCR])

    def first(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        if fail("first get", r, err):
            return
        agent.reboot()
        c.get(second, [SYS_DESCR])

    c.get(first, [SYS_DESCR])

actor _test_v3_agent_restart_boots_lost(t: testing.AsyncT):
    """The agent restarts without its boots (5 before, 1 after, its time from 0 again, as the lab's snmpd does
    after a docker restart): two requests in flight both get authenticated notInTimeWindows Reports that fail
    RFC 3414 3.2 step 7b; the Client resynchronises from the first, the second is then in the
    window, and both are resent: no request is lost"""
    t.timeout(30.0)
    u = _sha_aes()
    mn = MemNet()
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([u]), t.log_handler)
    c = _client(mn, u, 40001, OPTS.with_(max_in_flight=2), t.log_handler)

    def reported(label: str, outs: list[Outcome]) -> None:
        info = c.engine_info()
        s = c.stats()
        def run() -> None:
            testing.assertEqual(len(outs), 3, "one callback per request")
            testing.assertEqual(vbs_of(outs[0], "before the restart"), [VarBind(SYS_DESCR, OctetString(DESCR))])
            r1 = ok(outs[1], "first request after the restart")
            testing.assertEqual((r1.varbinds, r1.attempts), ([VarBind(SYS_DESCR, OctetString(DESCR))], 2))
            r2 = ok(outs[2], "second request after the restart")
            testing.assertEqual((r2.varbinds, r2.attempts), ([VarBind(e([1, 1, 0]), Integer(42))], 2))
            if info is not None:
                testing.assertEqual((info.engine_id, info.boots), (h(AGENT_ENGINE), 1))
                testing.assertTrue(info.time < 10, "time %d" % info.time)
            else:
                raise AssertionError("no engine info")
            # discovery and the two notInTimeWindows Reports; nothing dropped, nothing timed out
            testing.assertEqual((s.reports, s.timeouts, s.drops_auth, s.retries), (3, 0, 0, 0), str(s))
        report(t, outcome(run))

    col = Collector("restart", reported)

    def first(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        col.cb(cl, r, err)
        agent.reboot(1)
        c.get(col.cb, [SYS_DESCR])
        c.get(col.cb, [e([1, 1, 0])])

    c.get(first, [SYS_DESCR])
    col.expect(3)

actor _test_fault_too_big_v3(t: testing.AsyncT):
    """SNMPv3 authPriv with too_big_over: the GET is split into new exchanges and merged in order"""
    t.timeout(30.0)

    def check(outs: list[Outcome], c: Client) -> None:
        testing.assertEqual(vbs_of(outs[0], "split get"), [VarBind(e([9, i, 0]), big(i)) for i in range(1, 9)])
        testing.assertEqual(c.stats().timeouts, 0)

    run = _FaultRun(t, Faults(too_big_over=500), None, _sha_aes(), OPTS, check)
    c = run.client()
    c.get(run.callback(), [e([9, i, 0]) for i in range(1, 9)])
    run.expect(1)

actor _test_inform_retransmission_dedup(t: testing.AsyncT):
    """A v2c inform whose Response is lost is retransmitted; the receiver's dedup_window delivers it once"""
    t.timeout(30.0)
    mn = MemNet(NetFaults(drop_first_n=1, to_address=MANAGER))
    var got: list[Notification] = []

    def on_n(r: NotificationReceiver, n: Notification) -> None:
        got.append(n)

    rcv = NotificationReceiver(mn.server(RECEIVER, 162), ReceiverConfig(["public"], [], [], h(RECEIVER_ENGINE), 1, 60.0),
                               on_n, t.log_handler)
    c = Client(None, RECEIVER, Community("public"), t.log_handler, port=162, opts=Options(timeout=0.2, retries=2),
               transport=mn.client(MANAGER, 42001, RECEIVER, 162))

    def done(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        st = rcv.stats()
        def check() -> None:
            resp = ok(Outcome(r, err), "inform")
            testing.assertEqual(resp.attempts, 2)
            testing.assertEqual(len(got), 1, "delivered once")
            testing.assertEqual((st["delivered"], st["duplicates"], st["acked"]), (1, 1, 2), str(st))
        report(t, outcome(check))

    c.inform(done, notify.TRAP_LINK_DOWN, [VarBind(e([1, 1, 0]), Integer(3))], 500)

actor _test_discovery_budgets(t: testing.AsyncT):
    """Discovery keeps each request's own budget: a long one outlives a short Client default, a short one fails early"""
    t.timeout(30.0)
    u = _sha_aes()
    mn = MemNet(NetFaults(delay=0.5, to_address=MANAGER))
    agent = Agent(mn.server(AGENT, 161), make_view(), agent_config([u]), t.log_handler)
    # the Client's default would give up after 0.05 s; the agent's answers take 0.5 s
    c = _client(mn, u, 40001, Options(timeout=0.05, retries=0, max_in_flight=2), t.log_handler)
    var log: list[str] = []
    var short_elapsed = 0.0
    var started = 0.0

    def check() -> None:
        testing.assertEqual(sorted(log), ["long:ok", "short:timeout"])
        testing.assertTrue(short_elapsed < 0.45, "the short request failed after %.3f s" % short_elapsed)

    def note(what: str) -> None:
        log.append(what)
        if len(log) == 2:
            report(t, outcome(check))

    def long_done(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        note("long:" + ("ok" if err is None else str(err)))

    def short_done(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        short_elapsed = float(time.monotonic_ns()) / 1e9 - started
        note("short:" + ("timeout" if isinstance(err, errors.TimeoutError) else describe(Outcome(r, err))))

    started = float(time.monotonic_ns()) / 1e9
    c.get(long_done, [SYS_DESCR], Options(timeout=3.0, retries=0))
    c.get(short_done, [SYS_DESCR], Options(timeout=0.2, retries=0))


# Logging ##########################################################################################

actor _LogLines():
    var texts: list[str] = []

    def add(text: str) -> None:
        texts.append(text)

    def all() -> list[str]:
        return texts

class _CaptureSink(logging.Sink):
    # Every formatted message, with its data, goes to a _LogLines actor
    def __init__(self, lines: _LogLines):
        logging.Sink.__init__(self)
        self.lines = lines

    def handle(self, m: logging.Message):
        text = self.formatter.format(m)
        if text is not None:
            data = m.data
            if data is not None:
                text += " - " + str(data)
            self.lines.add(text)

actor _test_logs_never_show_secrets(t: testing.AsyncT):
    """Client, Agent and NotificationReceiver logging at every level never show a community or a key"""
    t.timeout(30.0)
    secret = "s3cr3t-community"
    lines = _LogLines()
    handler = logging.Handler("e2e")
    handler.add_sink(_CaptureSink(lines))
    handler.set_output_level(logging.ALL)
    u = _sha_aes()
    mn = MemNet()
    cfg = AgentConfig({secret: True}, [u], h(AGENT_ENGINE), AGENT_BOOTS, write_rules())
    agent = Agent(mn.server(AGENT, 161), make_view(), cfg, handler)
    var got = 0
    var done_count = 0

    def on_n(r: NotificationReceiver, n: Notification) -> None:
        got += 1
        maybe_done()

    def check() -> None:
        texts = lines.all()
        testing.assertTrue(len(texts) > 10, "something was logged")
        joined = "\n".join(texts)
        for bad in [secret, secret.encode().hex(), u.auth_ku.hex(), u.priv_ku.hex(), "authpass123", "privpass123"]:
            testing.assertFalse(bad in joined, "found " + bad)

    def maybe_done() -> None:
        if got == 4 and done_count == 4:
            after now QUIET: report(t, outcome(check))

    def req_done(cl: Client, r: ?Response, err: ?errors.SnmpError) -> None:
        if err is not None:
            t.failure(AssertionError(str(err)))
            return
        done_count += 1
        maybe_done()

    def trap_done(cl: Client, err: ?errors.SnmpError) -> None:
        if err is not None:
            t.failure(AssertionError(str(err)))

    rcv = NotificationReceiver(mn.server(RECEIVER, 162), ReceiverConfig([secret], [u], [], h(RECEIVER_ENGINE), 1),
                               on_n, handler)
    c2 = _client(mn, Community(secret), 40001, OPTS, handler)
    c2.get(req_done, [SYS_DESCR])
    c2.set(req_done, [VarBind(e([1, 1, 0]), Integer(5))])
    c3 = _client(mn, u, 40002, OPTS, handler)
    c3.get(req_done, [SYS_DESCR])
    n1 = Client(None, RECEIVER, Community(secret, message.SNMP_V1), handler, port=162, opts=OPTS,
                transport=mn.client(MANAGER, 42001, RECEIVER, 162))
    n1.trap_v1(trap_done, ENTERPRISE, b"\xc0\x00\x02\x01", 6, 1, [VarBind(e([1, 1, 0]), Integer(1))], 1)
    n2 = Client(None, RECEIVER, Community(secret), handler, port=162, opts=OPTS,
                transport=mn.client(MANAGER, 42002, RECEIVER, 162))
    n2.trap(trap_done, notify.TRAP_COLD_START, [], 1)
    n3 = Client(None, RECEIVER, u, handler, port=162, opts=OPTS, transport=mn.client(MANAGER, 42003, RECEIVER, 162))
    n3.trap(trap_done, notify.TRAP_COLD_START, [], 1)
    n3.inform(req_done, notify.TRAP_LINK_DOWN, [VarBind(e([1, 1, 0]), Integer(3))], 2)
