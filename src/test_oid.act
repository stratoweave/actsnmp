"""Tests for oid"""

import testing
from oid import Oid
from testutil import Lcg

def parse_fails(s: str) -> None:
    try:
        Oid.parse(s)
        testing.error("Oid.parse(%r) did not raise" % s)
    except ValueError:
        pass

def op(s: str) -> Oid:
    return Oid.parse(s)

def _test_parse_and_format() -> None:
    o = Oid.parse("1.3.6.1.2.1.1.1.0")
    testing.assertEqual(o.arcs, [1, 3, 6, 1, 2, 1, 1, 1, 0])
    testing.assertEqual(str(o), "1.3.6.1.2.1.1.1.0")
    testing.assertEqual(o.dotted(), ".1.3.6.1.2.1.1.1.0")
    testing.assertEqual(repr(o), "Oid(1.3.6.1.2.1.1.1.0)")
    testing.assertEqual(Oid.parse(".1.3.6.1.2.1.1.1.0"), o)
    testing.assertEqual(Oid.parse("1.3.6.1.4.1.4294967295").arcs, [1, 3, 6, 1, 4, 1, 4294967295])
    testing.assertEqual(Oid.parse("0").arcs, [0])
    testing.assertEqual(Oid.parse("1.3.6.1.4.1.0000000042").arcs, [1, 3, 6, 1, 4, 1, 42])
    # parse accepts what Oid accepts; encoding applies the first-arc rules
    testing.assertEqual(Oid.parse("3.99").arcs, [3, 99])
    testing.assertEqual(str(Oid([])), "")
    testing.assertEqual(Oid([]).dotted(), ".")

def _test_parse_rejects() -> None:
    for s in ["", ".", "..1", "1..3", "1.3.", ".1.3.", "a.b", "1.3.x", "1.-3", "-1.3", "+1.3", " 1.3", "1.3 ",
              "1. 3", "1.4294967296", "1.99999999999", "1.3.6.1.2.1.1.1.0x", "0x1.3", "1,3", "1.3\n", "١.٣"]:
        parse_fails(s)

def _test_constructor_validates() -> None:
    for arcs in [[-1], [1, 3, 4294967296], [1, -5]]:
        try:
            Oid(arcs)
            testing.error("Oid(%s) did not raise" % str(arcs))
        except ValueError:
            pass
    testing.assertEqual(Oid([0, 4294967295]).arcs, [0, 4294967295])

def _test_equality() -> None:
    testing.assertEqual(op("1.3.6.1"), Oid([1, 3, 6, 1]))
    testing.assertNotEqual(op("1.3.6.1"), op("1.3.6.1.0"))
    testing.assertNotEqual(op("1.3.6.1"), op("1.3.6.2"))
    testing.assertTrue(op("1.3") == op(".1.3"))
    testing.assertTrue(op("1.3") != op("1.4"))
    testing.assertEqual(Oid([]), Oid([]))

def _test_ordering() -> None:
    a = op("1.3.6.1.2.1.1")
    b = op("1.3.6.1.2.1.1.1.0")
    c = op("1.3.6.1.2.1.1.10.0")
    d = op("1.3.6.1.4.1.16383")
    e = op("1.3.6.1.4.1.16384")
    f = op("1.3.6.1.4.1.4294967295")
    testing.assertTrue(a < b, "prefix sorts first")
    testing.assertTrue(b < c, "1 < 10 numerically, not textually")
    testing.assertTrue(d < e, "16383 < 16384 (bytewise BER would disagree)")
    testing.assertTrue(e < f)
    testing.assertTrue(Oid([]) < op("0"))
    testing.assertTrue(op("2") > op("1.3.6"))
    testing.assertTrue(a <= a and a >= a and not (a < a) and not (a > a))
    testing.assertTrue(c > b and c >= b and b <= c)
    testing.assertEqual(sorted([f, c, e, a, d, b]), [a, b, c, d, e, f])
    testing.assertEqual(min([c, a, b], None), a)
    testing.assertEqual(max([c, a, b], None), c)

def _test_hash_and_dict() -> None:
    d = {op("1.3.6.1.2.1.1.1.0"): "sysDescr", op("1.3.6.1.2.1.1.3.0"): "sysUpTime"}
    testing.assertEqual(d[Oid([1, 3, 6, 1, 2, 1, 1, 1, 0])], "sysDescr")
    testing.assertTrue(op(".1.3.6.1.2.1.1.3.0") in d)
    testing.assertFalse(op("1.3.6.1.2.1.1.3") in d)
    testing.assertEqual(hash(op("1.3.6.1")), hash(Oid([1, 3, 6, 1])))
    # the hash packs two arcs per update and starts with the length: OIDs whose packed arcs
    # coincide still hash apart, and odd and even lengths work
    testing.assertNotEqual(hash(Oid([5])), hash(Oid([0, 5])))
    testing.assertNotEqual(hash(Oid([1, 0])), hash(Oid([1, 0, 0])))
    testing.assertNotEqual(hash(Oid([])), hash(Oid([0])))
    keys = [Oid([1, 3, 6, 1, 2, 1, 2, 2, 1, 2, i]) for i in range(200)] + [Oid([i]) for i in range(50)] + [Oid([])]
    big: dict[Oid, int] = {}
    for i, k in enumerate(keys):
        big[k] = i
    testing.assertEqual(len(big), len(keys))
    for i, k in enumerate(keys):
        testing.assertEqual(big[Oid(k.arcs.copy())], i, str(k))
    s = {op("1.3"), op(".1.3"), op("1.3.0"), Oid([1, 3])}
    testing.assertEqual(len(s), 2)
    testing.assertTrue(op("1.3.0") in s)
    testing.assertEqual(sorted(list(s)), [op("1.3"), op("1.3.0")])

def _test_len_and_iter() -> None:
    o = op("1.3.6.1.2")
    testing.assertEqual(len(o), 5)
    testing.assertEqual(len(Oid([])), 0)
    testing.assertEqual([a for a in o], [1, 3, 6, 1, 2])
    total = 0
    for a in o:
        total += a
    testing.assertEqual(total, 13)

def _test_prefix_ops() -> None:
    root = op("1.3.6.1.2.1.2.2.1")
    inst = op("1.3.6.1.2.1.2.2.1.2.7")
    testing.assertTrue(inst.startswith(root))
    testing.assertTrue(inst.startswith(inst))
    testing.assertTrue(inst.startswith(Oid([])))
    testing.assertFalse(root.startswith(inst))
    testing.assertFalse(op("1.3.6.1.2.1.2.2.10").startswith(root))
    testing.assertTrue(root.is_prefix_of(inst))
    testing.assertFalse(inst.is_prefix_of(root))
    testing.assertEqual(inst.suffix(root), [2, 7])
    testing.assertEqual(inst.suffix(inst), [])
    testing.assertEqual(inst.suffix(Oid([])), inst.arcs)
    try:
        root.suffix(inst)
        testing.error("suffix of a non-prefix did not raise")
    except ValueError:
        pass
    try:
        op("1.3.6.1.2.1.2.2.10.1").suffix(root)
        testing.error("suffix of a sibling did not raise")
    except ValueError:
        pass

def _test_child_parent_sibling() -> None:
    o = op("1.3.6.1.2.1.2.2.1.2")
    testing.assertEqual(o.child([7]), op("1.3.6.1.2.1.2.2.1.2.7"))
    testing.assertEqual(o.child([]), o)
    testing.assertEqual(o.child([1, 2, 3]).arcs, o.arcs + [1, 2, 3])
    testing.assertEqual(o.arcs, [1, 3, 6, 1, 2, 1, 2, 2, 1, 2], "child does not modify the parent")
    try:
        o.child([4294967296])
        testing.error("child with arc 2^32 did not raise")
    except ValueError:
        pass
    testing.assertEqual(o.parent(), op("1.3.6.1.2.1.2.2.1"))
    testing.assertEqual(op("1").parent(), Oid([]))
    try:
        Oid([]).parent()
        testing.error("parent of an empty OID did not raise")
    except ValueError:
        pass
    sib = o.next_sibling()
    testing.assertEqual(sib, op("1.3.6.1.2.1.2.2.1.3"))
    testing.assertEqual(o.arcs[9], 2, "next_sibling does not modify the OID")
    testing.assertNone(op("1.3.6.1.4294967295").next_sibling())
    testing.assertNone(Oid([]).next_sibling())
    # every OID in the subtree lies strictly between the root and its next sibling
    if sib is not None:
        for x in [o.child([0]), o.child([4294967295, 4294967295]), o.child([1, 2, 3])]:
            testing.assertTrue(o < x and x < sib, str(x))

def _test_key() -> None:
    testing.assertEqual(op("1.3").key(), b"\x00\x00\x00\x01\x00\x00\x00\x03")
    testing.assertEqual(op("1.4294967295").key(), b"\x00\x00\x00\x01\xff\xff\xff\xff")
    testing.assertEqual(Oid([]).key(), b"")
    oids = [op("1.3.6.1.4.1.16384"), op("1.3.6.1.4.1.16383"), op("1.3.6.1.4.1"), op("1.3.6.1.4.1.16383.0"),
            op("1.3.6.1.4.1.256"), op("1.3.6.1.4.1.255"), op("1.3.6.1.4.1.4294967295"), op("1.3.6.1.4.2"), op("0.0")]
    for a in oids:
        for b in oids:
            testing.assertEqual(a < b, a.key() < b.key(), "key order of %s and %s" % (str(a), str(b)))
            testing.assertEqual(a == b, a.key() == b.key())

def _test_key_order_random() -> None:
    rnd = Lcg(12345)
    choices = [0, 1, 127, 128, 255, 256, 16383, 16384, 4294967295]
    oids: list[Oid] = []
    for i in range(200):
        arcs: list[int] = []
        for j in range(1 + rnd.below(6)):
            arcs.append(choices[rnd.below(len(choices))])
        oids.append(Oid(arcs))
    for i in range(len(oids) - 1):
        a = oids[i]
        b = oids[i + 1]
        testing.assertEqual(a < b, a.key() < b.key(), "key order of %s and %s" % (str(a), str(b)))
