"""Tests for notify

MSG_M and MSG_N are the reference linkDown Trap and SNMPv2-Trap packets.
The RFC 3584 conversions (NETSNMP_*) were recorded from net-snmp 5.9.4's
snmptrapd, which hands converted traps to a traphandle script. pysnmp's
v1_to_v2() is not a reference: it orders and adds the extra varbinds
differently. The other messages were encoded independently with pysnmp.
"""

import testing
import ber
import errors
import message
import notify
import pdu
import usm
from message import CommunityMessage, V3Message, ScopedPdu, UsmSecurityParameters
from notify import Notification
from oid import Oid
from pdu import Pdu, TrapV1Pdu
from values import VarBind, Value, Integer, OctetString, Null, ObjectIdentifier, IpAddress, TimeTicks
from values import Counter32, NoSuchObject
from testutil import h, value_fails

def o(s: str) -> Oid:
    return Oid.parse(s)

def vb(oid: str, v: Value) -> VarBind:
    return VarBind(Oid.parse(oid), v)

MSG_M = """30 3d 02 01 00 04 06 70 75 62 6c 69 63 a4 30 06 0a 2b 06 01 04 01 bf 08 03 02 0a 40 04 c0 00 02 01
02 01 02 02 01 00 43 03 01 e2 40 30 11 30 0f 06 0a 2b 06 01 02 01 02 02 01 01 03 02 01 03"""
MSG_N = """30 75 02 01 01 04 06 70 75 62 6c 69 63 a7 68 02 01 2a 02 01 00 02 01 00 30 5d
30 0f 06 08 2b 06 01 02 01 01 03 00 43 03 01 e2 40
30 17 06 0a 2b 06 01 06 03 01 01 04 01 00 06 09 2b 06 01 06 03 01 01 05 03
30 0f 06 0a 2b 06 01 02 01 02 02 01 01 03 02 01 03
30 0f 06 0a 2b 06 01 02 01 02 02 01 07 03 02 01 02
30 0f 06 0a 2b 06 01 02 01 02 02 01 08 03 02 01 02"""
MSG_M_AS_V2 = """30819602010104067075626c6963a7818802012a020100020100307d300f06082b06010201010300430301e240
3017060a2b06010603010104010006092b0601060301010503300f060a2b060102010202010103020103
301106092b06010603120103004004c0000201301306092b060106031201040004067075626c6963
3018060a2b060106030101040300060a2b06010401bf0803020a"""
MSG_V3_TRAP = """308194020103300e020107020300ffe30401000201030420301e0408800000000102030402010102010c0408755f6e6f
6175746804000400305d040880000000010203040403637478a74c0201630201000201003041300f06082b06010201
01030043032dcaaa301a060a2b060106030101040100060c2b06010401bf08ce0f0300163012060d2b06010401bf08
ce0f01010100020100"""
MSG_TRAP_3E9 = "302d02010004067075626c6963a42006092b06010401bf08ce0f4004c0000201020106020500b2d05e004301643000"
MSG_INFORM = """305e02010104067075626c6963a651020312d6870201000201003044301106082b06010201010300430500ffffffff
301a060a2b060106030101040100060c2b06010401bf08ce0f0300073013060d2b06010401bf08ce0f0101020004026869"""
