# Shape checks ######################################################################################

actor _test_shape_checks(t: testing.AsyncT):
    """GET/SET/INFORM responses must match count and OIDs (strict), GETNEXT the count, GETBULK the limit"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var step = 0
    var results: list[str] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _pdu(req).varbinds
        if step == 0 or step == 1:      # GET answered with another OID (strict, then lenient)
            p.server.send_to(_reply(req, [VarBind(Oid.parse("1.3.6.1.9.9"), Integer(1))] + _answer(vbs[1:])), address, port)
        elif step == 2:                 # GET answered with one varbind too few
            p.server.send_to(_reply(req, _answer(vbs[1:])), address, port)
        elif step == 3:                 # GETNEXT answered with one varbind too many
            p.server.send_to(_reply(req, _answer_next(vbs) + _answer_next(vbs[:1])), address, port)
        elif step == 4:                 # GETBULK N=1, M=2, R=1: at most 3 varbinds
            p.server.send_to(_reply(req, _answer_next(vbs + vbs)), address, port)
        else:                           # GETNEXT with other OIDs is fine
            p.server.send_to(_reply(req, _answer_next(vbs)), address, port)

    def outcome(r: ?Response, e: ?errors.SnmpError) -> str:
        if e is not None:
            return "invalid" if isinstance(e, errors.InvalidResponseError) else "error: " + str(e)
        return "ok"

    def check() -> None:
        testing.assertEqual(results, ["invalid", "ok", "invalid", "invalid", "invalid", "ok"])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        results.append(outcome(r, e))
        step += 1
        if step == 1:
            c.get(done, _oids(2), SLOW.with_(strict_response_oids=False))
        elif step == 2:
            c.get(done, _oids(2))
        elif step == 3:
            c.get_next(done, _oids(2))
        elif step == 4:
            c.get_bulk(done, _oids(2), 1, 2)
        elif step == 5:
            c.get_next(done, _oids(2))
        else:
            _finish(t, check)

    p.server.set_receiver(on_request)
    c.get(done, _oids(2))


# tooBig and splitting ###############################################################################

actor _test_too_big_split(t: testing.AsyncT):
    """tooBig for more than one varbind splits the GET in halves, recursively, and merges the answers"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    oids = _oids(5)
    var sizes: list[int] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _pdu(req).varbinds
        sizes.append(len(vbs))
        if len(vbs) > 1:
            p.server.send_to(_reply(req, [], pdu.TOO_BIG, 0), address, port)
        else:
            p.server.send_to(_reply(req, _answer(vbs)), address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(resp.varbinds, _answer([VarBind(o) for o in oids]))
        testing.assertEqual(sizes, [5, 2, 1, 1, 3, 1, 2, 1, 1])
        testing.assertEqual(resp.attempts, 9)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get(done, oids)


actor _test_too_big_single_and_set(t: testing.AsyncT):
    """tooBig for one varbind is an error; a SET is never split (40 varbinds in one PDU, tooBig reported)"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var sizes: list[int] = []
    var statuses: list[int] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        sizes.append(len(_pdu(req).varbinds))
        p.server.send_to(_reply(req, [], pdu.TOO_BIG, 0), address, port)

    def status_of(r: ?Response, e: ?errors.SnmpError) -> int:
        if isinstance(e, errors.ErrorStatusError):
            resp = error_response(e)
            if resp is not None:
                return resp.error_status
        return -1

    def check() -> None:
        testing.assertEqual(statuses, [pdu.TOO_BIG, pdu.TOO_BIG])
        testing.assertEqual(sizes, [1, 40])

    def set_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        statuses.append(status_of(r, e))
        _finish(t, check)

    def get_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        statuses.append(status_of(r, e))
        c.set(set_done, [VarBind(o, Integer(1)) for o in _oids(40)])

    p.server.set_receiver(on_request)
    c.get(get_done, _oids(1))


actor _test_max_oids_per_request(t: testing.AsyncT):
    """5 OIDs with max_oids_per_request 2 go out as 2 + 2 + 1, merged in order; an error index maps back"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW.with_(max_oids_per_request=2), transport=p.client)
    oids = _oids(5)
    var sizes: list[int] = []
    var fail_part = False

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _pdu(req).varbinds
        sizes.append(len(vbs))
        if fail_part and vbs[0].oid == oids[2]:
            p.server.send_to(_reply(req, vbs, pdu.GEN_ERR, 2), address, port)
        else:
            p.server.send_to(_reply(req, _answer(vbs)), address, port)

    def check_error(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.ErrorStatusError):
            testing.assertEqual((err.status, err.index), (pdu.GEN_ERR, 4), "index of the caller's 4th varbind")
            testing.assertEqual(err.oid, oids[3].arcs)
            resp = error_response(err)
            if resp is not None:
                testing.assertEqual(len(resp.varbinds), 5)
                testing.assertEqual(resp.varbinds[0], VarBind(oids[0], _val(oids[0])))
                testing.assertEqual(resp.error_index, 4)
            else:
                testing.error("no Response")
        else:
            testing.error("not an ErrorStatusError: " + str(err))
        testing.assertEqual(sizes, [2, 2, 1, 2, 2])

    def failed_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check_error(r, e))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        try:
            resp = _ok(r, e)
            testing.assertEqual(resp.varbinds, _answer([VarBind(o) for o in oids]))
            testing.assertEqual(sizes, [2, 2, 1])
            testing.assertEqual(resp.attempts, 3)
        except Exception as ex:
            t.failure(ex)
            return
        fail_part = True
        c.get(failed_done, oids)

    p.server.set_receiver(on_request)
    c.get(done, oids)


actor _test_bulk_too_big_halves(t: testing.AsyncT):
    """A tooBig GETBULK is resent with half the max-repetitions until it fits"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var reps: list[int] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        q = _pdu(req)
        reps.append(q.max_repetitions())
        if q.max_repetitions() > 2:
            p.server.send_to(_reply(req, [], pdu.TOO_BIG, 0), address, port)
        else:
            p.server.send_to(_reply(req, _answer_next(q.varbinds + q.varbinds)), address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(reps, [9, 4, 2])
        testing.assertEqual(len(resp.varbinds), 2)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get_bulk(done, _oids(1), 0, 9)


actor _test_too_big_no_split(t: testing.AsyncT):
    """Options.split_too_big=False: tooBig fails a 5-varbind GET and a GETBULK at once, nothing is split or halved

    The CLI uses it, so its get and bulkget report tooBig as net-snmp's tools do.
    """
    mn = MemNet()
    p = mem_pair(mn)
    opts = SLOW.with_(split_too_big=False)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=opts, transport=p.client)
    var sizes: list[int] = []
    var reps: list[int] = []
    var statuses: list[(int, int)] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        q = _pdu(req)
        sizes.append(len(q.varbinds))
        if q.pdu_type == pdu.GETBULK:
            reps.append(q.max_repetitions())
        p.server.send_to(_reply(req, [], pdu.TOO_BIG, 0), address, port)

    def status_of(e: ?errors.SnmpError) -> (int, int):
        if isinstance(e, errors.ErrorStatusError):
            return (e.status, e.index)
        return (-1, -1)

    def check() -> None:
        testing.assertEqual(statuses, [(pdu.TOO_BIG, 0), (pdu.TOO_BIG, 0)])
        testing.assertEqual(sizes, [5, 1])
        testing.assertEqual(reps, [9])
        testing.assertTrue(Options().split_too_big)
        testing.assertFalse(opts.with_(retries=2).split_too_big)

    def bulk_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        statuses.append(status_of(e))
        _finish(t, check)

    def get_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        statuses.append(status_of(e))
        c.get_bulk(bulk_done, _oids(1), 0, 9)

    p.server.set_receiver(on_request)
    c.get(get_done, _oids(5))


# SNMPv1 normalisation ##############################################################################

actor _test_v1_bulk_as_getnext(t: testing.AsyncT):
    """SNMPv1 has no GETBULK: it is sent as a GETNEXT of the OIDs with zero fields"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public", message.SNMP_V1), t.log_handler, opts=SLOW, transport=p.client)
    var seen: list[CommunityMessage] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        seen.append(req)
        p.server.send_to(_reply(req, _answer_next(_pdu(req).varbinds)), address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        req = seen[0]
        q = _pdu(req)
        testing.assertEqual((req.version, q.pdu_type, q.error_status, q.error_index), (message.SNMP_V1, pdu.GETNEXT, 0, 0))
        testing.assertEqual(resp.varbinds, _answer_next([VarBind(o) for o in _oids(2)]))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get_bulk(done, _oids(2), 0, 10)


actor _test_v1_get_no_such_name_fixed(t: testing.AsyncT):
    """SNMPv1 GET: noSuchName drops that varbind, resends the rest and reports NoSuchObject for it"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public", message.SNMP_V1), t.log_handler, opts=SLOW, transport=p.client)
    oids = _oids(4)
    missing = [oids[1], oids[3]]
    var sizes: list[int] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _pdu(req).varbinds
        sizes.append(len(vbs))
        for i in range(len(vbs)):
            if vbs[i].oid in missing:
                p.server.send_to(_reply(req, vbs, pdu.NO_SUCH_NAME, i + 1), address, port)
                return
        p.server.send_to(_reply(req, _answer(vbs)), address, port)

    def check_unfixed(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.ErrorStatusError):
            testing.assertEqual((err.status, err.index), (pdu.NO_SUCH_NAME, 2))
            testing.assertEqual(err.oid, oids[1].arcs)
        else:
            testing.error("not an ErrorStatusError: " + str(err))

    def unfixed_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check_unfixed(r, e))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        try:
            resp = _ok(r, e)
            testing.assertEqual(resp.varbinds, [VarBind(oids[0], _val(oids[0])), VarBind(oids[1], NoSuchObject()),
                                                VarBind(oids[2], _val(oids[2])), VarBind(oids[3], NoSuchObject())])
            testing.assertEqual(sizes, [4, 3, 2])
            testing.assertEqual(resp.error_status, 0)
        except Exception as ex:
            t.failure(ex)
            return
        c.get(unfixed_done, oids, SLOW.with_(v1_fix_errors=False))

    p.server.set_receiver(on_request)
    c.get(done, oids)


actor _test_v1_getnext_no_such_name_end(t: testing.AsyncT):
    """SNMPv1 GETNEXT: noSuchName (end of MIB) becomes EndOfMibView for that varbind; a lone one needs no resend"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public", message.SNMP_V1), t.log_handler, opts=SLOW, transport=p.client)
    last = Oid.parse("1.3.6.1.9.9.9")
    first = _oids(1)[0]
    var sizes: list[int] = []
    var got: list[Response] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _pdu(req).varbinds
        sizes.append(len(vbs))
        for i in range(len(vbs)):
            if vbs[i].oid == last:
                p.server.send_to(_reply(req, vbs, pdu.NO_SUCH_NAME, i + 1), address, port)
                return
        p.server.send_to(_reply(req, _answer_next(vbs)), address, port)

    def check() -> None:
        testing.assertEqual(got[0].varbinds, [VarBind(_successor(first), _val(_successor(first))),
                                              VarBind(last, EndOfMibView())])
        testing.assertEqual(got[1].varbinds, [VarBind(last, EndOfMibView())])
        testing.assertEqual(sizes, [2, 1, 1])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        got.append(_ok(r, e))
        if len(got) == 1:
            c.get_next(done, [last])
        else:
            _finish(t, check)

    p.server.set_receiver(on_request)
    c.get_next(done, [first, last])


# Cancel, close, queueing, invalid arguments, transport failures #######################################

actor _test_cancel_exactly_once(t: testing.AsyncT):
    """cancel(): CancelledError once; the late answer is dropped; a queued request is cancelled without being sent"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var held: list[CommunityMessage] = []
    var log: list[str] = []
    var h1 = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        held.append(_cm(data))

    def outcome(name: str, r: ?Response, e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.CancelledError):
            return name + ":cancelled"
        if e is not None:
            return name + ":error " + str(e)
        return name + ":ok"

    def verify() -> None:
        testing.assertEqual(log, ["second:cancelled", "first:cancelled", "third:ok"])
        testing.assertEqual(len(held), 2, "the queued second request was never sent")
        testing.assertEqual(c.stats().drops_unknown_id, 1, "the late answer to the first")

    def third(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append(outcome("third", r, e))
        after now QUIET: _finish(t, verify)

    def answer_third() -> None:
        if len(held) == 2:
            req = held[1]
            p.server.send_to(_reply(req, _answer(_pdu(req).varbinds)), MANAGER, 40000)
        else:
            after now 0.01: answer_third()

    def first(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append(outcome("first", r, e))
        req = held[0]
        p.server.send_to(_reply(req, _answer(_pdu(req).varbinds)), MANAGER, 40000)      # too late
        c.cancel(h1)                                                                    # no second callback
        c.get(third, _oids(1))
        answer_third()

    def second(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append(outcome("second", r, e))

    def cancel_first() -> None:
        # once the first request is out
        if len(held) == 1:
            c.cancel(h1)
            c.cancel(h1)
            c.cancel(9999)
        else:
            after now 0.01: cancel_first()

    p.server.set_receiver(on_request)
    h1 = c.get(first, _oids(1))
    h2 = c.get(second, _oids(2))
    c.cancel(h2)
    cancel_first()


actor _test_close_exactly_once(t: testing.AsyncT):
    """close(): every pending, queued and discovery callback gets CancelledError once; later calls too"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW.with_(max_in_flight=2), transport=p.client)
    var log: list[str] = []
    var sent = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        sent += 1

    def name_of(e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.CancelledError):
            return "cancelled"
        if isinstance(e, errors.EncodeError):
            return "encode"
        return "other"

    def verify() -> None:
        testing.assertEqual(sorted(log), ["a:cancelled", "after-get:cancelled", "after-trap:cancelled", "b:cancelled",
                                          "c:cancelled"])
        testing.assertEqual(sent, 2, "max_in_flight 2: the third stayed queued")

    def cb_a(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("a:" + name_of(e))

    def cb_b(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("b:" + name_of(e))

    def cb_c(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("c:" + name_of(e))

    def cb_after(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("after-get:" + name_of(e))

    def trap_done(cl: Client, e: ?errors.SnmpError) -> None:
        log.append("after-trap:" + name_of(e))

    def closing() -> None:
        c.close()
        c.close()
        c.get(cb_after, _oids(1))
        c.trap(trap_done, TRAP_OID, [])
        after now QUIET: _finish(t, verify)

    p.server.set_receiver(on_request)
    c.get(cb_a, _oids(1))
    c.get(cb_b, _oids(1))
    c.get(cb_c, _oids(1))
    after now 0.05: closing()


actor _test_queueing_max_in_flight(t: testing.AsyncT):
    """max_in_flight 2: at most two requests outstanding; the rest wait in order"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW.with_(max_in_flight=2), transport=p.client)
    oids = _oids(5)
    var held: list[(CommunityMessage, str, int)] = []
    var outstanding_max = 0
    var order: list[Oid] = []
    var done_order: list[Oid] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        order.append(_pdu(req).varbinds[0].oid)
        held.append((req, address, port))
        if len(held) > outstanding_max:
            outstanding_max = len(held)
        if len(held) == 2 or len(order) == 5:
            for entry in held:
                p.server.send_to(_reply(entry.0, _answer(_pdu(entry.0).varbinds)), entry.1, entry.2)
            held = []

    def check() -> None:
        testing.assertEqual(order, oids)
        testing.assertEqual(done_order, oids)
        testing.assertEqual(outstanding_max, 2)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        done_order.append(_ok(r, e).varbinds[0].oid)
        if len(done_order) == 5:
            _finish(t, check)

    p.server.set_receiver(on_request)
    for o in oids:
        c.get(done, [o])


actor _test_queueing_one_at_a_time(t: testing.AsyncT):
    """max_in_flight 1 (the default): a request is sent only after the previous one completed"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var count = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        p.server.send_to(_reply(req, _answer(_pdu(req).varbinds)), address, port)

    def check() -> None:
        hist = mn.history()
        directions = ["req" if d.dst_address == AGENT else "resp" for d in hist]
        testing.assertEqual(directions, ["req", "resp", "req", "resp", "req", "resp"])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        count += 1
        if count == 3:
            _finish(t, check)

    p.server.set_receiver(on_request)
    for o in _oids(3):
        c.get(done, [o])


actor _test_invalid_arguments(t: testing.AsyncT):
    """Invalid arguments reach the callback as EncodeError; nothing is sent"""
    mn = MemNet()
    p = mem_pair(mn)
    c2 = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    c1 = Client(None, AGENT, Community("public", message.SNMP_V1), t.log_handler, opts=SLOW,
                transport=mn.client(MANAGER, 40001, AGENT, 161))
    var log: list[str] = []
    expected = 13

    def on_request(data: bytes, address: str, port: int) -> None:
        log.append("sent")

    def name_of(e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.EncodeError):
            return "encode"
        if e is not None:
            return "other: " + str(e)
        return "ok"

    def check() -> None:
        testing.assertEqual(log, ["encode"] * expected)

    def note(text: str) -> None:
        log.append(text)
        if len(log) == expected:
            after now QUIET: _finish(t, check)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    def trap_done(cl: Client, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    def engine_done(cl: Client, i: ?EngineInfo, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    p.server.set_receiver(on_request)
    c2.get(done, [])                                                      # no OIDs
    c2.get(done, [Oid([1])])                                              # one arc
    c2.get_next(done, [Oid([3, 1])])                                      # first arc above 2
    c2.get(done, [Oid([1, 3] + list(range(127)))])                        # 129 arcs
    c2.get_bulk(done, _oids(1), -1, 5)                                    # negative non-repeaters
    c2.get_bulk(done, _oids(1), 0, -2)                                    # negative max-repetitions
    c2.set(done, [VarBind(_oids(1)[0], Integer(1 << 40))])                # not an Integer32
    c1.set(done, [VarBind(_oids(1)[0], Counter64(u64(5)))])               # Counter64 in SNMPv1
    c1.inform(done, TRAP_OID, [])                                         # no InformRequest in SNMPv1
    c1.trap(trap_done, TRAP_OID, [])                                      # SNMPv2-Trap in SNMPv1
    c2.trap_v1(trap_done, ENTERPRISE, b"\x0a\x00\x00\x01", 6, 1, [])      # Trap-PDU in SNMPv2c
    c1.trap_v1(trap_done, ENTERPRISE, b"\x0a\x00\x01", 6, 1, [])          # agent-addr of 3 octets
    c2.discover(engine_done)                                              # discovery is SNMPv3 only


proc def _no_send(data: bytes) -> None:
    pass

proc def _no_close() -> None:
    pass

proc def _failing_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
    on_error("UDP setup for 10.0.0.1:161 failed: no route", True)

actor _test_transport_failures(t: testing.AsyncT):
    """A fatal transport error fails requests with TransportError; so does a Client without any transport"""
    broken = Transport(_no_send, _failing_receiver, _no_close)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=broken)
    none = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW)
    var log: list[str] = []

    def name_of(e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.TransportError):
            return "transport: " + e.error_message
        if e is not None:
            return "other: " + str(e)
        return "ok"

    def check() -> None:
        testing.assertEqual(sorted(log), ["transport: UDP setup for 10.0.0.1:161 failed: no route",
                                          "transport: UDP setup for 10.0.0.1:161 failed: no route",
                                          "transport: no transport: neither cap nor transport was given",
                                          "transport: no transport: neither cap nor transport was given"])

    def note(text: str) -> None:
        log.append(text)
        if len(log) == 4:
            _finish(t, check)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    def trap_done(cl: Client, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    c.get(done, _oids(1))
    c.trap(trap_done, TRAP_OID, [])
    none.get(done, _oids(1))
    none.trap(trap_done, TRAP_OID, [])


actor _TransportSwitch():
    # Holds the error callback a Client registered, so a test can fail the transport later
    var on_error: ?action(str, bool) -> None = None
    var sent = 0

    def register(cb: action(str, bool) -> None) -> None:
        on_error = cb

    def send(data: bytes) -> None:
        sent += 1

    def fail(text: str) -> None:
        cb = on_error
        if cb is not None:
            cb(text, True)

def _switch_transport(s: _TransportSwitch) -> Transport:
    def _send(data: bytes) -> None:
        s.send(data)
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        s.register(on_error)
    return Transport(_send, _set_receiver, _no_close)

actor _test_transport_fails_pending(t: testing.AsyncT):
    """A fatal error while requests are pending and queued fails all of them at once"""
    sw = _TransportSwitch()
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=_switch_transport(sw))
    var log: list[str] = []

    def check() -> None:
        testing.assertEqual(log, ["transport", "transport"])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("transport" if isinstance(e, errors.TransportError) else "other")
        if len(log) == 2:
            _finish(t, check)

    def fail() -> None:
        sw.fail("socket died")

    c.get(done, _oids(1))
    c.get(done, _oids(1))
    after now 0.05: fail()


# Logging ###########################################################################################

actor _Collector():
    var texts: list[str] = []

    def add(text: str) -> None:
        texts.append(text)

    def all() -> list[str]:
        return texts

class _CaptureSink(logging.Sink):
    # A sink that hands every formatted message, with its data, to a collector actor
    def __init__(self, collector: _Collector):
        logging.Sink.__init__(self)
        self.collector = collector

    def handle(self, m: logging.Message):
        text = self.formatter.format(m)
        if text is not None:
            data = m.data
            if data is not None:
                text += " - " + str(data)
            self.collector.add(text)

actor _test_logs_never_show_the_community(t: testing.AsyncT):
    """With every level logged (trace included), no log line contains the community"""
    col = _Collector()
    handler = logging.Handler("client")
    handler.add_sink(_CaptureSink(col))
    handler.set_output_level(logging.ALL)
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("s3cr3t-community"), handler, opts=SLOW, transport=p.client)
    var count = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        p.server.send_to(_reply(req, [], pdu.TOO_BIG, 0), address, port)
        p.server.send_to(_reply(req, _answer(_pdu(req).varbinds)), address, port)

    def check() -> None:
        texts = col.all()
        testing.assertTrue(len(texts) > 3, "something was logged")
        joined = "\n".join(texts)
        testing.assertFalse("s3cr3t" in joined, joined)
        testing.assertFalse(b"s3cr3t-community".hex() in joined)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        count += 1
        if count == 2:
            after now QUIET: _finish(t, check)

    p.server.set_receiver(on_request)
    c.get(done, _oids(2))
    c.get(done, _oids(1))


# SNMPv3 ############################################################################################

# _V3Agent modes
NORMAL = 0
SILENT = 1
ALWAYS_TIME_WINDOW = 2          # answer every request with an authenticated notInTimeWindows Report
CRAFTED_REPORT = 3              # answer every request with a noAuthNoPriv Report of report_name
FORGED_FIRST = 4                # send a copy of every response with a broken MAC first
UNAUTH_FIRST = 5                # send an unauthenticated copy of every response first
PROBE_RESPONSE = 6              # answer the discovery probe with a Response
SHORT_ENGINE_ID = 7             # answer the discovery probe with a 4-octet engine ID
ALWAYS_UNKNOWN_ENGINE = 8       # answer every request with an unknownEngineIDs Report
HOLD_FIRST = 9                  # keep the first request; answer it (late) when the second arrives
WRONG_RID_FIRST = 10            # send an authenticated response with another request-id first
OTHER_ENGINE_FIRST = 11         # send a response that names another engine ID first

def _respond_pdu(p: Pdu) -> Pdu:
    # What _V3Agent answers to an accepted request
    if p.pdu_type == pdu.INFORM:
        return notify.inform_response(p)
    if p.pdu_type == pdu.GETNEXT:
        return Pdu(pdu.RESPONSE, p.request_id, 0, 0, _answer_next(p.varbinds))
    return Pdu(pdu.RESPONSE, p.request_id, 0, 0, _answer(p.varbinds))

actor _V3Agent(srv: ServerTransport, users: list[Usm], engine_id: bytes, pdu_types: list[int]=[pdu.GET, pdu.GETNEXT, pdu.GETBULK, pdu.SET]):
    """A scripted SNMPv3 agent: an AuthoritativeEngine (boots 1, time 1000) with switchable faults

    seen() lists what happened per request: "probe" for a discovery probe,
    "ok" for an accepted one, otherwise the counter of the Report or drop.
    """
    var eng = AuthoritativeEngine(engine_id, 1, _now() - 1000.0, users, pdu_types)
    var eid = engine_id
    var mode = NORMAL
    var forge_discovery = False
    var disc_boots = 0
    var disc_time = 0
    var report_name = usm.report_oid(usm.USM_STATS_DECRYPTION_ERRORS)
    var log: list[str] = []
    var held: ?(bytes, V3Message) = None
    salt = SaltCounter(u64(1000))

    proc def _probe(data: bytes, m: V3Message, address: str, port: int) -> None:
        log.append("probe")
        rid = 0
        s = m.scoped
        if s is not None:
            rid = s.pdu.request_id
        if mode == SILENT:
            return
        if mode == PROBE_RESPONSE:
            hdr = V3Message(m.msg_id, 65507, 0, UsmSecurityParameters(eid, 1, 1000, b""))
            resp = Pdu(pdu.RESPONSE, rid, 0, 0, [])
            srv.send_to(usm.protect(hdr, message.encode_scoped(ScopedPdu(eid, b"", resp)), None, u64(0)), address, port)
            return
        if mode == SHORT_ENGINE_ID:
            rep = _crafted_report(m.msg_id, rid, b"\x80\x00\x01\x02", 1, 1000, b"",
                                  usm.report_oid(usm.USM_STATS_UNKNOWN_ENGINE_IDS))
            srv.send_to(rep, address, port)
            return
        if forge_discovery:
            rep = _crafted_report(m.msg_id, rid, eid, disc_boots, disc_time, b"",
                                  usm.report_oid(usm.USM_STATS_UNKNOWN_ENGINE_IDS))
            srv.send_to(rep, address, port)
            return
        inc = eng.incoming(data, m, _now())
        r = inc.report
        if r is not None:
            srv.send_to(r, address, port)

    proc def _request(data: bytes, m: V3Message, address: str, port: int) -> None:
        now = _now()
        if mode == SILENT:
            log.append("silent")
            return
        if mode == ALWAYS_TIME_WINDOW:
            log.append(usm.USM_STATS_NOT_IN_TIME_WINDOWS)
            boots, etime = eng.clock(now)
            keys = eng.localized(m.usm.user)
            srv.send_to(_crafted_report(m.msg_id, 0, eid, boots, etime, m.usm.user,
                                        usm.report_oid(usm.USM_STATS_NOT_IN_TIME_WINDOWS), keys), address, port)
            return
        if mode == CRAFTED_REPORT:
            log.append("crafted")
            boots, etime = eng.clock(now)
            srv.send_to(_crafted_report(m.msg_id, 0, eid, boots, etime, m.usm.user, report_name), address, port)
            return
        if mode == ALWAYS_UNKNOWN_ENGINE:
            log.append(usm.USM_STATS_UNKNOWN_ENGINE_IDS)
            boots, etime = eng.clock(now)
            srv.send_to(_crafted_report(m.msg_id, 0, eid, boots, etime, m.usm.user,
                                        usm.report_oid(usm.USM_STATS_UNKNOWN_ENGINE_IDS)), address, port)
            return
        if mode == HOLD_FIRST:
            first = held
            if first is not None:
                mode = NORMAL
                _serve(first.0, first.1, address, port)
            else:
                held = (data, m)
                log.append("held")
                return
        _serve(data, m, address, port)

    proc def _serve(data: bytes, m: V3Message, address: str, port: int) -> None:
        now = _now()
        inc = eng.incoming(data, m, now)
        r = inc.report
        if r is not None:
            log.append(inc.counter)
            srv.send_to(r, address, port)
            return
        s = inc.scoped
        if s is not None:
            log.append("ok")
            answer = eng.respond(m, inc.user, _respond_pdu(s.pdu), s.context_engine_id, s.context_name, now, salt.next())
            if mode == FORGED_FIRST:
                srv.send_to(_flip_mac(answer), address, port)
            elif mode == WRONG_RID_FIRST:
                wrong = Pdu(pdu.RESPONSE, s.pdu.request_id ^ 1, 0, 0, _answer(s.pdu.varbinds))
                srv.send_to(eng.respond(m, inc.user, wrong, s.context_engine_id, s.context_name, now, salt.next()),
                            address, port)
            elif mode == OTHER_ENGINE_FIRST:
                boots, etime = eng.clock(now)
                hdr = V3Message(m.msg_id, 65507, 0, UsmSecurityParameters(h(ENGINE2_HEX), boots, etime, m.usm.user))
                plain = ScopedPdu(s.context_engine_id, s.context_name, _respond_pdu(s.pdu))
                srv.send_to(usm.protect(hdr, message.encode_scoped(plain), None, u64(0)), address, port)
            elif mode == UNAUTH_FIRST:
                boots, etime = eng.clock(now)
                hdr = V3Message(m.msg_id, 65507, 0, UsmSecurityParameters(eid, boots, etime, m.usm.user))
                plain = ScopedPdu(s.context_engine_id, s.context_name, _respond_pdu(s.pdu))
                srv.send_to(usm.protect(hdr, message.encode_scoped(plain), None, u64(0)), address, port)
            srv.send_to(answer, address, port)
        else:
            log.append("dropped:" + inc.counter)

    def on_request(data: bytes, address: str, port: int) -> None:
        c, m = message.decode(data)
        if m is not None:
            if m.usm.engine_id == b"":
                _probe(data, m, address, port)
            else:
                _request(data, m, address, port)
        else:
            log.append("not v3")

    def set_mode(m: int) -> None:
        mode = m

    def set_report(name: Oid) -> None:
        report_name = name

    def set_forged_discovery(boots: int, etime: int) -> None:
        forge_discovery = True
        disc_boots = boots
        disc_time = etime

    def reboot(boots: int) -> None:
        """Restart the engine with the given boots and time 10"""
        eng = AuthoritativeEngine(eid, boots, _now() - 10.0, users, pdu_types)

    def change_engine(new_id: bytes) -> None:
        """Replace the engine by one with another engine ID (a replaced device)"""
        eid = new_id
        eng = AuthoritativeEngine(new_id, 1, _now() - 500.0, users, pdu_types)

    def seen() -> list[str]:
        return log

    srv.set_receiver(on_request)


actor _test_v3_discovery_hint_two_round_trips(t: testing.AsyncT):
    """authPriv GET to an unknown engine: probe, then the request with the Report's boots/time: two round trips"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)
    oids = _oids(2)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(resp.varbinds, _answer([VarBind(o) for o in oids]))
        testing.assertEqual(agent.seen(), ["probe", "ok"])
        testing.assertEqual((resp.context_engine_id, resp.context_name), (_engine_id(), b""))
        testing.assertEqual(resp.attempts, 1)
        info = c.engine_info()
        if info is not None:
            testing.assertEqual(info.engine_id, _engine_id())
            testing.assertEqual(info.boots, 1)
            testing.assertTrue(info.time >= 1000 and info.time < 1010, "time %d" % info.time)
        else:
            testing.error("no engine info")
        s = c.stats()
        testing.assertEqual((s.reports, s.responses, s.drops_auth), (1, 1, 0))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    c.get(done, oids)


