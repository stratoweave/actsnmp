# Notifications #####################################################################################

actor _test_trap_v2c(t: testing.AsyncT):
    """trap(): an SNMPv2-Trap with sysUpTime.0, snmpTrapOID.0 and the payload; cb once handed over"""
    mn = MemNet()
    p = mem_pair(mn, server_port=162)
    c = Client(None, AGENT, Community("public"), t.log_handler, port=162, opts=SLOW, transport=p.client)
    payload = [VarBind(Oid.parse("1.3.6.1.4.1.8072.2.3.2.1"), Integer(42))]
    var got: list[notify.Notification] = []
    var errs: list[str] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        cm = _cm(data)
        got.append(notify.notification_from_v2c(_pdu(cm), cm.community, address, port))

    def check() -> None:
        testing.assertEqual(errs, ["ok", "ok"])
        testing.assertEqual(len(got), 2)
        n = got[0]
        testing.assertEqual((n.version, n.pdu_type, n.community, n.problem), (message.SNMP_V2C, pdu.TRAP_V2, b"public", ""))
        testing.assertEqual((n.uptime, n.trap_oid, n.varbinds), (12345, TRAP_OID, payload))
        testing.assertTrue(n.request_id >= 1)
        testing.assertTrue(got[1].uptime >= 0 and got[1].uptime < 300, "uptime since the Client started: %d" % got[1].uptime)
        testing.assertEqual(c.stats().requests, 0, "traps are not requests")

    def done(cl: Client, e: ?errors.SnmpError) -> None:
        errs.append(_describe(e))
        if len(errs) == 2:
            after now QUIET: _finish(t, check)

    p.server.set_receiver(on_request)
    c.trap(done, TRAP_OID, payload, 12345)
    c.trap(done, TRAP_OID, payload)


actor _test_trap_v1(t: testing.AsyncT):
    """trap_v1(): an SNMPv1 Trap-PDU with our fields"""
    mn = MemNet()
    p = mem_pair(mn, server_port=162)
    c = Client(None, AGENT, Community("public", message.SNMP_V1), t.log_handler, port=162, opts=SLOW, transport=p.client)
    payload = [VarBind(Oid.parse("1.3.6.1.4.1.8072.9999.1.1.1.0"), Integer(0))]
    var got: list[CommunityMessage] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        got.append(_cm(data))

    def check() -> None:
        testing.assertEqual(len(got), 1)
        cm = got[0]
        testing.assertEqual((cm.version, cm.community), (message.SNMP_V1, b"public"))
        tr = cm.trap
        if tr is not None:
            testing.assertEqual(tr, TrapV1Pdu(ENTERPRISE, b"\xc0\x00\x02\x01", 6, 42, 12345, payload))
        else:
            testing.error("not a Trap-PDU")

    def done(cl: Client, e: ?errors.SnmpError) -> None:
        if e is not None:
            t.failure(AssertionError("trap failed: " + str(e)))
            return
        after now QUIET: _finish(t, check)

    p.server.set_receiver(on_request)
    c.trap_v1(done, ENTERPRISE, b"\xc0\x00\x02\x01", 6, 42, payload, 12345)


actor _test_trap_v3(t: testing.AsyncT):
    """SNMPv3 trap: we are authoritative (local_engine_id, boots 1, our time), authPriv, not reportable"""
    mn = MemNet()
    p = mem_pair(mn, server_port=162)
    local = h("80001f88056163747472617031")
    c = Client(None, AGENT, _shaaes(), t.log_handler, port=162, opts=SLOW, transport=p.client, local_engine_id=local)
    d = Client(None, AGENT, _users()[0], t.log_handler, port=162, opts=SLOW, transport=mn.client(MANAGER, 40001, AGENT, 162))
    payload = [VarBind(Oid.parse("1.3.6.1.4.1.8072.2.3.2.1"), Integer(7))]
    var got: list[(V3Message, ScopedPdu)] = []
    var errs: list[str] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        m = _v3(data)
        user = _shaaes() if m.usm.user == b"shaaes" else _users()[0]
        keys = user.localized(m.usm.engine_id)
        et = usm.EngineTime(m.usm.engine_id, 0, 0, 0, _now())
        level = m.flags & usm.LEVEL_AUTH_PRIV
        got.append((m, usm.process_incoming(data, m, keys if level != 0 else None, level, et, _now()).scoped))

    def check() -> None:
        testing.assertEqual(errs, ["ok", "ok"])
        testing.assertEqual(len(got), 2)
        first = 0 if got[0].0.usm.user == b"shaaes" else 1
        m = got[first].0
        s = got[first].1
        testing.assertEqual(m.flags, message.FLAG_AUTH | message.FLAG_PRIV, "authPriv, no reportableFlag")
        testing.assertEqual((m.usm.engine_id, m.usm.boots, m.usm.user), (local, 1, b"shaaes"))
        testing.assertTrue(m.usm.time >= 0 and m.usm.time < 5)
        testing.assertEqual(s.context_engine_id, local)
        n = notify.notification_from_v3(m, s, AGENT, 0)
        testing.assertEqual((n.pdu_type, n.uptime, n.trap_oid, n.varbinds, n.problem), (pdu.TRAP_V2, 99, TRAP_OID, payload, ""))
        m2 = got[1 - first].0
        testing.assertEqual(m2.flags, 0, "noAuthNoPriv user")
        testing.assertEqual(len(m2.usm.engine_id), 13, "default local engine ID: RFC 3411 format 5")
        testing.assertEqual(m2.usm.engine_id[:5], h("80001f8805"))

    def done(cl: Client, e: ?errors.SnmpError) -> None:
        errs.append(_describe(e))
        if len(errs) == 2:
            after now QUIET: _finish(t, check)

    p.server.set_receiver(on_request)
    c.trap(done, TRAP_OID, payload, 99)
    d.trap(done, TRAP_OID, payload, 99)


actor _test_inform_v2c(t: testing.AsyncT):
    """inform(): an InformRequest, retried after a loss, completed by the receiver's Response"""
    mn = MemNet()
    p = mem_pair(mn, server_port=162)
    c = Client(None, AGENT, Community("public"), t.log_handler, port=162, opts=Options(timeout=0.05, retries=2),
               transport=p.client)
    payload = [VarBind(Oid.parse("1.3.6.1.4.1.8072.2.3.2.1"), Integer(42))]
    var seen: list[Pdu] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        cm = _cm(data)
        q = _pdu(cm)
        seen.append(q)
        if len(seen) > 1:
            resp = notify.inform_response(q)
            p.server.send_to(message.encode_community(CommunityMessage(cm.version, cm.community, resp)), address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(resp.attempts, 2)
        testing.assertEqual(seen[0].pdu_type, pdu.INFORM)
        testing.assertEqual(seen[0].varbinds, notify.build_trap_v2(500, TRAP_OID, payload))
        testing.assertEqual(seen[0].request_id, seen[1].request_id, "a retransmitted inform keeps its request-id")
        testing.assertEqual(resp.varbinds, notify.build_trap_v2(500, TRAP_OID, payload))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.inform(done, TRAP_OID, payload, 500)


actor _test_inform_v3(t: testing.AsyncT):
    """SNMPv3 inform: the receiver is authoritative and is discovered first"""
    mn = MemNet()
