    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(rcv.seen(), ["probe", "ok"])
        testing.assertEqual(resp.varbinds, notify.build_trap_v2(77, TRAP_OID, payload))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    c.inform(done, TRAP_OID, payload, 77)


actor _test_inform_wrong_echo(t: testing.AsyncT):
