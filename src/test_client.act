actor _test_v3_report_kinds(t: testing.AsyncT):
    """unknownUserNames, wrongDigests, unsupportedSecLevels (from the engine), decryptionErrors and an
    unknown counter (crafted) each end the request with a ReportError of that name"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    clients = [Usm.from_passwords("nobody", usm.AUTH_SHA1, "authpassword"),
               Usm.from_passwords("shaaes", usm.AUTH_SHA1, "wrongpassword", usm.PRIV_AES128, "privpassword"),
               Usm.from_passwords("shaaes", usm.AUTH_SHA1, "authpassword"),
               _shaaes(),
               _shaaes()]
    var n = 0
    var names: list[str] = []
    var arcs: list[list[int]] = []

    def check() -> None:
        testing.assertEqual(names, [usm.USM_STATS_UNKNOWN_USER_NAMES, usm.USM_STATS_WRONG_DIGESTS,
                                    usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, usm.USM_STATS_DECRYPTION_ERRORS,
                                    "unknown report"])
        testing.assertEqual(arcs[0], usm.report_oid(usm.USM_STATS_UNKNOWN_USER_NAMES).arcs)
        testing.assertEqual(arcs[4], [1, 3, 6, 1, 4, 1, 99, 99, 0])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        if isinstance(e, errors.ReportError):
            names.append(e.name)
            arcs.append(e.oid)
        else:
            names.append("not a ReportError: " + _describe(e))
            arcs.append([])
        n += 1
        if n == len(clients):
            _finish(t, check)
        else:
            next_client()

    def next_client() -> None:
        if n == 3:
            agent.set_mode(CRAFTED_REPORT)
        if n == 4:
            agent.set_report(Oid.parse("1.3.6.1.4.1.99.99.0"))
        tr = mn.client(MANAGER, 41000 + n, AGENT, 161)
        cl = Client(None, AGENT, clients[n], t.log_handler, opts=SLOW, transport=tr)
        cl.get(done, _oids(1))

    next_client()


actor _test_v3_forged_response_dropped(t: testing.AsyncT):
    """A response with a broken MAC, an unauthenticated one and one from another engine are dropped (drops_auth);
    the genuine ones complete"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_mode(FORGED_FIRST)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)

    def check3(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        testing.assertEqual(c.stats().drops_auth, 3)

    def third(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check3(r, e))

    def second(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        try:
            _ok(r, e)
            testing.assertEqual(c.stats().drops_auth, 2)
        except Exception as ex:
            t.failure(ex)
            return
        agent.set_mode(OTHER_ENGINE_FIRST)
        c.get(third, _oids(1))

    def first(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        try:
            _ok(r, e)
            testing.assertEqual(c.stats().drops_auth, 1)
        except Exception as ex:
            t.failure(ex)
            return
        agent.set_mode(UNAUTH_FIRST)
        c.get(second, _oids(1))

    c.get(first, _oids(1))


actor _test_v3_reset_after_timeouts(t: testing.AsyncT):
    """Two consecutive timeouts reset the engine state: the next request discovers again"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)
    var step = 0

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        testing.assertEqual(agent.seen(), ["probe", "ok", "silent", "silent", "probe", "ok"])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        step += 1
        if step == 1:
            agent.set_mode(SILENT)
            c.get(done, _oids(1), FAST)
        elif step == 2:
            if c.engine_info() is None:
                t.failure(AssertionError("reset after one timeout"))
                return
            c.get(done, _oids(1), FAST)
        elif step == 3:
            if c.engine_info() is not None:
                t.failure(AssertionError("no reset after two timeouts"))
                return
            agent.set_mode(NORMAL)
            c.get(done, _oids(1))
        else:
            _finish(t, lambda: check(r, e))

    c.get(done, _oids(1))


actor _test_v3_discovery_failures(t: testing.AsyncT):
    """Discovery fails: no answer (TimeoutError), a Response to the probe, an engine ID of 4 octets (InvalidResponseError)"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_mode(SILENT)
    var n = 0
    var log: list[str] = []

    def name_of(e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.TimeoutError):
            return "timeout" if e.hint == "SNMPv3 engine discovery" else "timeout, hint " + str(e.hint)
        if isinstance(e, errors.InvalidResponseError):
            return "invalid"
        if e is not None:
            return "other: " + str(e)
        return "ok"

    def check() -> None:
        testing.assertEqual(log, ["timeout", "timeout", "invalid", "invalid"])

    def note(text: str) -> None:
        log.append(text)
        n += 1
        if n == 4:
            _finish(t, check)
        else:
            next_case()

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    def engine_done(cl: Client, info: ?EngineInfo, e: ?errors.SnmpError) -> None:
        note(name_of(e))

    def next_case() -> None:
        tr = mn.client(MANAGER, 41000 + n, AGENT, 161)
        cl = Client(None, AGENT, _shaaes(), t.log_handler, opts=FAST, transport=tr)
        if n == 0:
            cl.get(done, _oids(1))
        elif n == 1:
            cl.discover(engine_done)
        elif n == 2:
            agent.set_mode(PROBE_RESPONSE)
            cl.get(done, _oids(1))
        else:
            agent.set_mode(SHORT_ENGINE_ID)
            cl.get(done, _oids(1))

    next_case()


actor _test_v3_discover(t: testing.AsyncT):
    """discover() reports the engine ID and the Report's boots/time; requests then skip the probe"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)
    var infos: list[EngineInfo] = []

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        testing.assertEqual(len(infos), 2, "both discover() callbacks, one probe")
        testing.assertEqual(infos[0].engine_id, _engine_id())
        testing.assertEqual(infos[0].boots, 1)
        testing.assertTrue(infos[0].time >= 1000 and infos[0].time < 1010)
        testing.assertEqual(agent.seen(), ["probe", "ok"])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    def engine_done(cl: Client, info: ?EngineInfo, e: ?errors.SnmpError) -> None:
        if info is not None:
            infos.append(info)
        if len(infos) == 2:
            c.get(done, _oids(1))

    c.discover(engine_done)
    c.discover(engine_done)


