actor _test_v3_unknown_engine_twice(t: testing.AsyncT):
    """unknownEngineIDs again after the one rediscovery: ReportError"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_mode(ALWAYS_UNKNOWN_ENGINE)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.ReportError):
            testing.assertEqual(err.name, usm.USM_STATS_UNKNOWN_ENGINE_IDS)
        else:
            testing.error("not a ReportError: " + str(err))
        u = usm.USM_STATS_UNKNOWN_ENGINE_IDS
        testing.assertEqual(agent.seen(), ["probe", u, "probe", u])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    c.get(done, _oids(1))


actor _test_v3_forged_discovery_cannot_lock_out(t: testing.AsyncT):
    """A discovery Report with huge boots is only a hint: the authenticated notInTimeWindows Report wins"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_forged_discovery(2000000000, 5)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        testing.assertEqual(agent.seen(), ["probe", usm.USM_STATS_NOT_IN_TIME_WINDOWS, "ok"])
        info = c.engine_info()
        if info is not None:
            testing.assertEqual(info.boots, 1)
        else:
            testing.error("no engine info")

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    c.get(done, _oids(1))


actor _test_v3_boots_went_down_resets(t: testing.AsyncT):
    """The agent restarts with lower boots (not persisted): its answers fail the time window, the request
    times out with a hint, the engine state is reset at once and the next request works again"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.reboot(5)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)
    var step = 0

    def check_timeout(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.TimeoutError):
            testing.assertEqual(err.hint, "1 datagram failed authentication (1 outside the time window)")
        else:
            testing.error("not a TimeoutError: " + str(err))
        testing.assertTrue(c.engine_info() is None, "reset after one time-window failure")

    def check_last(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        testing.assertEqual(agent.seen(), ["probe", "ok", usm.USM_STATS_NOT_IN_TIME_WINDOWS, "probe", "ok"])
        info = c.engine_info()
        if info is not None:
            testing.assertEqual(info.boots, 1)
        else:
            testing.error("no engine info")

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        step += 1
        if step == 1:
            try:
                _ok(r, e)
            except Exception as ex:
                t.failure(ex)
                return
            agent.reboot(1)
            c.get(done, _oids(1), FAST.with_(timeout=0.1))
        elif step == 2:
            try:
                check_timeout(r, e)
            except Exception as ex:
                t.failure(ex)
                return
            c.get(done, _oids(1))
        else:
            _finish(t, lambda: check_last(r, e))

    c.get(done, _oids(1))


actor _test_v3_late_reply_and_wrong_request_id(t: testing.AsyncT):
    """SNMPv3: the answer to attempt 1 (its msgID) completes the request during attempt 2; an authenticated
    response with another request-id is dropped"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=Options(timeout=0.1, retries=2), transport=p.client)
    var step = 0

    def check_late(r: ?Response, e: ?errors.SnmpError) -> None:
        resp = _ok(r, e)
        testing.assertEqual(resp.attempts, 2)
        testing.assertEqual(agent.seen(), ["probe", "ok", "held", "ok", "ok"])

    def check_wrong(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        s = c.stats()
        testing.assertEqual((s.drops_pdu, s.drops_unknown_id), (1, 1))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        step += 1
        if step == 1:
            agent.set_mode(HOLD_FIRST)
            c.get(done, _oids(1))
        elif step == 2:
            try:
                check_late(r, e)
            except Exception as ex:
                t.failure(ex)
                return
            agent.set_mode(WRONG_RID_FIRST)
            c.get(done, _oids(1))
        else:
            _finish(t, lambda: check_wrong(r, e))

    c.get(done, _oids(1))


actor _test_v3_cancel_and_close_while_discovering(t: testing.AsyncT):
    """A request waiting for discovery can be cancelled; close() cancels the discovery callbacks"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_mode(SILENT)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)
    var log: list[str] = []

    def name_of(e: ?errors.SnmpError) -> str:
        if isinstance(e, errors.CancelledError):
            return "cancelled"
        return _describe(e)

    def check() -> None:
        testing.assertEqual(log, ["get:cancelled", "get2:cancelled", "discover:cancelled"])
        testing.assertEqual(agent.seen(), ["probe"])

    def got(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("get:" + name_of(e))

    def got2(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("get2:" + name_of(e))

    def discovered(cl: Client, info: ?EngineInfo, e: ?errors.SnmpError) -> None:
        log.append("discover:" + name_of(e))

    def later() -> None:
        c.close()
        after now QUIET: _finish(t, check)

    h1 = c.get(got, _oids(1))
    c.discover(discovered)
    c.get(got2, _oids(1))
    c.cancel(h1)
    after now 0.05: later()


# UDP loopback ######################################################################################

actor _test_udp_loopback(t: testing.EnvT):
    """Over real UDP on 127.0.0.1 (Client made from a UDPConnectCap): a GET is answered; a closed port gives
    the ICMP unreachable hint"""
    t.timeout(8.0)
    ucap = net.UDPCap(net.NetCap(t.env.cap))
    var srv: ?ServerTransport = None
    var closed_port = 0
    var phase = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        s = srv
        if s is not None:
            s.send_to(_reply(req, _answer(_pdu(req).varbinds)), address, port)

    def check_refused(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.TimeoutError):
            testing.assertEqual(err.hint, "ICMP port unreachable")
        else:
            testing.error("not a TimeoutError: " + str(err))

    def refused_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        cl.close()
        s = srv
        if s is not None:
            s.close()
        _finish_env(t, lambda: check_refused(r, e))

    def ok_done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        cl.close()
        try:
            resp = _ok(r, e)
            testing.assertEqual(resp.varbinds, _answer([VarBind(o) for o in _oids(2)]))
        except Exception as ex:
            t.failure(ex)
            return
        start_refused()

    def start_refused() -> None:
        c2 = Client(net.UDPConnectCap(ucap), "127.0.0.1", Community("public"), t.log_handler, port=closed_port,
                    opts=Options(timeout=0.2, retries=1))
        c2.get(refused_done, _oids(1))

    def on_closed_ready(st: ServerTransport, error: ?str) -> None:
        # bind, note the port, close: nothing listens there afterwards
        closed_port = st.local_port()
        st.close()
        s = srv
        if s is not None:
            c = Client(net.UDPConnectCap(ucap), "127.0.0.1", Community("public"), t.log_handler,
                       port=s.local_port(), opts=Options(timeout=1.0, retries=2))
            c.get(ok_done, _oids(2))

    def on_ready(st: ServerTransport, error: ?str) -> None:
        if error is not None:
            t.failure(AssertionError("listen failed: " + error))
            return
        srv = st
        st.set_receiver(on_request)
        udp_server_transport(net.UDPListenCap(ucap), "127.0.0.1", 0, on_closed_ready)

    udp_server_transport(net.UDPListenCap(ucap), "127.0.0.1", 0, on_ready)


# Edge cases: Reports, long queues, discovery budgets, trap boots ##################################

# An encrypted (authPriv) Report

actor _test_rv_encrypted_report(t: testing.AsyncT):
    """A Report at the request's level (authPriv, encrypted) must end the request with ReportError, not a timeout"""
    t.timeout(10.0)
    mn = MemNet()
    p = mem_pair(mn)
    eid = h(ENGINE_HEX)
    u = _shaaes()
    keys = u.localized(eid)
    salt = SaltCounter(u64(77))
    c = Client(None, AGENT, u, t.log_handler, opts=Options(timeout=0.3, retries=0), transport=p.client,
               engine=EngineInfo(eid, 1, 1000, _now()))
    var started = _now()

    def on_request(data: bytes, address: str, port: int) -> None:
        cm, m = message.decode(data)
        if m is not None:
            hdr = V3Message(m.msg_id, 65507, message.FLAG_AUTH | message.FLAG_PRIV,
                            UsmSecurityParameters(eid, 1, 1000, b"shaaes"))
            rep = Pdu(pdu.REPORT, 0, 0, 0, [VarBind(usm.report_oid(usm.SNMP_UNKNOWN_CONTEXTS), Counter32(1))])
            p.server.send_to(usm.protect(hdr, message.encode_scoped(ScopedPdu(eid, b"", rep)), keys, salt.next()),
                             address, port)

    def check(e: ?errors.SnmpError, elapsed: float, s: str) -> None:
        if not isinstance(e, errors.ReportError):
            raise AssertionError("expected ReportError(snmpUnknownContexts), got " + _describe(e)
                                 + " after %.3f s; " % elapsed + s)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        elapsed = _now() - started
        s = str(c.stats())
        _finish(t, lambda: check(e, elapsed, s))

    p.server.set_receiver(on_request)
    started = _now()
    c.get(done, _oids(1))


# Fatal transport error with a long queue: no recursion, no quadratic work ##########################

actor _BigQueue(t: testing.AsyncT, n: int, use_close: bool, limit: float):
    sw = _TransportSwitch()
    c = Client(None, AGENT, Community("public"), None, opts=Options(timeout=60.0, retries=0), transport=_switch_transport(sw))
    var got = 0
    var wrong = 0
    var t0 = 0.0

    def check(elapsed: float) -> None:
        testing.assertEqual(wrong, 0)
        testing.assertTrue(elapsed < limit, "%d queued requests: the callbacks took %.3f s after the trigger" % (n, elapsed))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        if use_close:
            if not isinstance(e, errors.CancelledError):
                wrong += 1
        elif not isinstance(e, errors.TransportError):
            wrong += 1
        got += 1
        if got == n:
            elapsed = _now() - t0
            _finish(t, lambda: check(elapsed))

    def trigger() -> None:
        t0 = _now()
        if use_close:
            c.close()
        else:
            sw.fail("socket died")

    def submitted(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        pass

    for i in range(n):
        c.get(done, _oids(1))
    # a synchronous call: every get() above has been queued when it returns
    h = c.get(submitted, _oids(1))
    c.cancel(h)
    trigger()

actor _test_rv_fatal_queue_5k(t: testing.AsyncT):
    """A fatal transport error with 5000 queued requests: all fail with TransportError"""
    t.timeout(120.0)
    b = _BigQueue(t, 5000, False, 1000.0)

actor _test_rv_close_queue_5k(t: testing.AsyncT):
    """close() with 5000 queued requests"""
    t.timeout(120.0)
    b = _BigQueue(t, 5000, True, 1000.0)

actor _test_rv_close_queue_20k(t: testing.AsyncT):
    """close() with 20000 queued requests must not take seconds (quadratic queue filtering)"""
    t.timeout(300.0)
    b = _BigQueue(t, 20000, True, 2.0)

# Discovery follows the request's Options ##########################################################

actor _test_rv_discovery_uses_request_opts(t: testing.AsyncT):
    """A request with timeout 0.1 s and no retries must fail in well under a second, also while discovering"""
    t.timeout(20.0)
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=Options(timeout=1.0, retries=2), transport=p.client)
    var started = _now()
    var probes = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        probes += 1           # a silent agent

    def check(e: ?errors.SnmpError, elapsed: float) -> None:
        testing.assertTrue(isinstance(e, errors.TimeoutError), _describe(e))
        testing.assertTrue(elapsed < 0.6, "the 0.1 s request failed after %.3f s and %d probes: " % (elapsed, probes)
                           + _describe(e))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        elapsed = _now() - started
        _finish(t, lambda: check(e, elapsed))

    p.server.set_receiver(on_request)
    started = _now()
    c.get(done, _oids(1), Options(timeout=0.1, retries=0))


# SNMPv3 traps after a sender restart (local_engine_boots) ##########################################

actor _test_rv_trap_v3_after_restart(t: testing.AsyncT):
    """A restarted sender with the same engine ID and boots + 1: its traps are accepted

    The first datagram stands for the previous run (boots 1, time 100000).
    With boots 1 again, a receiver that keeps time records would reject the
    new traps for a day, so the Client passes local_engine_boots=2 (RFC 3414
    section 2.2.2).
    """
    t.timeout(10.0)
    mn = MemNet()
    eid = h("80001f888001aabbccddeeff")
    u = Usm.from_passwords("shaonly", usm.AUTH_SHA1, "authpassword")
    cfg = ReceiverConfig([], [u], [eid], h("80001f8880616374736e6d7072"), 1)
    var delivered: list[Notification] = []

    def on_notification(r: NotificationReceiver, n: Notification) -> None:
        delivered.append(n)

    rcv = NotificationReceiver(mn.server("10.0.0.9", 162), cfg, on_notification, t.log_handler)
    keys = u.localized(eid)
    hdr = V3Message(4711, 65507, message.FLAG_AUTH, UsmSecurityParameters(eid, 1, 100000, b"shaonly"))
    old = Pdu(pdu.TRAP_V2, 1, 0, 0, notify.build_trap_v2(10000000, TRAP_OID, []))
    mn.send(usm.protect(hdr, message.encode_scoped(ScopedPdu(eid, b"", old)), keys, u64(0)), MANAGER, 40000,
            "10.0.0.9", 162)
    c = Client(None, "10.0.0.9", u, t.log_handler, port=162, transport=mn.client(MANAGER, 40001, "10.0.0.9", 162),
               local_engine_id=eid, local_engine_boots=2)

    def check() -> None:
        s = rcv.stats()
        testing.assertEqual(len(delivered), 2, "delivered %d; receiver stats %s" % (len(delivered), str(s)))

    def sent(cl: Client, e: ?errors.SnmpError) -> None:
        after now 0.3: _finish(t, check)

    def go() -> None:
        c.trap(sent, TRAP_OID, [])

    after now 0.1: go()



# SNMPv3 tooBig split, fatal error during discovery ##################################################

actor _TooBigV3Agent(srv: ServerTransport, u: Usm, eid: bytes):
    # An authoritative engine that answers tooBig to every request with more than one varbind
    var eng = AuthoritativeEngine(eid, 1, _now() - 1000.0, [u])
    salt = SaltCounter(u64(5))
    var sizes: list[int] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        c, m = message.decode(data)
        if m is not None:
            now = _now()
            inc = eng.incoming(data, m, now)
            r = inc.report
            if r is not None:
                srv.send_to(r, address, port)
                return
            sc = inc.scoped
            if sc is not None:
                q = sc.pdu
                sizes.append(len(q.varbinds))
                if len(q.varbinds) > 1:
                    resp = Pdu(pdu.RESPONSE, q.request_id, pdu.TOO_BIG, 0, [])
                else:
                    resp = Pdu(pdu.RESPONSE, q.request_id, 0, 0,
                               [VarBind(vb.oid, OctetString(vb.oid.dotted().encode())) for vb in q.varbinds])
                srv.send_to(eng.respond(m, inc.user, resp, sc.context_engine_id, sc.context_name, now, salt.next()),
                            address, port)

    def seen() -> list[int]:
        return sizes

    srv.set_receiver(on_request)

actor _test_rv_v3_too_big_split(t: testing.AsyncT):
    """SNMPv3 authPriv: tooBig splits like v2c, each part a new exchange; merged in order"""
    t.timeout(10.0)
    mn = MemNet()
    p = mem_pair(mn)
    eid = h(ENGINE_HEX)
    agent = _TooBigV3Agent(p.server, _shaaes(), eid)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=Options(timeout=2.0, retries=0), transport=p.client)
    oids = _oids(3)

    def check(r: ?Response, e: ?errors.SnmpError, sizes: list[int]) -> None:
        if e is not None:
            raise AssertionError("unexpected error " + str(e))
        if r is not None:
            testing.assertEqual([vb.oid for vb in r.varbinds], oids)
            testing.assertEqual([vb.value for vb in r.varbinds], [OctetString(o.dotted().encode()) for o in oids])
        testing.assertEqual(sizes, [3, 1, 2, 1, 1])

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        sizes = agent.seen()
        _finish(t, lambda: check(r, e, sizes))

    c.get(done, oids)


actor _test_rv_fatal_during_discovery(t: testing.AsyncT):
    """A fatal transport error while two requests and a discover() wait for discovery: three TransportErrors"""
    t.timeout(10.0)
    sw = _TransportSwitch()
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=Options(timeout=5.0, retries=0, max_in_flight=1),
               transport=_switch_transport(sw))
    var log: list[str] = []

    def verify() -> None:
        testing.assertEqual(sorted(log), ["disc:transport", "get:transport", "get:transport"])

    def note(what: str) -> None:
        log.append(what)
        if len(log) == 3:
            after now 0.2: _finish(t, verify)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        note("get:" + ("transport" if isinstance(e, errors.TransportError) else _describe(e)))

    def disc(cl: Client, i: ?EngineInfo, e: ?errors.SnmpError) -> None:
        note("disc:" + ("transport" if isinstance(e, errors.TransportError) else _describe(e)))

    c.get(done, _oids(1))
    c.get(done, _oids(1))
    c.discover(disc)
    after now 0.1: sw.fail("socket died")

actor _test_rv_error_index_outside_part(t: testing.AsyncT):
    """A split GET whose second part is answered genErr with an index beyond that part: index 0, no OID blamed"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=Options(timeout=2.0, retries=0,
               max_oids_per_request=2), transport=p.client)
    var parts = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        cm = _cm(data)
        parts += 1
        if parts == 2:
            p.server.send_to(_reply(cm, _pdu(cm).varbinds, pdu.GEN_ERR, 7), address, port)
        else:
            p.server.send_to(_reply(cm, _answer(_pdu(cm).varbinds)), address, port)

    def check(e: ?errors.SnmpError) -> None:
        if isinstance(e, errors.ErrorStatusError):
            testing.assertEqual((e.status, e.index), (pdu.GEN_ERR, 0))
            testing.assertTrue(e.oid is None, "no OID blamed")
            r = error_response(e)
            if r is not None:
                testing.assertEqual(r.error_index, 0)
        else:
            raise AssertionError("expected ErrorStatusError, got " + _describe(e))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(e))

    p.server.set_receiver(on_request)
    c.get(done, _oids(5))

actor _test_rv_stats_queue(t: testing.AsyncT):
    """Stats.queued and Stats.in_flight show the backlog of a slow agent"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=Options(timeout=5.0, retries=0, max_in_flight=2),
               transport=p.client)

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        pass

    for i in range(5):
        c.get(done, _oids(1))
    s = c.stats()
    c.close()
    _finish(t, lambda: testing.assertEqual((s.queued, s.in_flight, s.requests), (3, 2, 5)))

actor _test_rv_trap_boots_validated(t: testing.AsyncT):
    """local_engine_boots outside 1..2^31-1 is an EncodeError of trap(); the encoded boots is the parameter"""
    mn = MemNet()
    srv = mn.server("10.0.0.9", 162)
    eid = h("80001f888001aabbccddeeff")
    u = Usm.from_passwords("shaonly", usm.AUTH_SHA1, "authpassword")
    bad = Client(None, "10.0.0.9", u, None, port=162, transport=mn.client(MANAGER, 40001, "10.0.0.9", 162),
                 local_engine_id=eid, local_engine_boots=0)
    good = Client(None, "10.0.0.9", u, None, port=162, transport=mn.client(MANAGER, 40002, "10.0.0.9", 162),
                  local_engine_id=eid, local_engine_boots=77)
    var log: list[str] = []
    var boots = -1

    def on_data(data: bytes, address: str, port: int) -> None:
        boots = _v3(data).usm.boots
        log.append("received")
        if len(log) == 3:
            _finish(t, verify)

    def verify() -> None:
        testing.assertEqual(sorted(log), ["bad:EncodeError", "good:ok", "received"])
        testing.assertEqual(boots, 77)

    def bad_done(cl: Client, e: ?errors.SnmpError) -> None:
        log.append("bad:" + ("EncodeError" if isinstance(e, errors.EncodeError) else _describe(e)))
        if len(log) == 3:
            _finish(t, verify)

    def good_done(cl: Client, e: ?errors.SnmpError) -> None:
        log.append("good:" + _describe(e))
        if len(log) == 3:
            _finish(t, verify)

    srv.set_receiver(on_data)
    bad.trap(bad_done, TRAP_OID, [])
    good.trap(good_done, TRAP_OID, [])

def _test_rv_options_repr_complete() -> None:
    """repr(Options()) names every field"""
    r = repr(Options())
    for name in ["timeout", "retries", "backoff", "max_timeout", "max_in_flight", "max_oids_per_request",
                 "max_repetitions", "use_bulk", "adaptive_bulk", "check_increasing", "get_root_if_empty",
                 "max_walk_varbinds", "v1_fix_errors", "strict_response_oids", "check_community", "request_id_bits",
                 "max_queued", "split_too_big"]:
        testing.assertTrue(name + "=" in r, name + " missing in " + r)

actor _test_rv_max_queued(t: testing.AsyncT):
    """Options.max_queued: with 2 queued behind a silent agent, the next request fails at once with QueueFullError"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=Options(timeout=5.0, retries=0, max_queued=2),
               transport=p.client)
    var log: list[str] = []
    var s: ?Stats = None

    def check() -> None:
        testing.assertEqual(log, ["full", "cancelled", "cancelled", "cancelled"])
        st = s
        if st is not None:
            testing.assertEqual((st.queued, st.in_flight, st.requests), (2, 1, 3))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        log.append("cancelled" if isinstance(e, errors.CancelledError) else
                   ("full" if isinstance(e, errors.QueueFullError) else _describe(e)))
        if len(log) == 4:
            _finish(t, check)

    for i in range(4):
        c.get(done, _oids(1))
    s = c.stats()
    c.close()
