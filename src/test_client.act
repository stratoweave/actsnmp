    c.get(done, _oids(1))


actor _test_wrong_version_and_pdu_type_dropped(t: testing.AsyncT):
    """An SNMPv1 answer to a v2c request and answers with a non-Response PDU type are dropped"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _answer(_pdu(req).varbinds)
        p.server.send_to(_reply(req, vbs, version=message.SNMP_V1), address, port)
        p.server.send_to(_reply(req, vbs, pdu_type=pdu.GET), address, port)
        p.server.send_to(_reply(req, vbs, pdu_type=pdu.REPORT), address, port)
        trap = TrapV1Pdu(ENTERPRISE, b"\x0a\x00\x00\x01", 6, 1, 0, [])
        p.server.send_to(message.encode_community(CommunityMessage(message.SNMP_V1, b"public", None, trap)), address, port)
        p.server.send_to(_reply(req, vbs), address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        _ok(r, e)
        s = c.stats()
        testing.assertEqual((s.drops_version, s.drops_pdu), (2, 2))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get(done, _oids(1))


actor _test_community_check_option(t: testing.AsyncT):
    """Another community is accepted by default (like net-snmp) and dropped with check_community"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=SLOW, transport=p.client)
    var phase = 0

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        vbs = _answer(_pdu(req).varbinds)
        p.server.send_to(_reply(req, vbs, community=b"other"), address, port)
        if phase == 1:
            p.server.send_to(_reply(req, vbs), address, port)

    def checked(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        def verify() -> None:
            _ok(r, e)
            testing.assertEqual(c.stats().drops_auth, 1, "the other community was dropped")
        _finish(t, verify)

    def unchecked(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        try:
            _ok(r, e)
            testing.assertEqual(c.stats().drops_auth, 0)
        except Exception as ex:
            t.failure(ex)
            return
        phase = 1
        c.get(checked, _oids(1), SLOW.with_(check_community=True))

    p.server.set_receiver(on_request)
    c.get(unchecked, _oids(1))


actor _test_timeout_hint_drops(t: testing.AsyncT):
    """Every answer fails the community check: the TimeoutError says so"""
    mn = MemNet()
    p = mem_pair(mn)
    c = Client(None, AGENT, Community("public"), t.log_handler, opts=Options(timeout=0.05, retries=1, check_community=True),
               transport=p.client)

    def on_request(data: bytes, address: str, port: int) -> None:
        req = _cm(data)
        p.server.send_to(_reply(req, _answer(_pdu(req).varbinds), community=b"wrong"), address, port)
        p.server.send_to(b"junk", address, port)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.TimeoutError):
            testing.assertEqual(err.hint, "2 datagrams failed authentication; 2 undecodable datagrams")
            testing.assertTrue("2 datagrams failed authentication" in err.error_message)
        else:
            testing.error("not a TimeoutError: " + str(err))

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get(done, _oids(1))


actor _test_icmp_unreachable_hint(t: testing.AsyncT):
