        agent.reboot(2)
        c.get(second, _oids(1))

    c.get(first, _oids(1))


actor _test_v3_resync_budget(t: testing.AsyncT):
    """notInTimeWindows again after the one resync: ReportError, and the engine state is reset"""
    mn = MemNet()
    p = mem_pair(mn)
    agent = _V3Agent(p.server, _users(), _engine_id())
    agent.set_mode(ALWAYS_TIME_WINDOW)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=SLOW, transport=p.client)

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        err = _failed(r, e)
        if isinstance(err, errors.ReportError):
            testing.assertEqual(err.name, usm.USM_STATS_NOT_IN_TIME_WINDOWS)
            testing.assertEqual(err.oid, usm.report_oid(usm.USM_STATS_NOT_IN_TIME_WINDOWS).arcs)
            testing.assertEqual(err.value, 1)
            testing.assertFalse(err.transient)
        else:
            testing.error("not a ReportError: " + str(err))
        testing.assertEqual(agent.seen(), ["probe", usm.USM_STATS_NOT_IN_TIME_WINDOWS, usm.USM_STATS_NOT_IN_TIME_WINDOWS])
        testing.assertTrue(c.engine_info() is None, "engine state reset")

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    c.get(done, _oids(1))


