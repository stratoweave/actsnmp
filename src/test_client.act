actor _test_v3_wire_format(t: testing.AsyncT):
    """The probe is RFC 3414's; requests carry fresh msgIDs per attempt, the same request-id, reportable authPriv"""
    mn = MemNet()
    p = mem_pair(mn)
    users = _users()
    eng = AuthoritativeEngine(_engine_id(), 1, _now() - 1000.0, users)
    c = Client(None, AGENT, _shaaes(), t.log_handler, opts=Options(timeout=0.05, retries=2), transport=p.client)
    keys = _shaaes().localized(_engine_id())
    var msgs: list[V3Message] = []
    var scoped: list[ScopedPdu] = []

    def on_request(data: bytes, address: str, port: int) -> None:
        m = _v3(data)
        msgs.append(m)
        if m.usm.engine_id == b"":
            r = eng.incoming(data, m, _now()).report
            if r is not None:
                p.server.send_to(r, address, port)
        else:
            scoped.append(usm.unprotect(data, m, keys))     # never answered: retries

    def check(r: ?Response, e: ?errors.SnmpError) -> None:
        _failed(r, e)
        testing.assertEqual(len(msgs), 4)
        probe = msgs[0]
        testing.assertEqual(probe.flags, message.FLAG_REPORTABLE)
        testing.assertEqual(probe.usm, UsmSecurityParameters())
        s0 = probe.scoped
        if s0 is not None:
            testing.assertEqual((s0.context_engine_id, s0.context_name, s0.pdu.pdu_type, s0.pdu.varbinds),
                                (b"", b"", pdu.GET, []))
        else:
            testing.error("probe without plaintext ScopedPDU")
        reqs = msgs[1:]
        testing.assertEqual(len(set([m.msg_id for m in reqs + [probe]])), 4, "fresh msgIDs")
        for m in reqs:
            testing.assertEqual(m.flags, message.FLAG_AUTH | message.FLAG_PRIV | message.FLAG_REPORTABLE)
            testing.assertEqual((m.usm.engine_id, m.usm.user, m.max_size), (_engine_id(), b"shaaes", 65507))
            testing.assertEqual(m.usm.boots, 1)
            testing.assertTrue(m.usm.time >= 1000 and m.usm.time < 1010, "hint time %d" % m.usm.time)
        testing.assertEqual(len(set([m.usm.priv_params for m in reqs])), 3, "fresh salts")
        testing.assertEqual(len(set([s.pdu.request_id for s in scoped])), 1, "same request-id")
        testing.assertEqual(scoped[0].context_engine_id, _engine_id())
        if isinstance(e, errors.TimeoutError):
            testing.assertEqual(e.hint, "with authPriv, a wrong privacy password or protocol also gives no response")
        else:
            testing.error("not a TimeoutError")

    def done(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        _finish(t, lambda: check(r, e))

    p.server.set_receiver(on_request)
    c.get(done, _oids(1))


