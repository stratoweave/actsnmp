# Rows of the B.10 table (interop/expected/canon/table.txt): c=1 INTEGER i, c=6 OID B.10.1.1.i.
LAB_TABLE = r""".1.3.6.1.4.1.8072.9999.1.10.1.1.1 = INTEGER: 1
.1.3.6.1.4.1.8072.9999.1.10.1.1.2 = INTEGER: 2
.1.3.6.1.4.1.8072.9999.1.10.1.1.3 = INTEGER: 3
.1.3.6.1.4.1.8072.9999.1.10.1.1.99 = INTEGER: 99
.1.3.6.1.4.1.8072.9999.1.10.1.1.100 = INTEGER: 100
.1.3.6.1.4.1.8072.9999.1.10.1.1.255 = INTEGER: 255
.1.3.6.1.4.1.8072.9999.1.10.1.1.256 = INTEGER: 256
.1.3.6.1.4.1.8072.9999.1.10.1.1.299 = INTEGER: 299
.1.3.6.1.4.1.8072.9999.1.10.1.1.300 = INTEGER: 300
.1.3.6.1.4.1.8072.9999.1.10.1.6.1 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.1
.1.3.6.1.4.1.8072.9999.1.10.1.6.2 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.2
.1.3.6.1.4.1.8072.9999.1.10.1.6.3 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.3
.1.3.6.1.4.1.8072.9999.1.10.1.6.99 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.99
.1.3.6.1.4.1.8072.9999.1.10.1.6.100 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.100
.1.3.6.1.4.1.8072.9999.1.10.1.6.255 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.255
.1.3.6.1.4.1.8072.9999.1.10.1.6.256 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.256
.1.3.6.1.4.1.8072.9999.1.10.1.6.299 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.299
.1.3.6.1.4.1.8072.9999.1.10.1.6.300 = OID: .1.3.6.1.4.1.8072.9999.1.10.1.1.300"""

LAB_BASE = "1.3.6.1.4.1.8072.9999.1"


def _canon_rows(text: str) -> list[(Oid, str, str)]:
    """(oid, type, value text) of canonical `OID = TYPE: value` lines."""
    out: list[(Oid, str, str)] = []
    for line in text.splitlines():
        if line == "":
            continue
        eq = line.find(" = ")
        colon = line.find(": ", eq)
        out.append((Oid.parse(line[:eq]), line[eq + 3:colon], line[colon + 2:]))
    return out


def _test_lab_strtable() -> None:
    parts = spec("var")
    rows = _canon_rows(LAB_STRTABLE)
    testing.assertEqual(len(rows), 60)
    names: dict[int, set[bytes]] = {}
    for r in rows:
        col = Oid.parse(LAB_BASE + ".11.1").arcs
        c = r.0.arcs[len(col)]
        vals = index.decode_instance(r.0, Oid(col + [c]), parts)
        testing.assertEqual(len(vals), 1)
        v = vals[0]
        if isinstance(v, OctetString):
            ns = names.get(c)
            if ns is not None:
                ns.add(v.value)
            else:
                names[c] = {v.value}
            if c == 1:
                # column 1 holds the name that is the index
                testing.assertEqual(r.1, "STRING")
                testing.assertEqual("\"" + v.value.decode() + "\"", r.2)
        else:
            testing.error("not an OctetString: " + repr(v))
        testing.assertEqual(Oid(col + [c] + index.encode_index(vals, parts)), r.0)
    testing.assertEqual(len(names[1]), 20)
    testing.assertEqual(names[1], names[2])
    testing.assertEqual(names[1], names[3])
    testing.assertTrue(b"a-long-interface-name-for-index-tests" in names[1])
    testing.assertTrue(b"ge-0/0/4" in names[1])
    # the same rows as IMPLIED (no length) and fixed: the decoders disagree as they must
    try:
        index.decode_index(od("4.101.116.104.48"), spec("fixed(4)"))
        testing.error("fixed(4) accepted a length-prefixed name")
    except IndexDecodeError as e:
        testing.assertTrue("trailing" in e.error_message)
    testing.assertEqual(index.decode_index(od("4.101.116.104.48"), spec("implied")), [oh("0465746830")])


def _test_lab_table() -> None:
    rows = _canon_rows(LAB_TABLE)
    testing.assertEqual(len(rows), 18)
    col = Oid.parse(LAB_BASE + ".10.1").arcs
    for r in rows:
        c = r.0.arcs[len(col)]
        vals = index.decode_instance(r.0, Oid(col + [c]), spec("int"))
        i = vals[0]
        if isinstance(i, Integer):
            if c == 1:
                testing.assertEqual(r.2, str(i.value))
            else:
                # c=6 points at column 1 of the same row
                testing.assertEqual(Oid.parse(r.2), Oid(col + [1, i.value]))
        else:
            testing.error("not an Integer: " + repr(i))


def _u32(rng: Lcg) -> int:
    return (rng.next64() >> 32) & 0xffffffff


def _random_value(rng: Lcg, p: IndexPart) -> Value:
    k = p.enc
    if k == "int":
        return Integer(_u32(rng) if rng.below(2) == 0 else rng.below(10))
    if k == "fixed" or k == "var" or k == "implied":
        n = p.size if k == "fixed" else rng.below(12)
        return OctetString(bytes([rng.below(256) for i in range(n)]))
    if k == "oid" or k == "oid-implied":
        n = rng.below(10)
        return ObjectIdentifier(Oid([_u32(rng) if rng.below(4) == 0 else rng.below(200) for i in range(n)]))
    return ip(rng.below(256), rng.below(256), rng.below(256), rng.below(256))


def _random_spec(rng: Lcg) -> list[IndexPart]:
    n = rng.below(5)
    out: list[IndexPart] = []
    for i in range(n):
        e = index.ENCODINGS[rng.below(8)]
        if (e == "implied" or e == "oid-implied") and i != n - 1:
            e = "var"
        out.append(IndexPart(e, rng.below(7) if e == "fixed" else 0))
    return out


def _test_round_trip_fuzz() -> None:
    """Random specs and values: encode then decode gives the values back; every mutation of the
    suffix (truncation, extension, changed sub-ids) decodes or raises IndexDecodeError, nothing
    else."""
    rng = Lcg(2578)
    decoded = 0
    rejected = 0
    for t in range(2000):
        parts = _random_spec(rng)
        vals = [_random_value(rng, p) for p in parts]
        suffix = index.encode_index(vals, parts)
        testing.assertEqual(index.decode_index(suffix, parts), vals, index.spec_str(parts))
        for m in range(4):
            s2 = list(suffix)
            how = rng.below(4)
            if how == 0 and len(s2) > 0:
                s2 = s2[:rng.below(len(s2))]
            elif how == 1:
                s2.append(rng.below(300))
            elif how == 2 and len(s2) > 0:
                s2[rng.below(len(s2))] = rng.below(4) * 100 if rng.below(2) == 0 else 4294967295
            elif len(s2) > 0:
                s2[rng.below(len(s2))] = -1 if rng.below(8) == 0 else 129
            try:
                v2 = index.decode_index(s2, parts)
                testing.assertEqual(len(v2), len(parts))
                testing.assertEqual(index.encode_index(v2, parts), s2)
                decoded += 1
            except IndexDecodeError:
                rejected += 1
    testing.assertTrue(decoded > 1000, "decoded %d" % decoded)
    testing.assertTrue(rejected > 1000, "rejected %d" % rejected)
