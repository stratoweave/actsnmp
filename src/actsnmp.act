"""actsnmp: a command line SNMP tool compatible with net-snmp's

    actsnmp get|getnext|bulkget|walk|bulkwalk|set|table [OPTIONS] AGENT ...
    actsnmp trap|inform [OPTIONS] AGENT ...
    actsnmp agent|trapd [OPTIONS]
    actsnmp translate|mib2yang|mibmeta|miblint [OPTIONS] ...

The client commands mimic snmpget, snmpgetnext, snmpbulkget, snmpwalk,
snmpbulkwalk, snmpset, snmptrap and snmpinform: same options (see
cliopts), same stdout and stderr text, same exit codes. Without MIBs the
output is that of net-snmp run with `-m '' -On`. The exit code is 0 on
success (exception values and "End of MIB" included), 1 for a timeout, a
non-increasing OID or a local error, and 2 when the agent answers with an
error-status. interop/clicheck.sh runs the same command lines through
both tools and compares the output.

Like net-snmp, get and getnext drop the failed varbind and retry after an
error-status unless -Cf is given. walk and bulkwalk write their output per
response, so large walks are not buffered. With -Cc, where net-snmp would
loop forever, a repeated OID ends the walk with an error. table fetches
the columns with Client.get_table and prints the rows in index order.

An agent address with tcp: or tcp6: carries the command over TCP (RFC
3430, transport.tcp_transport()). net-snmp's tools connect when they open
the session, so a connection that fails before the agent has answered
anything ends the command at once with net-snmp's error, "snmpget:
Unknown host (tcp:HOST:PORT) (Connection refused)" (TcpWatch). A trap gets
no answer, so over TCP the command waits for its connection: it exits with
0 shortly after the connection came up and carried the trap, or with
net-snmp's error and code 1 if the connection failed within -t seconds.
Host names of udp6: and tcp6: addresses resolve to IPv6 addresses only
and those of tcp: addresses to IPv4 addresses, as in net-snmp; a tcp:
name without an IPv4 address resolves to IPv6. A name that does not
resolve is net-snmp's "Unknown host" (resolves_name(), HostLookup).

agent serves an snmprec file (the lab dataset by default) until SIGTERM or
SIGINT. trapd prints each notification it receives, canonically with
--canon or otherwise in net-snmp style. Both listen on UDP, or with --tcp
on TCP. The MIB commands are in mibcli.

The commands are actors that take the parsed options, a Client and output
callbacks, so test_cli can run them in-process over transport.MemNet.
"""

import file
import net
import time

import cliopts
import errors
import fmt
import message
import mibcli
import mibview
import pdu
import security
import usm
from agent import Agent, AgentConfig
from client import Client, EngineInfo, Options, Response, Table, error_response
from cliopts import CliError, CliOptions
from mibview import MibView
from notify import Notification
from oid import Oid
from receiver import NotificationReceiver, ReceiverConfig
from security import Community, Security, Usm
from transport import ServerTransport, Transport, tcp_server_transport, tcp_transport, udp_server_transport
from values import ObjectIdentifier, VarBind, is_exception

VERSION = "0.1.0-dev"

# Seconds a trap command waits after handing its datagram to the transport before it exits; over
# TCP, after its connection came up and the trap was written
TRAP_LINGER = 0.3

# Longest wait for a TCP connection to come up, in seconds: about as long as Linux retries a SYN
TCP_CONNECT_MAX = 120.0

# How the Client's TimeoutError.hint starts when the SNMPv3 engine discovery timed out
DISCOVERY_HINT = "SNMPv3 engine discovery"

# net-snmp's texts for the SNMPv3 Reports that end a request (snmp_api_errstring)
_REPORT_TEXTS: dict[str, str] = {
    "usmStatsUnknownUserNames": "Unknown user name",
    "usmStatsWrongDigests": "Authentication failure (incorrect password, community or key)",
    "usmStatsUnsupportedSecLevels": "Unsupported security level",
    "usmStatsNotInTimeWindows": "Not in time window",
    "usmStatsUnknownEngineIDs": "Unknown engine ID",
    "usmStatsDecryptionErrors": "Decryption error",
    "snmpUnknownSecurityModels": "Unknown security model in message",
}


# Helpers shared by the commands #####################################################################

def tool_name(o: CliOptions) -> str:
    """The net-snmp tool a command imitates, for its messages ("snmpget", "snmpinform", ...)"""
    if o.command == "trap" or o.command == "inform":
        return "snmpinform" if o.inform else "snmptrap"
    if o.command == "agent":
        return "snmpd"
    if o.command == "trapd":
        return "snmptrapd"
    return "snmp" + o.command

def varbind_text(o: CliOptions, vb: VarBind) -> str:
    """One output line without its newline: net-snmp style per the -O options, or canonical with --canon"""
    if o.canon:
        return fmt.canon_varbind(vb)
    t = o.mib
    if t is not None:
        return mibcli.varbind_text(t, vb, o.output, o.inp.use_hints)
    return fmt.netsnmp_varbind(vb, o.output)

def oid_text(o: ?CliOptions, oid: Oid) -> str:
    """An OID in messages (net-snmp's fprint_objid): numeric, or with MIBs loaded named in the -O style"""
    if o is not None:
        t = o.mib
        if t is not None and not o.canon:
            return mibcli.oid_text(t, oid.arcs, o.output).0
    return oid.dotted()

def lines_text(o: CliOptions, vbs: list[VarBind]) -> str:
    """varbind_text of every varbind, each followed by a newline"""
    return "".join([varbind_text(o, vb) + "\n" for vb in vbs])

def request_options(o: CliOptions) -> Options:
    """Client Options that behave like net-snmp: -t/-r, a fixed timeout per attempt, nothing split or fixed

    Every OID goes in one PDU, tooBig is reported like any other
    error-status, and SNMPv1's noSuchName is left to the command.
    """
    return Options(timeout=o.timeout, retries=o.retries, backoff=1.0,
                   max_timeout=o.timeout, max_oids_per_request=0,
                   max_repetitions=o.max_repetitions, v1_fix_errors=False, split_too_big=False)

def security_of(o: CliOptions) -> Security:
    """The Community or Usm of the command line

    Derives the SNMPv3 master keys, so call it once per process. Raises
    ValueError for credentials the library rejects.
    """
    if o.version == message.SNMP_V3:
        if o.session_error != "":
            # only the engine discovery runs (Command): a noAuthNoPriv user that needs no pass phrase
            return Usm.from_passwords(o.user if o.user != "" else "-", usm.AUTH_NONE, "", usm.PRIV_NONE, "",
                                      o.context, o.context_engine_id)
        return Usm.from_passwords(o.user, o.auth_protocol, o.auth_password, o.priv_protocol, o.priv_password,
                                  o.context, o.context_engine_id)
    community = o.community
    return Community(community if community is not None else "", o.version)

def failed_object(r: ?Response, e: errors.ErrorStatusError, o: ?CliOptions=None) -> str:
    """The text after "Failed object: ": the OID error-index points at in the response, "" if there is none"""
    if r is not None:
        if e.index >= 1 and e.index <= len(r.varbinds):
            return oid_text(o, r.varbinds[e.index - 1].oid)
        return ""
    arcs = e.oid
    if arcs is not None:
        return oid_text(o, Oid(arcs))
    return ""

def error_status_text(period: bool, e: errors.ErrorStatusError, o: ?CliOptions=None) -> str:
    """net-snmp's stderr text for an error-status, with the final newline

    period adds the period every tool but snmpget prints after "Error in
    packet". A non-zero error-index adds a "Failed object: <OID>" line and
    an empty line.
    """
    text = "Error in packet" + ("." if period else "") + "\nReason: " + pdu.error_status_text(e.status) + "\n"
    if e.index != 0:
        return text + "Failed object: " + failed_object(error_response(e), e, o) + "\n\n"
    return text

def failure_text(o: CliOptions, e: errors.SnmpError, period: bool) -> str:
    """The stderr text of a request that failed without an error-status, with the final newline

    A timeout is "Timeout: No Response from <agent>" (with a period for
    snmpget and snmpgetnext), or "<tool>: Timeout" when the SNMPv3 engine
    discovery timed out, since net-snmp discovers when it opens the session.
    Other errors are "<tool>: <reason>" with net-snmp's texts for SNMPv3
    Reports and, with MIBs, the detail a failed name lookup left behind:
    "snmpget: Unknown user name (Sub-id not found: (top) -> sysDescr)".
    """
    stale = " (" + o.mib_detail + ")" if o.mib_detail != "" else ""
    if isinstance(e, errors.TimeoutError):
        hint = e.hint
        if hint is not None and hint.startswith(DISCOVERY_HINT):
            return tool_name(o) + ": Timeout" + stale + "\n"
        return "Timeout: No Response from " + o.peer + ("." if period else "") + "\n"
    if isinstance(e, errors.TransportError) and "DNS lookup" in e.error_message:
        return unknown_host_text(o, "")
    if isinstance(e, errors.ReportError):
        t = _REPORT_TEXTS.get(e.name)
        if t is not None:
            return tool_name(o) + ": " + t + stale + "\n"
    return tool_name(o) + ": " + e.error_message + stale + "\n"

def unknown_host_text(o: CliOptions, reason: str) -> str:
    """net-snmp's error when it cannot open the session to the agent, with the final newline

    "snmpget: Unknown host (tcp:HOST:PORT) (Connection refused)"; an empty
    reason, for a host name that does not resolve, leaves the second
    parenthesis out.
    """
    return tool_name(o) + ": Unknown host (" + o.peer + ")" + (" (" + reason + ")" if reason != "" else "") + "\n"

def session_error_text(o: CliOptions) -> str:
    """CliOptions.session_error as net-snmp prints it when it opens the session, with the final newline"""
    return o.session_error + (" (" + o.mib_detail + ")" if o.mib_detail != "" else "") + "\n"

def build_problem(o: CliOptions) -> str:
    """net-snmp's error for an OID whose first sub-identifier is above 2, or ""

    Our encoder refuses such OIDs too; this reports them in net-snmp's
    words before anything is sent.
    """
    head = "snmp_build: unknown failure\n" + tool_name(o) + ": Error building ASN.1 representation ("
    bad_name = head + "Can't build OID for variable)\n"
    bad_value = head + "build objid: bad first subidentifier)\n"
    if o.command == "trap" or o.command == "inform":
        first = o.enterprise if o.version == message.SNMP_V1 else o.trap_oid
        if len(first.arcs) > 0 and first.arcs[0] > 2:
            return bad_value
    for n in o.oids:
        if len(n.arcs) > 0 and n.arcs[0] > 2:
            return bad_name
    for vb in o.varbinds:
        v = vb.value
        if len(vb.oid.arcs) > 0 and vb.oid.arcs[0] > 2:
            return bad_name
        if isinstance(v, ObjectIdentifier) and len(v.value.arcs) > 0 and v.value.arcs[0] > 2:
            return bad_value
    return ""

def oid_not_increasing(previous: Oid, received: Oid, o: ?CliOptions=None) -> str:
    """net-snmp's walk error for a received OID that is not greater than the previous one"""
    return "Error: OID not increasing: " + oid_text(o, previous) + "\n >= " + oid_text(o, received) + "\n\n"

def walk_end(o: CliOptions) -> ?Oid:
    """snmpwalk's end of the walk: -CE, else the root with its last arc + 1 (None: no upper bound)"""
    e = o.end_oid
    if e is not None:
        return e
    return o.oids[0].next_sibling()

def notification_text(o: CliOptions, n: Notification) -> str:
    """What trapd prints for one notification, with the final newline

    With --canon this is fmt.canon_notification(n). Otherwise the header
    gets `from=ADDRESS:PORT` (`[ADDRESS]:PORT` for IPv6, `session-N` for
    TCP session N, see Notification.source()) after the PDU type and the
    varbinds are printed in net-snmp style. An SNMPv1 trap shows its original varbinds, without
    the snmpTrapCommunity.0 that RFC 3584 translation adds.
    """
    block = fmt.canon_notification(n)
    if o.canon:
        return block + "\n"
    first = block.split("\n")[0]
    words = first.split(" ")
    head = " ".join(words[:3]) + " from=" + n.source()
    if len(words) > 3:
        head += " " + " ".join(words[3:])
    v1 = n.v1
    vbs = v1.varbinds if v1 is not None else n.varbinds
    return head + "\n" + "".join([varbind_text(o, vb) + "\n" for vb in vbs]) + "END\n"

def agent_communities(o: CliOptions) -> dict[str, bool]:
    """agent -c (read-only) and -w (read-write) communities; without either the lab's public (ro) and private (rw)"""
    if len(o.communities) == 0 and len(o.rw_communities) == 0:
        return {"public": False, "private": True}
    d: dict[str, bool] = {}
    for c in o.communities:
        d[c] = False
    for c in o.rw_communities:
        d[c] = True
    return d

def agent_config(o: CliOptions, rules_text: str, users_text: ?str) -> AgentConfig:
    """The AgentConfig of `actsnmp agent`; raises ValueError for invalid files"""
    users: list[Usm] = []
    read_only: list[str] = []
    if users_text is not None:
        u = security.load_users_tsv(users_text)
        users = u.users
        read_only = u.read_only
    return AgentConfig(agent_communities(o), users, o.server_engine_id, 1, mibview.load_write_rules(rules_text),
                       read_only_users=read_only)

def trapd_config(o: CliOptions, users_text: ?str) -> ReceiverConfig:
    """The ReceiverConfig of `actsnmp trapd`: -c communities (default public), the users file, any trap sender engine"""
    communities = o.communities if len(o.communities) > 0 else ["public"]
    users: list[Usm] = []
    if users_text is not None:
        users = security.load_users_tsv(users_text).users
    return ReceiverConfig(communities, users, [], o.server_engine_id, 1)


def table_text(o: CliOptions, t: Table) -> str:
    """The lines of `table`: the rows in index order, each row's values in the order of the columns"""
    out: list[str] = []
    for row in t.rows:
        for k in range(len(t.columns)):
            v = row.cells[k]
            if v is not None:
                out.append(varbind_text(o, VarBind(t.columns[k].child(row.index), v)) + "\n")
    return "".join(out)

def table_options(o: CliOptions) -> Options:
    """request_options for Client.get_table: -Cr is its max-repetitions, -Cc turns the increasing check off

    table has no net-snmp counterpart to imitate, so a tooBig answer halves the GETBULK as in any table walk.
    """
    return request_options(o).with_(check_increasing=not o.dont_check, split_too_big=True)


# TCP and host names #################################################################################

# strerror() texts that net-snmp prints where the network's texts for the same errors differ
_STRERROR: dict[str, str] = {"host is unreachable": "No route to host",
                             "address not available": "Cannot assign requested address"}

def connect_failure(error: str) -> str:
    """The reason in net-snmp's words when a transport error says that a TCP connection failed, else ""

    tcp_transport() reports "TCP connection to ADDRESS:PORT failed: REASON"
    with REASON in lower case as the network gives it (refused, unreachable,
    or "no connection within N s"). net-snmp prints strerror()'s text, and
    "Connection timed out" when the connection does not come up. An error
    on a connection that was up ("TCP connection to ... lost: REASON") is
    not a failed connection.
    """
    if not error.startswith("TCP connection to "):
        return ""
    i = error.find(" failed: ")
    if i < 0:
        return ""
    reason = error[i + len(" failed: "):]
    if reason.startswith("no connection within "):
        return "Connection timed out"
    t = _STRERROR.get(reason)
    if t is not None:
        return t
    return reason[:1].upper() + reason[1:]

def tcp_connect_timeout(o: CliOptions) -> float:
    """Seconds the TCP connection to the agent has to come up, at most TCP_CONNECT_MAX

    A trap waits -t seconds for it. Other commands give it longer than all
    tries of a request together (-t times (-r + 1)), so that an agent that
    never accepts the connection times out like one that does not answer
    over UDP: "Timeout: No Response from AGENT".
    """
    wait = o.timeout if o.command == "trap" and not o.inform else o.timeout * float(o.retries + 2)
    return wait if wait < TCP_CONNECT_MAX else TCP_CONNECT_MAX

proc def tcp_client_transport(cap: net.TCPConnectCap, o: CliOptions, on_connect: action() -> None) -> Transport:
    """tcp_transport() to the agent of a tcp: or tcp6: address, after resolves_name()

    stall_timeout is twice -t: the first retry of a request goes out on the
    same connection, so an answer that comes later than -t still counts, as
    over UDP; a later retry goes out on a new connection, in case the peer
    reset the old one (see tcp_transport()). on_connect is called each time
    a connection has come up.
    """
    return tcp_transport(cap, o.address, o.port, connect_timeout=tcp_connect_timeout(o),
                         stall_timeout=2.0 * o.timeout, on_connect=on_connect)

proc def tcp_command(cap: net.TCPConnectCap, o: CliOptions, sec: Security, out: action(str) -> None,
                     err: action(str) -> None, on_done: action(int) -> None) -> Command:
    """The Command of a client command over TCP, with a TcpWatch on its transport

    The Client sends over tcp_client_transport(). The TcpWatch ends the
    Command when the connection fails before the agent has answered
    (Command.connection_failed()) and tells it when the connection is up
    (Command.connected()), which ends a trap.
    """
    w = TcpWatch()
    tr = w.watch(tcp_client_transport(cap, o, w.connected))
    cmd = Command(o, new_client(None, o, sec, tr), out, err, on_done)
    w.on_failure(cmd.connection_failed)
    w.on_connect(cmd.connected)
    return cmd

def resolves_name(o: CliOptions) -> bool:
    """Whether the agent's host is looked up (HostLookup) before the command sets up its transport

    The command then uses the address found. As in net-snmp, udp6: and tcp6:
    hosts must resolve to IPv6 addresses (an IPv4 address gives "Unknown
    host") and tcp: names to IPv4 addresses. A tcp: name that does not
    resolve is "Unknown host"; tcp_transport() takes IP addresses only.
    udp: names are left to the UDP socket, which reports a name that does
    not resolve.
    """
    d = o.transport_domain
    if d == "udp6" or d == "tcp6":
        return not net.is_ipv6(o.address)
    if d == "tcp":
        return not (net.is_ipv4(o.address) or net.is_ipv6(o.address))
    return False


actor HostLookup(cap: net.DNSCap, name: str, ipv6_only: bool, on_done: action(str) -> None):
    """Resolves the host name of an agent; on_done(address) once, with "" when the name does not resolve

    ipv6_only asks for AAAA records only. Otherwise the first IPv4 address
    is the answer, and the first IPv6 address only for a name without one.
    """
    def _ipv6_failed(host: str, error: str) -> None:
        on_done("")

    def _ipv6_resolved(addresses: list[str]) -> None:
        on_done(addresses[0] if len(addresses) > 0 else "")

    def _ipv4_failed(host: str, error: str) -> None:
        net.lookup_aaaa(cap, name, _ipv6_resolved, _ipv6_failed)

    def _ipv4_resolved(addresses: list[str]) -> None:
        if len(addresses) > 0:
            on_done(addresses[0])
        else:
            _ipv4_failed(name, "no IPv4 address")

    if ipv6_only:
        net.lookup_aaaa(cap, name, _ipv6_resolved, _ipv6_failed)
    else:
        net.lookup_a(cap, name, _ipv4_resolved, _ipv4_failed)


actor TcpWatch():
    """Passes the messages and errors of a TCP transport on to its owner and watches its connection

    watch(tr) starts watching tr and returns the transport to give the
    owner (the Client), watched(tr, w). When tr reports that its connection
    failed (connect_failure()) before any message has arrived, the action
    given to on_failure() gets the reason, once. connected() is the
    on_connect of tr (tcp_transport()); the action given to on_connect() is
    called once, when the first connection has come up. Both actions are
    called also when they are registered after the event.
    """
    var _on_data: ?action(bytes, str, int) -> None = None
    var _on_error: ?action(str, bool) -> None = None
    var _on_failure: ?action(str) -> None = None
    var _on_connect: ?action() -> None = None
    var _answered = False
    var _failure = ""
    var _up = False

    def watch(tr: Transport) -> Transport:
        tr.set_receiver(_received, _failed)
        return watched(tr, self)

    def set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        _on_data = on_data
        _on_error = on_error

    def on_failure(report: action(str) -> None) -> None:
        _on_failure = report
        if _failure != "":
            report(_failure)

    def on_connect(report: action() -> None) -> None:
        _on_connect = report
        if _up:
            report()

    def connected() -> None:
        if not _up:
            _up = True
            report = _on_connect
            if report is not None:
                report()

    def _received(data: bytes, src_address: str, src_port: int) -> None:
        _answered = True
        on_data = _on_data
        if on_data is not None:
            on_data(data, src_address, src_port)

    def _failed(text: str, fatal: bool) -> None:
        if not _answered and _failure == "":
            _failure = connect_failure(text)
            report = _on_failure
            if report is not None and _failure != "":
                report(_failure)
        on_error = _on_error
        if on_error is not None:
            on_error(text, fatal)


def watched(tr: Transport, w: TcpWatch) -> Transport:
    """tr with its messages and errors passing through w (see TcpWatch)"""
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        w.set_receiver(on_data, on_error)
    return Transport(tr.send, _set_receiver, tr.close, source_checked=tr.source_checked)


# The client commands ################################################################################

actor Command(o: CliOptions, c: Client, out: action(str) -> None, err: action(str) -> None,
              on_done: action(int) -> None):
    """Runs one client command (get ... inform) with Client c

    out and err receive stdout and stderr text as whole lines, in output
    order. on_done is called once with the exit code. The caller owns c
    and closes it. Over TCP the caller calls connection_failed() when the
    connection fails before the agent has answered, and connected() when
    it is up (tcp_command() does).
    """
    _opts = request_options(o)
    _tool = tool_name(o)
    _start = time.monotonic()
    _end: ?Oid = walk_end(o) if (o.command == "walk" and len(o.oids) > 0) else None
    _root: Oid = o.oids[0] if len(o.oids) > 0 else Oid([])
    var _oids: list[Oid] = o.oids
    var _exit = 0
    var _finished = False
    var _trap_handed = False
    var _connection_up = False
    var _name: Oid = o.oids[0] if len(o.oids) > 0 else Oid([])
    var _count = 0
    var _seen: set[bytes] = set()

    proc def _finish(code: int) -> None:
        if not _finished:
            _finished = True
            on_done(code)

    proc def _fail(e: errors.SnmpError, period: bool) -> None:
        err(failure_text(o, e, period))
        _finish(1)

    # get and getnext ---------------------------------------------------------------------------------

    proc def _send_get() -> None:
        if o.command == "get":
            c.get(_got, _oids, _opts)
        else:
            c.get_next(_got, _oids, _opts)

    def _got(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        if e is not None:
            if isinstance(e, errors.ErrorStatusError):
                err(error_status_text(o.command != "get", e, o))
                # snmpgetnext sets its exit code 2 only for an error that names a varbind
                if o.command == "get" or e.index != 0:
                    _exit = 2
                # net-snmp's snmp_fix_pdu: drop the failed varbind and ask again for the rest
                if not o.dont_fix and e.index >= 1 and e.index <= len(_oids) and len(_oids) > 1:
                    _oids = _oids[:e.index - 1] + _oids[e.index:]
                    _send_get()
                else:
                    _finish(_exit)
            else:
                _fail(e, True)
            return
        if r is not None:
            out(lines_text(o, r.varbinds))
        _finish(_exit)

    # bulkget and set ---------------------------------------------------------------------------------

    def _completed(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        if e is not None:
            if isinstance(e, errors.ErrorStatusError):
                if o.command == "bulkget" and e.status == pdu.NO_SUCH_NAME:
                    # snmpbulkget takes noSuchName for the end of the MIB
                    out("End of MIB.\n")
                    _finish(0)
                    return
                err(error_status_text(True, e, o))
                _finish(2)
            else:
                _fail(e, False)
            return
        if r is not None and not o.quiet:
            out(lines_text(o, r.varbinds))
        _finish(0)

    # walk and bulkwalk -------------------------------------------------------------------------------

    proc def _walk_report() -> None:
        if o.print_count:
            out("Variables found: %d\n" % _count)
        if o.print_time:
            err("Total traversal time = %f seconds\n" % time.monotonic().since(_start).to_float())
        _finish(_exit)

    def _got_root(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        # snmp_get_and_print: prints (and counts) the varbinds of a successful answer, ignores everything else
        if e is None and r is not None:
            out(lines_text(o, r.varbinds))
            _count += len(r.varbinds)
        _walk_report()

    proc def _walk_done(success: bool) -> None:
        if _count == 0 and success and not o.dont_get_requested:
            c.get(_got_root, [_root], _opts)
        else:
            _walk_report()

    proc def _walk_next() -> None:
        if o.command == "bulkwalk":
            c.get_bulk(_got_next, [_name], o.non_repeaters, o.max_repetitions, _opts)
        else:
            c.get_next(_got_next, [_name], _opts)

    proc def _repeated(vb: VarBind) -> bool:
        # with -Cc only: a repeated OID would make net-snmp loop forever; stop instead
        if not o.dont_check:
            return False
        k = vb.oid.key()
        if k in _seen:
            return True
        _seen.add(k)
        return False

    proc def _walk_response(vbs: list[VarBind]) -> bool:
        # The varbinds of one response, as snmpwalk/snmpbulkwalk process them; True to go on
        bulk = o.command == "bulkwalk"
        running = True
        buf: list[str] = []
        n = len(vbs)
        for j in range(n):
            vb = vbs[j]
            if bulk:
                if not vb.oid.startswith(_root):
                    running = False
                    continue
            else:
                end = _end
                if end is not None and not (vb.oid < end):
                    running = False
                    continue
            _count += 1
            buf.append(varbind_text(o, vb) + "\n")
            if is_exception(vb.value):
                running = False
                continue
            if not o.dont_check and not (_name < vb.oid):
                out("".join(buf))
                buf = []
                err(oid_not_increasing(_name, vb.oid, o))
                running = False
                _exit = 1
            elif _repeated(vb):
                out("".join(buf))
                buf = []
                err("Error: OID repeated (the agent loops): " + vb.oid.dotted() + "\n")
                running = False
                _exit = 1
            if not bulk or j == n - 1:
                _name = vb.oid
        if len(buf) > 0:
            out("".join(buf))
        return running

    def _got_next(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        if e is not None:
            if isinstance(e, errors.ErrorStatusError):
                if e.status == pdu.NO_SUCH_NAME:
                    out("End of MIB\n")
                else:
                    err(error_status_text(True, e, o))
                    _exit = 2
                _walk_done(True)
            else:
                err(failure_text(o, e, False))
                _exit = 1
                _walk_done(False)
            return
        if r is not None:
            if len(r.varbinds) == 0:
                err(_tool + ": the agent returned no variables (no progress)\n")
                _exit = 1
                _walk_done(False)
            elif _walk_response(r.varbinds):
                _walk_next()
            else:
                _walk_done(True)

    def _got_included(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        # -Ci: snmp_get_and_print of the root; what it prints counts, so the GET of an empty subtree is skipped
        if e is None and r is not None:
            out(lines_text(o, r.varbinds))
            _count += len(r.varbinds)
        _walk_next()

    # table -------------------------------------------------------------------------------------------

    def _got_table(cl: Client, tbl: ?Table, e: ?errors.SnmpError) -> None:
        # Client.get_table: the rows found (also before an error), then the error as net-snmp's walks print it
        if tbl is not None:
            out(table_text(o, tbl))
        if e is not None:
            if isinstance(e, errors.ErrorStatusError):
                err(error_status_text(True, e, o))
                _finish(2)
            elif isinstance(e, errors.OidNotIncreasingError):
                err(oid_not_increasing(Oid(e.previous), Oid(e.received), o))
                _finish(1)
            else:
                _fail(e, False)
            return
        _finish(0)

    # trap and inform ---------------------------------------------------------------------------------

    def _trap_written() -> None:
        # Over TCP: the connection came up and carried the trap, or did not fail within its connect timeout
        _finish(0)

    def _trap_sent(cl: Client, e: ?errors.SnmpError) -> None:
        if e is not None:
            _fail(e, False)
            return
        if o.is_tcp():
            # the trap is written once the connection is up (connected()); connection_failed() ends the
            # command if the connection fails, and without either the connect timeout does
            _trap_handed = True
            wait = TRAP_LINGER if _connection_up else tcp_connect_timeout(o) + TRAP_LINGER
            after wait: _trap_written()
        else:
            _finish(0)

    def _acked(cl: Client, r: ?Response, e: ?errors.SnmpError) -> None:
        # snmpinform does not look at the error-status of the acknowledgement
        if e is not None:
            if isinstance(e, errors.TimeoutError):
                err(_tool + ": Timeout\n")
                _finish(1)
            elif not isinstance(e, errors.ErrorStatusError):
                _fail(e, False)
            else:
                _finish(0)
            return
        _finish(0)

    # TCP ---------------------------------------------------------------------------------------------

    def connection_failed(reason: str) -> None:
        """Ends the command as net-snmp's tools end when they cannot open a TCP session

        The connection to the agent failed (reason in net-snmp's words, see
        connect_failure()) before the agent answered anything: exit code 1
        with "<tool>: Unknown host (AGENT) (REASON)". Does nothing once the
        command has finished.
        """
        if not _finished:
            err(unknown_host_text(o, reason))
            _finish(1)

    def connected() -> None:
        """Notes that the connection to the agent is up and carries what was sent: a trap ends TRAP_LINGER later"""
        if not _connection_up:
            _connection_up = True
            if _trap_handed:
                after TRAP_LINGER: _trap_written()

    # dispatch ----------------------------------------------------------------------------------------

    def _discovered(cl: Client, info: ?EngineInfo, e: ?errors.SnmpError) -> None:
        # net-snmp reports o.session_error when it opens the session, after a successful discovery
        if e is not None:
            _fail(e, False)
        else:
            err(session_error_text(o))
            _finish(1)

    proc def _run() -> None:
        for w in o.warnings:
            err(w + "\n")
        for w in o.mib_notes:
            err(w + "\n")
        if o.session_error != "":
            if o.engine_id is None:
                c.discover(_discovered)
            else:
                err(session_error_text(o))
                _finish(1)
            return
        problem = build_problem(o)
        if problem != "":
            err(problem)
            _finish(1)
            return
        _dispatch()

    proc def _dispatch() -> None:
        cmd = o.command
        v1 = o.version == message.SNMP_V1
        if cmd == "get" or cmd == "getnext":
            _send_get()
        elif cmd == "bulkget":
            if v1:
                err(_tool + ": Cannot send V2 PDU on V1 session\n")
                _finish(1)
            else:
                c.get_bulk(_completed, o.oids, o.non_repeaters, o.max_repetitions, _opts)
        elif cmd == "set":
            c.set(_completed, o.varbinds, _opts)
        elif cmd == "walk" or cmd == "bulkwalk":
            if cmd == "bulkwalk" and v1:
                err(_tool + ": Cannot send V2 PDU on V1 session\n")
                _finish(1)
            elif o.include_requested:
                c.get(_got_included, [_root], _opts)
            else:
                _walk_next()
        elif cmd == "table":
            c.get_table(_got_table, o.oids, table_options(o))
        elif cmd == "trap" and not o.inform:
            if v1:
                c.trap_v1(_trap_sent, o.enterprise, o.agent_addr, o.generic, o.specific, o.varbinds, o.uptime)
            else:
                c.trap(_trap_sent, o.trap_oid, o.varbinds, o.uptime)
        elif cmd == "trap" or cmd == "inform":
            if v1:
                err("Cannot send INFORM as SNMPv1 PDU\n")
                _finish(1)
            else:
                c.inform(_acked, o.trap_oid, o.varbinds, o.uptime, _opts)
        else:
            err("actsnmp: " + cmd + " is not a client command\n")
            _finish(1)

    _run()


# trapd and agent #####################################################################################

actor TrapPrinter(o: CliOptions, out: action(str) -> None):
    """Writes notification_text of every notification a NotificationReceiver delivers"""
    def received(r: NotificationReceiver, n: Notification) -> None:
        out(notification_text(o, n))


def listen_text(o: CliOptions, port: int) -> str:
    """Where agent and trapd listen, as their messages show it

    ADDRESS:PORT, or with --tcp the agent address that a client command
    takes: tcp:127.0.0.1:16163, tcp6:[::1]:16163.
    """
    if not o.listen_tcp:
        return o.bind_address + ":%d" % port
    if ":" in o.bind_address:
        return "tcp6:[" + o.bind_address + "]:%d" % port
    return "tcp:" + o.bind_address + ":%d" % port

proc def listen(ucap: net.UDPListenCap, tcap: net.TCPListenCap, o: CliOptions,
                on_ready: action(ServerTransport, ?str) -> None) -> None:
    """udp_server_transport(), or tcp_server_transport() with --tcp, on o.bind_address and o.listen_port"""
    if o.listen_tcp:
        tcp_server_transport(tcap, o.bind_address, o.listen_port, on_ready)
    else:
        udp_server_transport(ucap, o.bind_address, o.listen_port, on_ready)


actor AgentServer(ucap: net.UDPListenCap, tcap: net.TCPListenCap, o: CliOptions, view: MibView, config: AgentConfig,
                  err: action(str) -> None, on_done: action(int) -> None):
    """Listens (see listen()) and serves view with an Agent until the process ends"""
    var _agent: ?Agent = None

    def _listening(t: ServerTransport, error: ?str) -> None:
        if error is not None:
            err("actsnmp agent: cannot listen on " + listen_text(o, o.listen_port) + ": " + error + "\n")
            on_done(1)
            return
        _agent = Agent(t, view, config, None)
        err("actsnmp agent: serving on " + listen_text(o, t.local_port()) + " (engine ID 0x"
            + config.engine_id.hex() + ")\n")

    listen(ucap, tcap, o, _listening)


actor TrapdServer(ucap: net.UDPListenCap, tcap: net.TCPListenCap, o: CliOptions, config: ReceiverConfig,
                  out: action(str) -> None, err: action(str) -> None, on_done: action(int) -> None):
    """Listens (see listen()) and prints every notification until the process ends"""
    var _receiver: ?NotificationReceiver = None
    _printer = TrapPrinter(o, out)

    def _listening(t: ServerTransport, error: ?str) -> None:
        if error is not None:
            err("actsnmp trapd: cannot listen on " + listen_text(o, o.listen_port) + ": " + error + "\n")
            on_done(1)
            return
        _receiver = NotificationReceiver(t, config, _printer.received, None)
        err("actsnmp trapd: listening on " + listen_text(o, t.local_port()) + " (engine ID 0x"
            + config.engine_id.hex() + ")\n")

    listen(ucap, tcap, o, _listening)


# main ################################################################################################

def _parse(argv: list[str]) -> (?CliOptions, str, bool):
    # The options, or the error text and whether the usage text follows it
    try:
        return (cliopts.parse(argv), "", False)
    except CliError as e:
        return (None, e.error_message, e.usage)

def _load_agent(o: CliOptions, rec: str, rules: str, users: ?str) -> (?MibView, ?AgentConfig, str):
    # The view and configuration of `agent`, or the error text
    try:
        return (mibview.load_snmprec(rec), agent_config(o, rules, users), "")
    except ValueError as e:
        return (None, None, e.error_message)

def _load_trapd(o: CliOptions, users: ?str) -> (?ReceiverConfig, str):
    try:
        return (trapd_config(o, users), "")
    except ValueError as e:
        return (None, e.error_message)

def _load_security(o: CliOptions) -> (?Security, str):
    try:
        return (security_of(o), "")
    except ValueError as e:
        return (None, e.error_message)

def _command_of(argv: list[str]) -> str:
    return argv[1] if len(argv) > 1 and argv[1] in cliopts.COMMANDS else ""

proc def new_client(cap: ?net.UDPConnectCap, o: CliOptions, sec: Security, tr: ?Transport=None) -> Client:
    """The Client of a client command

    -e is our own engine ID for an SNMPv3 trap and the peer's engine ID,
    which skips discovery, for every other command. tr replaces the UDP
    socket: the TCP transport of tcp_command(), or MemNet in tests.
    """
    engine: ?EngineInfo = None
    local_id: ?bytes = None
    eid = o.engine_id
    if eid is not None:
        if o.command == "trap" and not o.inform:
            local_id = eid
        else:
            engine = EngineInfo(eid, 0, 0, 0.0)
    return Client(cap, o.address, sec, None, port=o.port, opts=request_options(o), transport=tr, engine=engine,
                  local_engine_id=local_id, local_engine_boots=o.boots)

actor main(env):
    var _trap = False
    var _flush_out = False
    var _lookup: ?HostLookup = None

    def write_out(s: str) -> None:
        print(s, end="", flush=_flush_out)

    def write_err(s: str) -> None:
        print("", end="", flush=True)
        print(s, end="", err=True, flush=True)

    def finished(code: int) -> None:
        if _trap:
            after TRAP_LINGER: env.exit(code)
        else:
            env.exit(code)

    proc def _read(path: str) -> ?str:
        try:
            f = file.ReadFile(file.ReadFileCap(file.FileCap(env.cap)), path)
            data = f.read()
            f.close()
            return data.decode()
        except Exception:
            return None

    proc def _usage_error(msg: str, usage: bool) -> None:
        if msg != "":
            write_err(msg + "\n")
        if usage:
            write_err(cliopts.usage(_command_of(env.argv)) + "\n")
        env.exit(1)

    proc def _udp_listen_cap() -> net.UDPListenCap:
        return net.UDPListenCap(net.UDPCap(net.NetCap(env.cap)))

    proc def _tcp_listen_cap() -> net.TCPListenCap:
        return net.TCPListenCap(net.TCPCap(net.NetCap(env.cap)))

    proc def _serve_agent(o: CliOptions) -> None:
        rec = _read(o.snmprec)
        rules = _read(o.write_rules)
        users = _read(o.users)
        if users is None and o.users_given:
            _usage_error("actsnmp agent: cannot read the users file " + o.users, False)
        elif rec is None:
            _usage_error("actsnmp agent: cannot read the snmprec file " + o.snmprec, False)
        elif rules is None:
            _usage_error("actsnmp agent: cannot read the write rules " + o.write_rules, False)
        if rec is not None:
            if rules is not None:
                if users is not None or not o.users_given:
                    r = _load_agent(o, rec, rules, users)
                    view = r.0
                    config = r.1
                    if view is not None:
                        if config is not None:
                            AgentServer(_udp_listen_cap(), _tcp_listen_cap(), o, view, config, write_err, finished)
                            return
                    _usage_error("actsnmp agent: " + r.2, False)

    proc def _serve_trapd(o: CliOptions) -> None:
        users = _read(o.users)
        if users is None and o.users_given:
            _usage_error("actsnmp trapd: cannot read the users file " + o.users, False)
            return
        r = _load_trapd(o, users)
        config = r.0
        if config is not None:
            _flush_out = True
            TrapdServer(_udp_listen_cap(), _tcp_listen_cap(), o, config, write_out, write_err, finished)
        else:
            _usage_error("actsnmp trapd: " + r.1, False)

    proc def _start(o: CliOptions) -> None:
        if o.show_version:
            write_out("actsnmp version: " + VERSION + "\n")
            env.exit(0)
            return
        if o.help:
            write_err(cliopts.usage(o.command) + "\n")
            env.exit(1)
            return
        if o.command == "agent":
            _serve_agent(o)
            return
        if o.command == "trapd":
            _serve_trapd(o)
            return
        r = _load_security(o)
        sec = r.0
        if sec is not None:
            _client(o, sec)
        else:
            _usage_error(tool_name(o) + ": " + r.1, False)

    proc def _client(o: CliOptions, sec: Security) -> None:
        # A client command, after looking up the agent's host where resolves_name() says so
        if resolves_name(o):
            def resolved(address: str) -> None:
                if address == "":
                    write_err(unknown_host_text(o, ""))
                    env.exit(1)
                    return
                o.address = address
                _run_client(o, sec)
            _lookup = HostLookup(net.DNSCap(net.NetCap(env.cap)), o.address, o.transport_domain != "tcp", resolved)
        else:
            _run_client(o, sec)

    proc def _run_client(o: CliOptions, sec: Security) -> None:
        # A client command once its agent's host has been looked up where resolves_name() says so
        if o.is_tcp():
            tcp_command(net.TCPConnectCap(net.TCPCap(net.NetCap(env.cap))), o, sec, write_out, write_err, finished)
        else:
            # a trap command exits TRAP_LINGER after the datagram was handed over (Command waits over TCP)
            _trap = o.command == "trap" and not o.inform
            ccap = net.UDPConnectCap(net.UDPCap(net.NetCap(env.cap)))
            Command(o, new_client(ccap, o, sec), write_out, write_err, finished)

    proc def _mkdirs(path: str) -> None:
        # mkdir -p (errors show when the files are written)
        fs = file.FS(file.FileCap(env.cap))
        parts = path.split("/")
        for i in range(1, len(parts) + 1):
            d = "/".join(parts[:i])
            if d != "" and d != ".":
                try:
                    st = await async fs.stat(d)
                    if st.is_dir():
                        continue
                except Exception:
                    pass
                try:
                    await async fs.mkdir(d)
                except Exception:
                    pass

    proc def _write_files(files: list[(str, str)]) -> (str, str):
        # mib2yang's files: the paths written (stdout) and the errors (stderr)
        fcap = file.FileCap(env.cap)
        wcap = file.WriteFileCap(fcap)
        out: list[str] = []
        errs: list[str] = []
        for f in files:
            try:
                wf = file.WriteFile(wcap, f.0)
                wf.write(f.1.encode())
                await async wf.close()
                out.append(f.0 + "\n")
            except Exception as e:
                errs.append("mib2yang: cannot write " + f.0 + ": " + str(e) + "\n")
        return ("".join(out), "".join(errs))

    proc def _mib_command(o: CliOptions, ld: mibcli.Loaded) -> None:
        # translate, mib2yang, mibmeta and miblint
        r: ?mibcli.CmdResult = None
        if o.command == "translate":
            r = mibcli.translate(ld.tree, o.args, o.output, o.inp, o.details, o.print_tree, o.width, o.find_all,
                                 o.mib_lazy)
        elif o.command == "mib2yang":
            r = mibcli.mib2yang(ld, o.outdir, o.meta, o.consistent_status, o.ignore_hints, o.lint_level)
        elif o.command == "mibmeta":
            r = mibcli.mibmeta(ld, o.lint_level)
        else:
            r = mibcli.miblint(ld, o.lint_level)
        res = r!
        if res.code < 0:
            _usage_error("", True)
            return
        code = res.code
        out = res.out
        err = res.err
        if len(res.files) > 0:
            if o.outdir != "":
                _mkdirs(o.outdir)
            w = _write_files(res.files)
            out = w.0 + out
            if w.1 != "":
                err += w.1
                code = 1
        if out != "":
            write_out(out)
        if err != "":
            write_err(err)
        env.exit(code)

    proc def _load_mibs(o: CliOptions, env_mibs: ?str, env_dirs: ?str) -> mibcli.Loaded:
        # The MIBs of a command line: -M/MIBDIRS (snmptranslate: the last -M), -m/MIBS and the modules OID
        # arguments name; mib2yang, mibmeta and miblint load their arguments (modules or files)
        home = env.getenv("HOME")
        fcap = file.FileCap(env.cap)
        translate = o.command == "translate"
        path = mibcli.search_path(o.mib_dirs_opts, env_dirs, home, translate)
        if o.command in cliopts.MIB_COMMANDS and not translate:
            return mibcli.load(fcap, path, o.args, files=True)
        return mibcli.load(fcap, path, mibcli.module_list(o.mib_modules_opt, env_mibs), mibcli.modules_named(o.oid_words()))

    proc def _main() -> None:
        env_mibs = env.getenv("MIBS")
        env_dirs = env.getenv("MIBDIRS")
        o: ?CliOptions = None
        try:
            o = cliopts.scan(env.argv, env_mibs, env_dirs)
        except CliError as e:
            _usage_error(e.error_message, e.usage)
            return
        opts = o!
        if opts.help or opts.show_version:
            _start(opts)
            return
        if opts.mib_mode:
            ld = _load_mibs(opts, env_mibs, env_dirs)
            opts.mib = ld.tree
            opts.mib_lazy = ld.lazy_loads()
            if ld.messages != "" and opts.command not in cliopts.MIB_COMMANDS:
                write_err(ld.messages)
            if opts.command in cliopts.MIB_COMMANDS:
                if opts.command == "translate" and ld.messages != "":
                    write_err(ld.messages)
                    ld.messages = ""
                _mib_command(opts, ld)
                return
        try:
            cliopts.finish(opts)
        except CliError as e:
            _usage_error(e.error_message, e.usage)
            return
        _start(opts)

    _main()
