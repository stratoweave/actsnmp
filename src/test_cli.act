actor _test_notifications(t: testing.AsyncT):
    """trap and inform (snmptrap/snmpinform syntax, every type letter) to a receiver printed by trapd --canon"""
    t.timeout(60.0)
    mn = MemNet()
    var _failures: ?list[str] = None
    var _text: ?str = None

    proc def _check() -> None:
        failures = _failures
        text = _text
        if failures is not None and text is not None:
            got = text
            # the last block (sysUpTime from the Client's clock) only needs its header and END
            last = got.rfind("NOTIFICATION v2c TRAP2 community=\"public\" uptime=")
            tail = got[last:] if last >= 0 else ""
            got = got[:last] if last >= 0 else got
            f = list(failures)
            if got != EXPECTED_BLOCKS:
                f.append("trapd output differs:\n" + got)
            if not (tail.endswith(" trapoid=.1.3.6.1.6.3.1.1.5.1\nEND\n")):
                f.append("last block: " + repr(tail))
            finish(t, f)

    def steps_finished(failures: list[str]) -> None:
        _failures = failures
        _check()

    def collected(text: str) -> None:
        _text = text
        _check()

    trapd = cliopts.parse(["actsnmp", "trapd", "--canon"])
    blocks = Blocks(7, collected)
    printer = TrapPrinter(trapd, blocks.out)
    config = ReceiverConfig(["public"], security.load_users_tsv("\n".join(USERS)).users, [], h(RECEIVER_ENGINE), 1)
    rcv = NotificationReceiver(mn.server(RECEIVER, 162), config, printer.received, None)
    Script(mn, trap_steps(), 44000, steps_finished)

def _test_trapd_text() -> None:
    """trapd without --canon: the canonical header plus the source, net-snmp varbinds, no snmpTrapCommunity.0"""
    t = pdu.TrapV1Pdu(Oid([1, 3, 6, 1, 4, 1, 8072, 9999]), b"\xc0\x00\x02\x01", 6, 42, 12345,
                      [VarBind(e([2, 1, 0]), OctetString(b"a\x00"))])
    n = notify.notification_from_v1(t, b"public", "10.0.0.2", 40000)
    plain = cliopts.parse(["actsnmp", "trapd"])
    testing.assertEqual(actsnmp.notification_text(plain, n),
                        "NOTIFICATION v1 TRAP from=10.0.0.2:40000 community=\"public\" enterprise=.1.3.6.1.4.1.8072.9999"
                        + " agent=192.0.2.1 generic=6 specific=42 uptime=12345 trapoid=.1.3.6.1.4.1.8072.9999.0.42\n"
                        + EP + ".2.1.0 = Hex-STRING: 61 00 \nEND\n")
    canon = cliopts.parse(["actsnmp", "trapd", "--canon"])
    testing.assertEqual(actsnmp.notification_text(canon, n),
                        "NOTIFICATION v1 TRAP community=\"public\" enterprise=.1.3.6.1.4.1.8072.9999 agent=192.0.2.1"
                        + " generic=6 specific=42 uptime=12345 trapoid=.1.3.6.1.4.1.8072.9999.0.42\n"
                        + EP + ".2.1.0 = Hex-STRING: 61 00\nEND\n")


# TCP ###############################################################################################

def _now() -> float:
    # Monotonic time in seconds
    return float(time.monotonic_ns()) / 1000000000.0

proc def start_cli(mn: MemNet, port: int, args: list[str], on_done: action(Result) -> None) -> Command:
    """Start one client command over MemNet from MANAGER:port, like run_cli, and return its Command"""
    cap = Capture(on_done)
    o = cliopts.parse(["actsnmp"] + args)
    c = actsnmp.new_client(None, o, actsnmp.security_of(o), mn.client(MANAGER, port, o.address, o.port))
    return Command(o, c, cap.out, cap.err, cap.finished)

def _test_tcp_texts() -> None:
    """Failed TCP connections in net-snmp's words, the connect timeouts, host lookups and the listening texts"""
    refused = "TCP connection to 127.0.0.1:161 failed: connection refused"
    testing.assertEqual(actsnmp.connect_failure(refused), "Connection refused")
    testing.assertEqual(actsnmp.connect_failure("TCP connection to [::1]:161 failed: host is unreachable"),
                        "No route to host")
    testing.assertEqual(actsnmp.connect_failure("TCP connection to 10.0.0.1:161 failed: no connection within 3 s"),
                        "Connection timed out")
    testing.assertEqual(actsnmp.connect_failure("TCP connection to 10.0.0.1:161 failed: network is unreachable"),
                        "Network is unreachable")
    for other in ["TCP connection to 10.0.0.1:161 closed by the peer",
                  "TCP connection to 10.0.0.1:161 lost: broken pipe",
                  "TCP setup for localhost:161 failed: not an IPv4 or IPv6 address",
                  "TCP connection to 10.0.0.1:161 presumed dead: nothing received for 1.0 s after sending; reconnecting",
                  "TCP send queue for 10.0.0.1:161 is full; message dropped",
                  "TCP setup for 10.0.0.1:0 failed: port 0 is outside 1..65535",
                  "UDP receive error: connection refused"]:
        testing.assertEqual(actsnmp.connect_failure(other), "", other)
    o = cliopts.parse(["actsnmp", "get", "-c", "public", "-t", "2", "-r", "3", "tcp:h:1161", "1.3"])
    testing.assertEqual(actsnmp.unknown_host_text(o, "Connection refused"),
                        "snmpget: Unknown host (tcp:h:1161) (Connection refused)\n")
    testing.assertEqual(actsnmp.unknown_host_text(o, ""), "snmpget: Unknown host (tcp:h:1161)\n")
    # a request's connection may take longer than all its tries, a trap's one -t
    testing.assertEqual(actsnmp.tcp_connect_timeout(o), 10.0)
    trap = cliopts.parse(["actsnmp", "trap", "-c", "public", "-t", "2", "-r", "3", "tcp:h", "", "1.3"])
    testing.assertEqual(actsnmp.tcp_connect_timeout(trap), 2.0)
    inform = cliopts.parse(["actsnmp", "trap", "-Ci", "-c", "public", "-t", "2", "-r", "3", "tcp:h", "", "1.3"])
    testing.assertEqual(actsnmp.tcp_connect_timeout(inform), 10.0)
    slow = cliopts.parse(["actsnmp", "get", "-c", "public", "-t", "100", "tcp:h", "1.3"])
    testing.assertEqual(actsnmp.tcp_connect_timeout(slow), actsnmp.TCP_CONNECT_MAX)
    # udp6: and tcp6: hosts that are not IPv6 addresses, and tcp: names, are looked up
    lookups: list[(str, bool)] = [("h", False), ("udp:h", False), ("127.0.0.1", False), ("udp6:h", True),
                                  ("udp6:[::1]", False), ("udp6:127.0.0.1", True), ("tcp:h", True),
                                  ("tcp:127.0.0.1", False), ("tcp:[::1]:161", False), ("tcp6:h", True),
                                  ("tcp6:[::1]", False), ("tcp6:127.0.0.1", True), ("tcpv6:::ffff:10.0.0.1", False)]
    for k in lookups:
        a = cliopts.parse(["actsnmp", "get", "-c", "public", k.0, "1.3"])
        testing.assertEqual(actsnmp.resolves_name(a), k.1, k.0)
    # agent and trapd: the agent address of the TCP listener
    texts: list[(list[str], str)] = [(["agent"], "127.0.0.1:16163"), (["agent", "--bind", "::1"], "::1:16163"),
                                     (["agent", "--tcp"], "tcp:127.0.0.1:16163"),
                                     (["trapd", "--tcp", "--bind", "::1"], "tcp6:[::1]:16165")]
    for x in texts:
        s = cliopts.parse(["actsnmp"] + x.0)
        testing.assertEqual(actsnmp.listen_text(s, s.listen_port), x.1, " ".join(x.0))


actor FakeLink():
    """The far side of a fake transport: the test hands its receiver messages and errors"""
    var _on_data: ?action(bytes, str, int) -> None = None
    var _on_error: ?action(str, bool) -> None = None

    def set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        _on_data = on_data
        _on_error = on_error

    def deliver(data: bytes) -> None:
        on_data = _on_data
        if on_data is not None:
            on_data(data, "10.0.0.1", 161)

    def fail(text: str) -> None:
        on_error = _on_error
        if on_error is not None:
            on_error(text, False)

def fake_transport(f: FakeLink) -> Transport:
    """A Transport whose receiver gets what the test hands f; sending does nothing"""
    def _send(data: bytes) -> None:
        pass
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        f.set_receiver(on_data, on_error)
    def _close() -> None:
        pass
    return Transport(_send, _set_receiver, _close, source_checked=True)

actor Recorder():
    """What the owner of a watched transport and the failure callback received, in order"""
    var _events: list[str] = []

    def received(data: bytes, src_address: str, src_port: int) -> None:
        _events.append("data %d octets from " % len(data) + src_address + ":%d" % src_port)

    def failed(text: str, fatal: bool) -> None:
        _events.append("error " + text + (" (fatal)" if fatal else ""))

    def connection_failed(reason: str) -> None:
        _events.append("failed: " + reason)

    def connected() -> None:
        _events.append("up")

    def events() -> list[str]:
        return _events

actor _test_tcp_watch(t: testing.AsyncT):
    """TcpWatch passes everything on and reports a failed connection before any message, and one that is up, once"""
    t.timeout(10.0)
    refused = "TCP connection to 10.0.0.1:161 failed: connection refused"
    closed = "TCP connection to 10.0.0.1:161 closed by the peer"
    broken = "TCP connection to 10.0.0.1:161 lost: broken pipe"

    f1 = FakeLink()
    w1 = TcpWatch()
    t1 = w1.watch(fake_transport(f1))
    r1 = Recorder()
    f2 = FakeLink()
    w2 = TcpWatch()
    t2 = w2.watch(fake_transport(f2))
    r2 = Recorder()

    def settled() -> None:
        e1 = r1.events()
        e2 = r2.events()
        def checks() -> None:
            # a connection lost after it was up is no failed connection; registered after the
            # failure, the callback still gets it, once
            testing.assertEqual(e1, ["error " + closed, "error " + broken, "error " + refused,
                                     "error TCP connection to 10.0.0.1:161 failed: network is unreachable",
                                     "failed: Connection refused"])
            # once the agent has answered, a failed connection is only passed on; the connection that
            # came up is reported once, also to a callback registered afterwards
            testing.assertEqual(e2, ["data 2 octets from 10.0.0.1:161", "error " + refused, "up"])
        report(t, outcome(checks))

    def registration_due() -> None:
        w1.on_failure(r1.connection_failed)
        w2.on_connect(r2.connected)
        after 0.1: settled()

    t1.set_receiver(r1.received, r1.failed)
    t2.set_receiver(r2.received, r2.failed)
    w2.on_failure(r2.connection_failed)
    f1.fail(closed)
    f1.fail(broken)
    f1.fail(refused)
    f1.fail("TCP connection to 10.0.0.1:161 failed: network is unreachable")
    f2.deliver(b"\x30\x00")
    f2.fail(refused)
    w2.connected()
    w2.connected()
    after 0.2: registration_due()

actor _test_tcp_commands(t: testing.AsyncT):
    """Over TCP: connection_failed() ends a command with net-snmp's Unknown host; a trap waits for connected() or -t"""
    t.timeout(30.0)
    mn = MemNet()
    var results: dict[str, Result] = {}
    var trap_cmd: ?Command = None
    var started = 0.0
    var trap_wait = 0.0
    var up_wait = 0.0
    var blocks = ""

    def check() -> None:
        def checks() -> None:
            g = results["get"]
            testing.assertEqual((g.out, g.err, g.code),
                                ("", "snmpget: Unknown host (tcp:10.0.0.77) (Connection refused)\n", 1))
            f = results["failed trap"]
            testing.assertEqual((f.out, f.err, f.code),
                                ("", "snmptrap: Unknown host (tcp:" + RECEIVER + ") (Connection refused)\n", 1))
            w = results["trap"]
            testing.assertEqual((w.out, w.err, w.code), ("", "", 0))
            # without a report from the connection, the trap waited -t plus TRAP_LINGER
            testing.assertTrue(trap_wait >= 0.2 + actsnmp.TRAP_LINGER - 0.05, "trap waited %f s" % trap_wait)
            u = results["trap after connected"]
            testing.assertEqual((u.out, u.err, u.code), ("", "", 0))
            # with -t 5, TRAP_LINGER after the connection came up
            testing.assertTrue(up_wait >= actsnmp.TRAP_LINGER - 0.05 and up_wait < 2.0, "trap waited %f s" % up_wait)
            # MemNet carried the three traps; only the TCP connection of the second one was reported failed
            testing.assertEqual(sorted([b for b in blocks.split("END\n") if b != ""]),
                                ["NOTIFICATION v2c TRAP2 community=\"public\" uptime=%d trapoid=.1.3.6.1.6.3.1.1.5.1\n" % u
                                 for u in [7, 8, 9]])
        report(t, outcome(checks))

    proc def _done(name: str, r: Result) -> None:
        results[name] = r
        if len(results) == 4:
            check()

    def got(r: Result) -> None:
        _done("get", r)

    def trapped(r: Result) -> None:
        trap_wait = _now() - started
        _done("trap", r)

    def trap_failed(r: Result) -> None:
        _done("failed trap", r)

    def trapped_up(r: Result) -> None:
        up_wait = _now() - started
        _done("trap after connected", r)

    def collected(text: str) -> None:
        blocks = text

    def refusal_due() -> None:
        c = trap_cmd
        if c is not None:
            c.connection_failed("Connection refused")

    trapd = cliopts.parse(["actsnmp", "trapd", "--canon"])
    printer = TrapPrinter(trapd, Blocks(3, collected).out)
    config = ReceiverConfig(["public"], [], [], h(RECEIVER_ENGINE), 1)
    rcv = NotificationReceiver(mn.server(RECEIVER, 162), config, printer.received, None)
    # nothing listens on 10.0.0.77, and the request would time out only after 5 s
    get_cmd = start_cli(mn, 45000, ["get", "-v2c", "-c", "public", "-t", "5", "tcp:10.0.0.77", "1.3.6.1.2.1.1.1.0"],
                        got)
    get_cmd.connection_failed("Connection refused")
    started = _now()
    start_cli(mn, 45001, ["trap", "-v2c", "-c", "public", "-t", "0.2", "tcp:" + RECEIVER, "7", "1.3.6.1.6.3.1.1.5.1"],
              trapped)
    trap_cmd = start_cli(mn, 45002, ["trap", "-v2c", "-c", "public", "-t", "0.2", "tcp:" + RECEIVER, "8",
                                     "1.3.6.1.6.3.1.1.5.1"], trap_failed)
    up_cmd = start_cli(mn, 45003, ["trap", "-v2c", "-c", "public", "-t", "5", "tcp:" + RECEIVER, "9",
                                   "1.3.6.1.6.3.1.1.5.1"], trapped_up)
    up_cmd.connected()
    after 0.05: refusal_due()


# Helpers ###########################################################################################

def _test_error_texts() -> None:
    """net-snmp's error-status lines: snmpget without the period, Failed object only for a non-zero index"""
    e1 = errors.ErrorStatusError(pdu.GEN_ERR, 0)
    testing.assertEqual(actsnmp.error_status_text(False, e1), "Error in packet\nReason: (genError) A general failure occured\n")
    e2 = errors.ErrorStatusError(pdu.NOT_WRITABLE, 2, [1, 3, 6])
    testing.assertEqual(actsnmp.error_status_text(True, e2),
                        "Error in packet.\nReason: notWritable (That object does not support modification)\n"
                        + "Failed object: .1.3.6\n\n")
    e3 = errors.ErrorStatusError(99, 1)
    testing.assertEqual(actsnmp.error_status_text(True, e3), "Error in packet.\nReason: Unknown Error\nFailed object: \n\n")
    testing.assertEqual(actsnmp.oid_not_increasing(Oid([1, 3, 2]), Oid([1, 3, 1])),
                        "Error: OID not increasing: .1.3.2\n >= .1.3.1\n\n")

def _test_tool_names() -> None:
    names = ["snmpget", "snmpgetnext", "snmpbulkget", "snmpwalk", "snmpbulkwalk", "snmpset", "snmptable"]
    cmds = ["get", "getnext", "bulkget", "walk", "bulkwalk", "set", "table"]
    for i in range(len(cmds)):
        o = cliopts.parse(["actsnmp", cmds[i], "-v2c", "-c", "x", "h", "1.3" if cmds[i] != "set" else "1.3"]
                          + (["i", "1"] if cmds[i] == "set" else []))
        testing.assertEqual(actsnmp.tool_name(o), names[i])
    testing.assertEqual(actsnmp.tool_name(cliopts.parse(["actsnmp", "trap", "-v2c", "-c", "x", "h", "", "1.3"])),
                        "snmptrap")
    testing.assertEqual(actsnmp.tool_name(cliopts.parse(["actsnmp", "trap", "-Ci", "-v2c", "-c", "x", "h", "", "1.3"])),
                        "snmpinform")

def _test_request_options() -> None:
    """-t and -r map to a fixed timeout per attempt; nothing is split or fixed by the Client"""
    o = cliopts.parse(["actsnmp", "get", "-t", "2.5", "-r", "0", "-v2c", "-c", "x", "h", "1.3"])
    r = actsnmp.request_options(o)
    testing.assertEqual(r.timeout, 2.5)
    testing.assertEqual(r.retries, 0)
    testing.assertEqual(r.attempt_timeout(3), 2.5)
    testing.assertEqual(r.max_oids_per_request, 0)
    testing.assertFalse(r.v1_fix_errors)

def _test_agent_communities() -> None:
    a = cliopts.parse(["actsnmp", "agent"])
    testing.assertEqual(actsnmp.agent_communities(a), {"public": False, "private": True})
    b = cliopts.parse(["actsnmp", "agent", "-c", "ro", "-w", "rw", "-c", "ro2"])
    testing.assertEqual(actsnmp.agent_communities(b), {"ro": False, "ro2": False, "rw": True})
    d = cliopts.parse(["actsnmp", "trapd"])
    testing.assertEqual(actsnmp.trapd_config(d, None).communities, ["public"])
    d2 = cliopts.parse(["actsnmp", "trapd", "-c", "a", "-c", "b"])
    testing.assertEqual(actsnmp.trapd_config(d2, None).communities, ["a", "b"])


# The lab dataset (env tests) #######################################################################

def sorted_lines(text: str) -> str:
    """The lines of text in sorted order (each followed by a newline)"""
    lines = text.split("\n")
    if len(lines) > 0 and lines[len(lines) - 1] == "":
        lines = lines[:len(lines) - 1]
    return "".join([line + "\n" for line in sorted(lines)])

actor LabWalk(t: testing.EnvT, args: list[str], expected_file: str, sort_lines: bool, tree: ?mibcli.MibTree=None):
    """Serve the lab dataset as `actsnmp agent` does and compare one CLI walk with a recorded file

    sort_lines compares the sorted lines (a table printed in row order
    against a recorded walk in column order); tree: the MIBs to print with.
    """
    mn = MemNet()
    o = cliopts.parse(["actsnmp", "agent"])
    config = actsnmp.agent_config(o, read_text(t, cliopts.LAB_WRITE_RULES), read_text(t, cliopts.LAB_USERS))
    view = mibview.load_snmprec(read_text(t, cliopts.LAB_SNMPREC))
    expected_text = read_text(t, expected_file)
    expected = sorted_lines(expected_text) if sort_lines else expected_text
    ag = Agent(mn.server(AGENT, 161), view, config, None)

    def walked(r: Result) -> None:
        out = sorted_lines(r.out) if sort_lines else r.out
        if r.code == 0 and r.err == "" and out == expected:
            t.success()
        else:
            n = 0
            got = out.split("\n")
            want = expected.split("\n")
            while n < len(got) and n < len(want) and got[n] == want[n]:
                n += 1
            t.failure(AssertionError("exit %d, err %r; first difference at line %d: got %r, expected %r"
                                     % (r.code, r.err, n + 1, got[n] if n < len(got) else "<end>",
                                        want[n] if n < len(want) else "<end>")))

    run_cli(mn, 45000, args, walked, tree)

actor _test_lab_bulkwalk(t: testing.EnvT):
    """bulkwalk -v2c of the lab dataset equals interop/expected/netsnmp/snmpd-dataset.On.txt (snmpbulkwalk -On)"""
    t.timeout(120.0)
    LabWalk(t, ["bulkwalk", "-v2c", "-c", "public", AGENT, ".1.3.6.1.4.1.8072.9999.1"],
            "interop/expected/netsnmp/snmpd-dataset.On.txt", False)

