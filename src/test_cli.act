"""In-process tests of the actsnmp CLI against a real Agent and NotificationReceiver over MemNet

The expected texts and exit codes are net-snmp's (see
interop/expected/pathological-netsnmp.txt). The env tests compare whole
walks with the net-snmp output recorded in interop/expected/netsnmp/, byte
for byte.
"""

import testing
import time

import actsnmp
import agent
import ber
import cliopts
import errors
import file
import mibcli
import mib.resolver
import mibview
import notify
import pdu
import security
import values
from actsnmp import Command, TcpWatch, TrapPrinter
from agent import Agent, AgentConfig, Faults
from client import Client
from cliopts import CliOptions
from mibview import MibView, WriteRule
from notify import Notification
from oid import Oid
from receiver import NotificationReceiver, ReceiverConfig
from security import Usm
from transport import MemNet, Transport
from values import Counter64, Integer, IpAddress, ObjectIdentifier, OctetString, Opaque, VarBind
from testutil import h, outcome, read_text, report

AGENT = "10.0.0.1"
MANAGER = "10.0.0.2"
RECEIVER = "10.0.0.9"
AGENT_ENGINE = "80001f88806532652d6167656e74"
RECEIVER_ENGINE = "80001f8880616374736e6d7072"

EP = ".1.3.6.1.4.1.8072.9999.1"
SYS_DESCR = Oid([1, 3, 6, 1, 2, 1, 1, 1, 0])
LAST = Oid([1, 3, 6, 1, 6, 3, 99, 1, 0])
TIMEOUT_V2 = "Timeout: No Response from "
NO_SUCH_NAME = "Reason: (noSuchName) There is no such variable name in this MIB.\n"
END_OF_MIB_VIEW = " = No more variables left in this MIB View (It is past the end of the MIB tree)\n"
NO_SUCH_OBJECT = " = No Such Object available on this agent at this OID\n"

USERS: list[str] = [
    "u_noauth\tnoAuthNoPriv\t-\t-\t-\t-\t-\t-\tyes\tyes",
    "u_md5\tauthNoPriv\tMD5\t-\tMD5\t-\tauthpass123\t-\tyes\tyes",
    "u_sha_aes\tauthPriv\tSHA\tAES\tSHA\tAES\tauthpass123\tprivpass123\tyes\tyes",
    "u_md5_aes256c\tauthPriv\tMD5\tAES-256-C\tMD5\tAES256\tauthpass123\tprivpass123\tyes\tyes",
]

def e(arcs: list[int]) -> Oid:
    """An OID below 1.3.6.1.4.1.8072.9999.1"""
    return Oid([1, 3, 6, 1, 4, 1, 8072, 9999, 1] + arcs)

def make_view() -> MibView:
    """Scalars of several types, a 3x3 table (E.10.1.c.i = c*100+i), two writable scalars and a last variable"""
    vbs = [VarBind(SYS_DESCR, OctetString(b"actsnmp test agent")),
           VarBind(e([1, 1, 0]), Integer(42)),
           VarBind(e([2, 1, 0]), OctetString(b"hello")),
           VarBind(e([3, 1, 0]), Counter64(18446744073709551615)),
           VarBind(e([4, 1, 0]), IpAddress(b"\xc0\x00\x02\x01")),
           VarBind(e([5, 1, 0]), Opaque(b"\x9f\x78\x04\x3f\x80\x00\x00")),
           VarBind(e([20, 1, 0]), Integer(0)),
           VarBind(e([20, 2, 0]), OctetString(b"abc")),
           VarBind(LAST, Integer(7))]
    for c in range(1, 4):
        for i in range(1, 4):
            vbs.append(VarBind(e([10, 1, c, i]), Integer(c * 100 + i)))
    return MibView(vbs)

def make_config() -> AgentConfig:
    rules = [WriteRule(e([20, 1]), [ber.TAG_INTEGER], 0, 100), WriteRule(e([20, 2]), [ber.TAG_OCTET_STRING], 0, 16)]
    return AgentConfig({"public": False, "private": True}, security.load_users_tsv("\n".join(USERS)).users,
                       h(AGENT_ENGINE), 3, rules)

def table_lines(cols: list[int], rows: list[int], row_major: bool) -> str:
    """Output lines of the test table, in column order (a walk) or row order (table)"""
    out: list[str] = []
    if row_major:
        for i in rows:
            for c in cols:
                out.append(EP + ".10.1.%d.%d = INTEGER: %d\n" % (c, i, c * 100 + i))
    else:
        for c in cols:
            for i in rows:
                out.append(EP + ".10.1.%d.%d = INTEGER: %d\n" % (c, i, c * 100 + i))
    return "".join(out)


# The harness #######################################################################################

class Result(object):
    """What a command wrote and its exit code"""
    out: str
    err: str
    code: int

    def __init__(self, out: str, err: str, code: int):
        self.out = out
        self.err = err
        self.code = code

actor Capture(on_done: action(Result) -> None):
    """The out, err and finished callbacks of one command; on_done() once with everything"""
    var _out: list[str] = []
    var _err: list[str] = []
    var _done = False

    def out(s: str) -> None:
        _out.append(s)

    def err(s: str) -> None:
        _err.append(s)

    def finished(code: int) -> None:
        if not _done:
            _done = True
            on_done(Result("".join(_out), "".join(_err), code))

class Step(object):
    """A command line (without "actsnmp") and what it must write: exactly, or as a prefix of out and err"""
    args: list[str]
    out: str
    err: str
    code: int
    exact: bool

    def __init__(self, args: list[str], out: str, err: str, code: int, exact: bool=True):
        self.args = args
        self.out = out
        self.err = err
        self.code = code
        self.exact = exact

proc def run_cli(mn: MemNet, port: int, args: list[str], on_done: action(Result) -> None,
                 tree: ?mibcli.MibTree=None) -> None:
    """Run one client command over MemNet from MANAGER:port; parse errors are reported as exit code 1

    With tree the command reads and prints OIDs with those MIBs, as the CLI
    does after loading the -m modules (cliopts.scan, CliOptions.mib, finish).
    """
    cap = Capture(on_done)
    try:
        o = cliopts.scan(["actsnmp"] + args)
        o.mib = tree
        if not (o.help or o.show_version):
            cliopts.finish(o)
        sec = actsnmp.security_of(o)
        c = actsnmp.new_client(None, o, sec, mn.client(MANAGER, port, o.address, o.port))
        Command(o, c, cap.out, cap.err, cap.finished)
    except cliopts.CliError as x:
        if x.error_message != "":
            cap.err(x.error_message + "\n")
        cap.finished(1)
    except ValueError as x:
        cap.err(x.error_message + "\n")
        cap.finished(1)

def _mismatch(s: Step, r: Result) -> ?str:
    ok = r.code == s.code
    if s.exact:
        ok = ok and r.out == s.out and r.err == s.err
    else:
        ok = ok and r.out.startswith(s.out) and r.err.startswith(s.err)
    if ok:
        return None
    return ("actsnmp " + " ".join(s.args) + "\n  expected exit %d, out %r, err %r\n  got      exit %d, out %r, err %r"
            % (s.code, s.out, s.err, r.code, r.out, r.err))

actor Script(mn: MemNet, steps: list[Step], first_port: int, on_done: action(list[str]) -> None,
             tree: ?mibcli.MibTree=None):
    """Runs steps one after the other and reports the mismatches (empty: all passed); tree: the MIBs to use"""
    var _i = 0
    var _failures: list[str] = []

    def _step_finished(r: Result) -> None:
        m = _mismatch(steps[_i], r)
        if m is not None:
            _failures.append(m)
        _i += 1
        _next()

    proc def _next() -> None:
        if _i >= len(steps):
            on_done(_failures)
        else:
            run_cli(mn, first_port + _i, steps[_i].args, _step_finished, tree)

    _next()

proc def finish(t: testing.AsyncT, failures: list[str]) -> None:
    if len(failures) == 0:
        t.success()
    else:
        t.failure(AssertionError("%d step(s) failed:\n" % len(failures) + "\n".join(failures)))


# Requests ##########################################################################################

def request_steps() -> list[Step]:
    pub = ["-v2c", "-c", "public", AGENT]
    v1 = ["-v1", "-c", "public", AGENT]
    return [
        # get: values of several types and both exceptions (exit 0)
        Step(["get"] + pub + ["1.3.6.1.2.1.1.1.0", EP + ".1.1.0", EP + ".3.1.0", EP + ".4.1.0", EP + ".5.1.0",
                              EP + ".1.1.1", EP + ".99.0"],
             ".1.3.6.1.2.1.1.1.0 = STRING: \"actsnmp test agent\"\n" + EP + ".1.1.0 = INTEGER: 42\n"
             + EP + ".3.1.0 = Counter64: 18446744073709551615\n" + EP + ".4.1.0 = IpAddress: 192.0.2.1\n"
             + EP + ".5.1.0 = Opaque: Float: 1.000000\n"
             + EP + ".1.1.1 = No Such Instance currently exists at this OID\n" + EP + ".99.0" + NO_SUCH_OBJECT, "", 0),
        # get without the leading dot, -O flags
        Step(["get", "-Oqv"] + pub + ["1.3.6.1.4.1.8072.9999.1.1.1.0"], "42\n", "", 0),
        Step(["get", "-OQ"] + pub + [EP + ".2.1.0"], EP + ".2.1.0 = \"hello\"\n", "", 0),
        Step(["get", "--canon"] + pub + [EP + ".2.1.0", EP + ".5.1.0"],
             EP + ".2.1.0 = STRING: \"hello\"\n" + EP + ".5.1.0 = Opaque: 9F 78 04 3F 80 00 00\n", "", 0),
        # SNMPv1 noSuchName: snmpget prints the error, drops the varbind and asks again (exit 2)
        Step(["get"] + v1 + [EP + ".1.1.0", EP + ".99.0", EP + ".2.1.0"],
             EP + ".1.1.0 = INTEGER: 42\n" + EP + ".2.1.0 = STRING: \"hello\"\n",
             "Error in packet\n" + NO_SUCH_NAME + "Failed object: " + EP + ".99.0\n\n", 2),
        Step(["get", "-Cf"] + v1 + [EP + ".1.1.0", EP + ".99.0", EP + ".2.1.0"], "",
             "Error in packet\n" + NO_SUCH_NAME + "Failed object: " + EP + ".99.0\n\n", 2),
        # SNMPv1 Counter64 is hidden: noSuchName for the only varbind, nothing to retry
        Step(["get"] + v1 + [EP + ".3.1.0"], "", "Error in packet\n" + NO_SUCH_NAME + "Failed object: " + EP
             + ".3.1.0\n\n", 2),
        # getnext
        Step(["getnext"] + pub + [EP + ".1.1.0", EP + ".10.1.1"],
             EP + ".2.1.0 = STRING: \"hello\"\n" + EP + ".10.1.1.1 = INTEGER: 101\n", "", 0),
        Step(["getnext"] + pub + [LAST.dotted()], LAST.dotted() + END_OF_MIB_VIEW, "", 0),
        Step(["getnext"] + v1 + [LAST.dotted()], "",
             "Error in packet.\n" + NO_SUCH_NAME + "Failed object: " + LAST.dotted() + "\n\n", 2),
        # bulkget: one non-repeater, two columns, two repetitions
        Step(["bulkget", "-Cn1", "-Cr2"] + pub + [EP + ".1.1.0", EP + ".10.1.1", EP + ".10.1.2"],
             EP + ".2.1.0 = STRING: \"hello\"\n" + EP + ".10.1.1.1 = INTEGER: 101\n" + EP + ".10.1.2.1 = INTEGER: 201\n"
             + EP + ".10.1.1.2 = INTEGER: 102\n" + EP + ".10.1.2.2 = INTEGER: 202\n", "", 0),
        Step(["bulkget", "-C", "r1"] + pub + [EP + ".10.1.3"], EP + ".10.1.3.1 = INTEGER: 301\n", "", 0),
        Step(["bulkget"] + v1 + [EP + ".10.1.3"], "", "snmpbulkget: Cannot send V2 PDU on V1 session\n", 1),
        # set: success, noAccess (read-only community), notWritable, wrongType, -Cq
        Step(["set", "-v2c", "-c", "private", AGENT, EP + ".20.1.0", "i", "55", EP + ".20.2.0", "s", "xyz"],
             EP + ".20.1.0 = INTEGER: 55\n" + EP + ".20.2.0 = STRING: \"xyz\"\n", "", 0),
        Step(["set"] + pub + [EP + ".20.1.0", "i", "1"], "",
             "Error in packet.\nReason: noAccess\nFailed object: " + EP + ".20.1.0\n\n", 2),
        Step(["set", "-v2c", "-c", "private", AGENT, EP + ".1.1.0", "i", "1"], "",
             "Error in packet.\nReason: notWritable (That object does not support modification)\nFailed object: "
             + EP + ".1.1.0\n\n", 2),
        Step(["set", "-v2c", "-c", "private", AGENT, EP + ".20.1.0", "i", "5", EP + ".20.2.0", "i", "1"], "",
             "Error in packet.\nReason: wrongType (The set datatype does not match the data type the agent expects)\n"
             + "Failed object: " + EP + ".20.2.0\n\n", 2),
        Step(["set", "-Cq", "-v2c", "-c", "private", AGENT, EP + ".20.1.0", "i", "-0"], "", "", 0),
        Step(["get"] + pub + [EP + ".20.1.0", EP + ".20.2.0"],
             EP + ".20.1.0 = INTEGER: 0\n" + EP + ".20.2.0 = STRING: \"xyz\"\n", "", 0),
        Step(["set", "-v1", "-c", "private", AGENT, EP + ".1.1.0", "i", "1"], "",
             "Error in packet.\n" + NO_SUCH_NAME + "Failed object: " + EP + ".1.1.0\n\n", 2),
        # SNMPv3
        Step(["get", "-v3", "-l", "authPriv", "-u", "u_sha_aes", "-a", "SHA", "-A", "authpass123", "-x", "AES", "-X",
              "privpass123", AGENT, EP + ".2.1.0"], EP + ".2.1.0 = STRING: \"hello\"\n", "", 0),
        Step(["getnext", "-v3", "-l", "authNoPriv", "-u", "u_md5", "-A", "authpass123", AGENT, EP + ".2.1.0"],
             EP + ".3.1.0 = Counter64: 18446744073709551615\n", "", 0),
        Step(["get", "-v3", "-u", "u_noauth", "-e", AGENT_ENGINE, AGENT, EP + ".1.1.0"], EP + ".1.1.0 = INTEGER: 42\n",
             "", 0),
        Step(["get", "-v3", "-l", "noAuthNoPriv", "-u", "nobody", AGENT, EP + ".2.1.0"], "",
             "snmpget: Unknown user name\n", 1),
        Step(["get", "-v3", "-l", "authNoPriv", "-u", "u_md5", "-A", "wrongpass123", AGENT, EP + ".2.1.0"], "",
             "snmpget: Authentication failure (incorrect password, community or key)\n", 1),
        # timeouts: snmpget and snmpgetnext with a period, the others without
        Step(["get", "-t", "0.2", "-r", "1", "-v2c", "-c", "public", "10.0.0.5:1161", EP + ".1.1.0"], "",
             TIMEOUT_V2 + "10.0.0.5:1161.\n", 1),
        Step(["getnext", "-t", "0.2", "-r", "0", "-v2c", "-c", "public", "udp:10.0.0.5", EP + ".1.1.0"], "",
             TIMEOUT_V2 + "udp:10.0.0.5.\n", 1),
        Step(["set", "-t", "0.2", "-r", "0", "-v2c", "-c", "public", "10.0.0.5", EP + ".1.1.0", "i", "1"], "",
             TIMEOUT_V2 + "10.0.0.5\n", 1),
        Step(["bulkget", "-t", "0.2", "-r", "0", "-v2c", "-c", "public", "10.0.0.5", EP + ".1.1.0"], "",
             TIMEOUT_V2 + "10.0.0.5\n", 1),
        Step(["walk", "-t", "0.2", "-r", "0", "-v2c", "-c", "public", "10.0.0.5", EP], "", TIMEOUT_V2 + "10.0.0.5\n", 1),
        # wrong community: snmpd drops the request, so it is a timeout
        Step(["get", "-t", "0.2", "-r", "0", "-v2c", "-c", "nobody", AGENT, EP + ".1.1.0"], "",
             TIMEOUT_V2 + AGENT + ".\n", 1),
    ]

actor _test_requests(t: testing.AsyncT):
    """get, getnext, bulkget and set (v1, v2c, v3): stdout, stderr and exit codes as net-snmp's tools"""
    t.timeout(60.0)
    mn = MemNet()
    ag = Agent(mn.server(AGENT, 161), make_view(), make_config(), None)

    def finished(failures: list[str]) -> None:
        finish(t, failures)

    Script(mn, request_steps(), 41000, finished)


# Walks and tables ##################################################################################

def walk_steps() -> list[Step]:
    pub = ["-v2c", "-c", "public", AGENT]
    v1 = ["-v1", "-c", "public", AGENT]
    all_rows = table_lines([1, 2, 3], [1, 2, 3], False)
    return [
        Step(["walk"] + pub + [EP + ".10"], all_rows, "", 0),
        Step(["walk"] + v1 + [EP + ".10"], all_rows, "", 0),
        Step(["bulkwalk"] + pub + [EP + ".10"], all_rows, "", 0),
        Step(["bulkwalk", "-Cr2"] + pub + [EP + ".10"], all_rows, "", 0),
        Step(["bulkwalk", "-Cr1", "-Cp"] + pub + [EP + ".10.1.2"], table_lines([2], [1, 2, 3], False)
             + "Variables found: 3\n", "", 0),
        # the end of the MIB: snmpwalk prints the endOfMibView varbind; SNMPv1 prints "End of MIB"
        Step(["walk"] + pub + [".1.3.6.1.6.3.99"], LAST.dotted() + " = INTEGER: 7\n" + LAST.dotted() + END_OF_MIB_VIEW,
             "", 0),
        Step(["bulkwalk"] + pub + [".1.3.6.1.6.3.99"],
             LAST.dotted() + " = INTEGER: 7\n" + LAST.dotted() + END_OF_MIB_VIEW, "", 0),
        Step(["walk"] + v1 + [".1.3.6.1.6.3.99"], LAST.dotted() + " = INTEGER: 7\nEnd of MIB\n", "", 0),
        # an empty subtree: GET of the root (also for a scalar instance), not with -CI
        Step(["walk"] + pub + [EP + ".15"], EP + ".15" + NO_SUCH_OBJECT, "", 0),
        Step(["walk", "-CI"] + pub + [EP + ".15"], "", "", 0),
        Step(["walk"] + pub + [EP + ".1.1.0"], EP + ".1.1.0 = INTEGER: 42\n", "", 0),
        Step(["bulkwalk"] + pub + [EP + ".1.1.0"], EP + ".1.1.0 = INTEGER: 42\n", "", 0),
        # snmpwalk counts what the GET of the root printed
        Step(["walk", "-Cp"] + pub + [EP + ".15"], EP + ".15" + NO_SUCH_OBJECT + "Variables found: 1\n", "", 0),
        # -Ci: GET the root first; -CE: end OID
        Step(["walk", "-Ci"] + pub + [EP + ".4"], EP + ".4" + NO_SUCH_OBJECT + EP + ".4.1.0 = IpAddress: 192.0.2.1\n",
             "", 0),
        Step(["walk", "-CE", EP + ".10.1.1.3"] + pub + [EP + ".10"], table_lines([1], [1, 2], False), "", 0),
        Step(["walk", "-CpE", EP + ".10.1.2"] + pub + [EP + ".10"], table_lines([1], [1, 2, 3], False)
             + "Variables found: 3\n", "", 0),
        Step(["walk", "-Cp", "--canon"] + pub + [EP + ".4"], EP + ".4.1.0 = IpAddress: 192.0.2.1\nVariables found: 1\n",
             "", 0),
        # table: lock-step columns, rows in index order
        Step(["table"] + pub + [EP + ".10.1.1", EP + ".10.1.3"], table_lines([1, 3], [1, 2, 3], True), "", 0),
        Step(["table", "-Cr1"] + v1 + [EP + ".10.1.1", EP + ".10.1.2", EP + ".10.1.3"],
             table_lines([1, 2, 3], [1, 2, 3], True), "", 0),
        Step(["table"] + pub + [EP + ".10.1.3", EP + ".10.1.9"], table_lines([3], [1, 2, 3], True), "", 0),
        Step(["table", "--canon", "-v3", "-l", "authPriv", "-u", "u_sha_aes", "-a", "SHA", "-A", "authpass123", "-x",
              "AES", "-X", "privpass123", AGENT, EP + ".10.1.2", EP + ".10.1.1"], table_lines([2, 1], [1, 2, 3], True),
             "", 0),
        # columns the Client refuses: one inside another
        Step(["table"] + pub + [EP + ".10.1", EP + ".10.1.1"], "", "snmptable: ", 1, False),
    ]

actor _test_walks(t: testing.AsyncT):
    """walk, bulkwalk and table as snmpwalk and snmpbulkwalk print them"""
    t.timeout(60.0)
    mn = MemNet()
    ag = Agent(mn.server(AGENT, 161), make_view(), make_config(), None)

    def finished(failures: list[str]) -> None:
        finish(t, failures)

    Script(mn, walk_steps(), 42000, finished)

actor _test_walk_faults(t: testing.AsyncT):
    """A walk that meets a non-increasing OID (exit 1) or an error-status (exit 2), as net-snmp reports them"""
    t.timeout(60.0)
    mn = MemNet()
    bad = Agent(mn.server(AGENT, 161), make_view(), make_config(), None, Faults(non_increasing_at=e([10, 1, 1, 3])))
    err_agent = Agent(mn.server("10.0.0.3", 161), make_view(), make_config(), None,
                      Faults(error_at=e([10, 1, 2, 2]), error_status=pdu.GEN_ERR))
    pub = ["-v2c", "-c", "public", AGENT]
    steps = [
        Step(["walk"] + pub + [EP + ".10"],
             table_lines([1], [1, 2], False) + EP + ".10.1.1.2 = INTEGER: 103\n",
             "Error: OID not increasing: " + EP + ".10.1.1.2\n >= " + EP + ".10.1.1.2\n\n", 1),
        Step(["bulkwalk", "-Cr3"] + pub + [EP + ".10"], table_lines([1], [1, 2], False) + EP + ".10.1.1.2 = INTEGER: 103\n",
             "Error: OID not increasing: " + EP + ".10.1.1.2\n >= " + EP + ".10.1.1.2\n\n", 1, False),
        Step(["walk", "-v2c", "-c", "public", "10.0.0.3", EP + ".10"],
             table_lines([1], [1, 2, 3], False) + table_lines([2], [1, 2], False),
             "Error in packet.\nReason: (genError) A general failure occured\nFailed object: " + EP + ".10.1.2.2\n\n", 2),
        # table (Client.get_table): the rows found before the error, then the error
        Step(["table"] + pub + [EP + ".10.1.1"], "",
             "Error: OID not increasing: " + EP + ".10.1.1.2\n >= " + EP + ".10.1.1.2\n\n", 1, False),
        Step(["table", "-Cr1", "-v2c", "-c", "public", "10.0.0.3", EP + ".10.1.2"], table_lines([2], [1, 2], True),
             "Error in packet.\nReason: (genError) A general failure occured\nFailed object: " + EP + ".10.1.2.2\n\n", 2),
        # GETBULK from 10.1.2.2 (the last OID of the first response) names the faulty OID
        Step(["bulkwalk", "-Cr5", "-v2c", "-c", "public", "10.0.0.3", EP + ".10"],
             table_lines([1], [1, 2, 3], False) + table_lines([2], [1, 2], False),
             "Error in packet.\nReason: (genError) A general failure occured\nFailed object: " + EP + ".10.1.2.2\n\n", 2),
    ]

    def finished(failures: list[str]) -> None:
        finish(t, failures)

    Script(mn, steps, 43000, finished)


# net-snmp parity ####################################################################################

TOO_BIG_TEXT = "Reason: (tooBig) Response message would have been too large.\n"
BUILD_FAILURE = "snmp_build: unknown failure\n"

def parity_steps() -> list[Step]:
    pub = ["-v2c", "-c", "public", AGENT]
    big = ["-v2c", "-c", "public", "10.0.0.3"]
    nsn = ["-v2c", "-c", "public", "10.0.0.4"]
    md5 = ["-v3", "-l", "authNoPriv", "-u", "u_md5", "-A", "authpass123"]
    return [
        # tooBig: snmpgetnext's exit code is 2 only for an error-index; get and bulkget are neither split nor halved
        Step(["getnext"] + big + [EP + ".1.1.0"], "", "Error in packet.\n" + TOO_BIG_TEXT, 0),
        Step(["get"] + big + [EP + ".1.1.0", EP + ".2.1.0"], "", "Error in packet\n" + TOO_BIG_TEXT, 2),
        Step(["bulkget", "-Cr5"] + big + [EP + ".10"], "", "Error in packet.\n" + TOO_BIG_TEXT, 2),
        Step(["walk"] + big + [EP + ".10"], "", "Error in packet.\n" + TOO_BIG_TEXT, 2),
        # snmpbulkget takes noSuchName for the end of the MIB
        Step(["bulkget"] + nsn + [EP + ".10"], "End of MIB.\n", "", 0),
        # what -Ci printed counts (and makes the GET of an empty subtree unnecessary)
        Step(["walk", "-Cpi"] + pub + [EP + ".4"], EP + ".4" + NO_SUCH_OBJECT + EP + ".4.1.0 = IpAddress: 192.0.2.1\n"
             + "Variables found: 2\n", "", 0),
        Step(["bulkwalk", "-C", "p", "-C", "i"] + pub + [EP + ".15"], EP + ".15" + NO_SUCH_OBJECT + "Variables found: 1\n",
             "", 0),
        # SNMPv3: a discovery that times out is "<tool>: Timeout" (net-snmp discovers when it opens the session)
        Step(["get"] + md5 + ["-t", "0.2", "-r", "0", "10.0.0.5", EP + ".1.1.0"], "", "snmpget: Timeout\n", 1),
        Step(["walk"] + md5 + ["-t", "0.2", "-r", "0", "10.0.0.5", EP], "", "snmpwalk: Timeout\n", 1),
        Step(["get", "-e", AGENT_ENGINE] + md5 + ["-t", "0.2", "-r", "0", "10.0.0.5", EP + ".1.1.0"], "",
             TIMEOUT_V2 + "10.0.0.5.\n", 1),
        # the session errors come after a successful discovery
        Step(["get", "-v3", "-l", "authNoPriv", "-A", "authpass123", AGENT, EP + ".1.1.0"], "",
             "snmpget: No securityName specified\n", 1),
        Step(["set", "-v3", "-l", "authNoPriv", "-u", "u_md5", AGENT, EP + ".20.1.0", "i", "x"], "",
             "snmpset: USM authentication failure (incorrect password or key)\n", 1),
        Step(["walk", "-v3", "-l", "authPriv", "-u", "u_sha_aes", "-A", "authpass123", AGENT, EP], "",
             "snmpwalk: USM generic error\n", 1),
        Step(["get", "-v3", "-l", "authNoPriv", "-u", "u_md5", "-t", "0.2", "-r", "0", "10.0.0.5", EP + ".1.1.0"], "",
             "snmpget: Timeout\n", 1),
        Step(["get", "-v3", "-e", AGENT_ENGINE, "-l", "authNoPriv", "-u", "u_md5", "10.0.0.5", EP + ".1.1.0"], "",
             "snmpget: USM authentication failure (incorrect password or key)\n", 1),
        # OIDs net-snmp cannot encode (a first sub-identifier above 2)
        Step(["get"] + pub + [EP + ".1.1.0", "3.1"], "",
             BUILD_FAILURE + "snmpget: Error building ASN.1 representation (Can't build OID for variable)\n", 1),
        Step(["set", "-v2c", "-c", "private", AGENT, EP + ".20.1.0", "o", "5.1"], "",
             BUILD_FAILURE + "snmpset: Error building ASN.1 representation (build objid: bad first subidentifier)\n", 1),
        Step(["trap", "-v2c", "-c", "public", RECEIVER, "1", "3.1"], "",
             BUILD_FAILURE + "snmptrap: Error building ASN.1 representation (build objid: bad first subidentifier)\n", 1),
        # an unknown --NAME is a configuration-token warning; the command runs
        Step(["get", "--nosuch=1"] + pub + [EP + ".1.1.0"], EP + ".1.1.0 = INTEGER: 42\n",
             "(null): line 0: Warning: Unknown token: nosuch.\n", 0),
        # usage errors: a missing -Cr number prints only the usage text (not captured here)
        Step(["bulkget", "-Cr"] + pub + [EP + ".10"], "", "", 1),
        Step(["walk", "-Cx"] + pub + [EP + ".10"], "", "Unknown flag passed to -C: x\n", 1),
        Step(["set", "-v2c", "-c", "private", AGENT, EP + ".20.1.0", "i", "x", EP + ".20.2.0", "x", "0g"], "",
             EP + ".20.1.0: Value out of range (x)\n" + EP + ".20.2.0: Bad value notation (0g)\n", 1),
    ]

actor _test_parity(t: testing.AsyncT):
    """Command lines checked against net-snmp's output (interop/clicheck.sh): exact stdout, stderr, exit code"""
    t.timeout(60.0)
    mn = MemNet()
    ag = Agent(mn.server(AGENT, 161), make_view(), make_config(), None)
    big = Agent(mn.server("10.0.0.3", 161), make_view(), make_config(), None, Faults(too_big_over=40))
    nsn = Agent(mn.server("10.0.0.4", 161), make_view(), make_config(), None,
                Faults(error_at=e([10]), error_status=pdu.NO_SUCH_NAME))

    def finished(failures: list[str]) -> None:
        finish(t, failures)

    Script(mn, parity_steps(), 46000, finished)

def _test_failure_texts() -> None:
    """A DNS failure of the agent's name is net-snmp's Unknown host, a discovery timeout is "<tool>: Timeout" """
    o = cliopts.parse(["actsnmp", "get", "-c", "public", "udp:nosuch.invalid:161", "1.3"])
    dns = errors.TransportError("UDP setup for nosuch.invalid:161 failed: DNS lookup error: unknown node or service")
    testing.assertEqual(actsnmp.failure_text(o, dns, True), "snmpget: Unknown host (udp:nosuch.invalid:161)\n")
    other = errors.TransportError("UDP setup for x:161 failed: no route")
    testing.assertEqual(actsnmp.failure_text(o, other, True),
                        "snmpget: UDP setup for x:161 failed: no route\n")
    disc = errors.TimeoutError(2, 2.0, actsnmp.DISCOVERY_HINT + "; ICMP port unreachable")
    testing.assertEqual(actsnmp.failure_text(o, disc, True), "snmpget: Timeout\n")
    plain = errors.TimeoutError(2, 2.0, "ICMP port unreachable")
    testing.assertEqual(actsnmp.failure_text(o, plain, True), "Timeout: No Response from udp:nosuch.invalid:161.\n")
    # with MIBs the "<tool>: <reason>" texts carry the detail a name lookup left behind (snmp_sess_perror);
    # "Timeout: No Response" and "Unknown host (...)" do not
    o.mib_detail = "Sub-id not found: (top) -> sysDescr"
    testing.assertEqual(actsnmp.failure_text(o, disc, True), "snmpget: Timeout (Sub-id not found: (top) -> sysDescr)\n")
    testing.assertEqual(actsnmp.failure_text(o, other, True),
                        "snmpget: UDP setup for x:161 failed: no route (Sub-id not found: (top) -> sysDescr)\n")
    testing.assertEqual(actsnmp.failure_text(o, plain, True), "Timeout: No Response from udp:nosuch.invalid:161.\n")
    testing.assertEqual(actsnmp.failure_text(o, dns, True), "snmpget: Unknown host (udp:nosuch.invalid:161)\n")
    v = cliopts.parse(["actsnmp", "trap", "-v3", "-Ci", "h", "", "1.3.6"])
    testing.assertEqual(actsnmp.session_error_text(v), "snmpinform: No securityName specified\n")
    v.mib_detail = "Sub-id not found: (top) -> sysContact"
    testing.assertEqual(actsnmp.session_error_text(v),
                        "snmpinform: No securityName specified (Sub-id not found: (top) -> sysContact)\n")

def bp(args: list[str]) -> str:
    """actsnmp.build_problem of a command line"""
    return actsnmp.build_problem(cliopts.parse(["actsnmp"] + args))

def _test_build_problem() -> None:
    """build_problem checks the varbind names before their values, the trap OID and enterprise first"""
    testing.assertEqual(bp(["get", "-c", "x", "h", "1.3", "2.999"]), "")
    name = "Error building ASN.1 representation (Can't build OID for variable)\n"
    value = "Error building ASN.1 representation (build objid: bad first subidentifier)\n"
    testing.assertEqual(bp(["walk", "-c", "x", "h", "3.1"]), BUILD_FAILURE + "snmpwalk: " + name)
    testing.assertEqual(bp(["set", "-c", "x", "h", "1.3", "o", "3.1", "4.1", "i", "1"]), BUILD_FAILURE + "snmpset: " + value)
    testing.assertEqual(bp(["set", "-c", "x", "h", "4.1", "o", "3.1"]), BUILD_FAILURE + "snmpset: " + name)
    testing.assertEqual(bp(["trap", "-v1", "-c", "x", "h", "3.1", "", "6", "1", "1", "4.1", "i", "1"]),
                        BUILD_FAILURE + "snmptrap: " + value)
    testing.assertEqual(bp(["trap", "-Ci", "-c", "x", "h", "1", "1.3", "4.1", "i", "1"]),
                        BUILD_FAILURE + "snmpinform: " + name)


# Notifications ######################################################################################

actor Blocks(want: int, on_done: action(str) -> None):
    """Collects trapd output; on_done(text) once it holds want END lines"""
    var _parts: list[str] = []
    var _ends = 0
    var _reported = False

    def out(s: str) -> None:
        _parts.append(s)
        _ends += s.count("END\n")
        if not _reported and _ends >= want:
            _reported = True
            on_done("".join(_parts))

def trap_steps() -> list[Step]:
    v3 = ["-v3", "-l", "authPriv", "-u", "u_md5_aes256c", "-a", "MD5", "-A", "authpass123", "-x", "AES-256-C", "-X",
          "privpass123"]
    return [
        Step(["trap", "-v1", "-c", "public", RECEIVER, ".1.3.6.1.4.1.8072.9999", "192.0.2.1", "6", "42", "12345",
              EP + ".1.1.0", "i", "0"], "", "", 0),
        Step(["trap", "-v2c", "-c", "public", RECEIVER, "4294967295", ".1.3.6.1.4.1.8072.9999.3.0.13",
              EP + ".1.18.0", "i", "2147483647", EP + ".1.19.0", "i", "-2147483648", EP + ".2.2.0", "s", "",
              EP + ".2.5.0", "s", "say \"hi\" \\ back", EP + ".2.6.0", "x", "7461620a", EP + ".3.1.0", "o", ".0.0",
              EP + ".4.4.0", "a", "255.255.255.255", EP + ".5.5.0", "c", "4294967295", EP + ".6.4.0", "u", "4294967295",
              EP + ".7.3.0", "t", "8640000", EP + ".8.7.0", "C", "18446744073709551615", EP + ".9.2.0", "F", "1.0",
              EP + ".9.3.0", "I", "42", EP + ".9.4.0", "D", "-2.5", EP + ".9.5.0", "U", "18446744073709551615",
              EP + ".9.1.0", "q", "DEADBEEF", EP + ".2.7.0", "d", "1.2.250", EP + ".2.8.0", "b", "0 9 15",
              EP + ".2.9.0", "n", "ignored"], "", "", 0),
        Step(["inform", "-v2c", "-c", "public", "-r", "0", "-t", "5", RECEIVER, "123", ".1.3.6.1.4.1.8072.9999.3.0.14"],
             "", "", 0),
        Step(["trap", "-Ci", "-v2c", "-c", "public", RECEIVER, "1", ".1.3.6.1.4.1.8072.9999.3.0.15"], "", "", 0),
        Step(["trap"] + v3 + ["-e", "0x8000000001020304", RECEIVER, "3000002", ".1.3.6.1.4.1.8072.9999.3.0.16",
                              EP + ".1.1.0", "i", "1"], "", "", 0),
        Step(["inform"] + v3 + ["-r", "0", "-t", "5", RECEIVER, "3001002", ".1.3.6.1.4.1.8072.9999.3.0.17"], "", "",
             0),
        Step(["trap", "-v2c", "-c", "public", RECEIVER, "", ".1.3.6.1.6.3.1.1.5.1"], "", "", 0),
        # refused before anything is sent
        Step(["inform", "-v1", "-c", "public", RECEIVER, "1", ".1.3"], "", "Cannot send INFORM as SNMPv1 PDU\n", 1),
        Step(["inform", "-v2c", "-c", "public", "-r", "0", "-t", "0.2", "10.0.0.5", "1", ".1.3"], "",
             "snmpinform: Timeout\n", 1),
    ]

EXPECTED_BLOCKS = """NOTIFICATION v1 TRAP community="public" enterprise=.1.3.6.1.4.1.8072.9999 agent=192.0.2.1 generic=6 specific=42 uptime=12345 trapoid=.1.3.6.1.4.1.8072.9999.0.42
.1.3.6.1.4.1.8072.9999.1.1.1.0 = INTEGER: 0
END
NOTIFICATION v2c TRAP2 community="public" uptime=4294967295 trapoid=.1.3.6.1.4.1.8072.9999.3.0.13
.1.3.6.1.4.1.8072.9999.1.1.18.0 = INTEGER: 2147483647
