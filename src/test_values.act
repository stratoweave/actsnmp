"""Tests for values

Messages B, E, F, I, J, N and O are SNMPv1/v2c reference packets, checked
with pysnmp. The Opaque float and double vectors were checked with glibc
printf("%f"), which net-snmp uses, and Python struct.
"""

import testing
import ber
import errors
import values
from oid import Oid
from values import Value, VarBind, Integer, OctetString, Null, ObjectIdentifier, IpAddress, Counter32, Gauge32
from values import TimeTicks, Opaque, Counter64, NoSuchObject, NoSuchInstance, EndOfMibView, UnknownValue
from values import MalformedValue
from testutil import h, decode_fails, encode_fails, Lcg

def op(s: str) -> Oid:
    return Oid.parse(s)

def value_of(hx: str) -> Value:
    """Decode a single value TLV that must fill the whole input"""
    b = h(hx)
    v, n = values.decode_value(b, 0, len(b))
    testing.assertEqual(n, len(b), "value end of " + hx)
    return v

def vbl_range(msg: bytes) -> (int, int):
    """Return the content range of the VarBindList of a v1/v2c message"""
    ms, me = ber.expect_tlv(msg, 0, len(msg), ber.TAG_SEQUENCE)
    vs, ve = ber.expect_tlv(msg, ms, me, ber.TAG_INTEGER)
    cs, ce = ber.expect_tlv(msg, ve, me, ber.TAG_OCTET_STRING)
    tag, ps, pe = ber.read_tlv(msg, ce, me)
    p = ps
    for i in range(3):
        s, p = ber.expect_tlv(msg, p, pe, ber.TAG_INTEGER)
    return ber.expect_tlv(msg, p, pe, ber.TAG_SEQUENCE)


