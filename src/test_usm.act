def sysdescr_get(request_id: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"", Pdu(pdu.GET, request_id, varbinds=[VarBind(Oid.parse(SYS_DESCR))]))

def sysdescr_response(request_id: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"", Pdu(pdu.RESPONSE, request_id, varbinds=[
        VarBind(Oid.parse(SYS_DESCR), OctetString(b"actsnmp-v3-spec-test"))]))

def captures() -> list[(str, str, ?LocalizedUser, ScopedPdu)]:
    shaaes = user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128)
    md5des = user_for(b"md5des", usm.AUTH_MD5, usm.PRIV_DES)
    sha256aes = user_for(b"sha256aes", usm.AUTH_SHA256, usm.PRIV_AES128)
    return [
        ("discovery request", DISCOVERY_REQUEST, None, ScopedPdu(b"", b"", Pdu(pdu.GET, 5001))),
        ("discovery report", DISCOVERY_REPORT, None, report_scoped(5001, 4, 11)),
        ("sync request", SYNC_REQUEST, shaaes, sysdescr_get(5002)),
        ("sync report", SYNC_REPORT, shaaes, report_scoped(0, 2, 1)),
        ("net-snmp discovery request", NS_DISCOVERY_REQUEST, None, ScopedPdu(b"", b"", Pdu(pdu.GET, 0x7fd703ac))),
        ("net-snmp discovery report", NS_DISCOVERY_REPORT, None, report_scoped(0x7fd703ac, 4, 1)),
        ("net-snmp shaaes GET", NS_SHAAES_GET, shaaes, sysdescr_get(0x7fd703ab)),
        ("net-snmp shaaes Response", NS_SHAAES_RESPONSE, shaaes, sysdescr_response(0x7fd703ab)),
        # DES with net-snmp's PKCS#5-style padding: 7 and 3 octets after the ScopedPDU
        ("net-snmp md5des GET", NS_MD5DES_GET, md5des, sysdescr_get(0x01a95adc)),
        ("net-snmp md5des Response", NS_MD5DES_RESPONSE, md5des, sysdescr_response(0x01a95adc)),
        ("net-snmp sha256aes GET", NS_SHA256AES_GET, sha256aes, sysdescr_get(0x5ca535b8)),
        ("net-snmp sha256aes Response", NS_SHA256AES_RESPONSE, sha256aes, sysdescr_response(0x5ca535b8))]

def _test_unprotect_captures() -> None:
    for name, hx, u, want in captures():
        data = h(hx)
        testing.assertEqual(usm.unprotect(data, decode3(data), u), want, name)

def _test_unprotect_captured_plaintexts() -> None:
    # the decrypted ScopedPDUs equal the documented plaintexts of the captures
    md5des = user_for(b"md5des", usm.AUTH_MD5, usm.PRIV_DES)
    plain = h("302f040d80001f888001020304050607080400a01c020401a95adc020100020100300e300c06082b06010201010100050007070707070707")
    testing.assertEqual(usm.unprotect(h(NS_MD5DES_GET), decode3(h(NS_MD5DES_GET)), md5des),
                        message.decode_scoped(plain, 0, len(plain)))
    sha256aes = user_for(b"sha256aes", usm.AUTH_SHA256, usm.PRIV_AES128)
    plain2 = h("3043040d80001f888001020304050607080400a23002045ca535b80201000201003022302006082b060102010101000414616374736e6d702d76332d737065632d74657374")
    got = usm.unprotect(h(NS_SHA256AES_RESPONSE), decode3(h(NS_SHA256AES_RESPONSE)), sha256aes)
    testing.assertEqual(message.encode_scoped(got), plain2)


# Incoming failures #################################################################################

def incoming_fails(data: bytes, msg: V3Message, u: ?LocalizedUser, kind: str, what: str,
                   undecodable: bool=False) -> None:
    try:
        usm.unprotect(data, msg, u)
    except usm.UsmIncomingError as e:
        testing.assertEqual(e.kind, kind, what + ": " + e.error_message)
        testing.assertEqual(e.undecodable, undecodable, what + ": undecodable")
        return
    testing.error("no UsmIncomingError: " + what)

def with_mac(data: bytes, offset: int, auth: int) -> bytes:
    """data with a correct MAC for the vector key of auth written at offset"""
    n = usm.auth_mac_len(auth)
    zeroed = data[:offset] + b"\x00" * n + data[offset + n:]
    mac = usmcrypto.hmac(auth, auth_key(auth), zeroed)[:n]
    return zeroed[:offset] + mac + zeroed[offset + n:]

def authpriv_raw(user: bytes, auth: int, salt: bytes, ciphertext: bytes) -> bytes:
    """An authPriv message with arbitrary msgPrivacyParameters and encryptedPDU, correctly MAC'd"""
    params = UsmSecurityParameters(engine(), 1, 150, user, b"\x00" * usm.auth_mac_len(auth), salt)
    r = message.encode_v3(V3Message(MSG_ID, 65507, 0x07, params), ciphertext)
    return with_mac(r.msg, r.auth_offset, auth)

def _test_flipped_mac_wrong_digests() -> None:
    for v in all_vectors():
        if v.auth == usm.AUTH_NONE:
            continue
        m = decode3(v.data)
        n = usm.auth_mac_len(v.auth)
        for i in range(n):
            p = m.auth_offset + i
            bad = v.data[:p] + ber.BYTE_TABLE[v.data[p] ^ 0x01] + v.data[p + 1:]
            incoming_fails(bad, decode3(bad), v.localized(), usm.USM_STATS_WRONG_DIGESTS, v.name + " MAC octet %d" % i)

def _test_wrong_keys() -> None:
    for v in all_vectors():
        if v.auth == usm.AUTH_NONE:
            continue
        m = decode3(v.data)
        u = v.localized()
        wrong_auth = LocalizedUser(u.user, u.auth, u.priv, pseudo_random(len(u.auth_key), 5), u.priv_key, u.engine_id)
        incoming_fails(v.data, m, wrong_auth, usm.USM_STATS_WRONG_DIGESTS, v.name + " wrong auth key")
        if v.priv != usm.PRIV_NONE:
            # the MAC verifies, but the plaintext is garbage
            wrong_priv = LocalizedUser(u.user, u.auth, u.priv, u.auth_key, pseudo_random(len(u.priv_key), 9), u.engine_id)
            usm.authenticate(v.data, m, wrong_priv)
            incoming_fails(v.data, m, wrong_priv, usm.USM_STATS_DECRYPTION_ERRORS, v.name + " wrong priv key", True)

def _test_wrong_protocols() -> None:
    v = spec9_vectors()[4]          # V-SHA-AES
    m = decode3(v.data)
    # another hash with a key of its length: wrong MAC length or wrong MAC
    for auth in [usm.AUTH_MD5, usm.AUTH_SHA224, usm.AUTH_SHA256, usm.AUTH_SHA512]:
        u = LocalizedUser(b"shaaes", auth, usm.PRIV_AES128, auth_key(auth), priv_key(auth, usm.PRIV_AES128), engine())
        incoming_fails(v.data, m, u, usm.USM_STATS_WRONG_DIGESTS, "SHA message checked as " + usm.auth_name(auth))
    # another cipher with the right MAC key: a DES length mismatch (49 octets), or garbage plaintext
    for priv in [usm.PRIV_DES, usm.PRIV_3DES]:
        u = user_for(b"shaaes", usm.AUTH_SHA1, priv)
        incoming_fails(v.data, m, u, usm.USM_STATS_DECRYPTION_ERRORS, "AES message decrypted as " + usm.priv_name(priv))
    for priv in [usm.PRIV_AES192, usm.PRIV_AES256, usm.PRIV_AES256C]:
        u = user_for(b"shaaes", usm.AUTH_SHA1, priv)
        incoming_fails(v.data, m, u, usm.USM_STATS_DECRYPTION_ERRORS, "AES message decrypted as " + usm.priv_name(priv),
                       True)

def _test_unknown_user_and_engine() -> None:
    v = spec9_vectors()[4]          # V-SHA-AES, user shaaes
    m = decode3(v.data)
    incoming_fails(v.data, m, None, usm.USM_STATS_UNKNOWN_USER_NAMES, "authPriv without a user")
    other = user_for(b"shaaes2", usm.AUTH_SHA1, usm.PRIV_AES128)
    incoming_fails(v.data, m, other, usm.USM_STATS_UNKNOWN_USER_NAMES, "keys of another user")
    elsewhere = LocalizedUser(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128, auth_key(usm.AUTH_SHA1),
                              priv_key(usm.AUTH_SHA1, usm.PRIV_AES128), h("8000000001"))
    incoming_fails(v.data, m, elsewhere, usm.USM_STATS_UNKNOWN_ENGINE_IDS, "keys for another engine")
    a = spec9_vectors()[1]          # V-SHA-AUTHNOPRIV
    incoming_fails(a.data, decode3(a.data), None, usm.USM_STATS_UNKNOWN_USER_NAMES, "authNoPriv without a user")
    # noAuthNoPriv: no user needed; with a user, name and engine must still match
    n = spec9_vectors()[0]
    nm = decode3(n.data)
    testing.assertEqual(usm.unprotect(n.data, nm, None), get_scoped())
    testing.assertEqual(usm.unprotect(n.data, nm, user_for(b"noauth", usm.AUTH_SHA1, usm.PRIV_AES128)), get_scoped())
    incoming_fails(n.data, nm, user_for(b"other", usm.AUTH_NONE, usm.PRIV_NONE), usm.USM_STATS_UNKNOWN_USER_NAMES,
                   "noAuthNoPriv with another user")
    incoming_fails(n.data, nm, LocalizedUser(b"noauth", usm.AUTH_NONE, usm.PRIV_NONE, b"", b"", b"\x80\x00\x00\x00\x01"),
                   usm.USM_STATS_UNKNOWN_ENGINE_IDS, "noAuthNoPriv for another engine")

def _test_unsupported_levels() -> None:
    v = spec9_vectors()[4]          # V-SHA-AES
    m = decode3(v.data)
    incoming_fails(v.data, m, user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_NONE), usm.USM_STATS_UNSUPPORTED_SEC_LEVELS,
                   "authPriv for an authNoPriv user")
    incoming_fails(v.data, m, user_for(b"shaaes", usm.AUTH_NONE, usm.PRIV_NONE), usm.USM_STATS_UNSUPPORTED_SEC_LEVELS,
                   "authPriv for a noAuthNoPriv user")
    a = spec9_vectors()[1]          # V-SHA-AUTHNOPRIV
    incoming_fails(a.data, decode3(a.data), user_for(b"shaonly", usm.AUTH_NONE, usm.PRIV_NONE),
                   usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, "authNoPriv for a noAuthNoPriv user")
    # a user with privacy may send less (VACM decides, not USM)
    testing.assertEqual(usm.unprotect(a.data, decode3(a.data), user_for(b"shaonly", usm.AUTH_SHA1, usm.PRIV_AES128)),
                        get_scoped())

def _test_bad_privacy_parameters() -> None:
    plain = message.encode_scoped(get_scoped())
    shaaes = user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128)
    md5des = user_for(b"md5des", usm.AUTH_MD5, usm.PRIV_DES)
    for salt in [b"", b"\x01" * 7, b"\x01" * 9, b"\x01" * 16]:
        data = authpriv_raw(b"shaaes", usm.AUTH_SHA1, salt, plain)
        incoming_fails(data, decode3(data), shaaes, usm.USM_STATS_DECRYPTION_ERRORS, "AES salt of %d" % len(salt))
        data2 = authpriv_raw(b"md5des", usm.AUTH_MD5, salt, plain + b"\x00" * 7)
        incoming_fails(data2, decode3(data2), md5des, usm.USM_STATS_DECRYPTION_ERRORS, "DES salt of %d" % len(salt))
    # DES ciphertext must be a non-empty multiple of 8
    for n in [0, 1, 7, 9, 49, 55]:
        data = authpriv_raw(b"md5des", usm.AUTH_MD5, b"\x00" * 8, pseudo_random(n, n))
        incoming_fails(data, decode3(data), md5des, usm.USM_STATS_DECRYPTION_ERRORS, "DES ciphertext of %d" % n)
    # AES: empty ciphertext, and plaintexts that are no ScopedPDU
    salt = h("0102030405060708")
    iv = h("00000001000000960102030405060708")
    key = priv_key(usm.AUTH_SHA1, usm.PRIV_AES128)
    for pt in [b"", b"\x04\x00", b"\x30", b"\x30\x00", b"\x30\x80" + plain[2:], plain[:len(plain) - 1],
               b"\x30\x05\x04\x00\x04\x00\x05"]:
        data = authpriv_raw(b"shaaes", usm.AUTH_SHA1, salt, usmcrypto.aes_cfb128_encrypt(key, iv, pt))
        incoming_fails(data, decode3(data), shaaes, usm.USM_STATS_DECRYPTION_ERRORS, "AES plaintext " + pt.hex(), True)
    # trailing octets after the ScopedPDU are ignored with AES too
    data = authpriv_raw(b"shaaes", usm.AUTH_SHA1, salt, usmcrypto.aes_cfb128_encrypt(key, iv, plain + b"\x99\x98"))
    testing.assertEqual(usm.unprotect(data, decode3(data), shaaes), get_scoped())

def _test_invalid_messages() -> None:
    v = spec9_vectors()[4]          # V-SHA-AES
    m = decode3(v.data)
    u = v.localized()
    flags_only_priv = V3Message(m.msg_id, m.max_size, 0x06, m.usm, None, m.encrypted, auth_offset=m.auth_offset)
    incoming_fails(v.data, flags_only_priv, u, usm.SNMP_INVALID_MSGS, "privFlag without authFlag")
    flags_priv_none = V3Message(m.msg_id, m.max_size, 0x02, m.usm, None, m.encrypted, auth_offset=m.auth_offset)
    incoming_fails(v.data, flags_priv_none, None, usm.SNMP_INVALID_MSGS, "privFlag without authFlag, no user")
    other_model = V3Message(m.msg_id, m.max_size, m.flags, m.usm, None, m.encrypted, 2, m.auth_offset)
    incoming_fails(v.data, other_model, u, usm.SNMP_UNKNOWN_SECURITY_MODELS, "security model 2")
    no_offset = V3Message(m.msg_id, m.max_size, m.flags, m.usm, None, m.encrypted, auth_offset=-1)
    incoming_fails(v.data, no_offset, u, usm.USM_STATS_WRONG_DIGESTS, "auth_offset -1")
    past_end = V3Message(m.msg_id, m.max_size, m.flags, m.usm, None, m.encrypted, auth_offset=len(v.data) - 5)
    incoming_fails(v.data, past_end, u, usm.USM_STATS_WRONG_DIGESTS, "auth_offset past the end")
    shifted = V3Message(m.msg_id, m.max_size, m.flags, m.usm, None, m.encrypted, auth_offset=m.auth_offset + 1)
    incoming_fails(v.data, shifted, u, usm.USM_STATS_WRONG_DIGESTS, "auth_offset off by one")
    no_ct = V3Message(m.msg_id, m.max_size, m.flags, m.usm, None, None, auth_offset=m.auth_offset)
    incoming_fails(v.data, no_ct, u, usm.USM_STATS_DECRYPTION_ERRORS, "encrypted message without encryptedPDU")
    n = spec9_vectors()[0]
    nm = decode3(n.data)
    no_scoped = V3Message(nm.msg_id, nm.max_size, nm.flags, nm.usm, None, None, auth_offset=nm.auth_offset)
    incoming_fails(n.data, no_scoped, None, usm.SNMP_INVALID_MSGS, "plaintext message without ScopedPDU")

def _test_decrypt_scoped_alone() -> None:
    v = spec9_vectors()[4]          # V-SHA-AES
    m = decode3(v.data)
    for u in [None, user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_NONE)]:
        try:
            usm.decrypt_scoped(m, u)
            testing.error("decrypt_scoped without privacy keys")
        except usm.UsmIncomingError as e:
            ok = e.kind == usm.USM_STATS_UNKNOWN_USER_NAMES or e.kind == usm.USM_STATS_UNSUPPORTED_SEC_LEVELS
            testing.assertTrue(ok, e.error_message)
    n = spec9_vectors()[0]
    testing.assertEqual(usm.decrypt_scoped(decode3(n.data), None), get_scoped())
    # privFlag without authFlag: decrypt_scoped() refuses it on its own as well
    only_priv = V3Message(m.msg_id, m.max_size, 0x02, m.usm, None, m.encrypted, auth_offset=m.auth_offset)
    try:
        usm.decrypt_scoped(only_priv, v.localized())
        testing.error("decrypt_scoped with privFlag alone")
    except usm.UsmIncomingError as e:
        testing.assertEqual(e.kind, usm.SNMP_INVALID_MSGS)

def _test_mutations_never_pass_authenticated() -> None:
    # Flipping any bit of an authenticated message makes decode() or unprotect() fail with
    # their own errors; the only way through is losing authFlag (a visible downgrade).
    for v in all_vectors():
        if v.auth == usm.AUTH_NONE:
            continue
        u = v.localized()
        for i in range(len(v.data)):
            for bit in [0x01, 0x80]:
                bad = v.data[:i] + ber.BYTE_TABLE[v.data[i] ^ bit] + v.data[i + 1:]
                try:
                    m = decode3(bad)
                except errors.DecodeError:
                    continue
                try:
                    usm.unprotect(bad, m, u)
                except usm.UsmIncomingError:
                    continue
                if (m.flags & message.FLAG_AUTH) != 0:
                    testing.error(v.name + ": mutated message accepted, octet %d bit %d" % (i, bit))


# Timeliness ########################################################################################

MAX31 = 2147483647

def learned(boots: int, time: int, latest: int, at: float) -> EngineTime:
    """An authenticated record of engine(), as check_time_non_authoritative() returns them"""
    return EngineTime(engine(), boots, time, latest, at, True)

def unchanged(rec: EngineTime, et: EngineTime) -> None:
    testing.assertEqual((rec.engine_id, rec.boots, rec.time, rec.latest_received_time, rec.learned_at, rec.authenticated),
                        (et.engine_id, et.boots, et.time, et.latest_received_time, et.learned_at, et.authenticated))

def _test_time_authoritative() -> None:
    testing.assertTrue(usm.check_time_authoritative(1, 1000, 1, 1000))
    testing.assertTrue(usm.check_time_authoritative(1, 1000, 1, 850))
    testing.assertFalse(usm.check_time_authoritative(1, 1000, 1, 849))
    testing.assertTrue(usm.check_time_authoritative(1, 1000, 1, 1150))
    testing.assertFalse(usm.check_time_authoritative(1, 1000, 1, 1151))
    testing.assertTrue(usm.check_time_authoritative(1, 0, 1, 150))
    testing.assertFalse(usm.check_time_authoritative(1, 0, 1, 151))
    testing.assertTrue(usm.check_time_authoritative(0, 0, 0, 0))
    testing.assertFalse(usm.check_time_authoritative(2, 1000, 1, 1000))
    testing.assertFalse(usm.check_time_authoritative(1, 1000, 2, 1000))
    testing.assertFalse(usm.check_time_authoritative(1, 1000, 0, 0))
    testing.assertTrue(usm.check_time_authoritative(MAX31 - 1, MAX31, MAX31 - 1, MAX31 - 150))
    # latched boots: nothing is in time, not even an exact match
    testing.assertFalse(usm.check_time_authoritative(MAX31, 1000, MAX31, 1000))
    testing.assertEqual(usm.TIME_WINDOW, 150)
    testing.assertEqual(usm.MAX_BOOTS, MAX31)

def _test_time_non_authoritative_first_message() -> None:
    fresh = EngineTime(engine(), 0, 0, 0, 1000.0)
    testing.assertFalse(fresh.authenticated, "a new record is not authenticated")
    inside, rec = usm.check_time_non_authoritative(fresh, 1, 307, 1000.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(1, 307, 307, 1000.0))
    unchanged(fresh, EngineTime(engine(), 0, 0, 0, 1000.0))
    # an engine that has just booted (boots 0, time > 0) is learned too
    inside, rec = usm.check_time_non_authoritative(EngineTime(engine(), 0, 0, 0, 0.0), 0, 5, 50.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(0, 5, 5, 50.0))
    # so is boots and time 0, however old the empty record
    inside, rec = usm.check_time_non_authoritative(EngineTime(engine(), 0, 0, 0, 0.0), 0, 0, 5151.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(0, 0, 0, 5151.0))
    # once learned, boots and time 0 teach nothing new: inside only while the record is recent
    testing.assertTrue(usm.check_time_non_authoritative(learned(0, 0, 0, 5000.0), 0, 0, 5150.0).0)
    testing.assertFalse(usm.check_time_non_authoritative(learned(0, 0, 0, 5000.0), 0, 0, 5151.0).0)
    # a latched engine is learned, and is outside
    inside, rec = usm.check_time_non_authoritative(fresh, MAX31, 9, 1000.0)
    testing.assertFalse(inside)
    unchanged(rec, learned(MAX31, 9, 9, 1000.0))

def _test_time_non_authoritative_hint_cannot_lock_out() -> None:
    # The boots and time of an unauthenticated (possibly forged) discovery Report are only a
    # hint for outgoing messages: the first authenticated message replaces them, so a hint
    # with huge boots cannot make every genuine response look stale
    for hint_boots in [MAX31 - 1, MAX31, 7]:
        hint = EngineTime(engine(), hint_boots, 0, 0, 100.0)
        testing.assertEqual(hint.estimate(110.0), (hint_boots, 10), "the hint feeds the estimate")
        rec = hint
        for i in range(3):
            r = usm.check_time_non_authoritative(rec, 1, 307 + i, 101.0 + float(i))
            testing.assertTrue(r.0, "genuine authenticated response %d after hint boots %d" % (i, hint_boots))
            rec = r.1
        unchanged(rec, learned(1, 309, 309, 103.0))

def _test_time_non_authoritative_window() -> None:
    et = learned(1, 307, 307, 1000.0)
    # same time: inside, no update (the same record comes back)
    inside, rec = usm.check_time_non_authoritative(et, 1, 307, 1000.0)
    testing.assertTrue(inside)
    unchanged(rec, et)
    # older messages within 150 s of the estimate are inside; the record keeps the latest time
    inside, rec = usm.check_time_non_authoritative(et, 1, 157, 1000.0)
    testing.assertTrue(inside)
    unchanged(rec, et)
    inside, rec = usm.check_time_non_authoritative(et, 1, 156, 1000.0)
    testing.assertFalse(inside)
    unchanged(rec, et)
    # 100 s later the estimate is 407
    testing.assertTrue(usm.check_time_non_authoritative(et, 1, 257, 1100.0).0)
    testing.assertFalse(usm.check_time_non_authoritative(et, 1, 256, 1100.0).0)
    testing.assertTrue(usm.check_time_non_authoritative(et, 1, 257, 1100.9).0, "fractions of a second are truncated")
    # a newer time is learned
    inside, rec = usm.check_time_non_authoritative(et, 1, 400, 1100.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(1, 400, 400, 1100.0))
    # older boots are never inside
    inside, rec = usm.check_time_non_authoritative(et, 0, 307, 1000.0)
    testing.assertFalse(inside)
    unchanged(rec, et)
    # newer boots (an agent reboot) are learned whatever the time
    inside, rec = usm.check_time_non_authoritative(et, 2, 3, 2000.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(2, 3, 3, 2000.0))

def _test_time_non_authoritative_latest_received() -> None:
    # latestReceivedEngineTime, not the estimate, decides whether a time is new: a later
    # time is learned (and so inside) even when it is far behind the estimate
    et = learned(1, 307, 307, 1000.0)
    inside, rec = usm.check_time_non_authoritative(et, 1, 308, 5000.0)
    testing.assertTrue(inside)
    unchanged(rec, learned(1, 308, 308, 5000.0))
    skewed = learned(1, 500, 300, 1000.0)
    inside, rec = usm.check_time_non_authoritative(skewed, 1, 400, 1000.0)
    testing.assertTrue(inside)
    testing.assertEqual((rec.time, rec.latest_received_time), (400, 400))
    inside, rec = usm.check_time_non_authoritative(skewed, 1, 300, 1000.0)
    testing.assertFalse(inside, "not newer than latestReceivedEngineTime and 200 s behind")
    unchanged(rec, skewed)

def _test_time_non_authoritative_boots_latch() -> None:
    et = learned(5, 100, 100, 0.0)
    # boots 2^31-1 is learned, and from then on nothing is in time (RFC 3414 3.2 step 7b)
    inside, rec = usm.check_time_non_authoritative(et, MAX31, 10, 1.0)
    testing.assertFalse(inside)
    testing.assertEqual(rec.boots, MAX31)
    testing.assertFalse(usm.check_time_non_authoritative(rec, MAX31, 11, 1.0).0)
    testing.assertFalse(usm.check_time_non_authoritative(rec, MAX31, 10, 1.0).0)
    testing.assertFalse(usm.check_time_non_authoritative(rec, 6, 10, 1.0).0)
    # just below the latch everything works
    inside, rec = usm.check_time_non_authoritative(et, MAX31 - 1, MAX31, 1.0)
    testing.assertTrue(inside)
    testing.assertEqual((rec.boots, rec.time), (MAX31 - 1, MAX31))

def _test_engine_time_estimate() -> None:
    et = learned(3, 1000, 1000, 50.0)
    testing.assertEqual(et.estimate(50.0), (3, 1000))
    testing.assertEqual(et.estimate(60.75), (3, 1010))
    testing.assertEqual(et.estimate(40.0), (3, 990))
    testing.assertEqual(learned(3, 5, 5, 50.0).estimate(0.0), (3, 0))
    # engineTime wraps after 2^31-1 and boots goes up, but never past 2^31-1
    w = learned(3, MAX31 - 5, MAX31 - 5, 0.0)
    testing.assertEqual(w.estimate(5.0), (3, MAX31))
    testing.assertEqual(w.estimate(6.0), (4, 0))
    testing.assertEqual(w.estimate(10.0), (4, 4))
    testing.assertEqual(learned(MAX31, MAX31, 0, 0.0).estimate(10.0), (MAX31, 9))
    testing.assertEqual(EngineTime(b"", 0, 0, 0, 0.0).estimate(0.0), (0, 0))
    # an unauthenticated hint estimates the same way
    testing.assertEqual(EngineTime(engine(), 1, 307, 0, 10.0).estimate(12.5), (1, 309))

def _test_engine_time_repr() -> None:
    et = EngineTime(h("8000000001"), 1, 2, 3, 4.5)
    testing.assertEqual(repr(et), "EngineTime(engine_id=8000000001, boots=1, time=2, latest_received_time=3, learned_at=4.500000, authenticated=False)")
    testing.assertEqual(str(et), repr(et))
    testing.assertTrue(repr(EngineTime(h("8000000001"), 1, 2, 3, 4.5, True)).endswith("authenticated=True)"))


# process_incoming ##################################################################################

def shaaes() -> LocalizedUser:
    return user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128)

def protect_at(flags: int, boots: int, time: int, plain: ScopedPdu, u: ?LocalizedUser, msg_id: int=MSG_ID) -> bytes:
    hdr = V3Message(msg_id, 65507, flags, UsmSecurityParameters(engine(), boots, time, b"shaaes"))
    return usm.protect(hdr, message.encode_scoped(plain), u, u64(77))

def incoming(data: bytes, u: ?LocalizedUser, min_level: int, et: EngineTime, now: float) -> (ScopedPdu, EngineTime):
    r = usm.process_incoming(data, decode3(data), u, min_level, et, now)
    return (r.scoped, r.record)

def process_fails(data: bytes, u: ?LocalizedUser, min_level: int, et: EngineTime, now: float, kind: str, what: str) -> None:
    try:
        usm.process_incoming(data, decode3(data), u, min_level, et, now)
    except usm.UsmIncomingError as e:
        testing.assertEqual(e.kind, kind, what + ": " + e.error_message)
        return
    testing.error("no UsmIncomingError: " + what)

def _test_process_incoming_vectors() -> None:
    # Every authenticated vector is learned by an empty record and verified again by the
    # learned one; the record of a noAuthNoPriv message stays as it was.
    for v in all_vectors():
        u = v.localized() if v.auth != usm.AUTH_NONE else None
        fresh = EngineTime(engine(), 0, 0, 0, 500.0)
        if v.boots == MAX31:
            # an engine whose boots are latched sends nothing that is in time
            process_fails(v.data, u, usm.LEVEL_NO_AUTH_NO_PRIV, fresh, 500.0, usm.USM_STATS_NOT_IN_TIME_WINDOWS, v.name)
            continue
        scoped, rec = incoming(v.data, u, v.flags & usm.LEVEL_AUTH_PRIV, fresh, 500.0)
        testing.assertEqual(scoped, v.scoped(), v.name)
        if v.auth == usm.AUTH_NONE:
            unchanged(rec, fresh)
        else:
            unchanged(rec, EngineTime(engine(), v.boots, v.time, v.time, 500.0, True))
            testing.assertEqual(incoming(v.data, u, usm.LEVEL_NO_AUTH_NO_PRIV, rec, 600.0).0, v.scoped(), v.name)

def _test_process_incoming_rejects_replay() -> None:
    # A captured response (boots 1, time 150) replayed after the agent rebooted, or long
    # after it was sent, is outside the time window (RFC 3414 3.2 step 7b)
    u = shaaes()
    old = protect_at(0x03, 1, 150, response_scoped(), u)
    testing.assertEqual(incoming(old, u, usm.LEVEL_AUTH_PRIV, learned(1, 150, 150, 0.0), 10.0).0, response_scoped())
    process_fails(old, u, usm.LEVEL_AUTH_PRIV, learned(5, 10000, 10000, 0.0), 10.0, usm.USM_STATS_NOT_IN_TIME_WINDOWS,
                  "replay after 4 reboots")
    process_fails(old, u, usm.LEVEL_AUTH_PRIV, learned(1, 150, 150, 0.0), 151.0, usm.USM_STATS_NOT_IN_TIME_WINDOWS,
                  "replay 151 s later")
    # unprotect() is the untimed variant and accepts it
    testing.assertEqual(usm.unprotect(old, decode3(old), u), response_scoped())

def _test_process_incoming_min_level() -> None:
    # A forged response at a lower level than the request's is refused before any MAC work;
    # a Report may come at a lower level when the caller says so (RFC 3412 7.2 step 11b)
    u = shaaes()
    et = learned(1, 150, 150, 0.0)
    forged = protect_at(0x00, 0, 0, response_scoped(), None)
    for level in [usm.LEVEL_AUTH_NO_PRIV, usm.LEVEL_AUTH_PRIV]:
        process_fails(forged, u, level, et, 1.0, usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, "noAuthNoPriv response")
        process_fails(forged, None, level, et, 1.0, usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, "noAuthNoPriv, no user")
    auth_only = protect_at(0x01, 1, 150, response_scoped(), u)
    process_fails(auth_only, u, usm.LEVEL_AUTH_PRIV, et, 1.0, usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, "authNoPriv response")
    testing.assertEqual(incoming(auth_only, u, usm.LEVEL_AUTH_NO_PRIV, et, 1.0).0, response_scoped())
    report = protect_at(0x00, 1, 150, report_scoped(0, 3, 1), None)
    scoped, rec = incoming(report, u, usm.LEVEL_NO_AUTH_NO_PRIV, et, 1.0)
    testing.assertEqual(scoped, report_scoped(0, 3, 1))
    unchanged(rec, et)
    # privFlag alone is snmpInvalidMsgs whatever level is asked for
    r = message.encode_v3(V3Message(MSG_ID, 65507, 0x02, UsmSecurityParameters(engine(), 1, 150, b"shaaes",
                                                                                b"", b"\x00" * 8)), b"\x01" * 16)
    process_fails(r.msg, u, usm.LEVEL_AUTH_PRIV, et, 1.0, usm.SNMP_INVALID_MSGS, "privFlag without authFlag")
    value_fails(lambda: usm.process_incoming(report, decode3(report), u, 2, et, 1.0), "min_level 2")
    value_fails(lambda: usm.process_incoming(report, decode3(report), u, 7, et, 1.0), "min_level 7")

def _test_process_incoming_unauthenticated_never_moves_clock() -> None:
    # A forged noAuthNoPriv Report with boots 2^31-1 passes (a manager acts on such reports),
    # but its boots and time do not reach the record: genuine responses still verify
    u = shaaes()
    et = learned(1, 307, 307, 1000.0)
    forged = protect_at(0x00, MAX31, 0, report_scoped(0, 2, 1), None, 42)
    scoped, rec = incoming(forged, u, usm.LEVEL_NO_AUTH_NO_PRIV, et, 1001.0)
    unchanged(rec, et)
    genuine = protect_at(0x03, 1, 308, response_scoped(), u)
    scoped, rec = incoming(genuine, u, usm.LEVEL_AUTH_PRIV, rec, 1001.0)
    testing.assertEqual(scoped, response_scoped())
    unchanged(rec, learned(1, 308, 308, 1001.0))
    # an authenticated notInTimeWindows Report after a reboot is learned, as RFC 3414 4 intends
    sync = protect_at(0x01, 2, 5, report_scoped(0, 2, 1), u)
    scoped, rec = incoming(sync, u, usm.LEVEL_NO_AUTH_NO_PRIV, rec, 1002.0)
    unchanged(rec, learned(2, 5, 5, 1002.0))

def _test_process_incoming_checks_the_record() -> None:
    u = shaaes()
    data = protect_at(0x03, 1, 150, response_scoped(), u)
    other = EngineTime(h("8000000001"), 1, 150, 150, 0.0, True)
    value_fails(lambda: usm.process_incoming(data, decode3(data), u, usm.LEVEL_AUTH_PRIV, other, 1.0), "another engine")
    # authenticate() failures come through unchanged
    bad = data[:decode3(data).auth_offset] + b"\x00" * 12 + data[decode3(data).auth_offset + 12:]
    process_fails(bad, u, usm.LEVEL_AUTH_PRIV, learned(1, 150, 150, 0.0), 1.0, usm.USM_STATS_WRONG_DIGESTS, "bad MAC")
    process_fails(data, None, usm.LEVEL_AUTH_PRIV, learned(1, 150, 150, 0.0), 1.0, usm.USM_STATS_UNKNOWN_USER_NAMES,
                  "no user")


# Keys for authentication only (Usm.localized_auth) ################################################

def auth_only(u: LocalizedUser) -> LocalizedUser:
    return LocalizedUser(u.user, u.auth, u.priv, u.auth_key, b"", u.engine_id)

def _test_auth_only_user() -> None:
    # A user without its privacy key keeps its level, verifies MACs at any level, and refuses
    # to encrypt or decrypt
    for v in all_vectors():
        if v.priv == usm.PRIV_NONE:
            continue
        full = v.localized()
        a = auth_only(full)
        testing.assertEqual(a.level(), usm.LEVEL_AUTH_PRIV, v.name)
        testing.assertFalse(a.has_priv_key(), v.name)
        testing.assertTrue(full.has_priv_key(), v.name)
        m = decode3(v.data)
        usm.authenticate(v.data, m, a)
        value_fails(lambda: usm.decrypt_scoped(m, a), v.name + ": decrypt without the privacy key")
        testing.assertEqual(usm.decrypt_scoped(m, full), v.scoped(), v.name)
        encode_fails(lambda: usm.protect(v.header(), message.encode_scoped(v.scoped()), a, v.salt),
                     v.name + ": encrypt without the privacy key")
        bad = v.data[:m.auth_offset] + ber.BYTE_TABLE[v.data[m.auth_offset] ^ 1] + v.data[m.auth_offset + 1:]
        incoming_fails(bad, decode3(bad), a, usm.USM_STATS_WRONG_DIGESTS, v.name + ": flipped MAC")
    # it still sends and verifies authNoPriv
    a = auth_only(shaaes())
    data = protect_at(0x05, 1, 150, get_scoped(), a)
    testing.assertEqual(usm.unprotect(data, decode3(data), a), get_scoped())
    testing.assertFalse(user_for(b"x", usm.AUTH_SHA1, usm.PRIV_NONE).has_priv_key())


# Privacy salts #####################################################################################

def _test_salt_counter() -> None:
    c = usm.SaltCounter(u64(5))
    testing.assertEqual([c.next(), c.next(), c.next()], [u64(6), u64(7), u64(8)])
    w = usm.SaltCounter(u64(18446744073709551614))
    testing.assertEqual([w.next(), w.next(), w.next()], [u64(18446744073709551615), u64(0), u64(1)])
    testing.assertEqual(repr(c), "SaltCounter()")
    # random starts: two engines that share a key do not walk through the same salts (a
    # collision of two random 64-bit starts within 1000 steps has probability below 2^-53)
    a = usm.SaltCounter()
    b = usm.SaltCounter()
    sa = set([a.next() for i in range(1000)])
    for i in range(1000):
        testing.assertFalse(b.next() in sa, "salt reused across counters")

def _test_salt_counter_separates_des_ivs() -> None:
    # Two engines with their own random counters encrypt equal plaintexts under the same key
    # and boots with different DES salts, so with different IVs
    u = user_for(b"md5des", usm.AUTH_MD5, usm.PRIV_DES)
    hdr = V3Message(1, 65507, 0x07, UsmSecurityParameters(engine(), 1, 307, b"md5des"))
    plain = message.encode_scoped(get_scoped())
    a = decode3(usm.protect(hdr, plain, u, usm.SaltCounter().next()))
    b = decode3(usm.protect(hdr, plain, u, usm.SaltCounter().next()))
    testing.assertNotEqual(a.usm.priv_params, b.usm.priv_params)
    testing.assertNotEqual(a.encrypted, b.encrypted)


# Security levels ###################################################################################

def _test_level_constants_and_rfc3411() -> None:
    testing.assertEqual([usm.LEVEL_NO_AUTH_NO_PRIV, usm.LEVEL_AUTH_NO_PRIV, usm.LEVEL_AUTH_PRIV],
                        [0, message.FLAG_AUTH, message.FLAG_AUTH | message.FLAG_PRIV])
    # RFC 3411 SnmpSecurityLevel: noAuthNoPriv(1), authNoPriv(2), authPriv(3)
    testing.assertEqual([usm.rfc3411_level(f) for f in [0x00, 0x01, 0x03, 0x04, 0x05, 0x07]], [1, 2, 3, 1, 2, 3])
    testing.assertEqual([usm.level_from_rfc3411(n) for n in [1, 2, 3]],
                        [usm.LEVEL_NO_AUTH_NO_PRIV, usm.LEVEL_AUTH_NO_PRIV, usm.LEVEL_AUTH_PRIV])
    for n in [1, 2, 3]:
        testing.assertEqual(usm.rfc3411_level(usm.level_from_rfc3411(n)), n)
        testing.assertEqual(usm.level_from_name(str(n)), usm.level_from_rfc3411(n), "net-snmp -l %d" % n)
    value_fails(lambda: usm.rfc3411_level(message.FLAG_PRIV), "privFlag alone")
    for bad in [0, 4, -1]:
        value_fails(lambda: usm.level_from_rfc3411(bad), "SnmpSecurityLevel %d" % bad)
    testing.assertEqual(usm.level_of(usm.AUTH_SHA1, usm.PRIV_AES128), usm.LEVEL_AUTH_PRIV)
