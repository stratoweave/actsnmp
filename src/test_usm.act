"""Tests for usm

Unless noted, the vectors are the SNMPv3 reference vectors, verified
against net-snmp and pysnmp, plus RFC 3414 A.3 and A.5 and draft-reeder
B.2. protect() must reproduce the deterministic messages byte for byte.
The N_* messages cover the hash and cipher combinations those vectors
miss; they were generated by an independent Python implementation and
cross-checked with pysnmp 7.1.
"""

import testing
import ber
import errors
import message
import pdu
import usm
import usmcrypto
from message import ScopedPdu, UsmSecurityParameters, V3Message
from oid import Oid
from pdu import Pdu
from usm import EngineTime, LocalizedUser
from values import Counter32, OctetString, VarBind
from testutil import h, value_fails, encode_fails, pseudo_random

def all_auths() -> list[int]:
    return [usm.AUTH_MD5, usm.AUTH_SHA1, usm.AUTH_SHA224, usm.AUTH_SHA256, usm.AUTH_SHA384, usm.AUTH_SHA512]

def all_privs() -> list[int]:
    return [usm.PRIV_DES, usm.PRIV_AES128, usm.PRIV_AES192, usm.PRIV_AES256, usm.PRIV_AES192C,
            usm.PRIV_AES256C, usm.PRIV_3DES]


# Protocol names and constants ######################################################################

def _test_auth_from_name() -> None:
    cases: list[(str, int)] = [
        ("MD5", usm.AUTH_MD5), ("md5", usm.AUTH_MD5), ("HMAC-MD5", usm.AUTH_MD5),
        ("usmHMACMD5AuthProtocol", usm.AUTH_MD5),
        ("SHA", usm.AUTH_SHA1), ("sha", usm.AUTH_SHA1), ("SHA1", usm.AUTH_SHA1), ("Sha-1", usm.AUTH_SHA1),
        ("usmHMACSHAAuthProtocol", usm.AUTH_SHA1),
        ("SHA-224", usm.AUTH_SHA224), ("sha224", usm.AUTH_SHA224), ("usmHMAC128SHA224AuthProtocol", usm.AUTH_SHA224),
        ("SHA-256", usm.AUTH_SHA256), ("SHA256", usm.AUTH_SHA256), ("usmHMAC192SHA256AuthProtocol", usm.AUTH_SHA256),
        ("SHA-384", usm.AUTH_SHA384), ("sha384", usm.AUTH_SHA384), ("usmHMAC256SHA384AuthProtocol", usm.AUTH_SHA384),
        ("SHA-512", usm.AUTH_SHA512), ("SHA512", usm.AUTH_SHA512), ("usmHMAC384SHA512AuthProtocol", usm.AUTH_SHA512),
        ("none", usm.AUTH_NONE), ("usmNoAuthProtocol", usm.AUTH_NONE)]
    for name, want in cases:
        testing.assertEqual(usm.auth_from_name(name), want, name)
    for bad in ["", "SHA-2", "SHA-1024", "MD4", " SHA", "SHA ", "DES", "sha_256", "-"]:
        value_fails(lambda: usm.auth_from_name(bad), "auth_from_name " + repr(bad))

def _test_priv_from_name() -> None:
    cases: list[(str, int)] = [
        ("DES", usm.PRIV_DES), ("des", usm.PRIV_DES), ("usmDESPrivProtocol", usm.PRIV_DES),
        ("AES", usm.PRIV_AES128), ("AES128", usm.PRIV_AES128), ("aes-128", usm.PRIV_AES128),
        ("usmAesCfb128Protocol", usm.PRIV_AES128),
        # net-snmp: AES192/AES256 = Blumenthal; pysnmp spells that AES192BLMT
        ("AES192", usm.PRIV_AES192), ("AES-192", usm.PRIV_AES192), ("aes192blmt", usm.PRIV_AES192),
        ("usmAesBlumenthalCfb192Protocol", usm.PRIV_AES192),
        ("AES256", usm.PRIV_AES256), ("AES-256", usm.PRIV_AES256), ("AES256BLMT", usm.PRIV_AES256),
        ("usmAesBlumenthalCfb256Protocol", usm.PRIV_AES256),
        ("AES192C", usm.PRIV_AES192C), ("AES-192-C", usm.PRIV_AES192C), ("usmAesCfb192Protocol", usm.PRIV_AES192C),
        ("AES256C", usm.PRIV_AES256C), ("aes-256-c", usm.PRIV_AES256C), ("usmAesCfb256Protocol", usm.PRIV_AES256C),
        ("3DES", usm.PRIV_3DES), ("3desede", usm.PRIV_3DES), ("DES3", usm.PRIV_3DES),
        ("usm3DESEDEPrivProtocol", usm.PRIV_3DES),
        ("none", usm.PRIV_NONE), ("usmNoPrivProtocol", usm.PRIV_NONE)]
    for name, want in cases:
        testing.assertEqual(usm.priv_from_name(name), want, name)
    for bad in ["", "AES-512", "AES-128-C", "AES192-C", "RC4", " AES", "MD5", "-"]:
        value_fails(lambda: usm.priv_from_name(bad), "priv_from_name " + repr(bad))

def _test_names_round_trip() -> None:
    testing.assertEqual([usm.auth_name(a) for a in all_auths()], ["MD5", "SHA", "SHA-224", "SHA-256", "SHA-384", "SHA-512"])
    testing.assertEqual([usm.priv_name(p) for p in all_privs()],
                        ["DES", "AES", "AES-192", "AES-256", "AES-192-C", "AES-256-C", "3DES"])
    testing.assertEqual(usm.auth_name(usm.AUTH_NONE), "none")
    testing.assertEqual(usm.priv_name(usm.PRIV_NONE), "none")
    for a in [usm.AUTH_NONE] + all_auths():
        testing.assertEqual(usm.auth_from_name(usm.auth_name(a)), a)
    for p in [usm.PRIV_NONE] + all_privs():
        testing.assertEqual(usm.priv_from_name(usm.priv_name(p)), p)
    for bad in [-1, 7, 100]:
        value_fails(lambda: usm.auth_name(bad), "auth_name %d" % bad)
    for bad in [-1, 8, 100]:
        value_fails(lambda: usm.priv_name(bad), "priv_name %d" % bad)

def _test_levels() -> None:
    authpriv = message.FLAG_AUTH | message.FLAG_PRIV
    cases: list[(str, int)] = [("noAuthNoPriv", 0), ("NOAUTHNOPRIV", 0), ("1", 0), ("nanp", 0),
                               ("authNoPriv", message.FLAG_AUTH), ("2", message.FLAG_AUTH), ("anp", message.FLAG_AUTH),
                               ("authPriv", authpriv), ("authpriv", authpriv), ("3", authpriv), ("AP", authpriv)]
    for name, want in cases:
        testing.assertEqual(usm.level_from_name(name), want, name)
    for bad in ["", "4", "0", "priv", "authNoPrivacy"]:
        value_fails(lambda: usm.level_from_name(bad), "level_from_name " + repr(bad))
    testing.assertEqual(usm.level_name(0), "noAuthNoPriv")
    testing.assertEqual(usm.level_name(message.FLAG_REPORTABLE), "noAuthNoPriv")
    testing.assertEqual(usm.level_name(0x05), "authNoPriv")
    testing.assertEqual(usm.level_name(0x07), "authPriv")
    testing.assertEqual(usm.level_name(0xfb), "authPriv")
    value_fails(lambda: usm.level_name(message.FLAG_PRIV), "level_name of privacy without authentication")
    value_fails(lambda: usm.level_name(0x06), "level_name 0x06")
    # level_text: the same names, and one for privFlag alone instead of an error
    testing.assertEqual([usm.level_text(f) for f in [0x00, 0x04, 0x05, 0x07, 0xfb, 0x02, 0x06]],
                        ["noAuthNoPriv", "noAuthNoPriv", "authNoPriv", "authPriv", "authPriv", "privWithoutAuth",
                         "privWithoutAuth"])

def _test_lengths() -> None:
    testing.assertEqual([usm.auth_mac_len(a) for a in [usm.AUTH_NONE] + all_auths()], [0, 12, 12, 16, 24, 32, 48])
    testing.assertEqual([usm.auth_key_len(a) for a in [usm.AUTH_NONE] + all_auths()], [0, 16, 20, 28, 32, 48, 64])
    testing.assertEqual([usm.priv_key_len(p) for p in [usm.PRIV_NONE] + all_privs()], [0, 16, 16, 24, 32, 24, 32, 32])
    for a in all_auths():
        testing.assertEqual(len(usmcrypto.hash(a, b"")), usm.auth_key_len(a), "digest length of %d" % a)
    for bad in [-1, 7]:
        value_fails(lambda: usm.auth_mac_len(bad), "auth_mac_len %d" % bad)
        value_fails(lambda: usm.auth_key_len(bad), "auth_key_len %d" % bad)
    value_fails(lambda: usm.priv_key_len(8), "priv_key_len 8")
    value_fails(lambda: usm.priv_key_len(-1), "priv_key_len -1")

def _test_report_oids() -> None:
    cases: list[(str, str)] = [
        (usm.USM_STATS_UNSUPPORTED_SEC_LEVELS, "1.3.6.1.6.3.15.1.1.1.0"),
        (usm.USM_STATS_NOT_IN_TIME_WINDOWS, "1.3.6.1.6.3.15.1.1.2.0"),
        (usm.USM_STATS_UNKNOWN_USER_NAMES, "1.3.6.1.6.3.15.1.1.3.0"),
        (usm.USM_STATS_UNKNOWN_ENGINE_IDS, "1.3.6.1.6.3.15.1.1.4.0"),
        (usm.USM_STATS_WRONG_DIGESTS, "1.3.6.1.6.3.15.1.1.5.0"),
        (usm.USM_STATS_DECRYPTION_ERRORS, "1.3.6.1.6.3.15.1.1.6.0"),
        (usm.SNMP_UNKNOWN_SECURITY_MODELS, "1.3.6.1.6.3.11.2.1.1.0"),
        (usm.SNMP_INVALID_MSGS, "1.3.6.1.6.3.11.2.1.2.0"),
        (usm.SNMP_UNKNOWN_PDU_HANDLERS, "1.3.6.1.6.3.11.2.1.3.0"),
        (usm.SNMP_UNAVAILABLE_CONTEXTS, "1.3.6.1.6.3.12.1.4.0"),
        (usm.SNMP_UNKNOWN_CONTEXTS, "1.3.6.1.6.3.12.1.5.0")]
    for name, dotted in cases:
        o = Oid.parse(dotted)
        testing.assertEqual(usm.report_oid(name), o, name)
        testing.assertEqual(usm.report_name(o), name, dotted)
        testing.assertEqual(usm.report_name(o.parent()), name, dotted + " without instance")
    testing.assertEqual(usm.USM_STATS_UNKNOWN_USER_NAMES, "usmStatsUnknownUserNames")
    testing.assertEqual(usm.USM_STATS_UNKNOWN_ENGINE_IDS, "usmStatsUnknownEngineIDs")
    # the encoding of the usmStats prefix
    testing.assertEqual(ber.enc_oid_content(usm.report_oid(usm.USM_STATS_WRONG_DIGESTS).arcs).hex(), "2b060106030f01010500")
    for dotted in ["1.3.6.1.6.3.15.1.1", "1.3.6.1.6.3.15.1.1.7.0", "1.3.6.1.6.3.15.1.1.3.0.0", "1.3.6.1.6.3.15.1.2.3.0",
                   "1.3.6.1.2.1.1.1.0", "1.3"]:
        testing.assertNone(usm.report_name(Oid.parse(dotted)), dotted)
    testing.assertNone(usm.report_name(Oid([])))
    value_fails(lambda: usm.report_oid("usmStatsWhatever"), "report_oid of an unknown name")
    # report_oid returns a fresh OID each time
    o = usm.report_oid(usm.USM_STATS_WRONG_DIGESTS)
    o.arcs[0] = 2
    testing.assertEqual(str(usm.report_oid(usm.USM_STATS_WRONG_DIGESTS)), "1.3.6.1.6.3.15.1.1.5.0")


# Keys ##############################################################################################

MAPLE_ENGINE = "000000000000000000000002"

def maplesyrup() -> list[(int, str, str)]:
    """(auth, Ku, Kul) of the "maplesyrup" vectors"""
    return [
        (usm.AUTH_MD5, "9faf3283884e92834ebc9847d8edd963", "526f5eed9fcce26f8964c2930787d82b"),
        (usm.AUTH_SHA1, "9fb5cc0381497b3793528939ff788d5d79145211", "6695febc9288e36282235fc7151f128497b38f3f"),
        (usm.AUTH_SHA224, "282a5867ee9aac639ad59df9572c7d3ac0fbc13a905b6df07dbbf00b",
         "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be682075674"),
        (usm.AUTH_SHA256, "ab51014d1e077f6017df2b12bee5f5aa72993177e9bb569c4dff5a4ca0b4afac",
         "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a6445c2d6776f0f8b"),
        (usm.AUTH_SHA384, "e06eccdf2c68a06ed034723c9c26e0db3b669e1e2efed49150b55377a2e98f383c86fb836857444654b287c93f51ff64",
         "3b298f16164a11184279d5432bf169e2d2a48307de02b3d3f7e2b4f36eb6f0455a53689a3937eea07319a633d2ccba78"),
        (usm.AUTH_SHA512,
         "7e4396de5aadc77be853819b98c9406265b3a9c37cc3176569847a4e4f6fba63dd3a73d04924d31a63f95a601f9385af6be4ed1b37f87d040f7c6ed6f8d38a91",
         "22a5a36cedfcc085807a128d7bc6c2382167ad6c0dbc5fdff856740f3d84c099ad1ea87a8db096714d9788bd544047c9021e4229ce27e4c0a69250adfcffbb0b")]

def maple_kul(auth: int) -> bytes:
    for a, ku, kul in maplesyrup():
        if a == auth:
            return h(kul)
    raise ValueError("no maplesyrup row")

def _test_localize_maplesyrup() -> None:
    e = h(MAPLE_ENGINE)
    for auth, ku, kul in maplesyrup():
        testing.assertEqual(usm.localize(auth, h(ku), e).hex(), kul, usm.auth_name(auth))
    # RFC 3414 A.5 "newsyrup"
    testing.assertEqual(usm.localize(usm.AUTH_MD5, h("01add273107c4e596b4b00f82b1d42a7"), e).hex(),
                        "87021d7bd9d101ba05ea6e3bf9d9bd4a")
    testing.assertEqual(usm.localize(usm.AUTH_SHA1, h("3a51a6d736aa347b83dc4a87e3e55ee4d698ac71"), e).hex(),
                        "78e2dcce79d59403b58c1bbaa5bff46391f1cd25")

def _test_password_to_key() -> None:
    testing.assertEqual(usm.password_to_key(usm.AUTH_MD5, b"maplesyrup").hex(), "9faf3283884e92834ebc9847d8edd963")
    testing.assertEqual(usm.password_to_key(usm.AUTH_SHA1, b"maplesyrup").hex(), "9fb5cc0381497b3793528939ff788d5d79145211")
    value_fails(lambda: usm.password_to_key(usm.AUTH_NONE, b"maplesyrup"), "password_to_key without auth")
    value_fails(lambda: usm.password_to_key(7, b"maplesyrup"), "password_to_key with auth 7")
    value_fails(lambda: usm.password_to_key(usm.AUTH_SHA1, b""), "password_to_key of an empty password")

def _test_localize_rejects() -> None:
    value_fails(lambda: usm.localize(usm.AUTH_NONE, b"k", b"e"), "localize without auth")
    value_fails(lambda: usm.localize(-1, b"k", b"e"), "localize with auth -1")
    value_fails(lambda: usm.localize(7, b"k", b"e"), "localize with auth 7")
    value_fails(lambda: usm.extend_blumenthal(usm.AUTH_NONE, b"k", 32), "extend_blumenthal without auth")
    value_fails(lambda: usm.extend_reeder(usm.AUTH_NONE, b"k", b"e", 32), "extend_reeder without auth")

def extension_rows(auth: int) -> list[(int, str)]:
    """(priv, privacy key) of the key extension vectors for one hash"""
    if auth == usm.AUTH_MD5:
        return [
            (usm.PRIV_AES192, "526f5eed9fcce26f8964c2930787d82bfa24a92467426c2f"),
            (usm.PRIV_AES256, "526f5eed9fcce26f8964c2930787d82bfa24a92467426c2f4b09192be10dfaec"),
            (usm.PRIV_AES192C, "526f5eed9fcce26f8964c2930787d82b79eff44a90650ee0"),
            (usm.PRIV_AES256C, "526f5eed9fcce26f8964c2930787d82b79eff44a90650ee0a3a40abfac5acc12"),
            (usm.PRIV_3DES, "526f5eed9fcce26f8964c2930787d82b79eff44a90650ee0a3a40abfac5acc12")]
    if auth == usm.AUTH_SHA1:
        return [
            (usm.PRIV_AES192, "6695febc9288e36282235fc7151f128497b38f3f505e07eb"),
            (usm.PRIV_AES256, "6695febc9288e36282235fc7151f128497b38f3f505e07eb9af25568fa1f5dbe"),
            (usm.PRIV_AES192C, "6695febc9288e36282235fc7151f128497b38f3f9b8b6d78"),
            (usm.PRIV_AES256C, "6695febc9288e36282235fc7151f128497b38f3f9b8b6d78936ba6e7d19dfd9c"),
            (usm.PRIV_3DES, "6695febc9288e36282235fc7151f128497b38f3f9b8b6d78936ba6e7d19dfd9c")]
    if auth == usm.AUTH_SHA224:
        return [
            (usm.PRIV_AES192, "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be6"),
            (usm.PRIV_AES256, "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be682075674e82d9bf0"),
            (usm.PRIV_AES192C, "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be6"),
            (usm.PRIV_AES256C, "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be68207567422c34be4"),
            (usm.PRIV_3DES, "0bd8827c6e29f8065e08e09237f177e410f69b90e1782be68207567422c34be4")]
    return [
        (usm.PRIV_AES192, "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a"),
        (usm.PRIV_AES256, "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a6445c2d6776f0f8b"),
        (usm.PRIV_AES192C, "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a"),
        (usm.PRIV_AES256C, "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a6445c2d6776f0f8b"),
        (usm.PRIV_3DES, "8982e0e549e866db361a6b625d84cccc11162d453ee8ce3a6445c2d6776f0f8b")]

def check_extension(auth: int) -> None:
    kul = maple_kul(auth)
    e = h(MAPLE_ENGINE)
    for priv, want in extension_rows(auth):
        what = usm.auth_name(auth) + " " + usm.priv_name(priv)
        testing.assertEqual(usm.priv_key_from_kul(auth, priv, kul, e).hex(), want, what)
    # DES and AES-128 truncate to 16 octets
    testing.assertEqual(usm.priv_key_from_kul(auth, usm.PRIV_DES, kul, e), kul[:16])
    testing.assertEqual(usm.priv_key_from_kul(auth, usm.PRIV_AES128, kul, e), kul[:16])

def _test_priv_key_extension_md5() -> None:
    check_extension(usm.AUTH_MD5)

def _test_priv_key_extension_sha1() -> None:
    check_extension(usm.AUTH_SHA1)

def _test_priv_key_extension_sha224() -> None:
    check_extension(usm.AUTH_SHA224)

def _test_priv_key_extension_sha256() -> None:
    check_extension(usm.AUTH_SHA256)

def _test_priv_key_no_extension_long_hashes() -> None:
    # SHA-384 and SHA-512 keys are long enough for every cipher: plain truncation
    e = h(MAPLE_ENGINE)
    for auth in [usm.AUTH_SHA384, usm.AUTH_SHA512]:
        kul = maple_kul(auth)
        for priv in all_privs():
            testing.assertEqual(usm.priv_key_from_kul(auth, priv, kul, e), kul[:usm.priv_key_len(priv)],
                                usm.auth_name(auth) + " " + usm.priv_name(priv))

def _test_extension_functions() -> None:
    e = h(MAPLE_ENGINE)
    sha = maple_kul(usm.AUTH_SHA1)
    # draft-reeder B.2: 40 octets with SHA (one chaining round)
    testing.assertEqual(usm.extend_reeder(usm.AUTH_SHA1, sha, e, 40).hex(),
                        "6695febc9288e36282235fc7151f128497b38f3f9b8b6d78936ba6e7d19dfd9cd2d5065547743fb5")
    # draft-blumenthal A.1
    testing.assertEqual(usm.extend_blumenthal(usm.AUTH_SHA1, sha, 32).hex(),
                        "6695febc9288e36282235fc7151f128497b38f3f505e07eb9af25568fa1f5dbe")
    # Blumenthal over several rounds: K || H(K) || H(K || H(K)) (computed with Python hashlib)
    testing.assertEqual(usm.extend_blumenthal(usm.AUTH_MD5, maple_kul(usm.AUTH_MD5), 48).hex(),
                        "526f5eed9fcce26f8964c2930787d82bfa24a92467426c2f4b09192be10dfaecf0e919ede2ddaa44c67a3ed12eda7a81")
    # long enough already: truncation only
    testing.assertEqual(usm.extend_blumenthal(usm.AUTH_SHA1, sha, 16), sha[:16])
    testing.assertEqual(usm.extend_reeder(usm.AUTH_SHA1, sha, e, 20), sha)
    testing.assertEqual(usm.extend_reeder(usm.AUTH_SHA1, sha, e, 0), b"")

def _test_priv_key_from_kul_rejects() -> None:
    e = h(MAPLE_ENGINE)
    sha = maple_kul(usm.AUTH_SHA1)
    value_fails(lambda: usm.priv_key_from_kul(usm.AUTH_SHA1, usm.PRIV_NONE, sha, e), "PRIV_NONE")
    value_fails(lambda: usm.priv_key_from_kul(usm.AUTH_NONE, usm.PRIV_AES128, sha, e), "AUTH_NONE")
    value_fails(lambda: usm.priv_key_from_kul(usm.AUTH_SHA1, 8, sha, e), "priv 8")
    value_fails(lambda: usm.priv_key_from_kul(7, usm.PRIV_AES128, sha, e), "auth 7")
    value_fails(lambda: usm.priv_key_from_kul(usm.AUTH_SHA1, usm.PRIV_AES128, sha[:16], e), "short kul")
    value_fails(lambda: usm.priv_key_from_kul(usm.AUTH_MD5, usm.PRIV_DES, sha, e), "SHA kul for MD5")


# The vector keys: "authpassword"/"privpassword" for engine 80001f88800102030405060708 ###########

ENGINE = "80001f88800102030405060708"

def engine() -> bytes:
    return h(ENGINE)

def spec36() -> list[(int, str, str, list[str])]:
    """(auth, authKey, Kul(privpassword), privacy keys for DES AES AES192 AES256 AES192C AES256C)"""
    return [
        (usm.AUTH_MD5, "0750dc5d31704cd2601ae4b69b3e9021", "fc39a1c3d0320990e2f15aa313721ffb", [
            "fc39a1c3d0320990e2f15aa313721ffb", "fc39a1c3d0320990e2f15aa313721ffb",
            "fc39a1c3d0320990e2f15aa313721ffb3164033006355f67",
            "fc39a1c3d0320990e2f15aa313721ffb3164033006355f673fff27dba5dfc560",
            "fc39a1c3d0320990e2f15aa313721ffbe06d730af954144a",
            "fc39a1c3d0320990e2f15aa313721ffbe06d730af954144ab02dec578cc69104"]),
        (usm.AUTH_SHA1, "c3a7680bf9f2aafe04eb987ab75cfa5f32508b22", "d4b1c141c3730f4c2c41c7b686a631c352f66305", [
            "d4b1c141c3730f4c2c41c7b686a631c3", "d4b1c141c3730f4c2c41c7b686a631c3",
            "d4b1c141c3730f4c2c41c7b686a631c352f663050519c4a8",
            "d4b1c141c3730f4c2c41c7b686a631c352f663050519c4a879c36c1d75641535",
            "d4b1c141c3730f4c2c41c7b686a631c352f66305e82d4dd8",
