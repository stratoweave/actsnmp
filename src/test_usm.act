def auth_key(auth: int) -> bytes:
    """The vector authKey of auth (empty for AUTH_NONE)"""
    for a, k, kp, privs in spec36():
        if a == auth:
            return h(k)
    return b""

def priv_key(auth: int, priv: int) -> bytes:
    """The vector privacy key; 3DES is the 32-octet Reeder key, the same as AES256C's"""
    if priv == usm.PRIV_NONE:
        return b""
    for a, k, kp, privs in spec36():
        if a == auth:
            return h(privs[5] if priv == usm.PRIV_3DES else privs[priv - 1])
    raise ValueError("no privacy key without auth")

def user_for(name: bytes, auth: int, priv: int) -> LocalizedUser:
    return LocalizedUser(name, auth, priv, auth_key(auth), priv_key(auth, priv), engine())

def check_spec36_privs(auth: int) -> None:
    e = engine()
    for a, k, kp, privs in spec36():
        if a == auth:
            for priv in all_privs():
                testing.assertEqual(usm.priv_key_from_kul(a, priv, h(kp), e), priv_key(a, priv),
                                    usm.auth_name(a) + " " + usm.priv_name(priv))

def _test_spec36_priv_keys_md5() -> None:
    check_spec36_privs(usm.AUTH_MD5)

def _test_spec36_priv_keys_sha1() -> None:
    check_spec36_privs(usm.AUTH_SHA1)

def _test_spec36_priv_keys_sha224() -> None:
    check_spec36_privs(usm.AUTH_SHA224)

def _test_spec36_priv_keys_sha2_long() -> None:
    for auth in [usm.AUTH_SHA256, usm.AUTH_SHA384, usm.AUTH_SHA512]:
        check_spec36_privs(auth)


# LocalizedUser and UsmIncomingError ################################################################

def _test_localized_user() -> None:
    u = user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128)
    testing.assertEqual(u.level(), message.FLAG_AUTH | message.FLAG_PRIV)
    testing.assertEqual(user_for(b"shaonly", usm.AUTH_SHA1, usm.PRIV_NONE).level(), message.FLAG_AUTH)
    testing.assertEqual(LocalizedUser(b"noauth", usm.AUTH_NONE, usm.PRIV_NONE, b"", b"", engine()).level(), 0)
    r = repr(u)
    testing.assertEqual(r, "LocalizedUser(user=b'shaaes', engine_id=80001f88800102030405060708, auth=SHA, priv=AES)")
    testing.assertEqual(str(u), r)
    testing.assertFalse(u.auth_key.hex() in r)
    testing.assertFalse(u.priv_key.hex() in r)
    LocalizedUser(b"x" * 32, usm.AUTH_NONE, usm.PRIV_NONE, b"", b"", b"")

def _test_localized_user_rejects() -> None:
    k20 = b"\x01" * 20
    k16 = b"\x02" * 16
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_NONE, usm.PRIV_DES, b"", k16, b"e"), "privacy without auth")
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_SHA1, usm.PRIV_NONE, k16, b"", b"e"), "short auth key")
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_NONE, usm.PRIV_NONE, k16, b"", b"e"), "auth key without auth")
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_SHA1, usm.PRIV_AES256, k20, k16, b"e"), "short priv key")
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_SHA1, usm.PRIV_NONE, k20, k16, b"e"), "priv key without priv")
    value_fails(lambda: LocalizedUser(b"u", 7, usm.PRIV_NONE, k20, b"", b"e"), "auth 7")
    value_fails(lambda: LocalizedUser(b"u", usm.AUTH_SHA1, 8, k20, k16, b"e"), "priv 8")
    value_fails(lambda: LocalizedUser(b"x" * 33, usm.AUTH_NONE, usm.PRIV_NONE, b"", b"", b"e"), "33-octet user")

def _test_usm_incoming_error() -> None:
    e = usm.UsmIncomingError(usm.USM_STATS_WRONG_DIGESTS, "MAC does not verify")
    testing.assertEqual(e.kind, "usmStatsWrongDigests")
    testing.assertEqual(e.error_message, "usmStatsWrongDigests: MAC does not verify")
    testing.assertFalse(e.transient)
    testing.assertFalse(e.undecodable)
    testing.assertTrue(usm.UsmIncomingError(usm.USM_STATS_DECRYPTION_ERRORS, "garbage", True).undecodable)
    try:
        raise usm.UsmIncomingError(usm.USM_STATS_DECRYPTION_ERRORS, "x")
    except errors.AuthError as a:
        testing.assertTrue(isinstance(a, errors.SnmpError))
        return
    testing.error("UsmIncomingError is not an AuthError")


# Full messages #####################################################################################

SYS_DESCR = "1.3.6.1.2.1.1.1.0"
MSG_ID = 0x01020304

def get_scoped() -> ScopedPdu:
    """The ScopedPDU of the deterministic vectors: GET sysDescr.0, request-id 0x0a0b0c0d"""
    return ScopedPdu(engine(), b"", Pdu(pdu.GET, 0x0a0b0c0d, varbinds=[VarBind(Oid.parse(SYS_DESCR))]))

def response_scoped() -> ScopedPdu:
    """The ScopedPDU of the N_*_RESPONSE vectors"""
    return ScopedPdu(engine(), b"ctx", Pdu(pdu.RESPONSE, 0x0a0b0c0d, varbinds=[
        VarBind(Oid.parse(SYS_DESCR), OctetString(b"actsnmp-v3-spec-test"))]))

def report_scoped(request_id: int, counter: int, value: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"", Pdu(pdu.REPORT, request_id, varbinds=[
        VarBind(Oid([1, 3, 6, 1, 6, 3, 15, 1, 1, counter, 0]), Counter32(value))]))

def decode3(data: bytes) -> V3Message:
    c, m = message.decode(data)
    if m is not None:
        return m
    raise AssertionError("not an SNMPv3 message: " + data.hex())

class Vec(object):
    """A full message: how protect() builds it and what unprotect() must make of it"""
    name: str
    data: bytes
    user: bytes
    auth: int
    priv: int
    flags: int
    boots: int
    time: int
    salt: u64
    response: bool

    def __init__(self, name: str, hx: str, user: bytes, auth: int, priv: int, flags: int, salt: u64,
                 boots: int=1, time: int=150, response: bool=False):
        self.name = name
        self.data = h(hx)
        self.user = user
        self.auth = auth
        self.priv = priv
        self.flags = flags
        self.boots = boots
        self.time = time
        self.salt = salt
        self.response = response

    def scoped(self) -> ScopedPdu:
        return response_scoped() if self.response else get_scoped()

    def localized(self) -> LocalizedUser:
        return user_for(self.user, self.auth, self.priv)

    def header(self) -> V3Message:
        """The message fields protect() starts from (no MAC, no salt)"""
        return V3Message(MSG_ID, 65507, self.flags, UsmSecurityParameters(engine(), self.boots, self.time, self.user))

    def protect(self) -> bytes:
        u = self.localized() if self.auth != usm.AUTH_NONE else None
        return usm.protect(self.header(), message.encode_scoped(self.scoped()), u, self.salt)

