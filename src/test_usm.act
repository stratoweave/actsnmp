def spec9_vectors() -> list[Vec]:
    return [
        Vec("V-NOAUTH", V_NOAUTH, b"noauth", usm.AUTH_NONE, usm.PRIV_NONE, 0x04, 0, 0, 0),
        Vec("V-SHA-AUTHNOPRIV", V_SHA_AUTHNOPRIV, b"shaonly", usm.AUTH_SHA1, usm.PRIV_NONE, 0x05, 0),
        Vec("V-SHA512-AUTHNOPRIV", V_SHA512_AUTHNOPRIV, b"sha512only", usm.AUTH_SHA512, usm.PRIV_NONE, 0x05, 0),
        # DES salts: boots 1 || counter; the counter alone is passed, protect() adds the boots
        Vec("V-MD5-DES", V_MD5_DES, b"md5des", usm.AUTH_MD5, usm.PRIV_DES, 0x07, 0x2a),
        Vec("V-SHA-AES", V_SHA_AES, b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128, 0x07, 0xdeadbeef00000001),
        Vec("V-SHA256-AES", V_SHA256_AES, b"sha256aes", usm.AUTH_SHA256, usm.PRIV_AES128, 0x07, 0xdeadbeef00000002),
        Vec("V-SHA512-AES", V_SHA512_AES, b"sha512aes", usm.AUTH_SHA512, usm.PRIV_AES128, 0x07, 0xdeadbeef00000003),
        Vec("V-SHA-AES256-BLUMENTHAL", V_SHA_AES256_BLUMENTHAL, b"shaaes256", usm.AUTH_SHA1, usm.PRIV_AES256, 0x07,
            0xdeadbeef00000004),
        Vec("V-SHA-AES256C-REEDER", V_SHA_AES256C_REEDER, b"shaaes256c", usm.AUTH_SHA1, usm.PRIV_AES256C, 0x07,
            0xdeadbeef00000005),
        Vec("V-SHA256-DES", V_SHA256_DES, b"sha256des", usm.AUTH_SHA256, usm.PRIV_DES, 0x07, 0x2b)]

def new_vectors() -> list[Vec]:
    return [
        Vec("N-MD5-AUTHNOPRIV", N_MD5_AUTHNOPRIV, b"md5only", usm.AUTH_MD5, usm.PRIV_NONE, 0x05, 0),
        Vec("N-SHA224-AUTHNOPRIV", N_SHA224_AUTHNOPRIV, b"sha224only", usm.AUTH_SHA224, usm.PRIV_NONE, 0x05, 0),
        Vec("N-SHA384-AUTHNOPRIV", N_SHA384_AUTHNOPRIV, b"sha384only", usm.AUTH_SHA384, usm.PRIV_NONE, 0x05, 0),
        Vec("N-SHA224-AES192", N_SHA224_AES192, b"sha224aes192", usm.AUTH_SHA224, usm.PRIV_AES192, 0x07,
            0xdeadbeef00000010),
        Vec("N-SHA384-AES256C", N_SHA384_AES256C, b"sha384aes256c", usm.AUTH_SHA384, usm.PRIV_AES256C, 0x07,
            0xdeadbeef00000011),
        Vec("N-MD5-AES192", N_MD5_AES192, b"md5aes192", usm.AUTH_MD5, usm.PRIV_AES192, 0x07, 0xdeadbeef00000012),
        Vec("N-MD5-AES256C", N_MD5_AES256C, b"md5aes256c", usm.AUTH_MD5, usm.PRIV_AES256C, 0x07, 0xdeadbeef00000013),
        Vec("N-SHA224-AES256C", N_SHA224_AES256C, b"sha224aes256c", usm.AUTH_SHA224, usm.PRIV_AES256C, 0x07,
            0xdeadbeef00000014),
        Vec("N-SHA256-AES192", N_SHA256_AES192, b"sha256aes192", usm.AUTH_SHA256, usm.PRIV_AES192, 0x07,
            0xdeadbeef00000006),
        Vec("N-SHA-3DES", N_SHA_3DES, b"sha3des", usm.AUTH_SHA1, usm.PRIV_3DES, 0x07, 0x2c),
        Vec("N-MD5-3DES", N_MD5_3DES, b"md53des", usm.AUTH_MD5, usm.PRIV_3DES, 0x07, 0x2d),
        # only the low 32 bits of the salt count for DES; boots 7 comes from the message
        Vec("N-MD5-DES-RESPONSE", N_MD5_DES_RESPONSE, b"md5des", usm.AUTH_MD5, usm.PRIV_DES, 0x03,
            0xffffffff12345678, 7, 100000, True),
        Vec("N-SHA512-AES256-RESPONSE", N_SHA512_AES256_RESPONSE, b"sha512aes256", usm.AUTH_SHA512, usm.PRIV_AES256,
            0x03, 0xffffffffffffffff, 2147483647, 2147483647, True)]

def all_vectors() -> list[Vec]:
    return spec9_vectors() + new_vectors()

def _test_protect_spec9() -> None:
    for v in spec9_vectors():
        testing.assertEqual(v.protect().hex(), v.data.hex(), v.name)

def _test_protect_new_vectors() -> None:
    for v in new_vectors():
        testing.assertEqual(v.protect().hex(), v.data.hex(), v.name)

def _test_unprotect_vectors() -> None:
    for v in all_vectors():
        m = decode3(v.data)
        u = v.localized() if v.auth != usm.AUTH_NONE else None
        testing.assertEqual(usm.unprotect(v.data, m, u), v.scoped(), v.name)
        # the steps one by one give the same
        usm.authenticate(v.data, m, u)
        testing.assertEqual(usm.decrypt_scoped(m, u), v.scoped(), v.name)

def _test_protect_salt_on_the_wire() -> None:
    # DES/3DES: boots || low 32 bits of the salt; AES: the 64-bit salt
    for v in all_vectors():
        m = decode3(v.data)
        if v.priv == usm.PRIV_DES or v.priv == usm.PRIV_3DES:
            want = (u64(v.boots) << 32) | (v.salt & u64(0xffffffff))
        elif v.priv != usm.PRIV_NONE:
            want = v.salt
        else:
            testing.assertEqual(m.usm.priv_params, b"", v.name)
            continue
        got: u64 = 0
        for b in m.usm.priv_params:
            got = (got << 8) | u64(b)
        testing.assertEqual(len(m.usm.priv_params), 8, v.name)
        testing.assertEqual(got, want, v.name)

def _test_protect_ignores_message_params() -> None:
    # Whatever auth_params, priv_params, scoped and encrypted the caller leaves in msg, protect() fills them in
    for v in all_vectors():
        m = v.header()
        m.usm.auth_params = b"\xff" * 7
        m.usm.priv_params = b"\xee" * 3
        m.scoped = response_scoped()
        m.encrypted = b"junk"
        u = v.localized() if v.auth != usm.AUTH_NONE else None
        testing.assertEqual(usm.protect(m, message.encode_scoped(v.scoped()), u, v.salt), v.data, v.name)

def _test_protect_noauth_ignores_user_and_salt() -> None:
    v = spec9_vectors()[0]
    scoped = message.encode_scoped(v.scoped())
    other = user_for(b"someone", usm.AUTH_SHA1, usm.PRIV_AES128)
    testing.assertEqual(usm.protect(v.header(), scoped, other, 12345), v.data)
    testing.assertEqual(usm.protect(v.header(), scoped, None, 0xffffffffffffffff), v.data)

def _test_protect_rejects() -> None:
    scoped = message.encode_scoped(get_scoped())
    shaaes = user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128)
    shaonly = user_for(b"shaaes", usm.AUTH_SHA1, usm.PRIV_NONE)
    noauth = LocalizedUser(b"shaaes", usm.AUTH_NONE, usm.PRIV_NONE, b"", b"", engine())
    def hdr(flags: int) -> V3Message:
        return V3Message(MSG_ID, 65507, flags, UsmSecurityParameters(engine(), 1, 150, b"shaaes"))
    encode_fails(lambda: usm.protect(hdr(0x06), scoped, shaaes, 1), "privFlag without authFlag")
    encode_fails(lambda: usm.protect(hdr(0x02), scoped, None, 1), "privFlag without authFlag, no user")
    encode_fails(lambda: usm.protect(hdr(0x05), scoped, None, 1), "authNoPriv without a user")
    encode_fails(lambda: usm.protect(hdr(0x07), scoped, None, 1), "authPriv without a user")
    encode_fails(lambda: usm.protect(hdr(0x07), scoped, shaonly, 1), "authPriv with an authNoPriv user")
    encode_fails(lambda: usm.protect(hdr(0x05), scoped, noauth, 1), "authNoPriv with a noAuthNoPriv user")
    other_name = user_for(b"shaaes2", usm.AUTH_SHA1, usm.PRIV_AES128)
    encode_fails(lambda: usm.protect(hdr(0x07), scoped, other_name, 1), "user name differs")
    other_engine = LocalizedUser(b"shaaes", usm.AUTH_SHA1, usm.PRIV_AES128, auth_key(usm.AUTH_SHA1),
                                 priv_key(usm.AUTH_SHA1, usm.PRIV_AES128), h("80001f888001020304050607ff"))
    encode_fails(lambda: usm.protect(hdr(0x07), scoped, other_engine, 1), "engine ID differs")
    other_model = V3Message(MSG_ID, 65507, 0x04, UsmSecurityParameters(engine()), security_model=2)
    encode_fails(lambda: usm.protect(other_model, scoped, None, 1), "security model 2")
    for bad in [b"", b"\x04\x00", b"\xa0\x00"]:
        encode_fails(lambda: usm.protect(hdr(0x07), bad, shaaes, 1), "scoped_plain " + bad.hex())
        encode_fails(lambda: usm.protect(hdr(0x04), bad, None, 1), "noAuth scoped_plain " + bad.hex())
    late = V3Message(MSG_ID, 65507, 0x07, UsmSecurityParameters(engine(), 2147483648, 150, b"shaaes"))
    encode_fails(lambda: usm.protect(late, scoped, shaaes, 1), "boots above 2^31-1")
    big_id = V3Message(2147483648, 65507, 0x05, UsmSecurityParameters(engine(), 1, 150, b"shaaes"))
    encode_fails(lambda: usm.protect(big_id, scoped, shaonly, 1), "msgID above 2^31-1")

def scoped_with_name(n: int) -> ScopedPdu:
    return ScopedPdu(engine(), b"c" * n, Pdu(pdu.GET, 77, varbinds=[VarBind(Oid.parse(SYS_DESCR))]))

def _test_round_trip_all_protocols() -> None:
    # Every auth/priv combination with keys of the right lengths, and plaintexts of every
    # length modulo 8 (all DES/3DES padding lengths); also checks the salt is honoured.
    e = engine()
    for auth in all_auths():
        for priv in [usm.PRIV_NONE] + all_privs():
            ak = pseudo_random(usm.auth_key_len(auth), 17 + auth)
            pk = pseudo_random(usm.priv_key_len(priv), 101 + 13 * priv + auth)
            u = LocalizedUser(("user%d%d" % (auth, priv)).encode(), auth, priv, ak, pk, e)
            flags = 0x07 if priv != usm.PRIV_NONE else 0x05
            cbc = (priv == usm.PRIV_DES or priv == usm.PRIV_3DES)
            for n in range(8):
                s = scoped_with_name(n)
                hdr = V3Message(1000 + n, 1500, flags, UsmSecurityParameters(e, 3, 4000 + n, u.user))
                salt = u64(0x0102030405060708) + u64(n)
                data = usm.protect(hdr, message.encode_scoped(s), u, salt)
                m = decode3(data)
                what = usm.auth_name(auth) + "/" + usm.priv_name(priv) + " n=%d" % n
                testing.assertEqual(m.flags, flags, what)
                testing.assertEqual(len(m.usm.auth_params), usm.auth_mac_len(auth), what)
                testing.assertEqual(usm.unprotect(data, m, u), s, what)
                if priv != usm.PRIV_NONE:
                    ct = m.encrypted
                    if ct is not None:
                        plain_len = len(message.encode_scoped(s))
                        testing.assertEqual(len(ct), (plain_len + 7) // 8 * 8 if cbc else plain_len, what)
                    other = usm.protect(hdr, message.encode_scoped(s), u, salt + u64(1))
                    testing.assertNotEqual(other, data, what + " with the next salt")


