"""Tests for engine

Fed the captured net-snmp requests, the engine must answer with net-snmp's
Reports byte for byte. The other tests build requests with usm.protect().
"""

import testing
import message
import pdu
import usm
import usmcrypto
from engine import AuthoritativeEngine, Incoming
from message import ScopedPdu, UsmSecurityParameters, V3Message
from oid import Oid
from pdu import Pdu
from security import Usm
from usm import LocalizedUser
from values import Counter32, OctetString, VarBind
from testutil import h, encode_fails, value_fails

# The engine of the test vectors and captures, users with "authpassword"/"privpassword"
ENGINE = "80001f88800102030405060708"
SYS_DESCR = "1.3.6.1.2.1.1.1.0"

# Discovery and time synchronisation with net-snmp (captured exchanges)
