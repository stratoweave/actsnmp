"""Object identifiers

Oid is an immutable-by-convention list of arcs with the ordering SNMP uses
(arc-wise numeric, a prefix sorts before its extensions). It is Ord and
Hashable, so it works with sorted(), min()/max(), as a dict key and in sets,
and a Collection of its arcs, so len(o) and iterating over the arcs work.
"""

import ber

class Oid(object):
    """An OBJECT IDENTIFIER: a list of arcs, each 0..2^32-1

    Any number of arcs is allowed, so that whatever arrives on the wire can be
    represented (06 00 decodes to an Oid without arcs). Encoding a varbind
    name or an OID value requires 2 to 128 arcs with the X.690 first-arc
    rules; see ber.enc_oid_content.

    The arcs list is not copied: do not modify it after construction, since
    the Oid's ordering and hash depend on it. Methods that derive a new OID
    build a new list.
    """
    arcs: list[int]

    pure def __init__(self, arcs: list[int]):
        """Wrap arcs; raises ValueError if an arc is outside 0..2^32-1"""
        for i in range(len(arcs)):
            a = arcs[i]
            if a < 0 or a > 4294967295:
                raise ValueError("OID arc out of range: %d" % a)
        self.arcs = arcs

    @staticmethod
    def parse(s: str) -> Oid:
        """Parse dotted decimal, with or without a leading dot

        "1.3.6.1.2.1.1.1.0" and ".1.3.6.1.2.1.1.1.0" are the same OID. Raises
        ValueError for an empty string, an empty arc ("1..3", "1.3."), any
        character other than ASCII digits and the dots between arcs (signs,
        spaces, hex) and arcs above 2^32-1.
        """
        t = s[1:] if s.startswith(".") else s
        if t == "":
            raise ValueError("invalid OID %r: no arcs" % s)
        arcs: list[int] = []
        for p in t.split("."):
            if p == "" or len(p) > 10 or not (p.isascii() and p.isdecimal()):
                raise ValueError("invalid OID %r" % s)
            a = int(p)
            if a > ber.MAX_ARC:
                raise ValueError("invalid OID %r: arc %d exceeds 2^32-1" % (s, a))
            arcs.append(a)
        return Oid(arcs)

    def __str__(self) -> str:
        """Return the arcs joined by dots, without a leading dot: "1.3.6.1.2.1.1.1.0" """
        return ".".join([str(a) for a in self.arcs])

    def __repr__(self) -> str:
        return "Oid(" + self.__str__() + ")"

    def dotted(self) -> str:
        """Return the net-snmp -On form with a leading dot: ".1.3.6.1.2.1.1.1.0" """
        return "." + self.__str__()

    def startswith(self, prefix: Oid) -> bool:
        """Return True if prefix's arcs are the first arcs of this OID (or all of them)"""
        pa = prefix.arcs
        sa = self.arcs
        n = len(pa)
        if n > len(sa):
            return False
        for i in range(n):
            if sa[i] != pa[i]:
                return False
        return True

    def is_prefix_of(self, other: Oid) -> bool:
        """Return True if other starts with this OID; the subtree test of a walk"""
        return other.startswith(self)

    def suffix(self, prefix: Oid) -> list[int]:
        """Return the arcs after prefix, for example a table row's index

        Raises ValueError if prefix is not a prefix of this OID.
        """
        if not self.startswith(prefix):
            raise ValueError("%s is not a prefix of %s" % (prefix.__str__(), self.__str__()))
        return self.arcs[len(prefix.arcs):]

    def child(self, arcs: list[int]) -> Oid:
        """Return a new OID with arcs appended; raises ValueError for an arc out of range"""
        return Oid(self.arcs + arcs)

    def parent(self) -> Oid:
        """Return the OID without its last arc; raises ValueError for an OID without arcs"""
        n = len(self.arcs)
        if n == 0:
            raise ValueError("an OID without arcs has no parent")
        return Oid(self.arcs[:n - 1])

    def next_sibling(self) -> ?Oid:
        """Return the OID with its last arc incremented

        Every OID in the subtree of o is greater than o and smaller than
        o.next_sibling(). Returns None when the last arc is 2^32-1 or there
        are no arcs.
        """
        n = len(self.arcs)
        if n == 0 or self.arcs[n - 1] == ber.MAX_ARC:
            return None
        arcs = self.arcs.copy()
        arcs[n - 1] += 1
        return Oid(arcs)

    def key(self) -> bytes:
        """Return the arcs packed as 4-octet big-endian integers

        Two keys compare like the OIDs they come from, so they are usable as
        ordered keys outside Acton (unlike the BER encoding, where arc 16383
        encodes as ff 7f and 16384 as 81 80 00).
        """
        t = ber.BYTE_TABLE
        parts: list[bytes] = []
        for a in self.arcs:
            parts.append(t[a >> 24])
            parts.append(t[(a >> 16) & 0xff])
            parts.append(t[(a >> 8) & 0xff])
            parts.append(t[a & 0xff])
        return b"".join(parts)


extension Oid(Ord):
    def __eq__(self, other: Oid) -> bool:
        return self.arcs == other.arcs

    def __lt__(self, other: Oid) -> bool:
        return self.arcs < other.arcs


extension Oid(Hashable):
    def hash(self, h: hasher) -> None:
        # The length, then two arcs per hasher update: arcs are below 2^32, so (a << 32) | b is
        # injective, and each update costs as much as packing, so this is about twice as fast.
        a = self.arcs
        n = len(a)
        n.hash(h)
        i = 0
        while i + 1 < n:
            x: int = (a[i] << 32) | a[i + 1]
            x.hash(h)
            i += 2
        if i < n:
            a[i].hash(h)


extension Oid(Collection[int]):
    @staticmethod
    def __fromiter__(it):
        return Oid([a for a in it])

    def __iter__(self) -> Iterator[int]:
        return iter(self.arcs)

    def __len__(self) -> int:
        return len(self.arcs)
