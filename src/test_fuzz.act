# Tests: ber primitives and opaque_special ##########################################################

def check_dec_int(fx: Findings, b: bytes) -> None:
    n = len(b)
    v, err = attempt(lambda: ber.dec_int(b, 0, n), 0, n)
    bug(fx, "random", "", b, "ber.dec_int", err)
    if v is not None:
        fx.ok()
        enc = ber.enc_int_content(v)
        if ber.dec_int(enc, 0, len(enc)) != v or len(enc) > n:
            fx.fail("random", "", b, "dec_int gives %d, which re-encodes to " % v + enc.hex())
    elif n >= 1 and n <= 8:
        fx.fail("random", "", b, "dec_int rejects an INTEGER of 1 to 8 octets: " + err)

def check_dec_uint32(fx: Findings, b: bytes) -> None:
    n = len(b)
    u, err = attempt(lambda: ber.dec_uint32(b, 0, n), 0, n)
    bug(fx, "random", "", b, "ber.dec_uint32", err)
    if u is not None:
        if u < 0 or u > 0xffffffff:
            fx.fail("random", "", b, "dec_uint32 gives %d" % u)
        else:
            enc = ber.enc_uint_content(u)
            if ber.dec_uint32(enc, 0, len(enc)) != u:
                fx.fail("random", "", b, "dec_uint32 gives %d, which re-encodes to " % u + enc.hex())
    elif n >= 1 and n <= 4 and b[0] < 0x80:
        fx.fail("random", "", b, "dec_uint32 rejects a value below 2^31: " + err)

def check_dec_u64(fx: Findings, b: bytes) -> None:
    n = len(b)
    w, err = attempt(lambda: ber.dec_u64(b, 0, n), 0, n)
    bug(fx, "random", "", b, "ber.dec_u64", err)
    if w is not None:
        enc = ber.enc_u64_content(w)
        if ber.dec_u64(enc, 0, len(enc)) != w:
            fx.fail("random", "", b, "dec_u64 gives " + str(w) + ", which re-encodes to " + enc.hex())
    elif n >= 1 and n <= 8:
        fx.fail("random", "", b, "dec_u64 rejects a Counter64 of 1 to 8 octets: " + err)

def check_dec_oid(fx: Findings, b: bytes) -> None:
    # A decoded OID has 0 (06 00) or 2 to 128 arcs in range, and re-encodes to the same arcs.
    n = len(b)
    r, err = attempt(lambda: ber.dec_oid(b, 0, n), 0, n)
    bug(fx, "random", "", b, "ber.dec_oid", err)
    if r is not None:
        check_arcs(fx, b, r)

def check_arcs(fx: Findings, b: bytes, arcs: list[int]) -> None:
    n = len(b)
    bad = len(arcs) > ber.MAX_OID_ARCS or len(arcs) == 1 or (len(arcs) == 0) != (n == 0)
    for a in arcs:
        if a < 0 or a > ber.MAX_ARC:
            bad = True
    if bad:
        fx.fail("random", "", b, "dec_oid gives " + str(arcs))
    elif len(arcs) >= 2:
        enc, eerr = attempt_encode(lambda: ber.enc_oid_content(arcs))
        if enc is not None:
            if ber.dec_oid(enc, 0, len(enc)) != arcs:
                fx.fail("random", "", b, "the decoded OID " + str(arcs) + " re-encodes to " + enc.hex())
        else:
            fx.fail("random", "", b, "the decoded OID " + str(arcs) + " does not re-encode: " + eerr)

def check_read_tlv(fx: Findings, b: bytes) -> None:
    # A TLV header lies within the input, and expect_tlv with its tag agrees.
    n = len(b)
    r, err = attempt(lambda: ber.read_tlv(b, 0, n), 0, n)
    bug(fx, "random", "", b, "ber.read_tlv", err)
    if r is not None:
        check_header(fx, b, r.0, r.1, r.2)

def check_header(fx: Findings, b: bytes, tag: int, start: int, stop: int) -> None:
    n = len(b)
    if tag != b[0] or start < 2 or start > stop or stop > n:
        fx.fail("random", "", b, "read_tlv gives %d, %d, %d" % (tag, start, stop))
    r, err2 = attempt(lambda: ber.expect_tlv(b, 0, n, tag), 0, n)
    if r is not None:
        if r.0 != start or r.1 != stop:
            fx.fail("random", "", b, "expect_tlv gives %d, %d, read_tlv %d, %d" % (r.0, r.1, start, stop))
    else:
        fx.fail("random", "", b, "expect_tlv with the tag read_tlv found fails: " + err2)
    ln, err3 = attempt(lambda: ber.read_length(b, 1, n), 1, n)
    if ln is not None:
        if ln.0 != start or ln.1 != stop:
            fx.fail("random", "", b, "read_length gives %d, %d, read_tlv %d, %d" % (ln.0, ln.1, start, stop))
    else:
        fx.fail("random", "", b, "read_length fails where read_tlv succeeds: " + err3)

def check_primitives(fx: Findings, b: bytes) -> None:
    """Check the ber primitives on b; besides property 1, results must stay in range and re-encode"""
    fx.input()
    check_dec_int(fx, b)
    check_dec_uint32(fx, b)
    check_dec_u64(fx, b)
    check_dec_oid(fx, b)
    check_read_tlv(fx, b)
    n = len(b)
    bug(fx, "random", "", b, "ber.read_length", attempt(lambda: ber.read_length(b, 0, n), 0, n).1)

def check_ranges(fx: Findings, b: bytes, pos: int, end: int) -> None:
    """Property 1 for (pos, end) arguments that may lie outside the buffer or be reversed"""
    fx.input()
    what = "range [%d, %d)" % (pos, end)
    # check_bounds reports a bad range at pos, which may lie outside the buffer: do not
    # check DecodeError offsets here
    lo = -1000
    hi = 1000
    bug(fx, "random", what, b, "ber.dec_int", attempt(lambda: ber.dec_int(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.dec_uint32", attempt(lambda: ber.dec_uint32(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.dec_u64", attempt(lambda: ber.dec_u64(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.dec_oid", attempt(lambda: ber.dec_oid(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.read_tlv", attempt(lambda: ber.read_tlv(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.read_length", attempt(lambda: ber.read_length(b, pos, end), lo, hi).1)
    bug(fx, "random", what, b, "ber.dump", attempt(lambda: ber.dump(b, pos, end), lo, hi).1)
    for target in TARGETS:
        d, err = attempt(lambda: decode_at(target, b, pos, end), lo, hi)
        bug(fx, "random", what, b, TARGET_NAMES[target], err)
        if target == T_VALUE and d is not None:
            fx.ok()

def _test_ber_primitives_random(t: testing.SyncT) -> None:
    t.timeout(60.0)
    fx = Findings("ber primitives")
    rng = Rng(0x7072696d)
    for i in range(40000):
        check_primitives(fx, rng.steering(rng.below(12)))
    fx.finish(40000)
    fx = Findings("ber primitives with bad ranges")
    for i in range(5000):
        b = rng.steering(rng.below(8))
        check_ranges(fx, b, rng.below(len(b) + 4) - 2, rng.below(len(b) + 4) - 2)
    fx.finish(5000)

OPAQUE_KINDS: list[str] = ["Float", "Double", "I64", "U64", "Counter64"]

def _test_opaque_special_random(t: testing.SyncT) -> None:
    # Random net-snmp Opaque wrappers (9f 76/78/79/7a/7b and other second octets) with random
    # and random-length contents; opaque_special returns a result or None and never raises.
    t.timeout(60.0)
    fx = Findings("opaque_special")
    rng = Rng(0x6f7061717565)
    kinds = [0x76, 0x78, 0x79, 0x7a, 0x7b]
    for i in range(30000):
        fx.input()
        inner = kinds[rng.below(len(kinds))] if rng.below(8) != 0 else rng.below(256)
        n = rng.below(11)
        length = ber.BYTE_TABLE[n] if rng.below(4) != 0 else rng.steering(1 + rng.below(3))
        c = b"\x9f" + ber.BYTE_TABLE[inner] + length + rng.steering(n)
        if rng.below(4) == 0:
            c = c[:rng.below(len(c) + 1)]
        try:
            r = values.opaque_special(Opaque(c))
            if r is not None:
                fx.ok()
                if r.kind not in OPAQUE_KINDS or r.value == "":
                    fx.fail("random", "", c, "opaque_special gives " + r.kind + " " + r.value)
        except Exception as e:
            fx.fail("random", "", c, "values.opaque_special raised " + str(e))
    fx.finish(30000)


# Tests: nesting and edge cases #####################################################################

def _test_nesting_depth() -> None:
    # Nested constructed TLVs: ber.dump stops at MAX_DEPTH levels with DecodeError; the
    # other decoders do not recurse into values and must stay well-behaved.
    fx = Findings("nesting")
    rng = Rng(0x6e657374)
    x = b"\x05\x00"
    for depth in range(1, 41):
        x = render(ber.TAG_SEQUENCE if depth % 2 == 0 else pdu.RESPONSE, x)
        check_message(fx, "nesting", "depth %d" % depth, x)
        for target in TARGETS:
            check_at(fx, rng, target, "nesting", "depth %d" % depth, x)
        dumped, err = attempt(lambda: ber.dump(x, 0, len(x)), 0, len(x))
        if depth < ber.MAX_DEPTH:
            testing.assertNotNone(dumped, "dump at depth %d: " % depth + err)
        elif depth > ber.MAX_DEPTH:
            testing.assertTrue(err.startswith("DecodeError"), "dump at depth %d: " % depth + outcome(err))
    fx.finish(200)

def _test_hostile_headers() -> None:
    # Lengths far beyond the input, every unsupported length form, high-tag-number forms
    # and empty input: message.decode raises DecodeError, and no decoder raises anything else.
    rng = Rng(0x686f7374696c65)
    fx = Findings("hostile headers")
    cases = ["", "30", "30 80", "30 80 00 00", "30 81", "30 81 80", "30 82 ff", "30 84 ff ff ff ff",
             "30 84 7f ff ff ff 02 01 00", "30 83 ff ff ff 02 01 00", "30 85 00 00 00 00 01 00", "30 88 00",
             "30 ff 00", "1f 00", "3f 01 00", "bf 81 00", "ff ff", "30 03 02 01", "30 02 02 05",
             "30 0b 02 01 01 04 00 a0 84 ff ff ff ff", "30 0b 02 01 03 30 84 7f ff ff ff 04 00"]
    for hx in cases:
        d = ber.from_hex(hx)
        check_message(fx, "hostile", hx, d)
        for target in TARGETS:
            check_at(fx, rng, target, "hostile", hx, d)
        testing.assertNone(attempt(lambda: message.decode(d), 0, len(d)).0, hx)
    fx.finish(5 * len(cases))
