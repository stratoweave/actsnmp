# Value TLVs that decode: net-snmp Opaque special types and the lenient vectors
VALUES_OK: list[(str, str)] = [
    ("v1v2c 1.10 Opaque Counter64 2^40", "44 09 9f 76 06 01 00 00 00 00 00"),
    ("v1v2c 1.10 Opaque Float 1.5", "44 07 9f 78 04 3f c0 00 00"),
    ("v1v2c 1.10 Opaque Float laLoadFloat.1", "44 07 9f 78 04 40 0b c8 00"),
    ("v1v2c 1.10 Opaque Double 2.5", "44 0b 9f 79 08 40 04 00 00 00 00 00 00"),
    ("v1v2c 1.10 Opaque Int64 -5", "44 04 9f 7a 01 fb"),
    ("v1v2c 1.10 Opaque UInt64 5", "44 04 9f 7b 01 05"),
    ("v1v2c 1.10 Opaque UInt64 2^64-1", "44 0c 9f 7b 09 00 ff ff ff ff ff ff ff ff"),
    ("v1v2c 1.11 INTEGER 5 in 4 octets", "02 04 00 00 00 05"),
    ("v1v2c 1.11 Counter32 ff ff ff ff", "41 04 ff ff ff ff"),
    ("v1v2c 1.11 Counter64 2^32", "46 05 01 00 00 00 00"),
    ("v1v2c 1.11 OID 06 00", "06 00"),
    ("v1v2c 1.11 OID with 80 padding", "06 0a 2b 06 01 04 01 80 80 80 80 7f"),
    ("v1v2c 1.11 UInteger32", "47 01 2a"),
    ("v1v2c 1.11 NsapAddress", "45 03 47 00 05"),
    ("v1v2c 8 IpAddress of 3 octets", "40 03 0a 00 00"),
]

# The malformed-value vectors: the TLV is intact, so they
# decode, to a MalformedValue (INTEGER 2^48 fits 64 bits and is an Integer)
VALUES_MALFORMED: list[(str, str)] = [
    ("v1v2c 8 empty Counter32", "41 00"),
    ("v1v2c 8 empty INTEGER", "02 00"),
    ("v1v2c 8 TimeTicks of 8 octets", "43 08 ff ff ff ff ff ff ff ff"),
    ("v1v2c 8 INTEGER 2^48", "02 07 01 00 00 00 00 00 00"),
    ("v1v2c 8 OID arc 2^32", "06 0a 2b 06 01 04 01 90 80 80 80 00"),
    ("v1v2c 8 OID ending in a continuation octet", "06 02 2b 86"),
]


# Seed trees ########################################################################################

class Node(object):
    """A TLV of a seed; content that is itself a series of TLVs is parsed into children

    Constructed TLVs are parsed, and so is an OCTET STRING holding a
    SEQUENCE (msgSecurityParameters). The root of a seed is a virtual node
    with tag -1 whose children are the seed's top-level TLVs.
    """
    tag: int
    pos: int            # offset of the identifier octet in the seed
    start: int          # content range [start, stop) in the seed
    stop: int
    children: list[Node]
    nested: bool
    body: bytes         # the content, re-encoded from the children when nested
    encoded: bytes      # the whole TLV (only the body for the root)

    def __init__(self, tag: int, pos: int, start: int, stop: int, children: list[Node], nested: bool, body: bytes):
        self.tag = tag
        self.pos = pos
        self.start = start
        self.stop = stop
        self.children = children
        self.nested = nested
        self.body = body
        self.encoded = render(tag, body)


class Seed(object):
    """A named input and its TLV tree, flattened for picking nodes at random

    nodes and paths list every TLV in pre-order with the child indices that
    lead to it from the root; parents and parent_paths do the same for the
    nodes with children, the root (path []) included. tail holds the octets
    after the last top-level TLV that parses (DES padding).
    """
    name: str
    data: bytes
    root: Node
    tail: bytes
    nodes: list[Node]
    paths: list[list[int]]
    parents: list[Node]
    parent_paths: list[list[int]]

    def __init__(self, name: str, data: bytes, root: Node, tail: bytes):
        self.name = name
        self.data = data
        self.root = root
        self.tail = tail
        self.nodes = []
        self.paths = []
        self.parents = [root]
        self.parent_paths = [[]]


def render(tag: int, body: bytes) -> bytes:
    """Return the TLV with tag (any octet, also the high-tag-number form) and a minimal length"""
    if tag < 0:
        return body
    return ber.BYTE_TABLE[tag] + ber.enc_length(len(body)) + body

def render_long(tag: int, body: bytes, k: int) -> bytes:
    """Return the TLV with its length in the long form of k (1 to 4) octets, minimal or not"""
    n = len(body)
    octs = b"".join([ber.BYTE_TABLE[(n >> (8 * (k - 1 - i))) & 0xff] for i in range(k)])
    return ber.BYTE_TABLE[tag] + ber.BYTE_TABLE[0x80 | k] + octs + body

def parse_node(buf: bytes, pos: int, end: int) -> Node:
    tag, start, stop = ber.read_tlv(buf, pos, end)
    if (tag & 0x20) != 0 or (tag == ber.TAG_OCTET_STRING and stop > start and buf[start] == ber.TAG_SEQUENCE):
        kids, q = parse_tlvs(buf, start, stop)
        if q == stop:
            return Node(tag, pos, start, stop, kids, True, b"".join([c.encoded for c in kids]))
    return Node(tag, pos, start, stop, [], False, buf[start:stop])

def try_parse(buf: bytes, pos: int, end: int) -> ?Node:
    try:
        return parse_node(buf, pos, end)
    except errors.DecodeError:
        return None

def parse_tlvs(buf: bytes, pos: int, end: int) -> (list[Node], int):
    """Parse TLVs from pos until end or the first one that does not parse; return them and where they stop"""
    nodes: list[Node] = []
    p = pos
    while p < end:
        nd = try_parse(buf, p, end)
        if nd is not None:
            nodes.append(nd)
            p = nd.stop
        else:
            break
    return (nodes, p)

def flatten(s: Seed, n: Node, path: list[int]) -> None:
    for i in range(len(n.children)):
        c = n.children[i]
        p = path + [i]
        s.nodes.append(c)
        s.paths.append(p)
        if c.nested:
            s.parents.append(c)
            s.parent_paths.append(p)
            flatten(s, c, p)

def make_seed(name: str, data: bytes) -> Seed:
    kids, q = parse_tlvs(data, 0, len(data))
    root = Node(-1, 0, 0, q, kids, True, b"".join([c.encoded for c in kids]))
    s = Seed(name, data, root, data[q:])
    flatten(s, root, [])
    return s

def rebuild(n: Node, path: list[int], depth: int, repl: bytes) -> bytes:
    """Return the encoding of n with the TLV at path (from depth on) replaced by repl

    The lengths of all enclosing TLVs are recomputed.
    """
    if depth == len(path):
        return repl
    i = path[depth]
    parts = [c.encoded for c in n.children]
    parts[i] = rebuild(n.children[i], path, depth + 1, repl)
    return render(n.tag, b"".join(parts))

def replace_at(s: Seed, path: list[int], repl: bytes) -> bytes:
    """Return the seed with the TLV at path replaced by repl and consistent enclosing lengths"""
    return rebuild(s.root, path, 0, repl) + s.tail

def node_at(s: Seed, path: list[int]) -> Node:
    n = s.root
    for i in path:
        n = n.children[i]
    return n

def message_seeds() -> list[Seed]:
    return [make_seed(name, ber.from_hex(hx)) for name, hx in MESSAGES]

# Decoders to check: T_MESSAGE for datagrams (message.decode, message.peek, ber.dump), the
# others for the offset decoders
T_MESSAGE = -1
T_SCOPED = 0
T_PDU = 1
T_VARBINDS = 2
T_VALUE = 3
TARGETS: list[int] = [T_SCOPED, T_PDU, T_VARBINDS, T_VALUE]
TARGET_NAMES: list[str] = ["message.decode_scoped", "pdu.decode_pdu", "values.decode_varbinds", "values.decode_value"]

def is_pdu_tag(tag: int) -> bool:
    return tag >= pdu.GET and tag <= pdu.REPORT

def corpus(target: int) -> list[Seed]:
    """Return the inputs of an offset decoder, cut out of the seeds without duplicates

    T_SCOPED: the plaintexts and the ScopedPDUs of unencrypted SNMPv3
    messages; T_PDU: every PDU; T_VARBINDS: the content of every
    VarBindList; T_VALUE: every varbind name and value, the SNMPv1 Trap-PDU
    fields and VALUES_OK/VALUES_MALFORMED.
    """
    seen: set[bytes] = set()
    out: list[Seed] = []

    def add(name: str, data: bytes) -> None:
        if data not in seen:
            seen.add(data)
            out.append(make_seed(name, data))

    plain = [make_seed(name, ber.from_hex(hx)) for name, hx in PLAINTEXTS]
    if target == T_SCOPED:
        for s in plain:
            add(s.name, s.data)
    for s in message_seeds() + plain:
        for nd in s.nodes:
            kids = nd.children
            if target == T_SCOPED and nd.pos == 0 and len(kids) == 4 and kids[0].body == b"\x03" and kids[3].nested:
                add(s.name + " ScopedPDU", kids[3].encoded)
            if not is_pdu_tag(nd.tag) or not nd.nested or len(kids) == 0:
                continue
            vbl = kids[len(kids) - 1]
            if target == T_PDU:
                add(s.name + " PDU", nd.encoded)
            elif target == T_VARBINDS:
                add(s.name + " varbinds", vbl.body)
            elif target == T_VALUE:
                if nd.tag == pdu.TRAP_V1:
                    for i in range(len(kids) - 1):
                        add(s.name + " Trap-PDU field %d" % i, kids[i].encoded)
                for i in range(len(vbl.children)):
                    vb = vbl.children[i]
                    if len(vb.children) == 2:
                        add(s.name + " name %d" % i, vb.children[0].encoded)
                        add(s.name + " value %d" % i, vb.children[1].encoded)
    if target == T_VALUE:
        for name, hx in VALUES_OK + VALUES_MALFORMED:
            add(name, ber.from_hex(hx))
    return out


# Properties ########################################################################################

MAX_REPORTED = 12

# Prefix of a property 1 violation in the texts that attempt() returns
BUG = "BUG: "

class Findings(object):
    """The inputs a test checked, the property violations it found and how many MalformedValues it saw"""
    test: str
    inputs: int
    decoded: int
    malformed: int
    count: int
    failures: list[str]

    def __init__(self, test: str):
        self.test = test
        self.inputs = 0
        self.decoded = 0
        self.malformed = 0
        self.count = 0
        self.failures = []

    def input(self) -> None:
        self.inputs += 1

    def ok(self) -> None:
        self.decoded += 1

    def fail(self, seed: str, op: str, data: bytes, what: str) -> None:
        """Record a violation by data, the input that mutation op made from seed"""
        self.count += 1
        if len(self.failures) < MAX_REPORTED:
            self.failures.append("seed " + seed + ", mutation " + op + ", input " + data.hex() + ": " + what)

    def finish(self, min_inputs: int, mixed: bool=True) -> None:
        """Fail the test if a property was violated or the inputs were not what the test intends

        mixed: some inputs must decode and others must not, otherwise the
        mutations do not exercise the decoders.
        """
        if self.count > 0:
            testing.error("%s: %d property violations in %d inputs, the first %d:\n"
                          % (self.test, self.count, self.inputs, len(self.failures)) + "\n".join(self.failures))
        testing.assertTrue(self.inputs >= min_inputs,
                           "%s: %d inputs, expected %d" % (self.test, self.inputs, min_inputs))
        if mixed:
            testing.assertTrue(self.decoded > 0 and self.decoded < self.inputs,
                               "%s: %d of %d inputs decoded" % (self.test, self.decoded, self.inputs))
        else:
            testing.assertEqual(self.decoded, self.inputs, self.test + ": inputs that did not decode")

def attempt[T](f: mut() -> T, pos: int, end: int) -> (?T, str):
    """Run the decoder f on the input range [pos, end) of its buffer

    Returns (result, "") on success and (None, text) otherwise. text starts
    with BUG for a property 1 violation: an exception other than
    DecodeError, or a DecodeError offset outside [pos, end]. Otherwise it
    describes the DecodeError with its offset relative to pos, so that runs
    at different positions compare equal.
    """
    try:
        return (f(), "")
    except errors.DecodeError as e:
        if e.offset < pos or e.offset > end:
            return (None, BUG + "DecodeError offset %d outside [%d, %d]: " % (e.offset, pos, end) + e.error_message)
        return (None, "DecodeError at +%d: " % (e.offset - pos) + e.reason)
    except Exception as e:
        return (None, BUG + str(e))

def attempt_encode[T](f: mut() -> T) -> (?T, str):
    """Run the encoder f; like attempt, but EncodeError is the expected failure"""
    try:
        return (f(), "")
    except errors.EncodeError as e:
        return (None, "EncodeError: " + e.error_message)
    except Exception as e:
        return (None, BUG + str(e))

def outcome(err: str) -> str:
    return err if err != "" else "success"

def bug(fx: Findings, seed: str, op: str, data: bytes, what: str, err: str) -> bool:
    """Record err if it is a property 1 violation by what; return True if it is"""
    if err.startswith(BUG):
        fx.fail(seed, op, data, what + ": " + err)
        return True
    return False

def same_opt[A(Eq)](a: ?A, b: ?A) -> bool:
    if a is not None and b is not None:
        return a == b
    return a is None and b is None

def same_community(a: CommunityMessage, b: CommunityMessage) -> bool:
    return (a.version == b.version and a.community == b.community and same_opt(a.pdu, b.pdu)
            and same_opt(a.trap, b.trap))

def same_v3(a: V3Message, b: V3Message) -> bool:
    """Equal SNMPv3 messages, except for auth_offset, which depends on the length encodings"""
    return (a.msg_id == b.msg_id and a.max_size == b.max_size and a.flags == b.flags
            and a.security_model == b.security_model and a.usm == b.usm
            and same_opt(a.scoped, b.scoped) and same_opt(a.encrypted, b.encrypted))

def check_printable(fx: Findings, seed: str, op: str, data: bytes, f: mut() -> str) -> None:
    try:
        f()
    except Exception as e:
        fx.fail(seed, op, data, "repr of the decoded result raised " + str(e))

def check_values(fx: Findings, seed: str, op: str, data: bytes, vbs: list[VarBind]) -> None:
    for vb in vbs:
        check_value(fx, seed, op, data, vb.value)

def strict_error(tag: int, c: bytes) -> ?str:
    """The DecodeError reason of the strict ber decoder of tag for the content c, or None

    None also for the tags that decode without a strict decoder.
    """
    n = len(c)
    try:
        if tag == ber.TAG_INTEGER:
            ber.dec_int(c, 0, n)
        elif tag == ber.TAG_OID:
            ber.dec_oid(c, 0, n)
        elif tag == ber.TAG_COUNTER64:
            ber.dec_u64(c, 0, n)
        elif tag == ber.TAG_COUNTER32 or tag == ber.TAG_GAUGE32 or tag == ber.TAG_TIMETICKS:
            ber.dec_uint32(c, 0, n)
        return None
    except errors.DecodeError as e:
        return e.reason

def check_value(fx: Findings, seed: str, op: str, data: bytes, v: Value) -> None:
    """Properties 5 and 7 for one decoded value"""
    if isinstance(v, Opaque):
        try:
            values.opaque_special(v)
        except Exception as e:
            fx.fail(seed, op, data, "values.opaque_special raised " + str(e))
    if isinstance(v, MalformedValue):
        fx.malformed += 1
        reason = strict_error(v.raw_tag, v.value)
        if reason is None or reason != v.reason:
            fx.fail(seed, op, data, repr(v) + ": the strict decoder gives " + repr(reason))
    elif isinstance(v, UnknownValue):
        if strict_error(v.raw_tag, v.value) is not None:
            fx.fail(seed, op, data, repr(v) + ": malformed content as an UnknownValue")

def varbinds_of(p: ?Pdu, t: ?TrapV1Pdu) -> list[VarBind]:
    if p is not None:
        return p.varbinds
    if t is not None:
        return t.varbinds
    return []

def encode_v3_again(m: V3Message) -> (bytes, int):
    """Re-encode a decoded SNMPv3 message with its MAC written back; return it and the auth_offset"""
    s = m.scoped
    e = m.encrypted
    payload = message.encode_scoped(s) if s is not None else e if e is not None else b""
    r = message.encode_v3(m, payload)
    mac = m.usm.auth_params
    if m.security_model != message.SEC_MODEL_USM:
        return (r.msg, r.auth_offset)
    return (r.msg[:r.auth_offset] + mac + r.msg[r.auth_offset + len(mac):], r.auth_offset)

def check_peek(fx: Findings, seed: str, op: str, data: bytes, r: ?(version: int, id: int), err: str,
               version: int, ident: int) -> None:
    """Property 3: r and err, what message.peek gave for data, match what decode gave"""
    if r is not None:
        if r.version != version or r.id != ident:
            fx.fail(seed, op, data, "message.peek gives version %d, id %d; decode gives %d, %d"
                    % (r.version, r.id, version, ident))
    else:
        fx.fail(seed, op, data, "message.peek failed on a datagram that decodes: " + err)

def check_community(fx: Findings, seed: str, op: str, data: bytes, m: CommunityMessage) -> None:
    p = m.pdu
    t = m.trap
    if (p is None) == (t is None):
        fx.fail(seed, op, data, "a CommunityMessage must hold exactly one of pdu and trap")
        return
    check_printable(fx, seed, op, data, lambda: repr(m))
    check_values(fx, seed, op, data, varbinds_of(p, t))
    enc, eerr = attempt_encode(lambda: message.encode_community(m))
    bug(fx, seed, op, data, "message.encode_community", eerr)
    if enc is not None:
        check_community_reencoding(fx, seed, op, data, m, enc)

def check_community_reencoding(fx: Findings, seed: str, op: str, data: bytes, m: CommunityMessage, enc: bytes) -> None:
    r, err = attempt(lambda: message.decode(enc), 0, len(enc))
    if r is not None:
        c2, v2 = r
        if c2 is not None:
            if not same_community(m, c2):
                fx.fail(seed, op, data, "re-encoding " + enc.hex() + " decodes to " + repr(c2))
        else:
            fx.fail(seed, op, data, "re-encoding " + enc.hex() + " decodes to an SNMPv3 message")
    else:
        fx.fail(seed, op, data, "re-encoding " + enc.hex() + " does not decode: " + err)

def check_v3(fx: Findings, seed: str, op: str, data: bytes, m: V3Message) -> None:
    s = m.scoped
    e = m.encrypted
    if (s is None) == (e is None):
        fx.fail(seed, op, data, "a V3Message must hold exactly one of scoped and encrypted")
        return
    if ((m.flags & message.FLAG_PRIV) != 0) != (e is not None):
        fx.fail(seed, op, data, "privFlag and encrypted disagree")
    mac = m.usm.auth_params
    a = m.auth_offset
    if m.security_model == message.SEC_MODEL_USM:
        if a < 0 or a + len(mac) > len(data) or data[a:a + len(mac)] != mac:
            fx.fail(seed, op, data, "auth_offset %d does not locate msgAuthenticationParameters " % a + mac.hex())
    elif a != -1:
        fx.fail(seed, op, data, "auth_offset %d without USM" % a)
    check_printable(fx, seed, op, data, lambda: repr(m))
    if s is not None:
        check_values(fx, seed, op, data, s.pdu.varbinds)
    r, eerr = attempt_encode(lambda: encode_v3_again(m))
    bug(fx, seed, op, data, "message.encode_v3", eerr)
    if r is not None:
        check_v3_reencoding(fx, seed, op, data, m, r.0, r.1)

def check_v3_reencoding(fx: Findings, seed: str, op: str, data: bytes, m: V3Message, enc: bytes, aoff: int) -> None:
    r2, err = attempt(lambda: message.decode(enc), 0, len(enc))
    if r2 is not None:
        c2, v2 = r2
        if v2 is not None:
            if not same_v3(m, v2):
                fx.fail(seed, op, data, "re-encoding " + enc.hex() + " decodes to " + repr(v2))
            elif m.security_model == message.SEC_MODEL_USM and v2.auth_offset != aoff:
                fx.fail(seed, op, data, "re-encoding " + enc.hex()
                        + ": encode_v3 auth_offset %d, decode auth_offset %d" % (aoff, v2.auth_offset))
        else:
            fx.fail(seed, op, data, "re-encoding " + enc.hex() + " decodes to a community message")
    else:
        fx.fail(seed, op, data, "re-encoding " + enc.hex() + " does not decode: " + err)

def check_message(fx: Findings, seed: str, op: str, data: bytes) -> None:
    """Check properties 1, 2, 3 and 5 for a datagram"""
    fx.input()
    n = len(data)
    r, err = attempt(lambda: message.decode(data), 0, n)
    pk, perr = attempt(lambda: message.peek(data), 0, n)
    derr = attempt(lambda: ber.dump(data, 0, n), 0, n).1
    bug(fx, seed, op, data, "message.decode", err)
    bug(fx, seed, op, data, "message.peek", perr)
    bug(fx, seed, op, data, "ber.dump", derr)
    if r is not None:
        fx.ok()
        c, v = r
        if c is not None:
            p = c.pdu
            check_peek(fx, seed, op, data, pk, perr, c.version, p.request_id if p is not None else 0)
            check_community(fx, seed, op, data, c)
        elif v is not None:
            check_peek(fx, seed, op, data, pk, perr, message.SNMP_V3, v.msg_id)
            check_v3(fx, seed, op, data, v)
        else:
            fx.fail(seed, op, data, "message.decode returned no message")


class Decoded(object):
    """The result of an offset decoder in one comparable shape

    used is the number of octets consumed from pos, for decode_pdu and
    decode_value (which return the next position); 0 for the others.
    """
    scoped: ?ScopedPdu
    pdu: ?Pdu
    trap: ?TrapV1Pdu
    varbinds: list[VarBind]
    value: ?Value
    used: int

    def __init__(self, scoped: ?ScopedPdu=None, pdu: ?Pdu=None, trap: ?TrapV1Pdu=None,
                 varbinds: list[VarBind]=[], value: ?Value=None, used: int=0):
        self.scoped = scoped
        self.pdu = pdu
        self.trap = trap
        self.varbinds = varbinds
        self.value = value
        self.used = used

    def __repr__(self) -> str:
        return ("Decoded(" + repr(self.scoped) + ", " + repr(self.pdu) + ", " + repr(self.trap) + ", "
                + repr(self.varbinds) + ", " + repr(self.value) + ", used=%d)" % self.used)

def decode_at(target: int, buf: bytes, pos: int, end: int) -> Decoded:
    if target == T_SCOPED:
        return Decoded(scoped=message.decode_scoped(buf, pos, end))
    if target == T_PDU:
        p, t, nxt = pdu.decode_pdu(buf, pos, end)
        return Decoded(pdu=p, trap=t, used=nxt - pos)
    if target == T_VARBINDS:
        return Decoded(varbinds=values.decode_varbinds(buf, pos, end))
    v, nxt = values.decode_value(buf, pos, end)
    return Decoded(value=v, used=nxt - pos)

def encode_decoded(d: Decoded) -> bytes:
    """Re-encode d with the encoder of the decoder that produced it"""
    s = d.scoped
    p = d.pdu
    t = d.trap
    v = d.value
    if s is not None:
        return message.encode_scoped(s)
    if p is not None:
        return pdu.encode_pdu(p)
    if t is not None:
        return pdu.encode_trap_v1(t)
    if v is not None:
        return v.encode()
    return b"".join([values.encode_varbind(vb) for vb in d.varbinds])

def same_decoded(a: Decoded, b: Decoded, with_used: bool) -> bool:
    return (same_opt(a.scoped, b.scoped) and same_opt(a.pdu, b.pdu) and same_opt(a.trap, b.trap)
            and a.varbinds == b.varbinds and same_opt(a.value, b.value) and (not with_used or a.used == b.used))

def decoded_varbinds(d: Decoded) -> list[VarBind]:
    s = d.scoped
    if s is not None:
        return s.pdu.varbinds
    return varbinds_of(d.pdu, d.trap) + d.varbinds

def check_decoded(fx: Findings, target: int, seed: str, op: str, x: bytes, d: Decoded) -> None:
    if d.used < 0 or d.used > len(x):
        fx.fail(seed, op, x, TARGET_NAMES[target] + " returned a next position outside the input")
    check_printable(fx, seed, op, x, lambda: repr(d))
    check_values(fx, seed, op, x, decoded_varbinds(d))
    v = d.value
    if v is not None:
        check_value(fx, seed, op, x, v)
    enc, eerr = attempt_encode(lambda: encode_decoded(d))
    bug(fx, seed, op, x, "re-encoding", eerr)
    if enc is not None:
        d2, err = attempt(lambda: decode_at(target, enc, 0, len(enc)), 0, len(enc))
        if d2 is not None:
            if not same_decoded(d, d2, False):
                fx.fail(seed, op, x, "re-encoding " + enc.hex() + " decodes to " + repr(d2))
        else:
            fx.fail(seed, op, x, "re-encoding " + enc.hex() + " does not decode: " + err)

def check_at(fx: Findings, rng: Rng, target: int, seed: str, op: str, x: bytes) -> None:
    """Check properties 1, 2, 4 and 5 for the input x of an offset decoder"""
    fx.input()
    name = TARGET_NAMES[target]
    n = len(x)
    d, err = attempt(lambda: decode_at(target, x, 0, n), 0, n)
    pre = rng.octets(1 + rng.below(4))
    buf = pre + x + rng.octets(1 + rng.below(4))
    k = len(pre)
    d2, err2 = attempt(lambda: decode_at(target, buf, k, k + n), k, k + n)
    derr = attempt(lambda: ber.dump(x, 0, n), 0, n).1
    bug(fx, seed, op, x, "ber.dump", derr)
    if bug(fx, seed, op, x, name, err) or bug(fx, seed, op, x, name + " embedded in " + buf.hex(), err2):
        return
    if d is not None and d2 is not None:
        if not same_decoded(d, d2, True):
            fx.fail(seed, op, x, name + " embedded at offset %d in " % k + buf.hex() + " gives " + repr(d2)
                    + " instead of " + repr(d))
    elif err != err2:
        fx.fail(seed, op, x, name + " embedded at offset %d in " % k + buf.hex() + " gives " + outcome(err2)
                + " instead of " + outcome(err))
    if d is not None:
        fx.ok()
        check_decoded(fx, target, seed, op, x, d)

def check_input(fx: Findings, rng: Rng, target: int, seed: str, op: str, data: bytes) -> None:
    """Check data with the decoders of target (T_MESSAGE or one of TARGETS)"""
    if target == T_MESSAGE:
        check_message(fx, seed, op, data)
    else:
        check_at(fx, rng, target, seed, op, data)


# Mutations #########################################################################################

def set_octet(d: bytes, i: int, x: int) -> bytes:
    return d[:i] + ber.BYTE_TABLE[x] + d[i + 1:]

def raw_mutation(rng: Rng, d: bytes, s: Seed, other: Seed) -> (bytes, str):
    """Apply one octet-level mutation to d, which was derived from s; lengths are not fixed up

    The TLV positions come from s, so after earlier mutations they may be
    off, which is fine for fuzzing.
    """
    n = len(d)
    op = rng.below(9)
    if n == 0 or op == 0:
        i = rng.below(n + 1)
        ins = rng.steering(1 + rng.below(4))
        return (d[:i] + ins + d[i:], "insert@%d:" % i + ins.hex())
    i = rng.below(n)
    if op == 1:
        bit = rng.below(8)
        return (set_octet(d, i, d[i] ^ (1 << bit)), "flip@%d.%d" % (i, bit))
    if op == 2:
        x = OCTETS[rng.below(len(OCTETS))]
        return (set_octet(d, i, x), "set@%d=%02x" % (i, x))
    if op == 3:
        x = rng.below(256)
        return (set_octet(d, i, x), "set@%d=%02x" % (i, x))
    if op == 4:
        return (d[:i], "cut@%d" % i)
    if op == 5:
        k = 1 + rng.below(4)
        return (d[:i] + d[i + k:], "remove@%d:%d" % (i, k))
    if op == 8 or len(s.nodes) == 0:
        j = rng.below(len(other.data) + 1)
        return (d[:i] + other.data[j:], "splice@%d:%s@%d" % (i, other.name, j))
    nd = s.nodes[rng.below(len(s.nodes))]
    if op == 6:
        # one of the length octets of a TLV of the seed
        lp = nd.pos + 1 + rng.below(nd.start - nd.pos - 1)
        if lp < n:
            delta = LENGTH_DELTAS[rng.below(len(LENGTH_DELTAS))]
            return (set_octet(d, lp, (d[lp] + delta) & 0xff), "length@%d:%d" % (lp, delta))
        return (d[:i], "cut@%d" % i)
    # op == 7: duplicate a TLV of the seed right after itself
    if nd.stop <= n:
        return (d[:nd.stop] + d[nd.pos:nd.stop] + d[nd.stop:], "duplicate@%d-%d" % (nd.pos, nd.stop))
    return (d[:i], "cut@%d" % i)

def tree_mutation(rng: Rng, s: Seed, other: Seed, contents: list[bytes]) -> (bytes, str):
    """Apply one structure-aware mutation to s; the enclosing lengths stay consistent"""
    op = rng.below(13)
    if op >= 9 or len(s.nodes) == 0:
        j = rng.below(len(s.parents))
        par = s.parents[j]
        path = s.parent_paths[j]
        parts = [c.encoded for c in par.children]
        m = len(parts)
        if m == 0 or op == 9:
            k = rng.below(m + 1)
            new = other.nodes[rng.below(len(other.nodes))].encoded if len(other.nodes) > 0 else b"\x05\x00"
            parts.insert(k, new)
            what = "insert-child@%d:%d" % (par.pos, k)
        elif op == 10:
            k = rng.below(m)
            parts.insert(k, parts[k])
            what = "duplicate-child@%d:%d" % (par.pos, k)
        elif op == 11:
            k = rng.below(m)
            del parts[k]
            what = "remove-child@%d:%d" % (par.pos, k)
        else:
            k = rng.below(m)
            k2 = rng.below(m)
            tmp = parts[k]
            parts[k] = parts[k2]
            parts[k2] = tmp
            what = "swap-children@%d:%d,%d" % (par.pos, k, k2)
        return (replace_at(s, path, render(par.tag, b"".join(parts))), what)
    i = rng.below(len(s.nodes))
    nd = s.nodes[i]
    path = s.paths[i]
    tag = nd.tag
    if op == 0:
        c = contents[rng.below(len(contents))]
        return (replace_at(s, path, render(tag, c)), "content@%d:" % nd.pos + c.hex())
    if op == 1:
        c = rng.steering(rng.below(13))
        return (replace_at(s, path, render(tag, c)), "content@%d:" % nd.pos + c.hex())
    if op == 2:
        t = TAGS[rng.below(len(TAGS))]
        return (replace_at(s, path, render(t, nd.body)), "tag@%d=%02x" % (nd.pos, t))
    if op == 3:
        o = other.nodes[rng.below(len(other.nodes))] if len(other.nodes) > 0 else nd
        return (replace_at(s, path, o.encoded), "transplant@%d:%s@%d" % (nd.pos, other.name, o.pos))
    if op == 4:
        t = [ber.TAG_SEQUENCE, ber.TAG_OCTET_STRING, pdu.RESPONSE][rng.below(3)]
        return (replace_at(s, path, render(t, nd.encoded)), "wrap@%d:%02x" % (nd.pos, t))
    if op == 5:
        # a wrong length at this TLV only
        delta = LENGTH_DELTAS[rng.below(len(LENGTH_DELTAS))]
        n = len(nd.body) + delta
        if n < 0:
            n = 0
        bad = ber.BYTE_TABLE[tag] + ber.enc_length(n) + nd.body
        return (replace_at(s, path, bad), "length@%d:%d" % (nd.pos, delta))
    if op == 6:
        k = 1 + rng.below(4)
        if len(nd.body) >= 1 << (8 * k):
            k = 4
        return (replace_at(s, path, render_long(tag, nd.body, k)), "long-length@%d:%d" % (nd.pos, k))
    if op == 7:
        pad = b"\x00" * (1 + rng.below(9)) if rng.below(2) == 0 else b"\xff" * (1 + rng.below(9))
        return (replace_at(s, path, render(tag, pad + nd.body)), "pad@%d:" % nd.pos + pad.hex())
    # op == 8: random octets appended to the content
    extra = rng.steering(1 + rng.below(4))
    return (replace_at(s, path, render(tag, nd.body + extra)), "append@%d:" % nd.pos + extra.hex())

MODE_RAW = 0
MODE_TREE = 1
MODE_MIXED = 2

def mutate(rng: Rng, s: Seed, other: Seed, contents: list[bytes], mode: int) -> (bytes, str):
    """Return a mutant of s and a description of the mutations

    The first mutation is octet-level (MODE_RAW), structure-aware
    (MODE_TREE) or either (MODE_MIXED); each further octet-level mutation
    follows with probability 1/4.
    """
    structural = (mode == MODE_TREE) or (mode == MODE_MIXED and rng.below(2) == 0)
    d, what = tree_mutation(rng, s, other, contents) if structural else raw_mutation(rng, s.data, s, other)
    while rng.below(4) == 0:
        d, w = raw_mutation(rng, d, s, other)
        what += "+" + w
    return (d, what)

def fuzz(fx: Findings, rng: Rng, target: int, seeds: list[Seed], mutants: int, mode: int) -> None:
    """Check the given number of random mutants of seeds with the decoders of target"""
    contents = edge_contents()
    for i in range(mutants):
        s = seeds[rng.below(len(seeds))]
        other = seeds[rng.below(len(seeds))]
        d, what = mutate(rng, s, other, contents, mode)
        check_input(fx, rng, target, s.name, what, d)


# Tests: the harness itself #########################################################################

def _test_rng_xorshift64() -> None:
    # Reference values computed with Python integers:
    # x ^= x << 13 & (2**64-1); x ^= x >> 7; x ^= x << 17 & (2**64-1), from x = 1.
    r = Rng(1)
    want: list[u64] = [1082269761, 1152992998833853505, 11177516664432764457, 17678023832001937445,
                       9659130143999365733]
    testing.assertEqual([r.next() for i in range(5)], want)
    z = Rng(0)
    testing.assertEqual(z.next(), 15860402102123842989, "seed 0 falls back to the golden ratio seed")
    counts = [0] * 7
    for i in range(7000):
        counts[r.below(7)] += 1
    for c in counts:
        testing.assertTrue(c > 850 and c < 1150, "below(7) is roughly uniform: %d" % c)

def _test_seeds_and_corpora() -> None:
    # Guards the embedded hex and the tree code: every seed decodes, re-encodes to itself and
    # is rebuilt from its tree octet for octet; the corpora decode, VALUES_MALFORMED to
    # MalformedValue (except INTEGER 2^48, an Integer).
    for s in message_seeds():
        testing.assertEqual(replace_at(s, [], s.root.encoded), s.data, "tree of " + s.name)
        testing.assertEqual(s.tail, b"", s.name)
        c, v = message.decode(s.data)
        if c is not None:
            testing.assertEqual(message.encode_community(c), s.data, s.name)
        elif v is not None:
            testing.assertEqual(encode_v3_again(v).0, s.data, s.name)
        else:
            testing.error("no message: " + s.name)
    testing.assertEqual(len(MESSAGES), 38)
    testing.assertEqual(len(PLAINTEXTS), 8)
    malformed_names = set([name for name, hx in VALUES_MALFORMED])
    sizes = []
    for target in TARGETS:
        seeds = corpus(target)
        sizes.append(len(seeds))
        for s in seeds:
            d = decode_at(target, s.data, 0, len(s.data))
            # VALUES_OK holds lenient forms, which re-encode differently
            if s.tail == b"" and target != T_VALUE:
                testing.assertEqual(encode_decoded(d), s.data, "re-encoding " + s.name)
            v = d.value
            if s.name in malformed_names and v is not None:
                integer = isinstance(v, values.Integer)
                testing.assertTrue(isinstance(v, MalformedValue) or (integer and s.name == "v1v2c 8 INTEGER 2^48"),
                                   s.name + " decodes to " + repr(v))
    testing.assertEqual(sizes, [13, 29, 17, 80])

def _test_mutations_are_deterministic() -> None:
    seeds = message_seeds()
    contents = edge_contents()
    runs: list[list[str]] = []
    for run in range(2):
        rng = Rng(42)
        runs.append([mutate(rng, seeds[i % len(seeds)], seeds[(i * 7) % len(seeds)], contents, MODE_MIXED).0.hex()
                     for i in range(200)])
    testing.assertEqual(runs[0], runs[1])
    testing.assertTrue(len(set(runs[0])) > 150, "mutants are diverse")


# Tests: exhaustive mutations of the seeds ##########################################################

def _test_truncation_at_every_offset(t: testing.SyncT) -> None:
    t.timeout(60.0)
    fx = Findings("truncation")
    rng = Rng(0x7472756e63617465)
    for s in message_seeds():
        for k in range(len(s.data)):
            check_message(fx, s.name, "cut@%d" % k, s.data[:k])
            check_message(fx, s.name, "drop-first:%d" % (k + 1), s.data[k + 1:])
    for target in TARGETS:
        for s in corpus(target):
            for k in range(len(s.data)):
                check_at(fx, rng, target, s.name, "cut@%d" % k, s.data[:k])
    fx.finish(10000)

def _test_every_octet_interesting_values(t: testing.SyncT) -> None:
    t.timeout(60.0)
    fx = Findings("octets 00/7f/80/ff")
    for s in message_seeds():
        for i in range(len(s.data)):
            for x in INTERESTING:
                if x != s.data[i]:
                    check_message(fx, s.name, "set@%d=%02x" % (i, x), set_octet(s.data, i, x))
    fx.finish(15000)

def _test_every_bit_flipped(t: testing.SyncT) -> None:
    t.timeout(60.0)
    fx = Findings("bit flips")
    for s in message_seeds():
        for i in range(len(s.data)):
            for bit in range(8):
                check_message(fx, s.name, "flip@%d.%d" % (i, bit), set_octet(s.data, i, s.data[i] ^ (1 << bit)))
    fx.finish(30000)

def _test_every_length_field(t: testing.SyncT) -> None:
    # Each length field of each TLV, also inside msgSecurityParameters: changed in place
    # (the enclosing lengths no longer match) and changed with consistent enclosing lengths.
    t.timeout(60.0)
    fx = Findings("length fields")
    for s in message_seeds():
        for i in range(len(s.nodes)):
            nd = s.nodes[i]
            lp = nd.pos + 1
            for delta in LENGTH_DELTAS:
                for p in range(lp, nd.start):
                    d = set_octet(s.data, p, (s.data[p] + delta) & 0xff)
                    check_message(fx, s.name, "length@%d:%d" % (p, delta), d)
                n = len(nd.body) + delta
                if n >= 0:
                    bad = ber.BYTE_TABLE[nd.tag] + ber.enc_length(n) + nd.body
                    check_message(fx, s.name, "length-at@%d:%d" % (nd.pos, delta), replace_at(s, s.paths[i], bad))
            for x in LENGTH_OCTETS:
                if x != s.data[lp]:
                    check_message(fx, s.name, "length@%d=%02x" % (lp, x), set_octet(s.data, lp, x))
    fx.finish(10000)

def _test_structural_edits_at_every_tlv(t: testing.SyncT) -> None:
    # Each TLV duplicated, removed, wrapped, emptied and retagged, with consistent lengths
    t.timeout(60.0)
    fx = Findings("structural edits")
    for s in message_seeds():
        for i in range(len(s.nodes)):
            nd = s.nodes[i]
            path = s.paths[i]
            ppath = path[:len(path) - 1]
            par = node_at(s, ppath)
            k = path[len(path) - 1]
            parts = [c.encoded for c in par.children]
            dup = parts[:k + 1] + parts[k:]
            check_message(fx, s.name, "duplicate@%d" % nd.pos, replace_at(s, ppath, render(par.tag, b"".join(dup))))
            rest = parts[:k] + parts[k + 1:]
            check_message(fx, s.name, "remove@%d" % nd.pos, replace_at(s, ppath, render(par.tag, b"".join(rest))))
            check_message(fx, s.name, "wrap@%d" % nd.pos, replace_at(s, path, render(ber.TAG_SEQUENCE, nd.encoded)))
            check_message(fx, s.name, "empty@%d" % nd.pos, replace_at(s, path, render(nd.tag, b"")))
            for tag in TAGS:
                if tag != nd.tag:
                    check_message(fx, s.name, "tag@%d=%02x" % (nd.pos, tag), replace_at(s, path, render(tag, nd.body)))
    fx.finish(20000)

def lenient_variants(nd: Node) -> list[(str, bytes)]:
    """Encodings of nd that a lenient decoder must read as nd itself

    Every long length form that fits; for INTEGER, unsigned32 and Counter64
    a redundant leading 00 (or ff for negative INTEGERs) up to the octet
    limit of the type; for OIDs an 80 padding octet before the last
    sub-identifier.
    """
    out: list[(str, bytes)] = []
    body = nd.body
    n = len(body)
    for k in range(1, 5):
        if n < 1 << (8 * k):
            out.append(("long-length:%d" % k, render_long(nd.tag, body, k)))
    if nd.nested or n == 0:
        return out
    if nd.tag == ber.TAG_INTEGER and n < 9:
        out.append(("pad-integer", render(nd.tag, (b"\xff" if body[0] >= 0x80 else b"\x00") + body)))
    if nd.tag == ber.TAG_COUNTER64 and n < 9:
        out.append(("pad-counter64", render(nd.tag, b"\x00" * (9 - n) + body)))
    if (nd.tag == ber.TAG_COUNTER32 or nd.tag == ber.TAG_GAUGE32 or nd.tag == ber.TAG_TIMETICKS) and body[0] < 0x80:
        out.append(("pad-unsigned", render(nd.tag, b"\x00\x00\x00\x00\x00" + body)))
    if nd.tag == ber.TAG_OID:
        j = n - 1
        while j > 0 and body[j - 1] >= 0x80:
            j -= 1
        out.append(("pad-subid@%d" % j, render(nd.tag, body[:j] + b"\x80" + body[j:])))
    return out

def check_same_message(fx: Findings, seed: Seed, op: str, d: bytes) -> None:
    """Property 6: d, a lenient encoding of the seed, decodes to the seed's message"""
    r, err = attempt(lambda: message.decode(d), 0, len(d))
    c0, v0 = message.decode(seed.data)
    if r is not None:
        c, v = r
        if c0 is not None and c is not None:
            if not same_community(c0, c):
                fx.fail(seed.name, op, d, "decodes to " + repr(c))
        elif v0 is not None and v is not None:
            if not same_v3(v0, v):
                fx.fail(seed.name, op, d, "decodes to " + repr(v))
        else:
            fx.fail(seed.name, op, d, "decodes to another kind of message")
    else:
        fx.fail(seed.name, op, d, "a lenient form does not decode: " + err)

def _test_lenient_forms_decode_equal(t: testing.SyncT) -> None:
    t.timeout(60.0)
    fx = Findings("lenient forms")
    for s in message_seeds():
        for i in range(len(s.nodes)):
            nd = s.nodes[i]
            for what, variant in lenient_variants(nd):
                op = what + "@%d" % nd.pos
                d = replace_at(s, s.paths[i], variant)
                check_message(fx, s.name, op, d)
                check_same_message(fx, s, op, d)
    fx.finish(2900, False)


