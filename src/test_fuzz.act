"""Mutation fuzzing of the decoders

The seeds are the reference messages, net-snmp captures, decrypted
ScopedPDUs and value TLVs embedded below. Mutations range from bit flips
and truncation to structure-aware edits that keep the enclosing lengths
consistent, so that they reach the checks deep inside a message.

Properties checked for every mutated input:
1. Only DecodeError escapes a decoder, with an offset inside the decoded
   range.
2. A decoded result re-encodes (or raises EncodeError, as encoding is
   stricter than decoding) to octets that decode to an equal result.
3. message.peek agrees with message.decode, and the auth_offset of a
   decoded SNMPv3 message locates its MAC.
4. An offset decoder gives the same result when its input is embedded
   between random octets: it never reads outside [pos, end).
5. Decoded results can be printed, and opaque_special classifies every
   decoded Opaque without raising.
6. Non-minimal lengths and integers decode to the seed's structure.
7. A value decodes to a MalformedValue exactly when its TLV is intact and
   the strict decoder of its type rejects the content.

The generator is seeded, so every run checks the same inputs.
"""

import testing
import ber
import errors
import message
import pdu
import values
from message import CommunityMessage, V3Message, ScopedPdu
from pdu import Pdu, TrapV1Pdu
from values import Value, VarBind, Opaque, UnknownValue, MalformedValue


# Mutation material #################################################################################

# Interesting octet values: the extremes of a signed and an unsigned octet
INTERESTING: list[int] = [0x00, 0x7f, 0x80, 0xff]

# INTERESTING plus tag octets, the length forms around the short/long boundary (81..85) and
# the net-snmp Opaque escape 9f
OCTETS: list[int] = [0x00, 0x7f, 0x80, 0xff, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x1f, 0x30, 0x40, 0x41, 0x43,
                     0x44, 0x46, 0x81, 0x82, 0x83, 0x84, 0x85, 0x9f, 0xa0, 0xa2, 0xa4, 0xa5, 0xa8, 0xfe]

# Universal, application, context-specific (exceptions and PDUs) and high-tag-number form tags
TAGS: list[int] = [0x00, 0x02, 0x04, 0x05, 0x06, 0x1f, 0x30, 0x31, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
                   0x80, 0x81, 0x82, 0x9f, 0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7, 0xa8, 0xa9, 0xbf, 0xff]

# Replacement first length octets: zero, the short form maximum, indefinite, long forms of
# 1, 2 and 4 octets, the unsupported 5-octet form and 0xff
LENGTH_OCTETS: list[int] = [0x00, 0x7f, 0x80, 0x81, 0x82, 0x84, 0x85, 0xff]

LENGTH_DELTAS: list[int] = [-2, -1, 1, 2]

# Pseudo-random numbers #############################################################################

class Rng(object):
    """xorshift64 (Marsaglia 2003, shifts 13, 7, 17) from a fixed seed

    A fixed seed makes every run check the same inputs.
    """
    state: u64

    def __init__(self, seed: u64):
        self.state = seed if seed != 0 else 0x9e3779b97f4a7c15

    def next(self) -> u64:
        """Return the next 64-bit number"""
        x = self.state
        x ^= x << 13
        x ^= x >> 7
        x ^= x << 17
        self.state = x
        return x

    def below(self, n: int) -> int:
        """Return a number in 0..n-1; n must be at least 1"""
        return int(self.next() >> 33) % n

    def octets(self, n: int) -> bytes:
        """Return n random octets"""
        return b"".join([ber.BYTE_TABLE[self.below(256)] for i in range(n)])

    def steering(self, n: int) -> bytes:
        """Return n octets, about half of them from OCTETS"""
        return b"".join([ber.BYTE_TABLE[OCTETS[self.below(len(OCTETS))] if self.below(2) == 0 else self.below(256)]
                         for i in range(n)])


def edge_contents() -> list[bytes]:
    """Contents at the limits of the value decoders (INTEGER, unsigned, Counter64, OID, Opaque)"""
    return [
        b"", b"\x00", b"\x7f", b"\x80", b"\xff",
        # INTEGER: 9-octet forms around the int range, 10 octets, Integer32 limits and beyond
        b"\x00\x7f\xff\xff\xff\xff\xff\xff\xff", b"\x00\x80\x00\x00\x00\x00\x00\x00\x00",
        b"\xff\x80\x00\x00\x00\x00\x00\x00\x00", b"\xff\x7f\xff\xff\xff\xff\xff\xff\xff",
        b"\x00" * 10, b"\x80\x00\x00\x00", b"\x7f\xff\xff\xff", b"\x00\x80\x00\x00\x00", b"\xff\x7f\xff\xff\xff",
        # unsigned32 and Counter64: negative forms, 2^32, 2^64-1, 2^64
        b"\xff\xff\xff\xff\xff", b"\x80\x00\x00\x00\x00", b"\x01\x00\x00\x00\x00",
        b"\x00\x00\x00\x00\x01\x00\x00\x00\x00", b"\x00\xff\xff\xff\xff\xff\xff\xff\xff",
        b"\x01\x00\x00\x00\x00\x00\x00\x00\x00", b"\xff" * 9, b"\x80" + b"\x00" * 8,
        # OID: 128 and 129 arcs, arcs 2^32-1 and 2^32, a truncated and a padded sub-identifier,
        # first sub-identifiers 2^32-1 and 2^35-1
        b"\x2b" + b"\x01" * 126, b"\x2b" + b"\x01" * 127, b"\x2b\x8f\xff\xff\xff\x7f", b"\x2b\x90\x80\x80\x80\x00",
        b"\x2b\x86", b"\x2b" + b"\x80" * 20 + b"\x01", b"\x8f\xff\xff\xff\x7f", b"\xff\xff\xff\xff\x7f",
        # net-snmp Opaque wrappers: float, double extremes (max, subnormal, NaN, -inf), I64 min,
        # U64 max, Counter64, and malformed ones
        b"\x9f\x78\x04\x3f\xc0\x00\x00", b"\x9f\x79\x08\x7f\xef\xff\xff\xff\xff\xff\xff",
        b"\x9f\x79\x08\x00\x00\x00\x00\x00\x00\x00\x01", b"\x9f\x79\x08\x7f\xf8\x00\x00\x00\x00\x00\x00",
        b"\x9f\x79\x08\xff\xf0\x00\x00\x00\x00\x00\x00", b"\x9f\x7a\x08\x80\x00\x00\x00\x00\x00\x00\x00",
        b"\x9f\x7b\x09\x00\xff\xff\xff\xff\xff\xff\xff\xff", b"\x9f\x76\x05\x01\x00\x00\x00\x00",
        b"\x9f\x7a\x00", b"\x9f\x7b\x85\x00\x00\x00\x00\x01\x00", b"\x9f\x7a\x09\x00\x80\x00\x00\x00\x00\x00\x00\x00",
        b"\x9f\x78\x05\x00\x00\x00\x00\x00", b"\x9f\x79", b"\x9f\x7b\x80",
        # a long string (two length octets)
        b"A" * 300,
    ]


