"""Transports: UDP sockets, TCP connections, and an in-memory network for tests

A Transport carries SNMP messages between its owner (a Client) and one
peer; a ServerTransport carries them between its owner (an Agent or a
NotificationReceiver) and any number of peers. Both are classes of procs
that wrap an actor doing the work, so anything that provides the procs is
a transport. A test can wrap one to record or rewrite traffic by building
a new Transport from its own procs and those of the wrapped one.

udp_transport() is a connected socket to one agent and
udp_server_transport() a listening socket; each datagram is one message.
tcp_transport() and tcp_server_transport() carry messages over TCP
connections (RFC 3430): the messages follow each other on the stream and
the receiving side splits it again by their BER length (StreamFramer).
MemNet (with MemNet.client(), MemNet.server() and mem_pair()) is a
deterministic in-process datagram network with packet-level fault
injection (NetFaults), for testing retries, late and duplicate replies,
reordering, corruption and spoofing without sockets.
dispatcher.Dispatcher.attach() gives many Clients one shared
ServerTransport.

All implementations follow the same contract. A transport never waits for
its owner, and calls back asynchronously in the order in which messages
and errors arrived. Up to MAX_BUFFERED messages that arrive before a
receiver is registered are kept and handed over in order. close() is
idempotent; afterwards nothing is delivered and sending does nothing.
Errors go to the error callback, never raised, and say whether they are
fatal. Source addresses are text as the network reports them, with an
IPv4-mapped IPv6 address given as plain IPv4 (see normalize_address()).
tcp_transport() gives the address and port it connects to;
tcp_server_transport() gives src_address "" and the session number as
src_port.
"""

import logging
import net
import time
import ber

# Messages kept for a receiver that is not registered yet; more are dropped
MAX_BUFFERED = 64

# Messages udp_transport() and tcp_transport() queue while their socket
# connects; more are dropped with a non-fatal error
MAX_QUEUED = 256

# The smallest max_msg_size of the TCP transports: RFC 3430 section 2.2
# requires every engine to accept messages of at least 8192 octets over TCP
MIN_TCP_MESSAGE = 8192

# Longest wait, in seconds, of tcp_transport() after connections that could
# not be set up before it opens another (see tcp_transport())
MAX_TCP_HOLDOFF = 60.0

# Largest datagram MemNet carries: the IPv4 UDP maximum, as in net-snmp
MAX_DATAGRAM = 65507

# Seconds MemNet holds a datagram back for NetFaults.reorder when no
# later datagram overtakes it
REORDER_HOLD = 0.05

# The error a connected UDP socket reports for ICMP port unreachable; MemNet
# reports the same text to a client that sends to an address nobody is bound to
REFUSED = "UDP receive error: connection refused"

# Prefix of the non-fatal error a shared-socket transport reports when it did not send a request
# because another Client of the same peer has its id pending; the id follows in decimal (id_in_use()).
ID_IN_USE = "request id in use by another client of the peer, not sent: "

# MemNet's ephemeral ports, as in the IANA dynamic range
_EPHEMERAL_FIRST = 49152
_EPHEMERAL_COUNT = 16384

# Connect timeout given to net.TCPConnection, in seconds: longer than Linux retries an
# unanswered SYN (about 127 s), so that every connect ends with a connection or an error.
# tcp_transport() runs its own connect_timeout and closes a connection that comes up after it.
_NET_CONNECT_TIMEOUT = 135.0

# StreamFramer joins a buffered chunk shorter than this many octets with the part before it (see
# StreamFramer._append())
_FRAMER_JOIN = 4096


def normalize_address(address: str) -> str:
    """Return address without an IPv4-mapped IPv6 prefix

    "::ffff:192.0.2.1" (in any letter case) gives "192.0.2.1". Any other text
    is returned unchanged.
    """
    if len(address) > 7 and address[:7].lower() == "::ffff:":
        v4 = address[7:]
        if net.is_ipv4(v4):
            return v4
    return address

def _hex_group(t: str) -> int:
    # The value of 1 to 4 hex digits, -1 for anything else
    if len(t) < 1 or len(t) > 4:
        return -1
    v = 0
    for c in t:
        d = "0123456789abcdef".find(c.lower())
        if d < 0:
            return -1
        v = v * 16 + d
    return v

def _ipv4_octets(text: str) -> ?bytes:
    # Dotted decimal, four parts of 1 to 3 digits, each at most 255
    parts = text.split(".")
    if len(parts) != 4:
        return None
    out: list[int] = []
    for p in parts:
        if len(p) < 1 or len(p) > 3 or not (p.isascii() and p.isdecimal()):
            return None
        v = int(p)
        if v > 255:
            return None
        out.append(v)
    return bytes(out)

def _ipv6_groups(text: str, last: bool) -> ?list[int]:
    # The 16-bit groups of a colon-separated run; an IPv4 tail (last run only) gives two groups
    out: list[int] = []
    parts = text.split(":")
    for i in range(len(parts)):
        p = parts[i]
        if last and i == len(parts) - 1 and "." in p:
            v4 = _ipv4_octets(p)
            if v4 is not None:
                out.append(v4[0] * 256 + v4[1])
                out.append(v4[2] * 256 + v4[3])
            else:
                return None
        else:
            v = _hex_group(p)
            if v < 0:
                return None
            out.append(v)
    return out

def _ipv6_octets(text: str) -> ?bytes:
    # RFC 4291 section 2.2 text: eight groups, "::" for a run of zero groups, an IPv4 tail; a zone
    # ("%eth0") is ignored
    zone = text.find("%")
    t = text[:zone] if zone >= 0 else text
    halves = t.split("::")
    if len(halves) > 2:
        return None
    head: list[int] = []
    tail: list[int] = []
    if halves[0] != "":
        h = _ipv6_groups(halves[0], len(halves) == 1)
        if h is not None:
            head = h
        else:
            return None
    if len(halves) == 2:
        if halves[1] != "":
            tl = _ipv6_groups(halves[1], True)
            if tl is not None:
                tail = tl
            else:
                return None
        if len(head) + len(tail) > 7:
            return None
        head = head + [0 for _ in range(8 - len(head) - len(tail))] + tail
    elif len(head) != 8:
        return None
    out: list[int] = []
    for g in head:
        out.append(g >> 8)
        out.append(g & 0xff)
    return bytes(out)

def ip_octets(address: str) -> ?bytes:
    """Return the octets of an IP address in text form, None if it is not one

    IPv4 dotted decimal gives 4 octets and IPv6 (RFC 4291 section 2.2, in
    any letter case, with or without "::" and an embedded IPv4 tail) 16; an
    IPv4-mapped IPv6 address (::ffff:192.0.2.1, ::ffff:c000:201) gives the
    4 octets of its IPv4 address, and an IPv6 zone ("%eth0") is ignored.
    Compare these rather than the texts: the network reports sources in
    its own form, which need not be how the user wrote the address.
    """
    if ":" not in address:
        return _ipv4_octets(address)
    v6 = _ipv6_octets(address)
    if v6 is not None:
        if v6[:12] == b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff":
            return v6[12:]
        return v6
    return None

def id_in_use(error: str) -> int:
    """Return the id of an ID_IN_USE error, -1 for any other error"""
    if error.startswith(ID_IN_USE):
        digits = error[len(ID_IN_USE):]
        if len(digits) > 0 and len(digits) <= 10 and digits.isascii() and digits.isdecimal():
            return int(digits)
    return -1

def is_unreachable(error: str) -> bool:
    """Return True if a transport error reports an unreachable peer port

    A connected UDP socket reports ICMP port unreachable as "connection
    refused" (REFUSED); MemNet does the same when nothing is bound to the
    destination. The error is not fatal: the transport stays usable. A
    refused TCP connection ("TCP connection to ... failed: connection
    refused") is not this hint: tcp_transport() reports it as a failed
    connection.
    """
    return "connection refused" in error and not error.startswith("TCP ")

def _peer_text(address: str, port: int) -> str:
    # address:port, with an IPv6 address in brackets
    if ":" in address:
        return "[" + address + "]:" + str(port)
    return address + ":" + str(port)

def _now() -> float:
    # Monotonic time in seconds
    return float(time.monotonic_ns()) / 1000000000.0

def _tidy(error: str) -> str:
    # net.UDPConnection joins the A and AAAA lookup errors with two spaces,
    # usually repeating the same text; keep each distinct part once
    parts: list[str] = []
    for part in error.split("  "):
        if part != "" and part not in parts:
            parts.append(part)
    return "; ".join(parts)


class Transport(object):
    """Messages to and from one peer: the manager side

    send(data) sends one message to the peer. It never blocks and never
    raises; problems are reported to the error callback.

    set_receiver(on_data, on_error) registers the callbacks, replacing any
    earlier ones:

    - on_data(data, src_address, src_port) for every message. The source is
      not guaranteed to be the peer: a UDP socket only accepts the peer (the
      kernel filters), but MemNet delivers everything addressed to the
      transport, so that the owner's own source checks can be tested.
    - on_error(message, fatal) for every error. fatal False is a hint and
      the transport stays usable: ICMP port unreachable (see
      is_unreachable()), a message that could not be sent, a full send
      queue, a TCP connection that failed or closed. fatal True means the
      transport cannot send because setting it up failed (name resolution,
      socket, port); every later send(), and every later set_receiver(),
      reports the same error again at once.

    close() releases the socket. It is idempotent; afterwards nothing is
    delivered and send() does nothing.

    source_checked is True for a transport that delivers only messages it
    has accepted as the peer's (dispatcher.Dispatcher, which routes by
    source and, with strict_source=False, by request id; tcp_transport(),
    whose connection carries only the peer's messages); the Client then
    does not compare sources itself. False (the default) for a transport
    that delivers whatever arrives (MemNet), so the Client checks.

    send_request(data, hold), optional (None for most transports), sends a
    request whose answer the sender may wait for up to hold seconds. A
    shared-socket transport (dispatcher.Dispatcher) provides it: it keeps
    the request's id reserved and routable at least that long. The Client
    uses it instead of send() when it is there.
    """
    @property
    send: proc(bytes) -> None
    @property
    set_receiver: proc(action(bytes, str, int) -> None, action(str, bool) -> None) -> None
    @property
    close: proc() -> None
    source_checked: bool
    @property
    send_request: ?proc(bytes, float) -> None

    def __init__(self,
                 send: proc(bytes) -> None,
                 set_receiver: proc(action(bytes, str, int) -> None, action(str, bool) -> None) -> None,
                 close: proc() -> None,
                 source_checked: bool=False,
                 send_request: ?proc(bytes, float) -> None=None):
        self.send = send
        self.set_receiver = set_receiver
        self.close = close
        self.source_checked = source_checked
        self.send_request = send_request


class ServerTransport(object):
    """Messages to and from any number of peers: the agent side

    send_to(data, address, port) sends one message. address must be an IP
    address (no name resolution); reply to the src_address and src_port the
    message came with. tcp_server_transport() gives a session number
    instead of a source (src_address "", src_port the session) and answers
    on that session; it drops a message for any other address. There is no
    error callback: udp_server_transport()
    and tcp_server_transport() log send failures.

    set_receiver(on_data) registers the callback, replacing any earlier one;
    on_data(data, src_address, src_port) is called for every message.

    close() releases the socket. It is idempotent; afterwards nothing is
    delivered and send_to() does nothing.

    local_port() is the port the transport is bound to (useful after binding
    port 0), or 0 when binding failed.
    """
    @property
    send_to: proc(bytes, str, int) -> None
    @property
    set_receiver: proc(action(bytes, str, int) -> None) -> None
    @property
    close: proc() -> None
    @property
    local_port: proc() -> int

    def __init__(self,
                 send_to: proc(bytes, str, int) -> None,
                 set_receiver: proc(action(bytes, str, int) -> None) -> None,
                 close: proc() -> None,
                 local_port: proc() -> int):
        self.send_to = send_to
        self.set_receiver = set_receiver
        self.close = close
        self.local_port = local_port


class _Inbox(object):
    # The data callback of an endpoint, and the messages that arrived
    # before one was registered. Owned by one endpoint actor.
    @property
    on_data: ?action(bytes, str, int) -> None
    early: list[(bytes, str, int)]

    def __init__(self):
        self.on_data = None
        self.early = []

    proc def put(self, data: bytes, src_address: str, src_port: int) -> None:
        on_data = self.on_data
        if on_data is not None:
            on_data(data, src_address, src_port)
        elif len(self.early) < MAX_BUFFERED:
            self.early.append((data, src_address, src_port))

    proc def register(self, on_data: action(bytes, str, int) -> None) -> None:
        self.on_data = on_data
        for d in self.early:
            on_data(d.0, d.1, d.2)
        self.early = []

    mut def clear(self) -> None:
        self.on_data = None
        self.early = []


# UDP ##############################################################################################

def udp_transport(cap: net.UDPConnectCap, address: str, port: int) -> Transport:
    """Return a Transport over a UDP socket connected to address and port

    address is an IP address or a host name. For a name, net.UDPConnection
    uses whichever of the A and AAAA answers arrives first, so prefer IP
    addresses. Datagrams sent before the socket is connected are queued (at
    most MAX_QUEUED) and sent once it is. A setup failure (name resolution,
    socket, a port outside 1..65535) is a fatal error. The kernel drops
    datagrams from any source other than address and port; ICMP port
    unreachable arrives as a non-fatal error.
    """
    ep = _UdpClient(cap, address, port)
    def _send(data: bytes) -> None:
        ep.send(data)
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        ep.set_receiver(on_data, on_error)
    def _close() -> None:
        ep.close()
    return Transport(_send, _set_receiver, _close)


actor _UdpClient(cap: net.UDPConnectCap, address: str, port: int):
    # The actor behind udp_transport()
    var _conn: ?net.UDPConnection = None
    var _connected = False
    var _failure: ?str = None
    var _closed = False
    var _queue: list[bytes] = []
    var _on_error: ?action(str, bool) -> None = None
    var _inbox = _Inbox()

    proc def _report(message: str, fatal: bool) -> None:
        on_error = _on_error
        if on_error is not None:
            on_error(message, fatal)

    proc def _fail(error: str) -> None:
        message = "UDP setup for " + _peer_text(address, port) + " failed: " + error
        _failure = message
        _queue = []
        _report(message, True)

    def send(data: bytes) -> None:
        if _closed:
            return
        failure = _failure
        if failure is not None:
            _report(failure, True)
            return
        conn = _conn
        if conn is not None:
            if _connected:
                conn.write(data)
                return
        if len(_queue) < MAX_QUEUED:
            _queue.append(data)
        else:
            _report("UDP send queue for " + _peer_text(address, port) + " is full; datagram dropped", False)

    def set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        if _closed:
            return
        _on_error = on_error
        failure = _failure
        if failure is not None:
            on_error(failure, True)
        _inbox.register(on_data)

    def close() -> None:
        if _closed:
            return
        _closed = True
        _queue = []
        _on_error = None
        _inbox.clear()
        conn = _conn
        if conn is not None:
            conn.close()

    def _on_connect(c: net.UDPConnection) -> None:
        if _closed:
            c.close()
            return
        _connected = True
        for data in _queue:
            c.write(data)
        _queue = []

    def _on_receive(c: net.UDPConnection, data: bytes, src_address: str, src_port: int) -> None:
        if not _closed:
            _inbox.put(data, normalize_address(src_address), src_port)

    def _on_net_error(c: net.UDPConnection, error: str) -> None:
        if _closed:
            return
        if _connected:
            _report(error, False)
        else:
            c.close()
            _fail(_tidy(error))

    if port > 0 and port <= 65535:
        _conn = net.UDPConnection(cap, address, port, _on_connect, _on_receive, _on_net_error)
    else:
        _fail("port %d is outside 1..65535" % port)


def udp_server_transport(cap: net.UDPListenCap, address: str, port: int,
                         on_ready: action(ServerTransport, ?str) -> None,
                         log_handler: ?logging.Handler=None) -> None:
    """Listen for UDP datagrams on address and port, then call on_ready once

    port 0 picks an ephemeral port; the transport's local_port() tells which.
    on_ready(transport, None) means the transport is listening;
    on_ready(transport, error) means it could not (address in use, invalid
    address or port), and that transport's local_port() is 0 and it ignores
    sends. A socket bound to "::" also receives IPv4 datagrams (unless the
    host disables that); their sources are given as plain IPv4, and replies
    to plain IPv4 addresses work. Errors after listening (a datagram that
    could not be sent, an address that is not an IP address) are logged to
    log_handler as warnings.
    """
    _UdpServer(cap, address, port, on_ready, log_handler)


def _udp_server_transport(ep: _UdpServer, local_port: int) -> ServerTransport:
    # The transports' procs are closures built at module level, which call
    # the actor asynchronously in the caller's context.
    def _send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        ep.send_to(data, dst_address, dst_port)
    def _set_receiver(on_data: action(bytes, str, int) -> None) -> None:
        ep.set_receiver(on_data)
    def _close() -> None:
        ep.close()
    return ServerTransport(_send_to, _set_receiver, _close, lambda: local_port)


actor _UdpServer(cap: net.UDPListenCap, address: str, port: int,
                 on_ready: action(ServerTransport, ?str) -> None,
                 log_handler: ?logging.Handler):
    # The actor behind udp_server_transport()
    _log = logging.Logger(log_handler)
    var _listener: ?net.UDPListener = None
    var _closed = False
    var _inbox = _Inbox()

    def send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        listener = _listener
        if listener is not None:
            if _closed:
                return
            if dst_port > 0 and dst_port <= 65535:
                listener.send(data, dst_address, dst_port)
            else:
                _log.warning("UDP datagram for an invalid port dropped", {"address": dst_address, "port": dst_port})

    def set_receiver(on_data: action(bytes, str, int) -> None) -> None:
        if not _closed:
            _inbox.register(on_data)

    def close() -> None:
        if _closed:
            return
        _closed = True
        _inbox.clear()
        listener = _listener
        if listener is not None:
            listener.close()

    proc def _ready(local_port: int, error: ?str) -> None:
        on_ready(_udp_server_transport(self, local_port), error)

    def _on_listen(l: net.UDPListener, error: ?str) -> None:
        if error is not None:
            _listener = None
            l.close()
            _ready(0, "UDP listen on " + _peer_text(address, port) + " failed: " + error)
            return
        _ready(l.local_port(), None)

    def _on_receive(l: net.UDPListener, data: bytes, src_address: str, src_port: int) -> None:
        if not _closed:
            _inbox.put(data, normalize_address(src_address), src_port)

    def _on_net_error(l: net.UDPListener, error: str) -> None:
        if not _closed:
            _log.warning("UDP error", {"local": _peer_text(address, port), "error": error})

    if port >= 0 and port <= 65535:
        _listener = net.UDPListener(cap, address, port, _on_listen, _on_receive, _on_net_error)
    else:
        _ready(0, "UDP listen on " + _peer_text(address, port) + " failed: port outside 0..65535")


# Stream framing ###################################################################################

def message_length(header: bytes) -> int:
    """Return the total length of the SNMP message that header starts

    header is the start of the message as far as it has arrived. The result
    counts the tag, the length octets and the contents; 0 means header is
    too short to tell, -1 that it cannot start a message. SNMP sends the
    outer SEQUENCE (tag 0x30) with a definite length; the long form may use
    more length octets than needed (RFC 3417 section 8). The short form and
    the long form with 1 to 4 length octets are accepted; the indefinite
    length 0x80 is not. At most 6 octets of header are read.
    """
    if len(header) == 0:
        return 0
    if header[0] != 0x30:
        return -1
    if len(header) < 2:
        return 0
    first = header[1]
    if first < 0x80:
        return 2 + first
    count = first & 0x7f
    if count == 0 or count > 4:
        return -1
    if len(header) < 2 + count:
        return 0
    n = 0
    for i in range(count):
        n = n * 256 + header[2 + i]
    return 2 + count + n

def _framing_problem(header: bytes) -> str:
    # Why message_length(header) is -1
    if header[0] != 0x30:
        return "tag 0x%02x where a SEQUENCE (0x30) must start" % header[0]
    if header[1] == 0x80:
        return "indefinite length"
    return "%d length octets, at most 4 allowed" % (header[1] & 0x7f)


class StreamFramer(object):
    """Splits a byte stream into SNMP messages by their BER length (RFC 3430 section 2.1)

    feed(data) takes the octets that arrived next, in chunks of any size,
    and returns the messages they complete, in order; the rest is kept for
    the next feed(). Over TCP the messages follow each other without
    anything in between, so the outer SEQUENCE of each (message_length())
    tells where the next one starts.

    A header that cannot start a message (message_length() -1) or a
    message longer than max_msg_size octets loses framing: there is no way
    to find the next message, so the owner closes the connection (RFC 3430
    section 2.1). lost then says why (it is "" while framing holds), the
    messages completed before that point are still returned, and every
    later feed() returns nothing. The length is checked as soon as the
    header is there, so an oversize message is never buffered.
    """
    max_msg_size: int
    lost: str
    _parts: list[bytes]
    _offset: int
    _buffered: int
    _need: int

    def __init__(self, max_msg_size: int):
        self.max_msg_size = max_msg_size
        self.lost = ""
        # The octets not delivered yet: the chunks as they arrived, short ones
        # joined (_append()), the first of them from _offset on; _buffered
        # octets in all. _need is the total length of the message they start,
        # 0 while its header is incomplete.
        self._parts = []
        self._offset = 0
        self._buffered = 0
        self._need = 0

    def feed(self, data: bytes) -> list[bytes]:
        """Take the next octets of the stream; return the messages they complete"""
        out: list[bytes] = []
        if self.lost != "" or len(data) == 0:
            return out
        self._append(data)
        self._buffered += len(data)
        while self._buffered > 0:
            need = self._need
            if need == 0:
                header = self._peek(6)
                need = message_length(header)
                if need < 0:
                    self._lose(_framing_problem(header))
                    return out
                if need == 0:
                    return out
                if need > self.max_msg_size:
                    self._lose("message of %d octets, longer than the limit of %d" % (need, self.max_msg_size))
                    return out
                self._need = need
            if self._buffered < need:
                return out
            out.append(self._take(need))
            self._need = 0
        return out

    def _append(self, data: bytes) -> None:
        # Keep data after the buffered octets. A chunk shorter than _FRAMER_JOIN is joined with the
        # part before it while that part is no longer, so the short parts after the last long one
        # shrink from first to last. A message that trickles in a few octets at a time is then held
        # in about one part per _FRAMER_JOIN octets, each octet copied about log2(_FRAMER_JOIN)
        # times, rather than in one part per chunk.
        self._parts.append(data)
        n = len(self._parts)
        while n >= 2:
            last = self._parts[n - 1]
            before = self._parts[n - 2]
            start = self._offset if n == 2 else 0
            if len(last) >= _FRAMER_JOIN or len(before) - start > len(last):
                return
            self._parts[n - 2] = before[start:] + last
            del self._parts[n - 1]
            if n == 2:
                self._offset = 0
            n -= 1

    def _peek(self, n: int) -> bytes:
        # The first n buffered octets, fewer if fewer are there
        pieces: list[bytes] = []
        got = 0
        offset = self._offset
        for p in self._parts:
            piece = p[offset:offset + n - got]
            pieces.append(piece)
            got += len(piece)
            offset = 0
            if got >= n:
                break
        return b"".join(pieces)

    def _take(self, n: int) -> bytes:
        # Remove the first n buffered octets (n <= _buffered) and return them
        pieces: list[bytes] = []
        rest = n
        used = 0
        offset = self._offset
        while rest > 0:
            p = self._parts[used]
            available = len(p) - offset
            if available <= rest:
                pieces.append(p[offset:] if offset > 0 else p)
                rest -= available
                used += 1
                offset = 0
            else:
                pieces.append(p[offset:offset + rest])
                offset += rest
                rest = 0
        if used > 0:
            self._parts = self._parts[used:]
        self._offset = offset
        self._buffered -= n
        if len(pieces) == 1:
            return pieces[0]
        return b"".join(pieces)

    def _lose(self, reason: str) -> None:
        self.lost = reason
        self._parts = []
        self._offset = 0
        self._buffered = 0
        self._need = 0


def _check_tcp_options(max_msg_size: int, idle_timeout: float) -> None:
    # The checks that tcp_transport() and tcp_server_transport() share
    if max_msg_size < MIN_TCP_MESSAGE:
        raise ValueError("max_msg_size must be at least %d octets (RFC 3430), got %d"
                         % (MIN_TCP_MESSAGE, max_msg_size))
    if not (idle_timeout >= 0.0):
        raise ValueError("idle_timeout must be 0 (never) or a number of seconds")

def _net_reason(error: str) -> str:
    # The reason in an error of net.TCPConnection without its prefixes: "Error in TCP connect over
    # IPv4: connection refused" gives "connection refused", "Failed to write to TCP socket: broken
    # pipe" gives "broken pipe". Errors joined with two spaces keep each distinct reason once.
    reasons: list[str] = []
    for part in error.split("  "):
        i = part.rfind(": ")
        reason = part[i + 2:] if i >= 0 else part
        if reason != "" and reason not in reasons:
            reasons.append(reason)
    return "; ".join(reasons)


# TCP ##############################################################################################

def tcp_transport(cap: net.TCPConnectCap, address: str, port: int, connect_timeout: float=5.0,
                  idle_timeout: float=60.0, stall_timeout: float=2.0, max_msg_size: int=1048576,
                  on_connect: ?action() -> None=None) -> Transport:
    """Return a Transport over TCP connections to address and port (RFC 3430)

    The transport keeps one connection at a time. It opens it for the first
    send() and again for the first send() after the connection was lost;
    messages sent while it connects are queued (at most MAX_QUEUED) and
    sent once it is up. Each message is written in one piece, so messages
    never interleave on the stream; the messages that arrive are split by
    their BER length (StreamFramer) and delivered with the address and port
    given to tcp_transport() as their source. on_connect, if given, is
    called each time a connection has come up and the messages queued for
    it have been written. A connection carries only its peer's messages,
    so source_checked is True.

    address is an IPv4 or IPv6 address: look a host name up first (with
    net.lookup_a() or net.lookup_aaaa()). A host name, like a port outside
    1..65535, is a fatal error.

    A connection that cannot be set up (refused, unreachable, nothing
    within connect_timeout seconds) is reported as a non-fatal error, such
    as "TCP connection to 127.0.0.1:16161 failed: connection refused", and
    the messages queued for it are dropped. RFC 3430 section 2.3 makes such a
    connection a timeout of the request, and that is what the Client sees:
    the error is the hint of its TimeoutError. The socket of a connection
    that did not come up stays open until the process exits, so the
    transport does not try again at once: for connect_timeout seconds
    after the failure, doubled with each further failure in a row up to
    MAX_TCP_HOLDOFF, send() drops the message and reports the failure
    again.

    A connection that is up is lost on a write error ("TCP connection to
    ... lost: broken pipe"), a close by the peer ("... closed by the
    peer") or an arriving message that loses framing (a header that is not
    a definite-length SEQUENCE, a message longer than max_msg_size octets).
    Each is reported as a non-fatal error, and the next send() opens a new
    connection.

    A connection reset by the peer is not reported. The transport therefore
    drops a connection when a message is to be sent while the messages sent
    before it have had nothing back for stall_timeout seconds, counted from
    the first send after the last message that arrived. It reports a
    non-fatal error that says so and sends the message on a new connection.
    Answers flowing back keep a busy connection alive; 0 turns the rule off.
    A retry sent within stall_timeout of the first attempt stays on the
    connection, so an answer later than the Client's timeout still counts,
    as over UDP; a later retry goes out on a new connection. Twice the
    Client's timeout gives both. A sender of traps alone gets no answers and
    opens a new connection for each trap sent more than stall_timeout after
    the one before.

    The Client resends a request after its timeout whether the connection
    is up or not, and each try has a request-id of its own. Tries sent
    while a connection comes up are queued and written together once it is
    up, so a connection that comes up late (after a lost SYN) delivers
    every try queued for it, and the agent carries out each of them, a SET
    included. A connect_timeout below the Client's timeout queues at most
    one try of a request for each connection.

    A connection without traffic for idle_timeout seconds is closed (0:
    never); either side may close a connection at any time (RFC 3430
    section 2.3). close() closes the connection; it is idempotent.

    Raises ValueError for a connect_timeout that is not positive, a
    negative idle_timeout or stall_timeout, or a max_msg_size below
    MIN_TCP_MESSAGE.
    """
    if not (connect_timeout > 0.0):
        raise ValueError("connect_timeout must be positive")
    if not (stall_timeout >= 0.0):
        raise ValueError("stall_timeout must be 0 (off) or a number of seconds")
    _check_tcp_options(max_msg_size, idle_timeout)
    ep = _TcpClient(cap, address, port, connect_timeout, idle_timeout, stall_timeout, max_msg_size, on_connect)
    def _send(data: bytes) -> None:
        ep.send(data)
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        ep.set_receiver(on_data, on_error)
    def _close() -> None:
        ep.close()
    return Transport(_send, _set_receiver, _close, source_checked=True)


actor _TcpClient(cap: net.TCPConnectCap, address: str, port: int, connect_timeout: float, idle_timeout: float,
                 stall_timeout: float, max_msg_size: int, on_connect: ?action() -> None):
    # The actor behind tcp_transport(). _gen numbers the connections: the callbacks and timers of a
    # connection carry its number, and those of a connection that was dropped do nothing.
    _peer = _peer_text(address, port)
    var _conn: ?net.TCPConnection = None
    var _gen = 0
    var _connected = False
    var _failure: ?str = None
    var _closed = False
    var _queue: list[bytes] = []
    var _framer = StreamFramer(max_msg_size)
    # When the first message after the last one that arrived was sent; -1.0: none since
    var _unanswered_since = -1.0
    var _last_traffic = 0.0
    # The error of the last connection that could not be set up, the time before which no new one
    # is opened, and how long to wait after the next one that cannot be set up
    var _connect_error = ""
    var _hold_until = 0.0
    var _holdoff = connect_timeout
    var _on_error: ?action(str, bool) -> None = None
    var _inbox = _Inbox()

    proc def _report(message: str, fatal: bool) -> None:
        on_error = _on_error
        if on_error is not None:
            on_error(message, fatal)

    def _released(c: net.TCPConnection) -> None:
        # The close() callback: nothing is left to do
        pass

    proc def _drop() -> None:
        # Close the connection, if any, and forget it and its queue
        _gen += 1
        conn = _conn
        _conn = None
        _connected = False
        _queue = []
        _framer = StreamFramer(max_msg_size)
        _unanswered_since = -1.0
        if conn is not None:
            conn.close(_released)

    proc def _lost(what: str) -> None:
        _drop()
        _report("TCP connection to " + _peer + " " + what, False)

    proc def _not_set_up(reason: str) -> None:
        # The connection did not come up: no new one before the hold-off has passed
        message = "TCP connection to " + _peer + " failed: " + reason
        longest = MAX_TCP_HOLDOFF if MAX_TCP_HOLDOFF > connect_timeout else connect_timeout
        _connect_error = message
        _hold_until = _now() + _holdoff
        _holdoff = 2.0 * _holdoff if 2.0 * _holdoff < longest else longest
        _drop()
        _report(message, False)

    def _on_connect(gen: int, c: net.TCPConnection) -> None:
        if gen != _gen or _closed:
            # Dropped while it connected: close() does not stop a connect in progress
            c.close(_released)
            return
        _connected = True
        _holdoff = connect_timeout
        now = _now()
        _last_traffic = now
        if len(_queue) > 0:
            _unanswered_since = now
            for data in _queue:
                c.write(data)
            _queue = []
        report = on_connect
        if report is not None:
            report()
        if idle_timeout > 0.0:
            after now idle_timeout: _idle_check(gen)

    def _on_receive(gen: int, data: bytes) -> None:
        if gen != _gen or _closed:
            return
        _last_traffic = _now()
        messages = _framer.feed(data)
        if len(messages) > 0:
            _unanswered_since = -1.0
        for m in messages:
            _inbox.put(m, address, port)
        lost = _framer.lost
        if lost != "":
            _lost("closed: lost framing (" + lost + ")")

    def _on_net_error(gen: int, error: str) -> None:
        if gen == _gen and not _closed:
            if _connected:
                _lost("lost: " + _net_reason(error))
            else:
                _not_set_up(_net_reason(error))

    def _on_remote_close(gen: int) -> None:
        if gen == _gen and not _closed:
            _lost("closed by the peer")

    def _connect_expired(gen: int) -> None:
        if gen == _gen and not _connected and not _closed:
            _not_set_up("no connection within %g s" % connect_timeout)

    def _idle_check(gen: int) -> None:
        if gen != _gen or not _connected or _closed:
            return
        idle = _now() - _last_traffic
        if idle >= idle_timeout:
            _drop()
        else:
            wait = idle_timeout - idle
            after now wait: _idle_check(gen)

    proc def _open() -> None:
        _gen += 1
        gen = _gen
        _connected = False
        def connected(c: net.TCPConnection) -> None:
            _on_connect(gen, c)
        def on_receive(c: net.TCPConnection, data: bytes) -> None:
            _on_receive(gen, data)
        def on_error(c: net.TCPConnection, error: str) -> None:
            _on_net_error(gen, error)
        def on_remote_close(c: net.TCPConnection) -> None:
            _on_remote_close(gen)
        net_timeout = connect_timeout if connect_timeout > _NET_CONNECT_TIMEOUT else _NET_CONNECT_TIMEOUT
        _conn = net.TCPConnection(cap, address, port, connected, on_receive, on_error, on_remote_close,
                                  connect_timeout=net_timeout)
        after now connect_timeout: _connect_expired(gen)

    def send(data: bytes) -> None:
        if _closed:
            return
        failure = _failure
        if failure is not None:
            _report(failure, True)
            return
        conn = _conn
        if conn is not None:
            if _connected:
                now = _now()
                since = _unanswered_since
                if stall_timeout > 0.0 and since >= 0.0 and now - since >= stall_timeout:
                    _lost("presumed dead: nothing received for %.1f s after sending; reconnecting" % (now - since))
                else:
                    conn.write(data)
                    _last_traffic = now
                    if since < 0.0:
                        _unanswered_since = now
                    return
        if _conn is None:
            if _now() < _hold_until:
                _report(_connect_error, False)
                return
            _open()
        if len(_queue) < MAX_QUEUED:
            _queue.append(data)
        else:
            _report("TCP send queue for " + _peer + " is full; message dropped", False)

    def set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        if _closed:
            return
        _on_error = on_error
        failure = _failure
        if failure is not None:
            on_error(failure, True)
        _inbox.register(on_data)

    def close() -> None:
        if _closed:
            return
        _closed = True
        _on_error = None
        _inbox.clear()
        _drop()

    if port <= 0 or port > 65535:
        _failure = "TCP setup for " + _peer + " failed: port %d is outside 1..65535" % port
    elif not (net.is_ipv4(address) or net.is_ipv6(address)):
        _failure = "TCP setup for " + _peer + " failed: not an IPv4 or IPv6 address"


def tcp_server_transport(cap: net.TCPListenCap, address: str, port: int,
                         on_ready: action(ServerTransport, ?str) -> None,
                         log_handler: ?logging.Handler=None, max_connections: int=256,
                         idle_timeout: float=300.0, max_msg_size: int=1048576) -> None:
    """Listen for TCP connections on address and port (RFC 3430), then call on_ready once

    on_ready(transport, None) means the transport is listening;
    on_ready(transport, error) means it could not (address in use, an
    address that is not an IP address, port 0 or a port outside 1..65535),
    and that transport's local_port() is 0 and it ignores sends. Port 0 is
    refused because the port picked for it cannot be learned.

    Each accepted connection is a session, numbered 1, 2, 3, ... The peer
    address of an accepted connection is not available, so on_data gets
    src_address "" and the session number as src_port, and send_to(data,
    "", session) writes to that session; a message for any other address
    is dropped with a warning. An answer for a session that has closed is
    dropped: only the initiator opens connections (RFC 3430 section 2.3),
    so an answer goes out on the connection its request came on or not at
    all. A NotificationReceiver's dedup_window therefore matches a
    retransmitted inform only on the same connection.

    Each connection has its own StreamFramer: a connection that loses
    framing is closed, with a warning that does not show the message. A
    connection without traffic for idle_timeout seconds is closed (0:
    never). A connection reset by the peer is not reported, so its session
    stays open until then. With max_connections sessions open, a new
    connection takes the place of the session that has been without
    traffic longest, which is closed with a warning (either side may close
    a connection at any time, RFC 3430 section 2.3).

    The listening socket cannot be closed: close() stops serving, so it
    closes every session and, from then on, every new connection at once,
    while the port stays bound until the process exits. Errors after
    listening (an accept or a write that failed) are logged to log_handler
    as warnings.

    Raises ValueError for max_connections below 1, a negative idle_timeout
    or a max_msg_size below MIN_TCP_MESSAGE.
    """
    if max_connections < 1:
        raise ValueError("max_connections must be at least 1, got %d" % max_connections)
    _check_tcp_options(max_msg_size, idle_timeout)
    _TcpServer(cap, address, port, on_ready, log_handler, max_connections, idle_timeout, max_msg_size)


def _tcp_server_transport(ep: _TcpServer, local_port: int) -> ServerTransport:
    # Built at module level like _udp_server_transport()
    def _send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        ep.send_to(data, dst_address, dst_port)
    def _set_receiver(on_data: action(bytes, str, int) -> None) -> None:
        ep.set_receiver(on_data)
    def _close() -> None:
        ep.close()
    return ServerTransport(_send_to, _set_receiver, _close, lambda: local_port)


class _Session(object):
    # An accepted connection of tcp_server_transport(), its framer, and when it last carried a message
    conn: net.TCPListenConnection
    framer: StreamFramer
    last_traffic: float

    def __init__(self, conn: net.TCPListenConnection, framer: StreamFramer, last_traffic: float):
        self.conn = conn
        self.framer = framer
        self.last_traffic = last_traffic


actor _TcpServer(cap: net.TCPListenCap, address: str, port: int,
                 on_ready: action(ServerTransport, ?str) -> None,
                 log_handler: ?logging.Handler, max_connections: int, idle_timeout: float, max_msg_size: int):
    # The actor behind tcp_server_transport(); sessions are numbered from 1 and never reused
    _log = logging.Logger(log_handler)
    _local = _peer_text(address, port)
    var _listener: ?net.TCPListener = None
    var _ready_sent = False
    var _listening = False
    var _closed = False
    var _inbox = _Inbox()
    var _sessions: dict[int, _Session] = {}
    var _next_session = 1

    proc def _end(sid: int) -> None:
        s = _sessions.get(sid)
        if s is not None:
            del _sessions[sid]
            s.conn.close()

    def send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        if _closed:
            return
        if dst_address != "":
            _log.warning("message dropped: a TCP session is addressed as \"\" and its number, not by an address",
                         {"local": _local, "address": dst_address, "port": dst_port})
            return
        s = _sessions.get(dst_port)
        if s is not None:
            s.conn.write(data)
            s.last_traffic = _now()
        elif _listening:
            _log.debug("answer for a closed TCP session dropped", {"local": _local, "session": dst_port})

    def set_receiver(on_data: action(bytes, str, int) -> None) -> None:
        if not _closed:
            _inbox.register(on_data)

    def close() -> None:
        if _closed:
            return
        _closed = True
        _inbox.clear()
        for sid in list(_sessions.keys()):
            _end(sid)

    proc def _ready(local_port: int, error: ?str) -> None:
        _ready_sent = True
        on_ready(_tcp_server_transport(self, local_port), error)

    def _on_listen(l: net.TCPListener, error: ?str) -> None:
        if _ready_sent:
            # Later calls report failed accepts
            if error is not None and not _closed:
                _log.warning("TCP accept failed", {"local": _local, "error": error})
            return
        if error is not None:
            _ready(0, "TCP listen on " + _local + " failed: " + error)
            return
        _listening = True
        _ready(port, None)

    def _on_receive(sid: int, data: bytes) -> None:
        s = _sessions.get(sid)
        if s is not None:
            s.last_traffic = _now()
            framer = s.framer
            for m in framer.feed(data):
                _inbox.put(m, "", sid)
            if framer.lost != "":
                _log.warning("TCP connection closed: lost framing", {"local": _local, "session": sid,
                                                                     "reason": framer.lost})
                _end(sid)

    def _on_conn_error(sid: int, error: str) -> None:
        if sid in _sessions:
            _log.warning("TCP connection closed after an error", {"local": _local, "session": sid, "error": error})
            _end(sid)

    def _on_remote_close(sid: int) -> None:
        # The connection is closed already
        if sid in _sessions:
            del _sessions[sid]

    def _idle_check(sid: int) -> None:
        s = _sessions.get(sid)
        if s is not None:
            idle = _now() - s.last_traffic
            if idle >= idle_timeout:
                _log.debug("idle TCP connection closed", {"local": _local, "session": sid})
                _end(sid)
            else:
                wait = idle_timeout - idle
                after now wait: _idle_check(sid)

    proc def _make_room() -> None:
        # Close the session that has been without traffic longest
        quietest = 0
        since = 0.0
        for sid in _sessions.keys():
            t = _sessions[sid].last_traffic
            if quietest == 0 or t < since:
                quietest = sid
                since = t
        _log.warning("TCP connection closed for a new one: too many connections",
                     {"local": _local, "session": quietest, "limit": max_connections})
        _end(quietest)

    def _on_accept(c: net.TCPListenConnection) -> None:
        if _closed or not _listening:
            c.close()
            return
        if len(_sessions) >= max_connections:
            _make_room()
        sid = _next_session
        _next_session += 1
        _sessions[sid] = _Session(c, StreamFramer(max_msg_size), _now())
        def on_receive(conn: net.TCPListenConnection, data: bytes) -> None:
            _on_receive(sid, data)
        def on_error(conn: net.TCPListenConnection, error: str) -> None:
            _on_conn_error(sid, error)
        def on_remote_close(conn: net.TCPListenConnection) -> None:
            _on_remote_close(sid)
        c.cb_install(on_receive, on_error, on_remote_close)
        if idle_timeout > 0.0:
            after now idle_timeout: _idle_check(sid)

    if port == 0:
        _ready(0, "TCP listen on " + _local + " failed: port 0 is not supported: the port picked for it "
               + "cannot be learned")
    elif port < 0 or port > 65535:
        _ready(0, "TCP listen on " + _local + " failed: port outside 1..65535")
    else:
        _listener = net.TCPListener(cap, address, port, _on_listen, _on_accept)


# In-memory network ################################################################################

class NetFaults(object):
    """Packet-level faults that a MemNet applies to the datagrams it carries

    Faults apply to the datagrams whose destination matches to_address and
    to_port ("" and 0 match any). Those are numbered 1, 2, 3, ... in the order
    they are sent; the numbering restarts when MemNet.set_faults() is called.
    For each one, in this order:

    - drop_first_n: datagrams 1..n are dropped.
    - drop_every_nth: datagrams whose number is a multiple of n are dropped
      (0 = off).
    - corrupt_byte: the octet at this offset is inverted (XOR 0xff); a
      datagram that is not longer than the offset is left alone (-1 = off).
    - spoof_source: a forged copy, from the same address but source port + 1
      (65535 wraps to 1), is delivered right before the datagram. A spoofed
      datagram never triggers a "connection refused" error.
    - duplicate: the datagram is delivered twice.
    - reorder: of every two consecutive datagrams the first is held back and
      delivered right after the second (with its copies). A held datagram
      that no other overtakes within REORDER_HOLD seconds is delivered then.
    - delay: the datagram (with its copies) is delivered this many seconds
      after it was sent, 0.0 to 3600.0. Delayed datagrams keep their order.

    The constructor raises ValueError for a negative count, an offset below
    -1, a delay outside 0..3600 or a port outside 0..65535.
    """
    drop_first_n: int
    drop_every_nth: int
    duplicate: bool
    delay: float
    reorder: bool
    corrupt_byte: int
    spoof_source: bool
    to_address: str
    to_port: int

    def __init__(self, drop_first_n: int=0, drop_every_nth: int=0, duplicate: bool=False, delay: float=0.0,
                 reorder: bool=False, corrupt_byte: int=-1, spoof_source: bool=False,
                 to_address: str="", to_port: int=0):
        if drop_first_n < 0 or drop_every_nth < 0:
            raise ValueError("NetFaults drop counts must not be negative")
        if corrupt_byte < -1:
            raise ValueError("NetFaults corrupt_byte must be -1 (off) or an offset")
        if not (delay >= 0.0 and delay <= 3600.0):
            raise ValueError("NetFaults delay must be 0.0 to 3600.0 seconds")
        if to_port < 0 or to_port > 65535:
            raise ValueError("NetFaults to_port must be 0 (any) to 65535")
        self.drop_first_n = drop_first_n
        self.drop_every_nth = drop_every_nth
        self.duplicate = duplicate
        self.delay = delay
        self.reorder = reorder
        self.corrupt_byte = corrupt_byte
        self.spoof_source = spoof_source
        self.to_address = to_address
        self.to_port = to_port

    def matches(self, address: str, port: int) -> bool:
        """Return True if the faults apply to datagrams for address and port"""
        return (self.to_address == "" or self.to_address == address) and (self.to_port == 0 or self.to_port == port)


class Datagram(object):
    """One datagram as it was sent into a MemNet (see MemNet.history())"""
    data: bytes
    src_address: str
    src_port: int
    dst_address: str
    dst_port: int

    def __init__(self, data: bytes, src_address: str, src_port: int, dst_address: str, dst_port: int):
        self.data = data
        self.src_address = src_address
        self.src_port = src_port
        self.dst_address = dst_address
        self.dst_port = dst_port

    def __repr__(self) -> str:
        route = _peer_text(self.src_address, self.src_port) + " -> " + _peer_text(self.dst_address, self.dst_port)
        return "Datagram(" + route + ", " + self.data.hex() + ")"


class NetStats(object):
    """Counters of a MemNet (see MemNet.stats())

    sent: datagrams sent into the network.
    delivered: datagrams handed to an endpoint, copies included.
    unroutable: datagrams, copies included, for an address and port that no
        endpoint is bound to; they are dropped.
    oversize: datagrams longer than MAX_DATAGRAM; they are dropped.
    dropped, corrupted, spoofed, duplicated, reordered, delayed: datagrams
        that drop_first_n or drop_every_nth dropped, that were corrupted,
        that got a forged copy, that were duplicated, that were overtaken by
        a later datagram, and that were delayed (copies included).
    """
    sent: int
    delivered: int
    unroutable: int
    oversize: int
    dropped: int
    corrupted: int
    spoofed: int
    duplicated: int
    reordered: int
    delayed: int

    def __init__(self, sent: int, delivered: int, unroutable: int, oversize: int, dropped: int,
                 corrupted: int, spoofed: int, duplicated: int, reordered: int, delayed: int):
        self.sent = sent
        self.delivered = delivered
        self.unroutable = unroutable
        self.oversize = oversize
        self.dropped = dropped
        self.corrupted = corrupted
        self.spoofed = spoofed
        self.duplicated = duplicated
        self.reordered = reordered
        self.delayed = delayed

    def __repr__(self) -> str:
        counts = [("sent", self.sent), ("delivered", self.delivered), ("unroutable", self.unroutable),
                  ("oversize", self.oversize), ("dropped", self.dropped), ("corrupted", self.corrupted),
                  ("spoofed", self.spoofed), ("duplicated", self.duplicated), ("reordered", self.reordered),
                  ("delayed", self.delayed)]
        return "NetStats(" + ", ".join([c.0 + "=" + str(c.1) for c in counts]) + ")"


class _Binding(object):
    # An endpoint bound to an address and port; token tells bindings of the
    # same address and port apart, so a late release cannot remove a new one
    ep: _MemEndpoint
    token: int

    def __init__(self, ep: _MemEndpoint, token: int):
        self.ep = ep
        self.token = token


def _forged_port(port: int) -> int:
    return port + 1 if port < 65535 else 1


actor MemNet(faults: ?NetFaults=None):
    """A deterministic in-process datagram network with fault injection

    Endpoints are bound to an address and a port 1..65535. An address is any
    non-empty text, typically an IP address; it is not resolved or
    normalized. Get endpoints with client() and server(), or both at once
    with mem_pair().

    A datagram is delivered to the endpoint bound to its destination.
    Datagrams for an address and port that no endpoint is bound to are
    dropped, and a client endpoint that sent one gets a REFUSED error, as a
    connected UDP socket does for ICMP port unreachable. Datagrams longer
    than MAX_DATAGRAM are dropped, with a non-fatal error to a client
    sender. Without faults every datagram is delivered once, and those from
    one sender in the order they were sent.

    faults (see NetFaults) apply to every datagram sent afterwards;
    set_faults() replaces them. stats() and history() tell what happened.
    """
    var _faults: ?NetFaults = faults
    var _bindings: dict[(str, int), _Binding] = {}
    var _next_token = 1
    var _next_port = _EPHEMERAL_FIRST
    var _history: list[Datagram] = []
    var _numbered = 0
    var _held: ?list[(Datagram, bool)] = None
    var _hold_seq = 0
    var _delay_queue: list[(int, list[(Datagram, bool)])] = []
    var _delay_seq = 0
    var _sent = 0
    var _delivered = 0
    var _unroutable = 0
    var _oversize = 0
    var _dropped = 0
    var _corrupted = 0
    var _spoofed = 0
    var _duplicated = 0
    var _reordered = 0
    var _delayed = 0

    proc def _bind(address: str, port: int) -> (int, int):
        # Pick the port (a free ephemeral one for 0) and a token; raise ValueError if not possible
        if address == "":
            raise ValueError("MemNet address must not be empty")
        if port < 0 or port > 65535:
            raise ValueError("MemNet port %d is outside 0..65535" % port)
        token = _next_token
        _next_token += 1
        if port != 0:
            if (address, port) in _bindings:
                raise ValueError("MemNet address " + _peer_text(address, port) + " is in use")
            return (port, token)
        for _ in range(_EPHEMERAL_COUNT):
            p = _next_port
            _next_port = p + 1 if p < 65535 else _EPHEMERAL_FIRST
            if (address, p) not in _bindings:
                return (p, token)
        raise ValueError("MemNet address " + address + " has no free port")

    def client(address: str, port: int, peer_address: str, peer_port: int) -> Transport:
        """Return a Transport bound to address and port that sends to peer_address and peer_port

        port 0 picks a free port from 49152 up. The transport receives every
        datagram addressed to it, whatever its source (unlike a connected UDP
        socket), so that the owner's source checks can be tested. Raises
        ValueError for an empty address, a port outside 0..65535 (peer_port:
        1..65535) or an address and port that is in use; the caller sees it
        because using the result makes the call synchronous.
        """
        if peer_port <= 0 or peer_port > 65535:
            raise ValueError("MemNet peer port %d is outside 1..65535" % peer_port)
        p, token = _bind(address, port)
        ep = _MemEndpoint(self, address, p, token, peer_address, peer_port)
        _bindings[(address, p)] = _Binding(ep, token)
        return _mem_client_transport(ep)

    def server(address: str, port: int) -> ServerTransport:
        """Return a ServerTransport bound to address and port

        port 0 picks a free port from 49152 up; local_port() tells which.
        Raises ValueError for an empty address, a port outside 0..65535 or an
        address and port that is in use (see client()).
        """
        p, token = _bind(address, port)
        ep = _MemEndpoint(self, address, p, token, "", 0)
        _bindings[(address, p)] = _Binding(ep, token)
        return _mem_server_transport(ep, p)

    def send(data: bytes, src_address: str, src_port: int, dst_address: str, dst_port: int) -> None:
        """Send a datagram into the network as if from src_address and src_port

        The endpoints send through this. A test can use it to inject a
        datagram from any source, bound or not.
        """
        _sent += 1
        d = Datagram(data, src_address, src_port, dst_address, dst_port)
        _history.append(d)
        if len(data) > MAX_DATAGRAM:
            _oversize += 1
            _error_to(src_address, src_port, "Failed to send UDP datagram: message too long")
            return
        f = _faults
        if f is not None:
            if f.matches(dst_address, dst_port):
                _apply(f, d)
                return
        _deliver(d, True)

    def release(address: str, port: int, token: int) -> None:
        """Unbind an endpoint; endpoints call this when they are closed"""
        b = _bindings.get((address, port))
        if b is not None:
            if b.token == token:
                del _bindings[(address, port)]

    def set_faults(faults: ?NetFaults) -> None:
        """Replace the faults (None: no faults)

        Datagrams that delay or reorder holds back are delivered at once, in
        order, and the numbering of datagrams restarts at 1.
        """
        _release_delayed(_delay_seq)
        held = _held
        if held is not None:
            _held = None
            _deliver_all(held)
        _faults = faults
        _numbered = 0

    def stats() -> NetStats:
        """Return a snapshot of the counters"""
        return NetStats(_sent, _delivered, _unroutable, _oversize, _dropped,
                        _corrupted, _spoofed, _duplicated, _reordered, _delayed)

    def history() -> list[Datagram]:
        """Return every datagram sent so far, in order, as it was sent (before faults)"""
        return _history.copy()

    proc def _error_to(address: str, port: int, message: str) -> None:
        b = _bindings.get((address, port))
        if b is not None:
            b.ep.deliver_error(message)

    proc def _deliver(d: Datagram, genuine: bool) -> None:
        b = _bindings.get((d.dst_address, d.dst_port))
        if b is not None:
            _delivered += 1
            b.ep.deliver(d.data, d.src_address, d.src_port)
        else:
            _unroutable += 1
            if genuine:
                _error_to(d.src_address, d.src_port, REFUSED)

    def _deliver_all(unit: list[(Datagram, bool)]) -> None:
        for u in unit:
            _deliver(u.0, u.1)

    def _release_delayed(seq: int) -> None:
        # Deliver the delayed datagrams up to number seq. Every timer releases
        # all those queued before its own as well, so that the order holds
        # even when timers that are due at the same time fire in any order.
        while len(_delay_queue) > 0 and _delay_queue[0].0 <= seq:
            entry = _delay_queue.pop(0)
            _deliver_all(entry.1)

    proc def _schedule(unit: list[(Datagram, bool)], delay: float) -> None:
        if delay > 0.0:
            _delayed += len(unit)
            _delay_seq += 1
            _delay_queue.append((_delay_seq, unit))
            after now delay: _release_delayed(_delay_seq)
        else:
            _deliver_all(unit)

    def _release_held(seq: int, delay: float) -> None:
        held = _held
        if held is not None:
            if seq == _hold_seq:
                _held = None
                _schedule(held, delay)

    proc def _apply(f: NetFaults, d: Datagram) -> None:
        _numbered += 1
        n = _numbered
        if n <= f.drop_first_n or (f.drop_every_nth > 0 and n % f.drop_every_nth == 0):
            _dropped += 1
            return
        data = d.data
        i = f.corrupt_byte
        if i >= 0 and i < len(data):
            data = data[:i] + ber.BYTE_TABLE[data[i] ^ 0xff] + data[i + 1:]
            _corrupted += 1
        genuine = Datagram(data, d.src_address, d.src_port, d.dst_address, d.dst_port)
        unit: list[(Datagram, bool)] = []
        if f.spoof_source:
            _spoofed += 1
            unit.append((Datagram(data, d.src_address, _forged_port(d.src_port), d.dst_address, d.dst_port), False))
        unit.append((genuine, True))
        if f.duplicate:
            _duplicated += 1
            unit.append((genuine, True))
        if not f.reorder:
            _schedule(unit, f.delay)
            return
        held = _held
        if held is not None:
            _held = None
            _reordered += 1
            _schedule(unit + held, f.delay)
            return
        _held = unit
        _hold_seq += 1
        after now REORDER_HOLD: _release_held(_hold_seq, f.delay)


actor _MemEndpoint(network: MemNet, address: str, port: int, token: int, peer_address: str, peer_port: int):
    # One endpoint of a MemNet: a client (send to the peer, errors reported)
    # or a server (send_to anyone, peer_port 0)
    var _closed = False
    var _inbox = _Inbox()
    var _on_error: ?action(str, bool) -> None = None

    def send(data: bytes) -> None:
        if not _closed:
            network.send(data, address, port, peer_address, peer_port)

    def send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        if not _closed:
            network.send(data, address, port, dst_address, dst_port)

    def set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        if not _closed:
            _on_error = on_error
            _inbox.register(on_data)

    def set_data_receiver(on_data: action(bytes, str, int) -> None) -> None:
        if not _closed:
            _inbox.register(on_data)

    def close() -> None:
        if _closed:
            return
        _closed = True
        _on_error = None
        _inbox.clear()
        network.release(address, port, token)

    def deliver(data: bytes, src_address: str, src_port: int) -> None:
        if not _closed:
            _inbox.put(data, src_address, src_port)

    def deliver_error(message: str) -> None:
        on_error = _on_error
        if on_error is not None:
            on_error(message, False)


def _mem_client_transport(ep: _MemEndpoint) -> Transport:
    # Built at module level like _udp_server_transport()
    def _send(data: bytes) -> None:
        ep.send(data)
    def _set_receiver(on_data: action(bytes, str, int) -> None, on_error: action(str, bool) -> None) -> None:
        ep.set_receiver(on_data, on_error)
    def _close() -> None:
        ep.close()
    return Transport(_send, _set_receiver, _close)

def _mem_server_transport(ep: _MemEndpoint, local_port: int) -> ServerTransport:
    def _send_to(data: bytes, dst_address: str, dst_port: int) -> None:
        ep.send_to(data, dst_address, dst_port)
    def _set_receiver(on_data: action(bytes, str, int) -> None) -> None:
        ep.set_data_receiver(on_data)
    def _close() -> None:
        ep.close()
    return ServerTransport(_send_to, _set_receiver, _close, lambda: local_port)


def mem_pair(network: MemNet, client_addr: str="10.0.0.2", client_port: int=40000,
             server_addr: str="10.0.0.1", server_port: int=161) -> (client: Transport, server: ServerTransport):
    """Return a client Transport and a ServerTransport on network that talk to each other

    The server is bound first (port 0 picks a free port), then the client,
    which sends to the server. Raises ValueError like MemNet.client() and
    MemNet.server().
    """
    server = network.server(server_addr, server_port)
    client = network.client(client_addr, client_port, server_addr, server.local_port())
    return (client=client, server=server)
