"""Command line parser of the actsnmp CLI, compatible with net-snmp's tools

parse(argv) turns `actsnmp <command> ...` into a CliOptions object or
raises CliError. It reads no files and derives no keys. When MIBs are
involved the CLI calls the two halves itself: scan(argv) reads the
options, the CLI loads the MIBs they ask for into CliOptions.mib, and
finish(o) then reads the arguments with them.

The syntax is that of net-snmp's snmp_parse_args plus each tool's -C
options, so command lines written for snmpget, snmpwalk, snmptrap and the
others work unchanged. Options with a value may be glued or separate
(`-v2c`, `-v 2c`), flags may be grouped, and options and arguments may be
mixed as with GNU getopt. A word like "-5" is an argument, so a negative
INTEGER needs no `--`. AGENT is [udp:|udp6:|tcp:|tcp6:]HOST[:PORT], with
IPv6 literals in brackets when a port follows.

MIB mode is on with -m or -M, when MIBS or MIBDIRS is set, or when an OID
argument names a module (MOD::name). OIDs are then read as snmp_parse_oid
reads them, set and trap values follow the MIB's types, and -O and -I
accept the letters that need a MIB. Without MIBs OIDs are numeric, read
as read_objid reads them.

set, trap and inform take OID TYPE VALUE triples with snmpset's type
letters (see parse_value); actsnmp adds q for a raw Opaque. translate,
mib2yang, mibmeta and miblint have their own options (_scan_mib_command),
and agent and trapd take a few long options for the lab setup, --tcp
among them to listen on TCP instead of UDP.

Errors carry net-snmp's message and are checked in net-snmp's order. Where
net-snmp would truncate or wrap a value that does not fit its type,
actsnmp refuses it.
"""

import math
import fmt
import message
import mibcli
import usm
import values
import ber
from oid import Oid
from values import Value, VarBind, Integer, OctetString, Null, ObjectIdentifier, IpAddress, Counter32, Gauge32
from values import TimeTicks, Opaque, Counter64, UnknownValue

# The commands, in the order of the usage text
COMMANDS: list[str] = ["get", "getnext", "bulkget", "walk", "bulkwalk", "set", "table", "trap", "inform", "agent",
                       "trapd", "translate", "mib2yang", "mibmeta", "miblint"]

# The commands that only work on MIBs (no agent), with their own options (see _scan_mib_command)
MIB_COMMANDS: list[str] = ["translate", "mib2yang", "mibmeta", "miblint"]

# net-snmp's defaults
DEFAULT_TIMEOUT = 1.0
DEFAULT_RETRIES = 5
DEFAULT_MAX_REPETITIONS = 10
DEFAULT_WALK_ROOT = "1.3.6.1.2.1"
SNMP_PORT = 161
TRAP_PORT = 162
MAX_CMDLINE_OIDS = 128

# The lab defaults of `agent` and `trapd` (interop/README.md)
AGENT_PORT = 16163
TRAPD_PORT = 16165
DEFAULT_BIND = "127.0.0.1"
AGENT_ENGINE_ID = "80001f8880616374736e6d7061"
TRAPD_ENGINE_ID = "80001f8880616374736e6d7072"
LAB_SNMPREC = "interop/dataset/actsnmp.snmprec"
LAB_WRITE_RULES = "interop/dataset/write-rules.tsv"
LAB_USERS = "interop/config/users.tsv"

# snmptrap's enterprise when ENTERPRISE is empty (net-snmp's objid_enterprise default)
DEFAULT_ENTERPRISE = "1.3.6.1.4.1.3.1.1"

# Short options that take a value, and those that do not
_VALUE_LETTERS = "vculaAxXneEZtrOCmMIw"
_FLAG_LETTERS = "hHVd"

# Long options of agent and trapd that take a value
_SERVER_LONG: list[str] = ["snmprec", "write-rules", "users", "engine-id", "port", "bind"]

_INT32_MIN = -2147483648
_INT32_MAX = 2147483647
_UINT32_MAX = 4294967295


class CliError(Exception):
    """A command line that cannot be run (exit code 1)

    error_message is the stderr text without the final newline. usage says
    whether the command's usage text should follow, as net-snmp prints it
    after argument errors.
    """
    usage: bool

    def __init__(self, msg: str, usage: bool=False):
        self.error_message = msg
        self.usage = usage


def oid_words_of(command: str, args: list[str], v1: bool, end_oids: list[str]=[]) -> list[str]:
    """The positional arguments (args, the agent first) that the command reads as OIDs

    These are the words where a MOD::name makes net-snmp load module MOD:
    OID arguments, the OIDs of OID TYPE VALUE triples and values of type o,
    the trap OID or SNMPv1 enterprise, and end_oids (-CE). Other values, such
    as s 'Foo::bar', name no module.
    """
    out: list[str] = list(end_oids)
    if len(args) < 2:
        return out
    rest = args[1:]
    if command == "get" or command == "getnext" or command == "bulkget" or command == "table":
        return out + rest
    if command == "walk" or command == "bulkwalk":
        return out + rest[:1]
    triples: list[str] = []
    if command == "set":
        triples = rest
    elif command == "trap" and v1:
        out.append(rest[0])
        triples = rest[5:]
    elif command == "trap" or command == "inform":
        if len(rest) > 1:
            out.append(rest[1])
        triples = rest[2:]
    i = 0
    while i < len(triples):
        out.append(triples[i])
        if i + 2 < len(triples) and triples[i + 1].startswith("o"):
            out.append(triples[i + 2])
        i += 3
    return out

class CliOptions(object):
    """The parsed command line of one actsnmp command

    Most attributes hold one option each. peer is the agent argument as
    given, for messages; address, port and transport_domain ("udp", "udp6",
    "tcp" or "tcp6") are parsed from it. engine_id (-e) is the peer's
    engine ID, except for an SNMPv3 trap where it is our own. uptime -1
    means the sender's uptime. warnings are lines to print on stderr before
    the command runs. session_error is the error net-snmp reports when it
    opens an SNMPv3 session (no user, or no pass phrase for the level); the
    command then only runs the engine discovery before printing it.
    listen_tcp is agent's and trapd's --tcp.
    """
    command: str
    peer: str
    address: str
    port: int
    transport_domain: str
    version: int
    community: ?str
    communities: list[str]
    rw_communities: list[str]
    user: str
    level: int
    level_given: bool
    auth_protocol: int
    auth_password: str
    priv_protocol: int
    priv_password: str
    context: str
    engine_id: ?bytes
    context_engine_id: ?bytes
    boots: int
    timeout: float
    retries: int
    output: fmt.OutputOptions
    canon: bool
    oids: list[Oid]
    varbinds: list[VarBind]
    non_repeaters: int
    max_repetitions: int
    dont_check: bool
    include_requested: bool
    dont_get_requested: bool
    print_count: bool
    print_time: bool
    end_oid: ?Oid
    dont_fix: bool
    quiet: bool
    inform: bool
    uptime: int
    trap_oid: Oid
    enterprise: Oid
    agent_addr: bytes
    generic: int
    specific: int
    snmprec: str
    write_rules: str
    users: str
    users_given: bool
    server_engine_id: bytes
    listen_port: int
    bind_address: str
    listen_tcp: bool
    help: bool
    show_version: bool
    warnings: list[str]
    session_error: str
    end_oid_text: ?str
    mib_mode: bool
    mib_modules_opt: ?str
    mib_dirs_opts: list[str]
    inp: mibcli.InputOptions
    mib: ?mibcli.MibTree
    args: list[str]
    details: bool
    print_tree: bool
    find_all: bool
    width: int
    outdir: str
    meta: bool
    consistent_status: bool
    ignore_hints: list[str]
    lint_level: int
    mib_lazy: mibcli.LazyLoads
    mib_detail: str
    mib_notes: list[str]

    def __init__(self, command: str):
        self.command = command
        self.peer = ""
        self.address = ""
        self.port = TRAP_PORT if command == "trap" or command == "inform" else SNMP_PORT
        self.transport_domain = "udp"
        self.version = message.SNMP_V2C
        self.community = None
        self.communities = []
        self.rw_communities = []
        self.user = ""
        self.level = usm.LEVEL_NO_AUTH_NO_PRIV
        self.level_given = False
        self.auth_protocol = usm.AUTH_NONE
        self.auth_password = ""
        self.priv_protocol = usm.PRIV_NONE
        self.priv_password = ""
        self.context = ""
        self.engine_id = None
        self.context_engine_id = None
        self.boots = 1
        self.timeout = DEFAULT_TIMEOUT
        self.retries = DEFAULT_RETRIES
        self.output = fmt.OutputOptions()
        self.canon = False
        self.oids = []
        self.varbinds = []
        self.non_repeaters = 0
        self.max_repetitions = DEFAULT_MAX_REPETITIONS
        self.dont_check = False
        self.include_requested = False
        self.dont_get_requested = False
        self.print_count = False
        self.print_time = False
        self.end_oid = None
        self.dont_fix = False
        self.quiet = False
        self.inform = command == "inform"
        self.uptime = -1
        self.trap_oid = Oid([])
        self.enterprise = Oid([])
        self.agent_addr = b"\x00\x00\x00\x00"
        self.generic = 0
        self.specific = 0
        self.snmprec = LAB_SNMPREC
        self.write_rules = LAB_WRITE_RULES
        self.users = LAB_USERS
        self.users_given = False
        self.server_engine_id = bytes.from_hex(TRAPD_ENGINE_ID if command == "trapd" else AGENT_ENGINE_ID)
        self.listen_port = TRAPD_PORT if command == "trapd" else AGENT_PORT
        self.bind_address = DEFAULT_BIND
        self.listen_tcp = False
        self.help = False
        self.show_version = False
        self.warnings = []
        self.session_error = ""
        self.end_oid_text = None
        self.mib_mode = command in MIB_COMMANDS
        self.mib_modules_opt = None
        self.mib_dirs_opts = []
        self.inp = mibcli.InputOptions()
        self.mib = None
        self.args = []
        self.details = False
        self.print_tree = False
        self.find_all = False
        self.width = 1000000
        self.outdir = ""
        self.meta = False
        self.consistent_status = False
        self.ignore_hints = []
        self.lint_level = 3 if command == "miblint" else 2
        self.mib_lazy = mibcli.LazyLoads("", False, "")
        self.mib_detail = ""
        self.mib_notes = []

    def is_server(self) -> bool:
        """True for agent and trapd, which listen instead of talking to a peer"""
        return self.command == "agent" or self.command == "trapd"

    def is_tcp(self) -> bool:
        """True when the agent address names TCP (tcp:, tcp6:)"""
        return self.transport_domain == "tcp" or self.transport_domain == "tcp6"

    def oid_words(self) -> list[str]:
        """The arguments net-snmp reads as OIDs (oid_words_of), which load the modules they name"""
        if self.command in MIB_COMMANDS:
            return list(self.args)
        ends: list[str] = []
        end = self.end_oid_text
        if end is not None:
            ends.append(end)
        return oid_words_of(self.command, self.args, self.version == message.SNMP_V1, ends)

    def __repr__(self) -> str:
        # never shows communities or passwords
        return ("CliOptions(" + self.command + ", peer=" + repr(self.peer) + ", version=%d" % self.version
                + ", oids=[" + ", ".join([o.dotted() for o in self.oids]) + "], varbinds=%d)" % len(self.varbinds))

    def __str__(self) -> str:
        return self.__repr__()


# C number scanning (strtoul, strtol, strtod), as net-snmp's parsers use it ##########################

_C_SPACE = " \t\n\v\f\r"
_U64_MAX = u64(18446744073709551615)

def _digit(c: str) -> int:
    """The value of an ASCII digit or letter as a digit (0-9, then a/A = 10 .. z/Z = 35), 99 for anything else"""
    o = ord(c)
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 122:
        return o - 87
    if o >= 65 and o <= 90:
        return o - 55
    return 99

def _is_digit(c: str) -> bool:
    return _digit(c) < 10

class CNumber(object):
    """What C's strtoul (or strtol) makes of the start of a string

    neg is True for a minus sign, mag the magnitude (2^64-1 when it did not
    fit, overflow is True then) and end the index after the number: 0 when
    nothing was converted (C's end pointer is then the start of the string).
    """
    neg: bool
    mag: u64
    overflow: bool
    end: int

    def __init__(self, neg: bool, mag: u64, overflow: bool, end: int):
        self.neg = neg
        self.mag = mag
        self.overflow = overflow
        self.end = end

def c_number(s: str, base: int) -> CNumber:
    """C's strtoul(s, &end, base) scanning, which strtol shares

    Leading white space, an optional sign, then the digits of the base.
    Base 0 reads hexadecimal after "0x" or "0X" when a hex digit follows,
    octal after a leading 0 and decimal otherwise.
    """
    n = len(s)
    i = 0
    while i < n and s[i] in _C_SPACE:
        i += 1
    neg = False
    if i < n and (s[i] == "+" or s[i] == "-"):
        neg = s[i] == "-"
        i += 1
    b = base
    if ((b == 0 or b == 16) and i + 2 < n and s[i] == "0" and (s[i + 1] == "x" or s[i + 1] == "X")
            and _digit(s[i + 2]) < 16):
        b = 16
        i += 2
    elif b == 0:
        b = 8 if i < n and s[i] == "0" else 10
    start = i
    mag = u64(0)
    over = False
    ub = u64(b)
    while i < n and _digit(s[i]) < b:
        d = u64(_digit(s[i]))
        if not over:
            if mag > (_U64_MAX - d) // ub:
                over = True
                mag = _U64_MAX
            else:
                mag = mag * ub + d
        i += 1
    if i == start:
        return CNumber(False, u64(0), False, 0)
    return CNumber(neg, mag, over, i)

def _int32_of(r: CNumber) -> int:
    """C's (int)strtol(...): the low 32 bits of the saturated long, as a signed number"""
    m = 9223372036854775807 if (r.overflow or r.mag > u64(9223372036854775807)) else int(r.mag)
    if r.neg:
        m = (4294967296 - (m & 0xffffffff)) & 0xffffffff
    else:
        m = m & 0xffffffff
    return m - 4294967296 if m >= 2147483648 else m

class CFloat(object):
    """What C's strtod makes of the start of a string

    end is the index after the number (0: nothing converted); neg the sign;
    kind 0 for a finite number (magnitude value, which overflows to inf),
    1 for infinity and 2 for NaN.
    """
    end: int
    neg: bool
    kind: int
    value: float

    def __init__(self, end: int, neg: bool, kind: int, value: float):
        self.end = end
        self.neg = neg
        self.kind = kind
        self.value = value

def _word_at(s: str, i: int, word: str) -> bool:
    return s[i:i + len(word)].lower() == word

def c_float(s: str) -> CFloat:
    """C's strtod(s, &end) scanning

    White space, a sign, then infinity, inf, nan or nan(...) in any case, a
    hexadecimal number (0x, hex digits with an optional point, an optional
    binary exponent p) or a decimal one (digits with an optional point,
    an optional exponent e). An exponent without digits is not part of it.
    """
    n = len(s)
    i = 0
    while i < n and s[i] in _C_SPACE:
        i += 1
    neg = False
    if i < n and (s[i] == "+" or s[i] == "-"):
        neg = s[i] == "-"
        i += 1
    if _word_at(s, i, "infinity"):
        return CFloat(i + 8, neg, 1, 0.0)
    if _word_at(s, i, "inf"):
        return CFloat(i + 3, neg, 1, 0.0)
    if _word_at(s, i, "nan"):
        j = i + 3
        if j < n and s[j] == "(":
            k = j + 1
            while k < n and (_digit(s[k]) < 36 or s[k] == "_"):
                k += 1
            if k < n and s[k] == ")":
                j = k + 1
        return CFloat(j, neg, 2, 0.0)
    if (i + 2 < n and s[i] == "0" and (s[i + 1] == "x" or s[i + 1] == "X")
            and (_digit(s[i + 2]) < 16 or (s[i + 2] == "." and i + 3 < n and _digit(s[i + 3]) < 16))):
        j = i + 2
        m = 0.0
        e = 0
        digits = 0
        point = False
        while j < n and (_digit(s[j]) < 16 or (s[j] == "." and not point)):
            if s[j] == ".":
                point = True
            else:
                if digits < 14:
                    m = m * 16.0 + float(_digit(s[j]))
                    digits += 1 if (digits > 0 or _digit(s[j]) > 0) else 0
                    if point:
                        e -= 4
                elif not point:
                    e += 4
            j += 1
        if j < n and (s[j] == "p" or s[j] == "P"):
            k = j + 1
            esign = 1
            if k < n and (s[k] == "+" or s[k] == "-"):
                esign = -1 if s[k] == "-" else 1
                k += 1
            if k < n and _is_digit(s[k]):
                x = 0
                while k < n and _is_digit(s[k]):
                    if x < 100000:
                        x = x * 10 + _digit(s[k])
                    k += 1
                e += esign * x
                j = k
        return CFloat(j, neg, 0, math.ldexp(m, e) if m != 0.0 else 0.0)
    j = i
    digits = 0
    while j < n and _is_digit(s[j]):
        j += 1
        digits += 1
    if j < n and s[j] == ".":
        j += 1
        while j < n and _is_digit(s[j]):
            j += 1
            digits += 1
    if digits == 0:
        return CFloat(0, False, 0, 0.0)
    if j < n and (s[j] == "e" or s[j] == "E"):
        k = j + 1
        if k < n and (s[k] == "+" or s[k] == "-"):
            k += 1
        if k < n and _is_digit(s[k]):
            while k < n and _is_digit(s[k]):
                k += 1
            j = k
    return CFloat(j, neg, 0, float(s[i:j]))


# Value parsing (net-snmp's snmp_add_var type letters) ###############################################

# The type letters snmpset accepts (its check before snmp_add_var), plus actsnmp's c, C and q
SET_LETTERS = "iu3tcCaosxdbnqIUFD="

def _read64(text: str) -> u64:
    """net-snmp's read64(): an optional minus, then decimal digits up to the first other character

    The value wraps modulo 2^64 (a minus negates it in two's complement).
    Raises ValueError "Bad value notation" when no digit follows.
    """
    i = 0
    neg = text.startswith("-")
    if neg:
        i = 1
    hi = 0
    lo = 0
    ok = False
    while i < len(text) and _is_digit(text[i]):
        ok = True
        lo = lo * 10 + _digit(text[i])
        hi = (hi * 10 + (lo >> 32)) & 0xffffffff
        lo = lo & 0xffffffff
        i += 1
    if not ok:
        raise ValueError("Bad value notation (%s)" % text)
    if neg:
        hi = (~hi) & 0xffffffff
        lo = ((~lo) & 0xffffffff) + 1
        hi = (hi + (lo >> 32)) & 0xffffffff
        lo = lo & 0xffffffff
    return u64(hi) * u64(4294967296) + u64(lo)

def _unsigned32(text: str) -> int:
    """u, t, c and 3: strtoul in base 10 with nothing after the number; actsnmp refuses what does not fit 32 bits"""
    if text == "":
        raise ValueError("Bad value notation ()")
    r = c_number(text, 10)
    if r.end == 0 or r.end != len(text):
        raise ValueError("Bad value notation (%s)" % text)
    if r.overflow or r.mag > u64(4294967295) or (r.neg and r.mag != u64(0)):
        raise ValueError("Value out of range (%s)" % text)
    return int(r.mag)

def _integer32(text: str) -> int:
    """i: strtol in base 10 with nothing after the number (net-snmp: "Value out of range" otherwise)"""
    if text == "":
        raise ValueError("Bad value notation ()")
    r = c_number(text, 10)
    if r.end == 0 or r.end != len(text):
        raise ValueError("Value out of range (%s)" % text)
    if r.overflow or r.mag > (u64(2147483648) if r.neg else u64(2147483647)):
        raise ValueError("Value out of range (%s)" % text)
    v = int(r.mag)
    return -v if r.neg else v

def netsnmp_hex(text: str) -> ?bytes:
    """net-snmp's hex input (netsnmp_hex_to_binary with blank as the delimiter), or None

    An optional 0x or 0X at the start, then pairs of hex digits; blanks
    between the pairs are skipped. Anything else (an odd digit, a tab, a
    colon) makes it invalid.
    """
    n = len(text)
    i = 2 if n >= 2 and text[0] == "0" and (text[1] == "x" or text[1] == "X") else 0
    out: list[int] = []
    while i < n:
        if i + 1 < n and _digit(text[i]) < 16 and _digit(text[i + 1]) < 16:
            out.append(_digit(text[i]) * 16 + _digit(text[i + 1]))
            i += 2
        elif text[i] == " ":
            i += 1
        else:
            return None
    return bytes(out)

def _hex_value(text: str) -> bytes:
    b = netsnmp_hex(text)
    if b is None:
        raise ValueError("Bad value notation (%s)" % text)
    return b!

def _decimal_octets(text: str) -> bytes:
    """d: net-snmp's ascii_to_binary: decimal octets separated by white space or dots"""
    out: list[int] = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c in _C_SPACE or c == ".":
            i += 1
            continue
        if not _is_digit(c):
            raise ValueError("Bad value notation (%s)" % text)
        j = i
        v = 0
        while j < n and _is_digit(text[j]):
            if v <= 255:
                v = v * 10 + _digit(text[j])
            j += 1
        if v > 255:
            raise ValueError("Bad value notation (%s)" % text)
        out.append(v)
        i = j
    return bytes(out)

def _bits(text: str) -> bytes:
    """b: bit numbers (strtol base 0) separated by blanks, commas or tabs; bit 0 is the top bit of the first octet"""
    nums: list[int] = []
    for word in text.replace(",", " ").replace("\t", " ").split(" "):
        if word == "":
            continue
        r = c_number(word, 0)
        if r.end == 0 or r.end != len(word) or r.overflow or (r.neg and r.mag != u64(0)) or r.mag > u64(524279):
            raise ValueError("Value out of range (%s)" % word)
        nums.append(int(r.mag))
    n = 0
    for b in nums:
        if b // 8 + 1 > n:
            n = b // 8 + 1
    out: list[int] = [0] * n
    for b in nums:
        out[b // 8] = out[b // 8] | (0x80 >> (b % 8))
    return bytes(out)

def inet_aton(text: str) -> ?bytes:
    """glibc's inet_addr(): the 4 octets of a.b.c.d, a.b.c, a.b or a, or None

    Each part is a C number (0x hex, leading 0 octal); in the short forms
    the last part fills the remaining octets. White space and anything
    after it end the address. As with inet_addr, the all-ones address must
    be written 255.255.255.255.
    """
    parts: list[int] = []
    n = len(text)
    i = 0
    val = 0
    while True:
        if i >= n or not _is_digit(text[i]):
            return None
        r = c_number(text[i:], 0)
        if r.overflow or r.mag > u64(4294967295):
            return None
        val = int(r.mag)
        i += r.end
        if i < n and text[i] == ".":
            if len(parts) > 2 or val > 255:
                return None
            parts.append(val)
            i += 1
        else:
            break
    if i < n and not (text[i] in _C_SPACE):
        return None
    limits = [4294967295, 16777215, 65535, 255]
    if val > limits[len(parts)]:
        return None
    word = val
    for k in range(len(parts)):
        word = word | (parts[k] << (24 - 8 * k))
    if word == 0xffffffff and text != "255.255.255.255":
        return None
    return bytes([(word >> 24) & 255, (word >> 16) & 255, (word >> 8) & 255, word & 255])

def parse_ip(text: str) -> bytes:
    """The 4 octets of an IPv4 address as inet_addr() reads it (inet_aton); raises ValueError otherwise"""
    b = inet_aton(text)
    if b is None:
        raise ValueError("Bad value notation (%s)" % text)
    return b!

def _round_even(s: float) -> int:
    # s >= 0, rounded to the nearest integer, ties to even
    f = int(s)
    r = s - float(f)
    if r > 0.5 or (r == 0.5 and f % 2 == 1):
        f += 1
    return f

def _float_bits(neg: bool, kind: int, magnitude: float, exp_bits: int, frac_bits: int) -> int:
    # The IEEE 754 bits of a C float result (see c_float), rounded to nearest even
    sign = (1 << (exp_bits + frac_bits)) if neg else 0
    exp_all = (1 << exp_bits) - 1
    if kind == 1:
        return sign | (exp_all << frac_bits)
    if kind == 2:
        return sign | (exp_all << frac_bits) | (1 << (frac_bits - 1))
    m = magnitude
    if m == 0.0:
        return sign
    bias = (1 << (exp_bits - 1)) - 1
    e = 0
    while m >= 2.0 and e < 4096:
        m = m / 2.0
        e += 1
    while m < 1.0 and e > -4096:
        m = m * 2.0
        e -= 1
    if m >= 2.0:
        return sign | (exp_all << frac_bits)
    biased = e + bias
    if biased <= 0:
        # subnormal (or rounds up into the smallest normal number, which the bits express as well)
        bits = _round_even(math.ldexp(m, e - 1 + bias + frac_bits))
    else:
        bits = (biased << frac_bits) + _round_even(math.ldexp(m - 1.0, frac_bits))
    if bits >= (exp_all << frac_bits):
        return sign | (exp_all << frac_bits)
    return sign | bits

def ieee_bits(text: str, exp_bits: int, frac_bits: int) -> int:
    """The IEEE 754 bits of the number in text, rounded to nearest even

    exp_bits 8 and frac_bits 23 give binary32, 11 and 52 binary64. text is
    anything C's strtod reads, with blanks around it. Raises ValueError
    otherwise. A binary32 is rounded twice, via a double; net-snmp's strtof
    rounds once, which differs only for inputs very close to a tie.
    """
    t = text.strip()
    c = c_float(t)
    if c.end == 0 or c.end != len(t):
        raise ValueError("Bad value notation (%s)" % text)
    return _float_bits(c.neg, c.kind, c.value, exp_bits, frac_bits)

def _float_value(text: str, exp_bits: int, frac_bits: int) -> int:
    # F and D: the bits of the number strtod reads at the start of text (net-snmp ignores what follows)
    c = c_float(text)
    if c.end == 0:
        raise ValueError("Bad value notation (%s)" % text)
    return _float_bits(c.neg, c.kind, c.value, exp_bits, frac_bits)

def _be(v: int, n: int) -> bytes:
    # v (non-negative) as n big-endian octets
    out: list[int] = []
    for i in range(n - 1, -1, -1):
        out.append((v >> (8 * i)) & 0xff)
    return bytes(out)

def opaque_float(text: str) -> Opaque:
    """net-snmp's F: an Opaque-wrapped binary32 float (9f 78 04 + 4 octets)"""
    return Opaque(b"\x9f\x78\x04" + _be(_float_value(text, 8, 23), 4))

def opaque_double(text: str) -> Opaque:
    """net-snmp's D: an Opaque-wrapped binary64 double (9f 79 08 + 8 octets)"""
    bits = _float_value(text, 11, 52)
    return Opaque(b"\x9f\x79\x08" + _be(bits >> 32, 4) + _be(bits & 0xffffffff, 4))

def parse_value(letter: str, text: str) -> Value:
    """The value of a `TYPE VALUE` pair, as net-snmp's snmp_add_var reads it without MIBs

    The letters are snmpset's: i u c 3 t C a o n s x d b, and the
    Opaque-wrapped F D I U. q (a raw Opaque in hex) is our own. Numbers are
    read with the same C library functions net-snmp uses, so odd forms such
    as hex or octal INTEGERs are accepted where net-snmp accepts them.

    Raises ValueError with net-snmp's text. A value that does not fit its
    type, which net-snmp would send truncated, is refused with "Value out
    of range".
    """
    if letter == "i":
        return Integer(_integer32(text))
    if letter == "u":
        return Gauge32(_unsigned32(text))
    if letter == "c":
        return Counter32(_unsigned32(text))
    if letter == "3":
        return UnknownValue(ber.TAG_UINTEGER32, ber.enc_uint_content(_unsigned32(text)))
    if letter == "C":
        return Counter64(_read64(text))
    if letter == "t":
        return TimeTicks(_unsigned32(text))
    if letter == "a":
        return IpAddress(parse_ip(text))
    if letter == "o":
        r = read_objid(text)
        if r.detail != "" or len(r.arcs) == 0:
            raise ValueError("Unknown Object Identifier (" + r.detail + ")")
        return ObjectIdentifier(Oid(r.arcs))
    if letter == "n":
        return Null()
    if letter == "s":
        return OctetString(text.encode())
    if letter == "x":
        return OctetString(_hex_value(text))
    if letter == "d":
        return OctetString(_decimal_octets(text))
    if letter == "b":
        return OctetString(_bits(text))
    if letter == "q":
        return Opaque(_hex_value(text))
    if letter == "F":
        return opaque_float(text)
    if letter == "D":
        return opaque_double(text)
    if letter == "I":
        u = _read64(text)
        v = int(u) if u <= u64(9223372036854775807) else -int(_U64_MAX - u) - 1
        c = ber.enc_int_content(v)
        return Opaque(b"\x9f\x7a" + bytes([len(c)]) + c)
    if letter == "U":
        c = ber.enc_u64_content(_read64(text))
        return Opaque(b"\x9f\x7b" + bytes([len(c)]) + c)
    raise ValueError("Bad variable type (\"" + letter + "\")")


# OIDs (net-snmp's read_objid without MIBs) ##########################################################

class ObjidResult(object):
    """What read_objid made of a text: the arcs, or the detail of its "Unknown Object Identifier" error"""
    arcs: list[int]
    detail: str

    def __init__(self, arcs: list[int], detail: str):
        self.arcs = arcs
        self.detail = detail

def read_objid(text: str) -> ObjidResult:
    """Read a numeric OID as net-snmp's read_objid does with no MIBs loaded

    One leading dot is allowed and each sub-identifier is a C number. On
    failure the result has net-snmp's detail text. Unlike net-snmp, a
    sub-identifier above 2^32-1 and the OID "." are refused instead of
    being truncated or read as empty.
    """
    s = text[1:] if text.startswith(".") else text
    n = len(s)
    arcs: list[int] = []
    dot = s.find(".")
    piece = s if dot < 0 else s[:dot]
    if piece == "" or not _is_digit(piece[0]):
        return ObjidResult([], "Sub-id not found: (top) -> " + piece)
    r = c_number(piece, 0)
    if r.end != len(piece):
        return ObjidResult([], "Sub-id not found: (top) -> " + piece)
    if r.overflow or r.mag > u64(4294967295):
        return ObjidResult([], piece)
    arcs.append(int(r.mag))
    pos = dot + 1 if dot >= 0 else n + 1
    while pos <= n:
        rest = s[pos:]
        if rest == "" or not _is_digit(rest[0]):
            return ObjidResult([], rest)
        dot = rest.find(".")
        piece = rest if dot < 0 else rest[:dot]
        r = c_number(piece, 0)
        if r.end != len(piece) or len(arcs) >= ber.MAX_OID_ARCS or r.overflow or r.mag > u64(4294967295):
            return ObjidResult([], piece)
        arcs.append(int(r.mag))
        pos = pos + dot + 1 if dot >= 0 else n + 1
    return ObjidResult(arcs, "")

def parse_oid(text: str) -> Oid:
    """A numeric OID as read_objid reads it; CliError "<text>: Unknown Object Identifier (<detail>)" otherwise"""
    r = read_objid(text)
    if r.detail != "" or len(r.arcs) == 0:
        raise CliError(text + ": Unknown Object Identifier (" + r.detail + ")")
    return Oid(r.arcs)

def _mib_note(o: CliOptions, text: str) -> str:
    """What net-snmp prints while it reads text with MIBs loaded, before any error of its own (mibcli.LazyLoads)"""
    t = o.mib
    if t is None:
        return ""
    return o.mib_lazy.note(t!, text)

def objid(o: CliOptions, text: str) -> ObjidResult:
    """An OID argument as the command reads it, with o.mib if set and numerically otherwise

    On failure the arcs are empty and detail is the whole error line. Any
    messages from loading a module the text names come first on failure and
    go to o.mib_notes on success. A detail left behind by a successful
    lookup is kept in o.mib_detail, because net-snmp prints it with the
    next error that has no detail of its own.
    """
    t = o.mib
    if t is not None:
        note = _mib_note(o, text)
        r = mibcli.read_oid(t, text, o.inp)
        if r.ok:
            if note != "":
                o.mib_notes.append(note.rstrip("\n"))
            if r.stale != "":
                o.mib_detail = r.stale
            return ObjidResult(r.arcs, "")
        line = text + ": Unknown Object Identifier"
        if r.has_detail:
            line += " (" + r.detail + ")"
        elif o.mib_detail != "":
            line += " (" + o.mib_detail + ")"
        o.mib_detail = ""
        return ObjidResult([], note + line)
    n = read_objid(text)
    if n.detail != "" or len(n.arcs) == 0:
        return ObjidResult([], text + ": Unknown Object Identifier (" + n.detail + ")")
    return n

def oid_arg(o: CliOptions, text: str) -> Oid:
    """objid, or CliError with its message"""
    r = objid(o, text)
    if r.detail != "":
        raise CliError(r.detail)
    return Oid(r.arcs)

_TYPE_NAMES: dict[int, str] = {
    1: "OBJECT IDENTIFIER", 2: "OCTET STRING", 3: "INTEGER", 4: "NetworkAddress", 5: "IpAddress", 6: "Counter32",
    7: "Gauge32", 8: "Timeticks", 9: "Opaque", 10: "Null", 11: "Counter64", 12: "BITS", 13: "NsapAddress",
    14: "UInteger", 15: "Unsigned32", 16: "Integer32",
}

def _range_detail(t: mibcli.TNode, msg: str) -> str:
    # net-snmp's _check_range detail: "<msg> :: {(lo..hi), (v)}"
    parts = ["(%d..%d)" % (r.0, r.1) if r.0 != r.1 else "(%d)" % r.0 for r in t.ranges]
    return msg + " :: {{" + ", ".join(parts) + "}}"

def _in_range(t: mibcli.TNode, v: int) -> bool:
    if len(t.ranges) == 0:
        return True
    for r in t.ranges:
        if r.0 <= v and v <= r.1:
            return True
    return False

def mib_value(o: CliOptions, oid: Oid, letter: str, text: str) -> Value:
    """A `TYPE VALUE` pair as net-snmp's snmp_add_var reads it with MIBs loaded (o.mib)

    The object's MIB type replaces the letter `=` and is checked against
    any other letter unless -Ir is given. Enum labels, bit names,
    DISPLAY-HINTs and OID names are accepted, and values are checked
    against the MIB's ranges. Otherwise this is parse_value.
    """
    t_o = o.mib
    if t_o is None:
        return parse_value(letter, text)
    t = t_o!
    tp = t.node_at(oid.arcs)
    tt = 0
    if tp is not None:
        tt = mibcli.full_type(tp!)
    check = o.inp.check_range and tp is not None and tt > 0 and tt <= mibcli.T_INTEGER32
    ty = letter
    if tp is not None and letter == "=":
        if tt == mibcli.T_INTEGER or tt == mibcli.T_INTEGER32:
            ty = "i"
        elif tt == mibcli.T_GAUGE or tt == mibcli.T_UNSIGNED32:
            ty = "u"
        elif tt == mibcli.T_UINTEGER:
            ty = "3"
        elif tt == mibcli.T_COUNTER:
            ty = "c"
        elif tt == mibcli.T_COUNTER64:
            ty = "C"
        elif tt == mibcli.T_TIMETICKS:
            ty = "t"
        elif tt == mibcli.T_OCTETSTR:
            ty = "s"
        elif tt == mibcli.T_BITSTRING:
            ty = "b"
        elif tt == mibcli.T_IPADDR:
            ty = "a"
        elif tt == mibcli.T_OBJID:
            ty = "o"
    want = ""
    if check:
        if ty == "i" and tt != mibcli.T_INTEGER and tt != mibcli.T_INTEGER32:
            want = "INTEGER"
        elif ty == "u" and tt != mibcli.T_GAUGE and tt != mibcli.T_UNSIGNED32:
            want = "Unsigned32"
        elif ty == "3" and tt != mibcli.T_UINTEGER:
            want = "UInteger32"
        elif ty == "c" and tt != mibcli.T_COUNTER:
            want = "Counter32"
        elif ty == "C" and tt != mibcli.T_COUNTER64:
            want = "Counter64"
        elif ty == "t" and tt != mibcli.T_TIMETICKS:
            want = "Timeticks"
        elif ty == "a" and tt != mibcli.T_IPADDR:
            want = "IpAddress"
        elif ty == "o" and tt != mibcli.T_OBJID:
            want = "OBJECT IDENTIFIER"
        elif (ty == "s" or ty == "x" or ty == "d") and tt != mibcli.T_OCTETSTR and tt != mibcli.T_BITSTRING:
            want = "OCTET STRING"
        elif ty == "b" and (tt != mibcli.T_BITSTRING or len(tp!.enums) == 0):
            want = "BITS"
    if want != "":
        have = _TYPE_NAMES.get_def(tt, "TYPE_%d" % tt)
        raise ValueError("Bad variable type (Type of attribute is " + have + ", not " + want + ")")
    if tp is None:
        return parse_value(ty, text)
    node = tp!
    if ty == "i":
        if text == "":
            raise ValueError("Bad value notation ()")
        r = c_number(text, 10)
        v = 0
        if r.end == 0 or r.end != len(text):
            found = False
            for e in node.enums:
                if e.0 == text:
                    v = e.1
                    found = True
                    break
            if not found:
                raise ValueError("Value out of range (" + text + ")")
        else:
            v = _integer32(text)
        if o.inp.check_range and not _in_range(node, v):
            raise ValueError("Value out of range (" + _range_detail(node, text) + ")")
        return Integer(v)
    if ty == "o":
        r = objid(o, text)
        if r.detail != "":
            raise ValueError(r.detail[len(text) + 2:] if r.detail.startswith(text + ": ") else r.detail)
        return ObjectIdentifier(Oid(r.arcs))
    if ty == "s" or ty == "x" or ty == "d":
        b = b""
        h = node.hint
        if ty == "s" and o.inp.use_hints and h is not None:
            # net-snmp's lenient parse_octet_hint (abcdef is 0xef for 1x:); the text itself when it fails
            hinted = mibcli.parse_octet_hint(h, text)
            if hinted is not None:
                hb = hinted!
                if o.inp.check_range and not _in_range(node, len(hb)):
                    raise ValueError("Value out of range (" + _range_detail(node, "Value does not match DISPLAY-HINT")
                                     + ")")
                return OctetString(hb)
        if ty == "d":
            b = _decimal_octets(text)
        elif ty == "x":
            b = _hex_value(text)
        else:
            b = text.encode()
        if o.inp.check_range and not _in_range(node, len(b)):
            raise ValueError("Value out of range (" + _range_detail(node, "Bad string length") + ")")
        return OctetString(b)
    if ty == "b":
        n = 0
        for e in node.enums:
            if e.1 // 8 + 1 > n:
                n = e.1 // 8 + 1
        nums: list[int] = []
        for word in text.replace(",", " ").replace("\t", " ").split(" "):
            if word == "":
                continue
            r = c_number(word, 0)
            if r.end == 0 or r.end != len(word):
                found = False
                for e in node.enums:
                    if e.0 == word:
                        nums.append(e.1)
                        found = True
                        break
                if not found:
                    raise ValueError("Value out of range (" + word + ")")
            elif r.overflow or (r.neg and r.mag != u64(0)) or r.mag > u64(524279):
                raise ValueError("Value out of range (" + word + ")")
            else:
                nums.append(int(r.mag))
        for k in nums:
            if k // 8 + 1 > n:
                n = k // 8 + 1
        out: list[int] = [0] * n
        for k in nums:
            out[k // 8] = out[k // 8] | (0x80 >> (k % 8))
        return OctetString(bytes(out))
    return parse_value(ty, text)


# Agent specification #################################################################################

def _port(text: str, spec: str) -> int:
    if text == "" or len(text) > 5 or not (text.isascii() and text.isdecimal()):
        raise CliError("Invalid port in agent address: " + spec)
    p = int(text)
    if p < 1 or p > 65535:
        raise CliError("Invalid port in agent address: " + spec)
    return p

# The transport prefixes of agent addresses, with net-snmp's aliases, and their domains
_DOMAINS: list[(str, str)] = [("udp:", "udp"), ("udp6:", "udp6"), ("udpv6:", "udp6"), ("udpipv6:", "udp6"),
                              ("tcp:", "tcp"), ("tcp6:", "tcp6"), ("tcpv6:", "tcp6"), ("tcpipv6:", "tcp6")]

# net-snmp's other transport prefixes, which actsnmp refuses
_UNSUPPORTED: list[str] = ["unix:", "ipx:", "aal5pvc:", "dtlsudp:", "dtls:", "tls:", "tlstcp:", "ssh:", "callback:",
                           "alias:"]

def parse_agent(spec: str, default_port: int) -> (domain: str, host: str, port: int):
    """Split an agent specification [udp:|udp6:|tcp:|tcp6:]HOST[:PORT]

    The prefix is case-insensitive, and net-snmp's aliases udpv6:,
    udpipv6:, tcpv6: and tcpipv6: work too; without one the domain is udp.
    An IPv6 literal needs brackets when a port follows ([::1]:161); a HOST
    with two or more colons and no brackets has no port. Raises CliError
    for other transports, an empty host or a port outside 1..65535.
    """
    s = spec
    domain = "udp"
    low = spec.lower()
    for d in _DOMAINS:
        if low.startswith(d.0):
            domain = d.1
            s = spec[len(d.0):]
            break
    for prefix in _UNSUPPORTED:
        if low.startswith(prefix):
            raise CliError("Unsupported transport in agent address: " + spec + " (only udp, udp6, tcp and tcp6)")
    host = s
    port = default_port
    if s.startswith("["):
        close = s.find("]")
        if close < 0:
            raise CliError("Invalid agent address: " + spec)
        host = s[1:close]
        rest = s[close + 1:]
        if rest != "":
            if not rest.startswith(":"):
                raise CliError("Invalid agent address: " + spec)
            port = _port(rest[1:], spec)
    elif s.count(":") == 1:
        i = s.find(":")
        host = s[:i]
        port = _port(s[i + 1:], spec)
    if host == "":
        raise CliError("Invalid agent address: " + spec)
    return (domain=domain, host=host, port=port)

def parse_engine_id(text: str, flag: str) -> bytes:
    """An engine ID of 5 to 32 octets, in hex as net-snmp reads it

    flag is the option it came from, for the CliError message.
    """
    b = netsnmp_hex(text)
    ok_len = b is not None and len(b!) >= usm.MIN_ENGINE_ID_LEN and len(b!) <= usm.MAX_ENGINE_ID_LEN
    if flag == "-e" or flag == "-E":
        if b is None:
            raise CliError("Bad engine ID value after -3" + flag[1:] + " flag.", True)
        if not ok_len:
            raise CliError("Invalid engine ID value after " + flag + " flag.", True)
        return b!
    if b is None or not ok_len:
        raise CliError("Bad engine ID value after " + flag + " flag.")
    return b!


# The scanner ##########################################################################################

def tool_of(command: str) -> str:
    """The net-snmp tool a client command imitates ("snmpget", "snmptrap", ...); "actsnmp <command>" otherwise"""
    if command == "agent" or command == "trapd" or command == "":
        return "actsnmp " + command if command != "" else "actsnmp"
    return "snmp" + command

class _Opt(object):
    # One short option: its letter, its value ("" for flags) and, for walk's -CE, the end OIDs it took
    letter: str
    value: str
    extra: list[str]

    def __init__(self, letter: str, value: str, extra: list[str]):
        self.letter = letter
        self.value = value
        self.extra = extra

class _Raw(object):
    # The options and positional arguments of a command line, before interpretation
    shorts: list[_Opt]
    longs: list[(str, str)]         # (name, value) in order
    positional: list[str]

    def __init__(self):
        self.shorts = []
        self.longs = []
        self.positional = []

def _long_takes_value(name: str) -> bool:
    return name == "hexOutputLength" or name in _SERVER_LONG

def _in_value_follows(value: str) -> bool:
    # Whether the letters of a -I argument end in s or S with nothing after it: net-snmp's snmp_in_options
    # then takes the suffix or prefix from the next argument (-Is .0)
    for k in range(len(value)):
        c = value[k]
        if c == "s" or c == "S":
            return k == len(value) - 1
        if c not in "Rrhub":
            return False
    return False

def _scan(args: list[str], command: str, mib_mode: bool=False) -> _Raw:
    # Split args into options and positional arguments like GNU getopt with permutation. snmpwalk's
    # -CE takes the end OID from the next argument, for every E of the -C argument (-CEp OID works,
    # -CE.1.3 does not: the dot is the next -C letter). With MIBs (mib_mode) -Is and -IS without a
    # value take it from the next argument, as net-snmp's snmp_in_options does
    raw = _Raw()
    tool = tool_of(command)
    i = 0
    n = len(args)
    while i < n:
        a = args[i]
        i += 1
        if a == "--":
            while i < n:
                raw.positional.append(args[i])
                i += 1
            break
        if a.startswith("--"):
            body = a[2:]
            eq = body.find("=")
            if eq >= 0:
                raw.longs.append((body[:eq], body[eq + 1:]))
            elif _long_takes_value(body):
                if i >= n:
                    raise CliError("option '--" + body + "' requires an argument", True)
                raw.longs.append((body, args[i]))
                i += 1
            else:
                raw.longs.append((body, ""))
            continue
        if len(a) < 2 or not a.startswith("-") or _is_digit(a[1]):
            raw.positional.append(a)
            continue
        j = 1
        while j < len(a):
            c = a[j]
            j += 1
            if c in _FLAG_LETTERS:
                raw.shorts.append(_Opt(c, "", []))
            elif c in _VALUE_LETTERS:
                value = a[j:]
                if value == "":
                    if i >= n:
                        raise CliError(tool + ": option requires an argument -- '" + c + "'", True)
                    value = args[i]
                    i += 1
                extra: list[str] = []
                if c == "C" and command == "walk":
                    for k in range(value.count("E")):
                        if i < n:
                            extra.append(args[i])
                            i += 1
                if c == "I" and mib_mode and _in_value_follows(value):
                    if i >= n:
                        raise CliError(tool + ": option requires an argument -- 'I'", True)
                    extra.append(args[i])
                    i += 1
                raw.shorts.append(_Opt(c, value, extra))
                break
            else:
                raise CliError(tool + ": invalid option -- '" + c + "'", True)
    return raw


# Option interpretation ###############################################################################

# The -C letters of each command, as net-snmp's tools take them (table is actsnmp's own)
_C_LETTERS: dict[str, str] = {
    "get": "f", "getnext": "f", "bulkget": "nr", "walk": "ciIptE", "bulkwalk": "cinrp", "set": "q",
    "table": "rc", "trap": "i", "inform": "i",
}

def _version(text: str) -> int:
    if text == "1":
        return message.SNMP_V1
    if text == "2c" or text == "2C":
        return message.SNMP_V2C
    if text == "3":
        return message.SNMP_V3
    raise CliError("Invalid version specified after -v flag: " + text, True)

def _int_option(text: str, what: str, lo: int, hi: int) -> int:
    t = text[1:] if text.startswith("-") else text
    if t == "" or len(t) > 12 or not (t.isascii() and t.isdecimal()):
        raise CliError(what)
    v = int(t) if not text.startswith("-") else -int(t)
    if v < lo or v > hi:
        raise CliError(what)
    return v

def _timeout(text: str) -> float:
    # net-snmp: atof(TEXT) * 1000000 as a long must be positive; what follows the number is ignored
    c = c_float(text)
    v = c.value if c.end > 0 and c.kind == 0 and not c.neg else 0.0
    if v * 1000000.0 < 1.0 or v > 86400.0:
        raise CliError("Invalid timeout in seconds after -t flag.", True)
    return float(int(v * 1000000.0)) / 1000000.0

def _retries(text: str) -> int:
    # net-snmp: the text must start with a digit, and atoi() of it must not be negative
    if text == "" or not _is_digit(text[0]):
        raise CliError("Invalid number of retries after -r flag.", True)
    v = _int32_of(c_number(text, 10))
    if v < 0:
        raise CliError("Invalid number of retries after -r flag.", True)
    return v

def _boots(text: str) -> int:
    # -Z BOOTS,TIME as net-snmp reads it (strtoul for both); the time is not used
    r = c_number(text, 10)
    if r.end == 0:
        raise CliError("Need engine boots value after -3Z flag.", True)
    rest = text[r.end:]
    if not rest.startswith(","):
        raise CliError("Need engine time after \"-Z engineBoot\".", True)
    if c_number(rest[1:], 10).end == 0:
        raise CliError("Need engine time after \"-3Z engineBoot,\".", True)
    if r.neg or r.overflow or r.mag < u64(1) or r.mag > u64(2147483647):
        raise CliError("Invalid engine boots after -Z flag.", True)
    return int(r.mag)

def _apply_c(o: CliOptions, flags: str, extra: list[str]) -> None:
    # The -C letters of one -C argument, per command as in net-snmp's tools: "Unknown flag passed to -C"
    # without the usage text, the usage text alone for a missing number, "Bad value for" a negative one
    cmd = o.command
    letters = _C_LETTERS.get(cmd)
    allowed = letters if letters is not None else ""
    tool = tool_of(cmd)
    i = 0
    e_used = 0
    while i < len(flags):
        c = flags[i]
        i += 1
        if c not in allowed:
            raise CliError("Unknown flag passed to -C: " + c)
        if c == "f":
            o.dont_fix = not o.dont_fix
        elif c == "n" or c == "r":
            r = c_number(flags[i:], 0)
            if r.end == 0:
                raise CliError("", True)
            v = _int32_of(r)
            if v < 0:
                raise CliError(tool + ": Bad value for " + ("non-repeaters" if c == "n" else "max-repetitions"))
            if c == "n":
                o.non_repeaters = v
            else:
                o.max_repetitions = v
            i += r.end
        elif c == "c":
            o.dont_check = not o.dont_check
        elif c == "i" and (cmd == "trap" or cmd == "inform"):
            o.inform = True
        elif c == "i":
            o.include_requested = not o.include_requested
        elif c == "I":
            o.dont_get_requested = not o.dont_get_requested
        elif c == "p":
            o.print_count = not o.print_count
        elif c == "t":
            o.print_time = not o.print_time
        elif c == "E":
            # the OID is read after the options (parse), as snmpwalk does
            if e_used >= len(extra):
                raise CliError("No end OID given with -CE", True)
            o.end_oid_text = extra[e_used]
            e_used += 1
        elif c == "q":
            o.quiet = not o.quiet

def _apply_short(o: CliOptions, letter: str, value: str, extra: list[str]) -> None:
    if letter == "h":
        o.help = True
    elif letter == "H":
        o.help = True
    elif letter == "V":
        o.show_version = True
    elif letter == "v":
        o.version = _version(value)
    elif letter == "c":
        o.community = value
        o.communities.append(value)
    elif letter == "w" and o.command == "agent":
        o.rw_communities.append(value)
    elif letter == "u":
        o.user = value
    elif letter == "l":
        try:
            o.level = usm.level_from_name(value)
        except ValueError:
            raise CliError("Invalid security level specified after -3l flag: " + value, True)
        o.level_given = True
    elif letter == "a":
        try:
            o.auth_protocol = usm.auth_from_name(value)
        except ValueError:
            raise CliError("Invalid authentication protocol specified after -3a flag: " + value, True)
    elif letter == "A":
        o.auth_password = value
    elif letter == "x":
        try:
            o.priv_protocol = usm.priv_from_name(value)
        except ValueError:
            raise CliError("Invalid privacy protocol specified after -3x flag: " + value, True)
    elif letter == "X":
        o.priv_password = value
    elif letter == "n":
        o.context = value
    elif letter == "e":
        o.engine_id = parse_engine_id(value, "-e")
    elif letter == "E":
        o.context_engine_id = parse_engine_id(value, "-E")
    elif letter == "Z":
        o.boots = _boots(value)
    elif letter == "t":
        o.timeout = _timeout(value)
    elif letter == "r":
        o.retries = _retries(value)
    elif letter == "O":
        try:
            o.output = o.output.with_flags(value, o.mib_mode)
        except ValueError:
            known = "qQvxaTtneUbEX0fsSu" if o.mib_mode else "qQvxaTtneUbEX0"
            bad = ""
            for c in value:
                if bad == "" and c not in known:
                    bad = c
            raise CliError("Unknown output option passed to -O: " + bad + ".", True)
    elif letter == "C":
        _apply_c(o, value, extra)
    elif letter == "m":
        o.mib_modules_opt = value
    elif letter == "M":
        o.mib_dirs_opts.append(value)
    elif letter == "I":
        if o.mib_mode:
            bad = apply_input_options(o.inp, value + (extra[0] if len(extra) > 0 else ""))
            if bad != "":
                raise CliError("Unknown input option passed to -I: " + bad + ".", True)
    elif letter == "d":
        pass            # packet dumps: not implemented
    else:
        raise CliError(tool_of(o.command) + ": invalid option -- '" + letter + "'", True)

def apply_input_options(inp: mibcli.InputOptions, value: str) -> str:
    """Apply the letters of a net-snmp -I argument (snmp_in_options); the first unknown letter, "" if none

    R, b, r, h and u toggle random access, the regular-expression lookup,
    the range check (inverted), the DISPLAY-HINTs and UCD-style input; s and
    S take the rest of the argument as the suffix and prefix added to every
    OID.
    """
    i = 0
    while i < len(value):
        c = value[i]
        i += 1
        if c == "R":
            inp.random_access = not inp.random_access
        elif c == "r":
            inp.check_range = not inp.check_range
        elif c == "h":
            inp.use_hints = not inp.use_hints
        elif c == "u":
            inp.ucd = not inp.ucd
        elif c == "b":
            inp.regex = not inp.regex
        elif c == "s":
            inp.suffix = value[i:]
            return ""
        elif c == "S":
            inp.prefix = value[i:]
            return ""
        else:
            return c
    return ""

def _level(text: str) -> int:
    if text == "" or not text.isdecimal() or len(text) > 2:
        raise CliError("Invalid level after -l: " + text, True)
    return int(text)

def _scan_mib_command(o: CliOptions, args: list[str]) -> None:
    # The options of translate (snmptranslate's -m -M -w -T -O -I, and -D -P -L ignored) and of mib2yang,
    # mibmeta and miblint (-M, -l LEVEL, -o DIR, --meta, --consistent-status, --ignore-display-hint MOD::TC);
    # options and arguments may be mixed, "--" ends the options
    cmd = o.command
    tool = "snmptranslate" if cmd == "translate" else "actsnmp " + cmd
    letters = "mMwTOIDPL" if cmd == "translate" else ("Mlo" if cmd == "mib2yang" else "Ml")
    i = 0
    n = len(args)
    while i < n:
        a = args[i]
        i += 1
        if a == "--":
            o.args.extend(args[i:])
            break
        if a.startswith("--") and cmd != "translate":
            body = a[2:]
            eq = body.find("=")
            name = body if eq < 0 else body[:eq]
            if name == "help":
                o.help = True
            elif name == "meta" and cmd == "mib2yang" and eq < 0:
                o.meta = True
            elif name == "consistent-status" and cmd == "mib2yang" and eq < 0:
                o.consistent_status = True
            elif name == "ignore-display-hint" and cmd == "mib2yang":
                v = ""
                if eq >= 0:
                    v = body[eq + 1:]
                elif i < n:
                    v = args[i]
                    i += 1
                else:
                    raise CliError("option '--ignore-display-hint' requires an argument", True)
                for h in v.split(","):
                    if h != "":
                        if "::" not in h:
                            raise CliError("--ignore-display-hint takes MODULE::TC: " + h, True)
                        o.ignore_hints.append(h)
            else:
                raise CliError("unrecognized option '" + a + "'", True)
            continue
        if len(a) < 2 or not a.startswith("-"):
            o.args.append(a)
            continue
        j = 1
        while j < len(a):
            c = a[j]
            j += 1
            if c == "h":
                o.help = True
                continue
            if c == "V":
                o.show_version = True
                continue
            if c not in letters:
                if cmd == "translate":
                    raise CliError("snmptranslate: invalid option -- '" + c + "'\ninvalid option: -?", True)
                raise CliError(tool + ": invalid option -- '" + c + "'", True)
            value = a[j:]
            if value == "":
                if i >= n:
                    raise CliError(tool + ": option requires an argument -- '" + c + "'", True)
                value = args[i]
                i += 1
            if c == "m":
                o.mib_modules_opt = value
            elif c == "M":
                o.mib_dirs_opts.append(value)
            elif c == "w":
                r = c_number(value, 10)
                w = _int32_of(r) if r.end > 0 else 0
                if w <= 0:
                    raise CliError("Invalid width specification: " + value)
                o.width = w
            elif c == "T":
                for t in value:
                    if t == "d":
                        o.details = True
                    elif t == "p":
                        o.print_tree = True
                    elif t == "B":
                        o.find_all = True
                    else:
                        raise CliError("Invalid -T<lostpad> character: " + t, True)
            elif c == "O":
                try:
                    o.output = o.output.with_flags(value, True)
                except ValueError:
                    bad = ""
                    for x in value:
                        if bad == "" and x not in "qQvxaTtneUbEX0fsSu":
                            bad = x
                    raise CliError("Unknown OID option to -O: " + bad + ".", True)
            elif c == "I":
                if _in_value_follows(value):
                    # snmp_in_options takes the prefix or suffix from the next argument (snmptranslate
                    # crashes there); translate then ignores it, as snmptranslate ignores -ISPREFIX
                    if i >= n:
                        raise CliError(tool + ": option requires an argument -- 'I'", True)
                    value += args[i]
                    i += 1
                bad = apply_input_options(o.inp, value)
                if bad != "":
                    raise CliError("Unknown OID option to -I: " + bad + ".", True)
            elif c == "l":
                o.lint_level = _level(value)
            elif c == "o":
                o.outdir = value
            break
    if o.help or o.show_version:
        return
    if cmd != "translate" and len(o.args) == 0:
        raise CliError("Missing module name", True)

def _apply_long(o: CliOptions, name: str, value: str) -> None:
    if name == "help":
        o.help = True
    elif name == "version":
        o.show_version = True
    elif name == "canon":
        o.canon = True
    elif name == "hexOutputLength":
        n = _int_option(value, "Invalid value for --hexOutputLength: " + value, 0, 1000000)
        o.output = fmt.OutputOptions(o.output.quick, o.output.quick_equals, o.output.bare_value,
                                     o.output.string_format, o.output.hex_text, o.output.numeric_timeticks, n)
    elif o.is_server() and name == "snmprec" and o.command == "agent":
        o.snmprec = value
    elif o.is_server() and name == "write-rules" and o.command == "agent":
        o.write_rules = value
    elif o.is_server() and name == "users":
        o.users = value
        o.users_given = True
    elif o.is_server() and name == "engine-id":
        o.server_engine_id = parse_engine_id(value, "--engine-id")
    elif o.is_server() and name == "port":
        o.listen_port = _int_option(value, "Invalid port after --port: " + value, 0, 65535)
    elif o.is_server() and name == "bind":
        if value == "":
            raise CliError("Invalid address after --bind", True)
        o.bind_address = value
    elif o.is_server() and name == "tcp":
        o.listen_tcp = True
    elif o.is_server():
        raise CliError("unrecognized option '--" + name + "'", True)
    else:
        # net-snmp reads --NAME=VALUE as a configuration line and warns about unknown ones
        o.warnings.append("(null): line 0: Warning: Unknown token: " + name + ".")

def _c_int(text: str) -> int:
    # C's atol(): the number at the start of text, 0 if there is none
    r = c_number(text, 10)
    if r.end == 0:
        return 0
    if r.overflow or r.mag > u64(9223372036854775807):
        return -9223372036854775807 - 1 if r.neg else 9223372036854775807
    return -int(r.mag) if r.neg else int(r.mag)

def _trap_positional(o: CliOptions, args: list[str]) -> list[str]:
    # snmptrap/snmpinform positional arguments after the agent, with snmptrap's messages; returns the
    # OID TYPE VALUE words. GENERIC, SPECIFIC and UPTIME (v1) are read like atoi/atol, but must fit the
    # Trap-PDU (net-snmp sends whatever atoi made of them)
    if o.version == message.SNMP_V1:
        if o.inform:
            raise CliError("Cannot send INFORM as SNMPv1 PDU")
        if len(args) < 1:
            raise CliError("No enterprise oid", True)
        o.enterprise = oid_arg(o, args[0] if args[0] != "" else DEFAULT_ENTERPRISE)
        if len(args) < 2:
            raise CliError("Missing agent parameter", True)
        if args[1] != "":
            addr = inet_aton(args[1])
            if addr is None:
                raise CliError("unknown host: " + args[1])
            o.agent_addr = addr!
        if len(args) < 3:
            raise CliError("Missing generic-trap parameter", True)
        o.generic = _c_int(args[2])
        if o.generic < 0 or o.generic > 6:
            raise CliError("Invalid generic trap type: " + args[2])
        if len(args) < 4:
            raise CliError("Missing specific-trap parameter", True)
        o.specific = _c_int(args[3])
        if o.specific < _INT32_MIN or o.specific > _UINT32_MAX:
            raise CliError("Invalid specific trap type: " + args[3])
        if len(args) < 5:
            raise CliError("Missing uptime parameter", True)
        if args[4] != "":
            o.uptime = _c_int(args[4])
            if o.uptime < 0 or o.uptime > _UINT32_MAX:
                raise CliError("Invalid uptime: " + args[4])
        return args[5:]
    if len(args) < 1:
        raise CliError("Missing up-time parameter", True)
    if len(args) < 2:
        raise CliError("Missing trap-oid parameter", True)
    if args[0] != "":
        try:
            o.uptime = _unsigned32(args[0])
        except ValueError:
            raise CliError("Invalid uptime: " + args[0])
    o.trap_oid = oid_arg(o, args[1])
    return args[2:]

def _trap_varbinds(o: CliOptions, words: list[str]) -> list[VarBind]:
    # snmptrap's OID TYPE VALUE triples: the first problem ends the command
    vbs: list[VarBind] = []
    i = 0
    while i < len(words):
        name = words[i]
        if i + 3 > len(words):
            raise CliError(name + ": Missing type/value for variable")
        oid = oid_arg(o, name)
        t = words[i + 1]
        try:
            v = mib_value(o, oid, t[0] if t != "" else "\x00", words[i + 2])
        except ValueError as e:
            raise CliError(name + ": " + e.error_message)
        vbs.append(VarBind(oid, v))
        i += 3
    return vbs

def _set_varbinds(o: CliOptions, words: list[str]) -> list[VarBind]:
    # snmpset's OID TYPE VALUE triples: first the syntax and the type letters of all of them (the first
    # problem ends the command), then every OID and value, all problems reported together. Value errors
    # come after net-snmp opened the session, so a session error (session_error) hides them
    i = 0
    while i < len(words):
        name = words[i]
        if i + 1 >= len(words):
            raise CliError(name + ": Needs type and value")
        t = words[i + 1]
        letter = t[0] if t != "" else "\x00"
        if letter not in SET_LETTERS:
            raise CliError(name + ": Bad object type: " + letter)
        if i + 2 >= len(words):
            raise CliError(name + ": Needs value")
        i += 3
    vbs: list[VarBind] = []
    problems: list[str] = []
    i = 0
    while i < len(words):
        name = words[i]
        r = objid(o, name)
        if r.detail != "":
            problems.append(r.detail)
        else:
            try:
                vbs.append(VarBind(Oid(r.arcs), mib_value(o, Oid(r.arcs), words[i + 1][0], words[i + 2])))
            except ValueError as e:
                problems.append(name + ": " + e.error_message)
        i += 3
    if len(problems) > 0 and o.session_error == "":
        raise CliError("\n".join(problems))
    return vbs

def _oid_list(o: CliOptions, texts: list[str], all_problems: bool) -> list[Oid]:
    # The OIDs of get, getnext, bulkget and table: snmpget and snmpgetnext report every bad one,
    # snmpbulkget only the first
    oids: list[Oid] = []
    problems: list[str] = []
    for t in texts:
        r = objid(o, t)
        if r.detail != "":
            problems.append(r.detail)
            if not all_problems:
                break
        else:
            oids.append(Oid(r.arcs))
    if len(problems) > 0:
        raise CliError("\n".join(problems))
    return oids

def _key_problem(o: CliOptions, password: str, what: str) -> None:
    # net-snmp derives Ku from every pass phrase given, whatever the level, and stops at a short one
    if password != "" and len(password.encode()) < 8:
        raise CliError("Error: passphrase chosen is below the length requirements of the USM (min=8).\n"
                       + tool_of(o.command) + ":  (The supplied password length is too short.)\n"
                       + "Error generating a key (Ku) from the supplied " + what + " pass phrase. ")

def _check_v3(o: CliOptions) -> None:
    # The -l level against the protocols and passwords, with net-snmp's defaults (MD5, DES). What
    # net-snmp reports when it opens the session goes to session_error
    if o.version != message.SNMP_V3:
        return
    if not o.level_given:
        o.level = usm.LEVEL_NO_AUTH_NO_PRIV
    # snmptrap -Ci reports as snmpinform
    tool = "snmpinform" if o.command == "trap" and o.inform else tool_of(o.command)
    problem = ""
    if o.user == "":
        problem = tool + ": No securityName specified"
    if (o.level & message.FLAG_AUTH) != 0:
        if o.auth_protocol == usm.AUTH_NONE:
            o.auth_protocol = usm.AUTH_MD5
        if o.auth_password == "" and problem == "":
            problem = tool + ": USM authentication failure (incorrect password or key)"
    else:
        o.auth_protocol = usm.AUTH_NONE
        o.auth_password = ""
    if (o.level & message.FLAG_PRIV) != 0:
        if o.priv_protocol == usm.PRIV_NONE:
            o.priv_protocol = usm.PRIV_DES
        if o.priv_password == "" and problem == "":
            problem = tool + ": USM generic error"
    else:
        o.priv_protocol = usm.PRIV_NONE
        o.priv_password = ""
    o.session_error = problem

def parse(argv: list[str]) -> CliOptions:
    """Parse `actsnmp <command> [OPTIONS] ...` without MIBs: scan, then finish

    argv[0] is the program name. OIDs are read numerically.
    """
    o = scan(argv)
    if not (o.help or o.show_version):
        finish(o)
    return o

def scan(argv: list[str], env_mibs: ?str=None, env_mibdirs: ?str=None) -> CliOptions:
    """Read the options of `actsnmp <command> [OPTIONS] ...`, leaving the arguments in args

    argv[0] is the program name. -h, --help or a missing command give a
    CliOptions with help set and command "", -V one with show_version set.
    Raises CliError for a bad option. mib_mode is set when the options,
    env_mibs, env_mibdirs or a MOD::name argument ask for MIBs, and always
    for the MIB commands.
    """
    if len(argv) < 2:
        o = CliOptions("")
        o.help = True
        return o
    command = argv[1]
    if command == "-h" or command == "--help" or command == "help":
        o = CliOptions("")
        o.help = True
        return o
    if command == "-V" or command == "--version":
        o = CliOptions("")
        o.show_version = True
        return o
    if command not in COMMANDS:
        raise CliError("Unknown command: " + command, True)
    o = CliOptions(command)
    if command in MIB_COMMANDS:
        _scan_mib_command(o, argv[2:])
        return o
    raw = _scan(argv[2:], command)
    mib_mode = env_mibs is not None or env_mibdirs is not None
    v1 = False
    ends: list[str] = []
    for sh in raw.shorts:
        if sh.letter == "m" or sh.letter == "M":
            mib_mode = True
        elif sh.letter == "v":
            v1 = sh.value == "1"
        elif sh.letter == "C":
            ends.extend(sh.extra)
    if len(mibcli.modules_named(oid_words_of(command, raw.positional, v1, ends))) > 0:
        mib_mode = True
    o.mib_mode = mib_mode
    if mib_mode:
        raw = _scan(argv[2:], command, True)
    for s in raw.shorts:
        if s.letter == "w" and command != "agent":
            raise CliError(tool_of(command) + ": invalid option -- 'w'", True)
        _apply_short(o, s.letter, s.value, s.extra)
    for l in raw.longs:
        _apply_long(o, l.0, l.1)
    o.args = raw.positional
    return o

def finish(o: CliOptions) -> None:
    """Check and read the positional arguments of a scanned command line, using o.mib if set

    The checks run in net-snmp's order. SNMPv3 problems that net-snmp finds
    only when it opens the session do not raise; they go to
    o.session_error. Raises CliError for everything else.
    """
    if o.command in MIB_COMMANDS:
        return
    try:
        _finish(o)
        t = o.mib
        if t is not None:
            t.hidden = set()
    except CliError as e:
        if len(o.mib_notes) > 0:
            notes = "\n".join(o.mib_notes)
            o.mib_notes = []
            raise CliError(notes + ("\n" + e.error_message if e.error_message != "" else ""), e.usage)
        raise e

def _finish(o: CliOptions) -> None:
    command = o.command
    pos = o.args
    if o.is_server():
        if len(pos) > 0:
            raise CliError("Unexpected argument: " + pos[0], True)
        if o.listen_tcp and o.listen_port == 0:
            raise CliError("--port 0 is not supported with --tcp (the port picked for it cannot be learned)", True)
        if o.command == "agent" and o.engine_id is not None:
            o.server_engine_id = o.engine_id!
        if o.command == "trapd" and o.engine_id is not None:
            o.server_engine_id = o.engine_id!
        return
    if o.version == message.SNMP_V3:
        _key_problem(o, o.auth_password, "authentication")
        _key_problem(o, o.priv_password, "privacy")
    if len(pos) == 0:
        raise CliError("No hostname specified.", True)
    o.peer = pos[0]
    target = parse_agent(pos[0], o.port)
    o.transport_domain = target.domain
    o.address = target.host
    o.port = target.port
    if o.version != message.SNMP_V3 and o.community is None:
        raise CliError("No community name specified.", True)
    _check_v3(o)
    args = pos[1:]
    if command == "get" or command == "getnext" or command == "bulkget" or command == "table":
        if len(args) == 0:
            raise CliError("Missing object name", True)
        if len(args) > MAX_CMDLINE_OIDS:
            raise CliError("Too many object identifiers specified. Only %d allowed in one request."
                           % MAX_CMDLINE_OIDS, True)
        o.oids = _oid_list(o, args, command != "bulkget")
    elif command == "walk" or command == "bulkwalk":
        end = o.end_oid_text
        if end is not None:
            o.end_oid = oid_arg(o, end)
        # like snmpwalk, only the first argument is used
        o.oids = [oid_arg(o, args[0] if len(args) > 0 else DEFAULT_WALK_ROOT)]
    elif command == "set":
        if len(args) == 0:
            raise CliError("Missing object name", True)
        if len(args) > 3 * MAX_CMDLINE_OIDS:
            raise CliError("Too many assignments specified. Only %d allowed in one request." % MAX_CMDLINE_OIDS,
                           True)
        o.varbinds = _set_varbinds(o, args)
    else:
        if o.command == "trap" and o.inform and o.version == message.SNMP_V1:
            raise CliError("Cannot send INFORM as SNMPv1 PDU")
        o.varbinds = _trap_varbinds(o, _trap_positional(o, args))


# Usage texts #########################################################################################

_COMMON = """  -h, --help            print this text
  -V                    print the version
  -v 1|2c|3             SNMP version (default 2c)
  -c COMMUNITY          community (SNMPv1/v2c)
  -u USER               SNMPv3 user name
  -l LEVEL              noAuthNoPriv|authNoPriv|authPriv
  -a PROTOCOL           MD5|SHA|SHA-224|SHA-256|SHA-384|SHA-512
  -A PASSPHRASE         authentication pass phrase
  -x PROTOCOL           DES|AES|AES-192|AES-256|AES-192-C|AES-256-C|3DES
  -X PASSPHRASE         privacy pass phrase
  -n CONTEXT            context name
  -e ENGINE-ID          security engine ID (hex)
  -E ENGINE-ID          context engine ID (hex)
  -t TIMEOUT            seconds per attempt (default 1)
  -r RETRIES            retries (default 5)
  -O FLAGS              output options: q Q v x a T t (n e U b E X 0 accepted)
  --hexOutputLength=N   octets per Hex-STRING line (0: no line breaks)
  --canon               the interop lab's canonical output format
  -m MODULES, -M DIRS   load MIBs (names and values per the MIBs; see actsnmp translate -h)
  -I R|r|h|u|sSUF|SPRE  with MIBs: random access, no range check, no DISPLAY-HINTs, UCD-style, suffix, prefix
  -O f|s|S|u            with MIBs: full, label, MODULE::label (default), UCD-style OIDs; e U b E X: enums, units,
                        index forms"""

_C_TEXT: dict[str, str] = {
    "get": "  -Cf                   do not drop the failed OID and retry after an error",
    "getnext": "  -Cf                   do not drop the failed OID and retry after an error",
    "bulkget": "  -Cn<N>                non-repeaters (default 0)\n  -Cr<N>                max-repetitions (default 10)",
    "walk": ("  -Cc                   do not check that OIDs increase\n  -Ci                   include the root (GET it first)\n"
             + "  -CI                   no GET of the root when the subtree is empty\n"
             + "  -Cp                   print the number of variables found\n"
             + "  -Ct                   print the time the walk took\n  -CE OID               end the walk at OID"),
    "bulkwalk": ("  -Cc                   do not check that OIDs increase\n"
                 + "  -Ci                   include the root (GET it first)\n"
                 + "  -Cp                   print the number of variables found\n"
                 + "  -Cn<N>                non-repeaters (default 0)\n  -Cr<N>                max-repetitions (default 10)"),
    "set": "  -Cq                   do not print the result",
    "table": "  -Cr<N>                max-repetitions (default 10)\n  -Cc                   do not check that OIDs increase",
    "trap": "  -Ci                   send an INFORM instead of a TRAP",
    "inform": "  -Ci                   send an INFORM (the default of inform)",
}

_SYNOPSIS: dict[str, str] = {
    "get": "get [OPTIONS] AGENT OID [OID]...",
    "getnext": "getnext [OPTIONS] AGENT OID [OID]...",
    "bulkget": "bulkget [OPTIONS] AGENT OID [OID]...",
    "walk": "walk [OPTIONS] AGENT [OID]",
    "bulkwalk": "bulkwalk [OPTIONS] AGENT [OID]",
    "set": "set [OPTIONS] AGENT OID TYPE VALUE [OID TYPE VALUE]...",
    "table": "table [OPTIONS] AGENT COLUMN-OID [COLUMN-OID]...",
    "trap": ("trap [OPTIONS] AGENT UPTIME TRAPOID [OID TYPE VALUE]...\n"
             + "       actsnmp trap -v1 [OPTIONS] AGENT ENTERPRISE AGENT-ADDR GENERIC SPECIFIC UPTIME [OID TYPE VALUE]..."),
    "inform": "inform [OPTIONS] AGENT UPTIME TRAPOID [OID TYPE VALUE]...",
    "agent": ("agent [--snmprec FILE] [--write-rules TSV] [--users TSV] [--engine-id HEX] [--port N] [--bind ADDR] [--tcp] "
              + "[-c COMM]... [-w COMM]..."),
    "trapd": "trapd [--port N] [--bind ADDR] [--tcp] [-c COMM]... [--users TSV] [--engine-id HEX] [--canon] [-O FLAGS]",
    "translate": "translate [-m MODULES] [-M DIRS] [-O FLAGS] [-I FLAGS] [-Td] [-Tp] [-TB] [-w WIDTH] OID...",
    "mib2yang": ("mib2yang [-M DIRS] [-o OUTDIR] [--meta] [--consistent-status] [--ignore-display-hint MOD::TC] "
                 + "[-l LEVEL] MODULE|FILE..."),
    "mibmeta": "mibmeta [-M DIRS] [-l LEVEL] MODULE|FILE...",
    "miblint": "miblint [-M DIRS] [-l LEVEL] FILE|MODULE...",
}

_MIB_TEXT = """  -m MODULES            modules to load, ':'-separated (ALL: every module of the path; +X adds X to
                        net-snmp's default list; a name with a '/' is a file; default: MIBS, else none)
  -M DIRS               MIB search path, ':'-separated (+DIR appends, -DIR puts first; default: MIBDIRS,
                        else $HOME/.snmp/mibs:/usr/share/snmp/mibs:/usr/share/snmp/mibs/iana:/usr/share/snmp/mibs/ietf)"""

_TCP_TEXT = "  --tcp                 listen on TCP (RFC 3430) instead of UDP; not with --port 0\n"

def usage(command: str) -> str:
    """Return the usage text of a command ("" or an unknown name: of the whole CLI), without the final newline"""
    if command == "translate":
        return ("USAGE: actsnmp " + _SYNOPSIS["translate"] + "\n\n"
                + "  Translates OIDs between names and numbers like net-snmp's snmptranslate.\n" + _MIB_TEXT + "\n"
                + "  -O n|f|s|S|u          numeric, full, label, MODULE::label (default) or UCD-style output\n"
                + "                        (and the other -O letters of the SNMP commands)\n"
                + "  -Td                   print the details of the object\n"
                + "  -Tp                   print the tree below the object (the whole tree without OID)\n"
                + "  -TB                   every label the name matches as a regular expression\n"
                + "  -IR                   find a label anywhere in the tree (default: a path from the root)\n"
                + "  -Ib                   the best match of the name as a regular expression\n"
                + "  -Iu, -Ir, -Ih         names below mib-2; no index range checks; no DISPLAY-HINTs\n"
                + "  -Is SUFFIX, -IS PREFIX  append SUFFIX to / put PREFIX before every OID\n"
                + "  -w WIDTH              line width of -Td and -Tp")
    if command == "mib2yang" or command == "mibmeta" or command == "miblint":
        what = {"mib2yang": "Writes MODULE.yang (RFC 6643) per module, with --meta MODULE.mibmeta.json too.",
                "mibmeta": "Prints the mibmeta JSON (actsnmp-mibmeta/1) of the modules.",
                "miblint": "Prints the diagnostics of the modules (smilint-like), exit 1 for level 1-2."}[command]
        extra = ""
        if command == "mib2yang":
            extra = ("  -o OUTDIR             directory for the files (default: the current one)\n"
                     + "  --meta                also write MODULE.mibmeta.json\n"
                     + "  --consistent-status   a definition referring to a deprecated one of its module takes its status\n"
                     + "  --ignore-display-hint MOD::TC   ignore the DISPLAY-HINT of a TC (RFC 6643 section 2)\n")
        return ("USAGE: actsnmp " + _SYNOPSIS[command] + "\n\n  " + what + "\n"
                + "  MODULE|FILE           a module of the search path, or a file (its modules)\n"
                + "  -M DIRS               MIB search path (as for translate; default: MIBDIRS, else net-snmp's)\n"
                + extra
                + "  -l LEVEL              report diagnostics up to this level (1-6; default "
                + ("3" if command == "miblint" else "2") + ")")
    if command == "agent":
        return ("USAGE: actsnmp " + _SYNOPSIS["agent"] + "\n\n"
                + "  Serves an snmprec file (SNMPv1/v2c/v3) until SIGTERM or SIGINT.\n"
                + "  --snmprec FILE        default " + LAB_SNMPREC + "\n"
                + "  --write-rules TSV     default " + LAB_WRITE_RULES + "\n"
                + "  --users TSV           default " + LAB_USERS + " (skipped when absent)\n"
                + "  --engine-id HEX       default 0x" + AGENT_ENGINE_ID + "\n"
                + "  --port N, --bind ADDR default " + DEFAULT_BIND + ":%d\n" % AGENT_PORT
                + _TCP_TEXT
                + "  -c COMM / -w COMM     read-only / read-write community (default: public, private rw)")
    if command == "trapd":
        return ("USAGE: actsnmp " + _SYNOPSIS["trapd"] + "\n\n"
                + "  Prints every trap and inform received until SIGTERM or SIGINT.\n"
                + "  --port N, --bind ADDR default " + DEFAULT_BIND + ":%d\n" % TRAPD_PORT
                + _TCP_TEXT
                + "  -c COMM               accepted community (repeatable; default public; * = any)\n"
                + "  --users TSV           SNMPv3 users (default " + LAB_USERS + " when present)\n"
                + "  --engine-id HEX       default 0x" + TRAPD_ENGINE_ID + "\n"
                + "  --canon               canonical NOTIFICATION blocks (interop/expected/notify)")
    syn = _SYNOPSIS.get(command)
    if syn is not None:
        cx = _C_TEXT.get(command)
        c = cx if cx is not None else ""
        agent = ("\n\n  AGENT                 [udp:|udp6:|tcp:|tcp6:]HOST[:PORT] (default port %d)\n"
                 % (TRAP_PORT if command == "trap" or command == "inform" else SNMP_PORT))
        types = ""
        if command == "set" or command == "trap" or command == "inform":
            types = ("\n  TYPE                  i u c 3 C t a o n s x d b, q (Opaque hex), F D I U (Opaque float,\n"
                     + "                        double, Int64, UInt64)")
        return ("USAGE: actsnmp " + syn + agent + "\nOPTIONS:\n" + _COMMON
                + ("\n" + c if c != "" else "") + types)
    lines = ["USAGE: actsnmp COMMAND [OPTIONS] ...", "", "COMMANDS:"]
    for name in COMMANDS:
        lines.append("  actsnmp " + _SYNOPSIS[name].split("\n")[0])
    lines.append("")
    lines.append("actsnmp COMMAND -h shows the options of a command.")
    return "\n".join(lines)
