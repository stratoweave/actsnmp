"""Interop tests: the library over real UDP against the Docker lab (interop/README.md)

These are env tests gated with t.require("interop"). Start the lab, then:

    interop/up.sh
    acton test --tag interop --no-cache --min-iter 1 --max-iter 1 --max-time 120000 --jobs 1 --module test_interop

Each test skips itself when the lab's snmpd does not answer. Results are
compared in canonical form with interop/expected/canon/ and
interop/expected/notify/. The SET tests restore what they change, and the
restart test leaves snmpd freshly started.

Most tests describe their requests as a list of Steps that a Script actor
runs in order, then check the Outcomes by label, collecting every failure
instead of stopping at the first.
"""

import net
import process
import testing
import time

import errors
import fmt
import message
import mibview
import notify
import pdu
import security
import usm
