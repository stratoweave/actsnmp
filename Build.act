name = "snmp"
fingerprint = 0x9ad152920d1e63ff

# mbedtls headers only: the objects come from libActon, which links mbedcrypto
# into every Acton program. The option resolves to <acton dist>/deps of the
# compiler in use, so the headers always match the linked mbedtls.
# See deps/mbedtls_headers/build.zig.
zig_dependencies = {
    "mbedtls_headers": (
        path="deps/mbedtls_headers",
        options={"acton_sysdeps": "actonbase_dep.path(\"../deps\")"},
        artifacts=["mbedtls_headers"]
    )
}
