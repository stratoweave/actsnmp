# Fetched corpus (fetch.sh) and oracle outputs (oracles.sh, report.py): large
# and partly proprietary. Only the summaries (modules.tsv, duplicates.tsv,
# vendors.tsv) and the curated golden/ set are committed.
/corpus/
/cache/
__pycache__/
*.pyc
# staged (*.new) and previous (*.prev) generations of the summaries
# (index.py, report.py --stage, swap.py)
/*.new
/*.prev
*.tmp
# expected oracle outputs derived from IEEE/vendor module texts, which may not
# be redistributed; golden.sh --local regenerates them from the corpus
/golden/expected-local/
