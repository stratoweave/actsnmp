# Acton build state and output (the compiler puts the generated build.zig,
# build.zig.zon and all C/objects under out/; the Zig caches live in
# ~/.cache/acton, not in the project)
.acton.compile.lock
.acton.lock
/out/

# Written to the project root by older acton versions. Anchored to the
# root on purpose: deps/mbedtls_headers/build.zig{,.zon} must stay tracked.
/build.zig
/build.zig.zon

# Zig caches and fetched packages, in case zig or `acton zig-pkg` is run here
.zig-cache/
zig-cache/
zig-out/
zig-pkg/

# Test runner output; commit snapshots/expected/, not snapshots/output/
/snapshots/output/

# Python bytecode from the lab helper scripts
__pycache__/
